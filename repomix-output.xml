<file path="src/widgets/add-bean-modal/ui/useAddBeanSubmit.ts">
  1: import { useCreateBean, useUpdateBean } from '@entities/bean/queries';
  2: import { useInsertStockEvent } from '@entities/bean-stock-event';
  3: import type { Bean } from '@shared/types/database.types';
  4: 
  5: export interface FormData {
  6:     name: string;
  7:     origin: string;
  8:     region: string;
  9:     farm: string;
 10:     process: string;
 11:     variety: string;
 12:     altitude: string;
 13:     stock: string;
 14:     capacity: string;
 15:     costPerKg: string;
 16:     tastingNotes: string;
 17: }
 18: 
 19: interface UseAddBeanSubmitParams {
 20:     userId: string;
 21:     tab: 'new' | 'restock' | 'edit' | 'adjust';
 22:     selectedBeanId: string | null;
 23:     restockAmount: string;
 24:     adjustType: 'adjustment' | 'write_off';
 25:     adjustSign: '+' | '-';
 26:     adjustAmount: string;
 27:     adjustNote: string;
 28:     existingBeans: Bean[];
 29:     initialData: Bean | null;
 30:     onSuccess?: (bean: Bean | null) => void;
 31:     onClose: () => void;
 32: }
 33: 
 34: export const useAddBeanSubmit = ({
 35:     userId,
 36:     tab,
 37:     selectedBeanId,
 38:     restockAmount,
 39:     adjustType,
 40:     adjustSign,
 41:     adjustAmount,
 42:     adjustNote,
 43:     existingBeans,
 44:     initialData,
 45:     onSuccess,
 46:     onClose,
 47: }: UseAddBeanSubmitParams) => {
 48:     const createBean = useCreateBean(userId);
 49:     const updateBean = useUpdateBean(userId);
 50:     const insertStockEvent = useInsertStockEvent();
 51: 
 52:     const isSubmitting = createBean.isPending || updateBean.isPending || insertStockEvent.isPending;
 53: 
 54:     const handleSubmit = async (formData: FormData) => {
 55:         if (isSubmitting) return;
 56:         try {
 57:             if (tab === 'new') {
 58:                 const stockGrams = Math.round(parseFloat(formData.stock) * 1000) || 0;
 59:                 const newBean = await createBean.mutateAsync({
 60:                     user_id: userId,
 61:                     name: formData.name,
 62:                     origin: formData.origin || null,
 63:                     region: formData.region || null,
 64:                     farm: formData.farm || null,
 65:                     process: formData.process || null,
 66:                     variety: formData.variety || null,
 67:                     altitude_masl: formData.altitude ? parseInt(formData.altitude, 10) : null,
 68:                     capacity_grams: Math.round(parseFloat(formData.capacity) * 1000) || 5000,
 69:                     cost_per_kg: formData.costPerKg ? parseInt(formData.costPerKg, 10) : null,
 70:                     tasting_notes: formData.tastingNotes || null,
 71:                     purchase_date: new Date().toISOString().split('T')[0],
 72:                 });
 73:                 if (stockGrams > 0) {
 74:                     await insertStockEvent.mutateAsync({
 75:                         user_id: userId,
 76:                         bean_id: newBean.id,
 77:                         delta_grams: stockGrams,
 78:                         event_type: 'purchase',
 79:                     });
 80:                 }
 81:                 onSuccess?.(newBean);
 82:             } else if (tab === 'edit' && initialData) {
 83:                 const updated = await updateBean.mutateAsync({
 84:                     id: initialData.id,
 85:                     name: formData.name,
 86:                     origin: formData.origin || null,
 87:                     region: formData.region || null,
 88:                     farm: formData.farm || null,
 89:                     process: formData.process || null,
 90:                     variety: formData.variety || null,
 91:                     altitude_masl: formData.altitude ? parseInt(formData.altitude, 10) : null,
 92:                     capacity_grams: Math.round(parseFloat(formData.capacity) * 1000) || 5000,
 93:                     cost_per_kg: formData.costPerKg ? parseInt(formData.costPerKg, 10) : null,
 94:                     tasting_notes: formData.tastingNotes || null,
 95:                 });
 96:                 onSuccess?.(updated);
 97:             } else if (tab === 'restock' && selectedBeanId && restockAmount) {
 98:                 const amount = Math.round(parseFloat(restockAmount) * 1000);
 99:                 if (!Number.isFinite(amount) || amount <= 0) return;
100:                 const currentBean = existingBeans.find((b) => b.id === selectedBeanId);
101:                 await insertStockEvent.mutateAsync({
102:                     user_id: userId,
103:                     bean_id: selectedBeanId,
104:                     delta_grams: amount,
105:                     event_type: 'purchase',
106:                 });
107:                 onSuccess?.(currentBean ?? null);
108:             } else if (tab === 'adjust' && selectedBeanId && adjustAmount) {
109:                 const rawGrams = Math.round(parseFloat(adjustAmount) * 1000);
110:                 if (!Number.isFinite(rawGrams) || rawGrams <= 0) return;
111:                 const delta =
112:                     adjustType === 'write_off' ? -Math.abs(rawGrams) : adjustSign === '+' ? rawGrams : -rawGrams;
113:                 const currentBean = existingBeans.find((b) => b.id === selectedBeanId);
114:                 await insertStockEvent.mutateAsync({
115:                     user_id: userId,
116:                     bean_id: selectedBeanId,
117:                     delta_grams: delta,
118:                     event_type: adjustType,
119:                     note: adjustNote || null,
120:                 });
121:                 onSuccess?.(currentBean ?? null);
122:             }
123:             onClose();
124:         } catch (err) {
125:             console.error('AddBeanModal submit error:', err);
126:         }
127:     };
128: 
129:     return { handleSubmit, isSubmitting };
130: };
</file>

