784:                     : []),
785:             ],
786:             yAxis: [
787:                 {
788:                     gridIndex: 0,
789:                     type: 'value',
790:                     name: `Temperature (${unitLabel})`,
791:                     nameLocation: 'middle',
792:                     nameGap: Y_AXIS_NAME_GAP,
793:                     nameTextStyle: axisNameStyle,
794:                     axisLine: { onZero: false },
795:                     axisLabel: axisLabelStyle,
796:                     splitLine: { show: true, lineStyle: { color: colors.gridLine } },
797:                     min: temperatureUnit === 'F' ? 122 : 50,
798:                     max: temperatureUnit === 'F' ? 482 : 250,
799:                     interval: 20,
800:                 },
801:                 {
802:                     gridIndex: 0,
803:                     type: 'value',
804:                     name: `RoR (${rorUnit})`,
805:                     nameLocation: 'middle',
806:                     nameGap: Y_AXIS_NAME_GAP,
807:                     nameTextStyle: axisNameStyle,
808:                     position: 'right',
809:                     axisLine: { onZero: false },
810:                     axisLabel: rightYAxisLabel,
811:                     splitLine: { show: false },
812:                     min: ROR_Y_MIN,
