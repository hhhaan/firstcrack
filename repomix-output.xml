 27: const NUMERIC_INPUT_PROPS = {
 28:     type: 'text' as const,
 29:     inputMode: 'numeric' as const,
 30:     pattern: '[0-9]*',
 31: } satisfies Partial<React.InputHTMLAttributes<HTMLInputElement>>;
 32: 
 33: const handleNumericBeforeInput = (e: React.FormEvent<HTMLInputElement>) => {
 34:     const ev = e.nativeEvent as InputEvent;
 35:     if (ev.data && !/^\d*$/.test(ev.data)) e.preventDefault();
 36: };
 37: 
 38: const handleNumericPaste = (e: React.ClipboardEvent<HTMLInputElement>) => {
 39:     if (!/^\d+$/.test(e.clipboardData.getData('text/plain'))) e.preventDefault();
 40: };
 41: 
 42: const numericProps = {
 43:     ...NUMERIC_INPUT_PROPS,
 44:     onBeforeInput: handleNumericBeforeInput,
 45:     onPaste: handleNumericPaste,
 46: };
