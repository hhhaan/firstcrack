 26: class ModbusAdapter:
 27:     """
 28:     MODBUS TCP/RTU 어댑터 (Diedrich, Easyster, Proaster, Trinitas, Probat Probatone, Loring).
 29:     pymodbus 3.x AsyncModbusTcpClient / AsyncModbusSerialClient 사용.
 30: 
 31:     mode="tcp" → TCP (host, port)
 32:     mode="rtu" → Serial RTU (comport, baudrate)
 33: 
 34:     modbus_registers: roaster_registry의 "modbus_registers" 필드.
 35:       {
 36:         "BT": {"register": N, "func": 1|2|3|4, "unit_id": N,
 37:                "float": bool, "div": 0|1|2, "mode": "C"|"F",
 38:                "signed": bool},
 39:         "ET": {...} or None,
 40:       }
 41:     func=1 → Read Coils           (bit)
 42:     func=2 → Read Discrete Inputs (bit)
 43:     func=3 → Read Holding Registers
 44:     func=4 → Read Input Registers
 45:     float=True  → 2레지스터 IEEE 32-bit float (Diedrich CR/DR)
 46:     div=1  → ÷10, div=2 → ÷100
 47:     mode="F" → °F → °C 변환 (Diedrich, Loring)
 48:     signed=True → 16-bit signed integer 해석
 49: 
 50:     word_order="little" (기본) → Artisan wordorderLittle=True와 동일.
 51:                                   float 2레지스터를 [low, high] 순서로 해석.
 52:     word_order="big"           → [high, low] 순서.
 53:     """
 54: 
 55:     def __init__(
 56:         self,
 57:         mode: str = "tcp",
 58:         host: str = "127.0.0.1",
 59:         port: int = 502,
 60:         comport: str = "",
 61:         baudrate: int = 9600,
 62:         bytesize: int = 8,
 63:         parity: str = "N",
 64:         stopbits: float = 1,
 65:         interval: float = 1.0,
 66:         word_order: str = "little",
 67:         modbus_registers: dict[str, Any] | None = None,
 68:         **_: Any,
 69:     ) -> None:
 70:         self._mode = mode.lower()
 71:         self._host = host
 72:         self._port = port
 73:         self._comport = comport
 74:         self._baudrate = baudrate
 75:         self._bytesize = bytesize
 76:         self._parity = parity
 77:         self._stopbits = int(stopbits)
 78:         self._interval = interval
 79:         self._word_order = word_order.lower()  # "little" | "big"
 80:         self._regs: dict[str, Any] = modbus_registers or {}
 81:         self._client: Any = None
 82:         # Artisan 기본값: TCP readRetries=0, serial_readRetries=1.
 83:         # 우리도 동일하게 모드별 차등 — 500ms 폴링 사이클 안에 들어오도록.
 84:         # TODO(T36): RTU는 시리얼 응답이 본질적으로 느려서 500ms 폴링에는 빠듯함.
 85:         #   채널 3개 retry 한 번 들어가면 worst-case 1.8s → 폴링 cycle 누락 가능.
 86:         #   UI에서 RTU 머신 선택 시 pollIntervalMs를 자동으로 1000ms로 올리는 옵션 필요.
 87:         #   (artisan 권장도 RTU=1s 폴링)
 88:         self._read_retries: int = 0 if self._mode == "tcp" else 1
 89: 
 90:     async def connect(self) -> None:
 91:         from pymodbus.client import AsyncModbusTcpClient, AsyncModbusSerialClient  # type: ignore[import]
 92: 
 93:         if not self._regs:
 94:             raise ValueError(
 95:                 "modbus_registers가 비어 있음. roaster_registry 확인 필요."
 96:             )
 97: 
 98:         if self._mode == "tcp":
 99:             self._client = AsyncModbusTcpClient(
100:                 host=self._host, port=self._port, timeout=config.MODBUS_TCP_TIMEOUT
101:             )
102:             _log.info(
103:                 "ModbusAdapter connecting: TCP %s:%d timeout=%.1fs",
104:                 self._host,
105:                 self._port,
106:                 config.MODBUS_TCP_TIMEOUT,
107:             )
108:         else:
109:             self._client = AsyncModbusSerialClient(
110:                 port=self._comport,
111:                 framer=FramerType.RTU,
112:                 baudrate=self._baudrate,
113:                 bytesize=self._bytesize,
114:                 parity=self._parity,
115:                 stopbits=self._stopbits,
116:                 timeout=config.MODBUS_RTU_TIMEOUT,
117:             )
118:             _log.info(
119:                 "ModbusAdapter connecting: RTU port=%s baudrate=%d bytesize=%d parity=%s stopbits=%g timeout=%.1fs",
120:                 self._comport,
121:                 self._baudrate,
122:                 self._bytesize,
123:                 self._parity,
124:                 self._stopbits,
125:                 config.MODBUS_RTU_TIMEOUT,
126:             )
127: 
128:         await self._client.connect()
129:         if not self._client.connected:
130:             raise ConnectionError(
131:                 f"MODBUS 연결 실패: "
132:                 f"{'%s:%d' % (self._host, self._port) if self._mode == 'tcp' else self._comport}"
133:             )
134:         if self._mode != "tcp":
135:             await asyncio.sleep(config.MODBUS_RTU_CONNECT_DELAY)
136:         else:
137:             await asyncio.sleep(0.3)  # Artisan: "avoid possible hickups on startup"
138:         _log.info("ModbusAdapter connected OK (mode=%s)", self._mode)
139: 
140:     async def disconnect(self) -> None:
141:         if self._client is not None:
142:             client, self._client = self._client, None
143:             try:
144:                 # 불량 시리얼 포트에서 close()가 행하면 이후 모든 lock이 막힌다
145:                 await asyncio.wait_for(
146:                     asyncio.to_thread(client.close),
147:                     timeout=config.MODBUS_CLOSE_TIMEOUT,
148:                 )
149:             except Exception as exc:
150:                 _log.warning("MODBUS close 실패/타임아웃 (무시): %s", exc)
151: 
152:     async def _read_channel(self, cfg: dict[str, Any]) -> float:
153:         """단일 채널(BT 또는 ET) 읽기. retry 포함."""
154:         register: int = cfg["register"]
155:         func: int = cfg["func"]
156:         unit_id: int = cfg["unit_id"]
157:         is_float: bool = cfg.get("float", False)
158:         div: int = cfg.get("div", 0)
159:         temp_mode: str = cfg.get("mode", "C")
160:         is_signed: bool = cfg.get("signed", False)
161:         # func=1/2(bit): count=1, func=3/4: float/bcd(32bit)→2, bcd16/int→1
162:         is_bcd32 = cfg.get("bcd", False)
163:         is_bcd16 = cfg.get("bcd_as_int", False)
164:         count = 1 if func in (1, 2) else (2 if (is_float or is_bcd32) else 1)
165: 
166:         last_exc: Exception = RuntimeError("MODBUS 읽기 실패")
167:         for attempt in range(self._read_retries + 1):
168:             try:
169:                 _log.debug(
170:                     "READ attempt %d: func=%d register=%d(0x%04X) count=%d unit=%d",
171:                     attempt + 1,
172:                     func,
173:                     register,
174:                     register,
175:                     count,
176:                     unit_id,
177:                 )
178:                 TRACE.record(
179:                     "tx", "modbus",
180:                     f"func={func} register={register}(0x{register:04X}) count={count} unit={unit_id}",
181:                 )
182:                 if func == 1:
183:                     result = await self._client.read_coils(
184:                         register, count=count, device_id=unit_id
185:                     )
186:                 elif func == 2:
187:                     result = await self._client.read_discrete_inputs(
188:                         register, count=count, device_id=unit_id
189:                     )
190:                 elif func == 3:
191:                     result = await self._client.read_holding_registers(
192:                         register, count=count, device_id=unit_id
193:                     )
194:                 else:
195:                     result = await self._client.read_input_registers(
196:                         register, count=count, device_id=unit_id
197:                     )
198: 
199:                 if result.isError():
200:                     raise IOError(
201:                         f"MODBUS 오류 응답: func={func} register={register} unit={unit_id} → {result}"
202:                     )
203: 
204:                 # func=1/2: bit 반환
205:                 if func in (1, 2):
206:                     TRACE.record("rx", "modbus", f"register={register} bits", list(result.bits[:count]))
207:                     _log.debug("READ OK: bits=%s", result.bits)
208:                     return float(result.bits[0]) if result.bits else 0.0
209: 
210:                 TRACE.record("rx", "modbus", f"register={register} raw", list(result.registers))
211:                 _log.debug("READ OK: registers=%s", result.registers)
212: 
213:                 if is_float:
214:                     # word_order="little": [low_word, high_word] → 스왑 후 big-endian unpack
215:                     if self._word_order == "little":
216:                         raw = struct.pack(
217:                             ">HH", result.registers[1], result.registers[0]
218:                         )
219:                     else:
220:                         raw = struct.pack(
221:                             ">HH", result.registers[0], result.registers[1]
222:                         )
223:                     value = struct.unpack(">f", raw)[0]
224:                 else:
225:                     if is_bcd32:
226:                         # 32-bit BCD: 2 registers (Artisan inputBCDs, Loring temp channels)
227:                         if self._word_order == "little":
228:                             raw32 = (result.registers[1] << 16) | result.registers[0]
229:                         else:
230:                             raw32 = (result.registers[0] << 16) | result.registers[1]
231:                         raw_int = _bcd_decode(raw32)
232:                     elif is_bcd16:
233:                         # 16-bit BCD: 1 register (Artisan inputBCDsAsInt, Loring drum %)
234:                         raw_int = _bcd_decode(result.registers[0])
235:                     elif is_signed and result.registers[0] >= 0x8000:
236:                         raw_int = result.registers[0] - 0x10000
237:                     else:
238:                         raw_int = result.registers[0]
239: 
240:                     value = float(raw_int)
241: 
242:                     if div == 1:
243:                         value /= 10.0
244:                     elif div == 2:
245:                         value /= 100.0
246: 
247:                 if temp_mode == "F":
248:                     value = (value - 32.0) * 5.0 / 9.0
249: 
250:                 value = round(value, 1)
251:                 TRACE.record(
252:                     "info", "modbus",
253:                     f"decoded register={register} float={is_float} bcd32={is_bcd32} "
254:                     f"bcd16={is_bcd16} signed={is_signed} div={div} mode={temp_mode} "
255:                     f"word_order={self._word_order}",
256:                     value,
257:                 )
258:                 return value
259:             except Exception as exc:
260:                 last_exc = exc
261:                 TRACE.record("err", "modbus", f"register={register} attempt={attempt + 1}: {exc}")
262:                 _log.warning(
263:                     "MODBUS 읽기 실패 (attempt %d/%d): register=%d unit=%d — %s",
264:                     attempt + 1,
265:                     self._read_retries + 1,
266:                     register,
267:                     unit_id,
268:                     exc,
269:                 )
270:         raise last_exc
271: 
272:     async def read(self) -> Reading:
273:         if self._client is None or not self._client.connected:
274:             raise ConnectionError("MODBUS 클라이언트가 연결되지 않음")
275: 
276:         bt_cfg = self._regs.get("BT")
277:         et_cfg = self._regs.get("ET")
278:         drum_cfg = self._regs.get("drum")
279: 
280:         bt = await self._read_channel(bt_cfg) if bt_cfg else -1.0
281:         et = await self._read_channel(et_cfg) if et_cfg else -1.0
282:         drum = await self._read_channel(drum_cfg) if drum_cfg else 0.0
283: 
284:         return Reading(
285:             bt=bt, et=et, heater=0.0, fan=0.0, drum=drum, timestamp=time.monotonic()
286:         )
287: 
288:     async def control(
289:         self,
290:         heater: float | None = None,
291:         fan: float | None = None,
292:         drum: float | None = None,
293:     ) -> None:
294:         pass  # 제어 기능 미사용 — 제거 예정
295: 
296:     @property
297:     def connected(self) -> bool:
298:         return self._client is not None and self._client.connected
</file>

