 1: const resolveColor = (color: string): string => {
 2:     if (!color.startsWith('var(')) return color;
 3:     const name = color.slice(4, -1).trim();
 4:     return getComputedStyle(document.documentElement).getPropertyValue(name).trim() || '#171717';
 5: };
 6: 
 7: interface SparklineProps {
 8:     data: { bt: number }[];
 9:     color: string;
10:     width?: number;
11:     height?: number;
12: }
13: 
14: export const Sparkline = ({ data, color, width = 200, height = 44 }: SparklineProps) => {
15:     const bts = data.map((d) => d.bt);
16:     const min = Math.min(...bts);
17:     const max = Math.max(...bts);
18:     const range = max - min || 1;
19:     const pts = bts
20:         .map((v, i) => `${(i / (bts.length - 1)) * width},${height - ((v - min) / range) * height}`)
21:         .join(' ');
22:     return (
23:         <svg viewBox={`0 0 ${width} ${height}`} preserveAspectRatio="none" className="w-full h-11">
24:             <polyline points={pts} fill="none" stroke={color} strokeWidth={1.5} strokeLinejoin="round" />
25:         </svg>
26:     );
27: };
28: 
29: export { resolveColor };
</file>

