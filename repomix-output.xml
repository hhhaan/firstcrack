 1: import type { Database } from '@shared/types/database.types';
 2: import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
 3: import type { BlendWithComponents } from './api';
 4: import { blendApi } from './api';
 5: 
 6: type BlendInsert = Database['public']['Tables']['blends']['Insert'];
 7: type BlendComponentInsert = Database['public']['Tables']['blend_components']['Insert'];
 8: 
 9: export const blendKeys = {
10:     all: (userId: string) => ['blends', userId] as const,
11:     detail: (id: string) => ['blends', 'detail', id] as const,
12: };
13: 
14: export const useBlends = (userId: string) =>
15:     useQuery({
16:         queryKey: blendKeys.all(userId),
17:         queryFn: () => blendApi.list(userId),
18:         enabled: !!userId,
19:     });
20: 
21: export const useBlend = (id: string) =>
22:     useQuery({
23:         queryKey: blendKeys.detail(id),
24:         queryFn: () => blendApi.get(id),
25:         enabled: !!id,
26:     });
27: 
28: export const useCreateBlend = (userId: string) => {
29:     const qc = useQueryClient();
30:     return useMutation({
31:         mutationFn: ({
32:             blend,
33:             components,
34:         }: {
35:             blend: BlendInsert;
36:             components: Omit<BlendComponentInsert, 'blend_id'>[];
37:         }) => blendApi.create(blend, components),
38:         onSuccess: () => {
39:             qc.invalidateQueries({ queryKey: blendKeys.all(userId) });
40:         },
41:     });
42: };
43: 
44: export const useUpdateBlend = (userId: string) => {
45:     const qc = useQueryClient();
46:     return useMutation({
47:         mutationFn: ({
48:             id,
49:             patch,
50:             components,
51:         }: {
52:             id: string;
53:             patch: Parameters<typeof blendApi.update>[1];
54:             components: Parameters<typeof blendApi.update>[2];
55:         }) => blendApi.update(id, patch, components),
56:         onSuccess: (updated: BlendWithComponents) => {
57:             qc.setQueryData(blendKeys.detail(updated.id), updated);
58:             qc.invalidateQueries({ queryKey: blendKeys.all(userId) });
59:         },
60:     });
61: };
62: 
63: export const useDeleteBlend = (userId: string) => {
64:     const qc = useQueryClient();
65:     return useMutation({
66:         mutationFn: blendApi.delete,
67:         onSuccess: (_data: void, id: string) => {
68:             qc.removeQueries({ queryKey: blendKeys.detail(id) });
69:             qc.invalidateQueries({ queryKey: blendKeys.all(userId) });
70:         },
71:     });
72: };
</file>

<file path="src/entities/machine/lib.ts">
 1: import type { RoasterDef, SidecarStatus } from './types';
 2: 
 3: export const TCP_ONLY_FIELDS = new Set(['host', 'port']);
 4: export const RTU_ONLY_FIELDS = new Set(['comport', 'baudrate', 'bytesize', 'parity', 'stopbits']);
 5: 
 6: export const isRoasterFieldVisible = (fieldKey: string, mode: string | undefined): boolean => {
 7:     const normalized = mode?.toLowerCase() ?? '';
 8:     if (!normalized) return true;
 9:     const isTCP = normalized === 'tcp' || normalized === 'udp';
10:     const isRTU = normalized === 'rtu' || normalized === 'serial';
11:     if (TCP_ONLY_FIELDS.has(fieldKey) && isRTU) return false;
12:     if (RTU_ONLY_FIELDS.has(fieldKey) && isTCP) return false;
13:     return true;
14: };
15: 
16: export const initRoasterFormParams = (def: RoasterDef, existing?: Record<string, unknown>): Record<string, string> => {
17:     const initial: Record<string, string> = {};
18:     for (const field of def.form_fields) {
19:         const val = existing?.[field.key] ?? def.default_params[field.key];
20:         initial[field.key] = val != null ? String(val) : '';
21:     }
22:     return initial;
23: };
24: 
25: export const buildTypedConnectionParams = (
26:     def: RoasterDef,
27:     stringParams: Record<string, string>,
28: ): Record<string, unknown> => {
29:     const mode = stringParams.mode;
30:     const result: Record<string, unknown> = {};
31:     for (const field of def.form_fields) {
32:         if (!isRoasterFieldVisible(field.key, mode)) continue;
33:         const raw = stringParams[field.key];
34:         if (raw === '' || raw == null) continue;
35:         result[field.key] = field.type === 'number' ? Number(raw) : raw;
36:     }
37:     return result;
38: };
39: 
40: export const validateRoasterFormFields = (def: RoasterDef, stringParams: Record<string, string>): string | null => {
41:     const mode = stringParams.mode;
42:     for (const field of def.form_fields) {
43:         if (!isRoasterFieldVisible(field.key, mode)) continue;
44:         if (field.required && !stringParams[field.key]?.trim()) {
45:             return field.label;
46:         }
47:     }
48:     return null;
49: };
50: 
51: export const groupRoastersByBrand = (
52:     registry: Record<string, RoasterDef>,
53: ): Record<string, { key: string; def: RoasterDef }[]> => {
54:     const brands: Record<string, { key: string; def: RoasterDef }[]> = {};
55:     for (const [key, def] of Object.entries(registry)) {
56:         if (def.brand === 'Internal') continue;
57:         if (!brands[def.brand]) brands[def.brand] = [];
58:         brands[def.brand].push({ key, def });
59:     }
60:     return brands;
61: };
62: 
63: export const isSameSidecarStatus = (prev: SidecarStatus | null, next: SidecarStatus): boolean =>
64:     prev?.connected === next.connected &&
65:     prev?.roaster === next.roaster &&
66:     prev?.error === next.error &&
67:     prev?.reconnecting === next.reconnecting;
</file>

