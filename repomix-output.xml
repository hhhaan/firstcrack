BEGIN
  FOR v_row IN
    SELECT
      b.id,
      b.batch_size_kg,
      b.batch_count,
      b.yield_pct,
      b.target_roasted_kg,
      COALESCE(sess.completed, 0) AS completed
    FROM roast_plan_batches b
    LEFT JOIN LATERAL (
      SELECT COUNT(*)::integer AS completed
      FROM roast_sessions s
      WHERE s.plan_batch_id = b.id
    ) sess ON true
    WHERE b.bean_id = p_bean_id
      AND b.status IN ('pending', 'in-progress')
      AND b.exception_type IS DISTINCT FROM 'cancelled'
      AND (b.scheduled_date IS NULL OR b.scheduled_date <= v_horizon)
  LOOP
    v_batch_count := calc_plan_batch_count(
      v_row.target_roasted_kg,
      v_row.batch_size_kg,
      v_row.yield_pct,
      v_row.batch_count
    );
    v_remaining := GREATEST(0, v_batch_count - v_row.completed);
    v_reserved := v_reserved + (v_remaining * v_row.batch_size_kg * 1000)::integer;
  END LOOP;
  FOR v_row IN
    SELECT
      b.id,
      b.batch_size_kg,
      b.batch_count,
      b.yield_pct,
      b.target_roasted_kg,
      bc.ratio_pct,
      COALESCE(sess.completed, 0) AS completed
    FROM roast_plan_batches b
    JOIN blend_components bc ON bc.blend_id = b.blend_id AND bc.bean_id = p_bean_id
    LEFT JOIN LATERAL (
      SELECT COUNT(*)::integer AS completed
      FROM roast_sessions s
      WHERE s.plan_batch_id = b.id
    ) sess ON true
    WHERE b.blend_id IS NOT NULL
      AND b.status IN ('pending', 'in-progress')
      AND b.exception_type IS DISTINCT FROM 'cancelled'
      AND (b.scheduled_date IS NULL OR b.scheduled_date <= v_horizon)
  LOOP
    v_batch_count := calc_plan_batch_count(
      v_row.target_roasted_kg,
      v_row.batch_size_kg,
      v_row.yield_pct,
      v_row.batch_count
    );
    v_remaining := GREATEST(0, v_batch_count - v_row.completed);
    v_reserved := v_reserved + (
      v_remaining * v_row.batch_size_kg * 1000 * v_row.ratio_pct / 100
    )::integer;
  END LOOP;
  FOR v_rec IN
    SELECT r.*
    FROM recurrence_rules r
    WHERE r.status = 'active'
      AND r.bean_id = p_bean_id
      AND (r.until IS NULL OR r.until >= v_today)
  LOOP
    v_batch_count := calc_plan_batch_count(
      v_rec.target_roasted_kg,
      v_rec.batch_size_kg,
      v_rec.yield_pct,
      NULL
    );
    FOR v_occurrence IN
      SELECT expand_rrule_in_range(
        v_rec.rrule,
        v_rec.dtstart,
        v_today,
        v_horizon,
        v_rec.until
      )
    LOOP
      SELECT EXISTS (
        SELECT 1
        FROM roast_plan_batches ex
        WHERE ex.recurrence_rule_id = v_rec.id
          AND ex.original_date = v_occurrence
      ) INTO v_excluded;
      IF NOT v_excluded THEN
        v_reserved := v_reserved + (v_batch_count * v_rec.batch_size_kg * 1000)::integer;
      END IF;
    END LOOP;
  END LOOP;
  FOR v_rec IN
    SELECT r.*, bc.ratio_pct
    FROM recurrence_rules r
    JOIN blend_components bc ON bc.blend_id = r.blend_id AND bc.bean_id = p_bean_id
    WHERE r.status = 'active'
      AND r.blend_id IS NOT NULL
      AND (r.until IS NULL OR r.until >= v_today)
  LOOP
    v_batch_count := calc_plan_batch_count(
      v_rec.target_roasted_kg,
      v_rec.batch_size_kg,
      v_rec.yield_pct,
      NULL
    );
    FOR v_occurrence IN
      SELECT expand_rrule_in_range(
        v_rec.rrule,
        v_rec.dtstart,
        v_today,
        v_horizon,
        v_rec.until
      )
    LOOP
      SELECT EXISTS (
        SELECT 1
        FROM roast_plan_batches ex
        WHERE ex.recurrence_rule_id = v_rec.id
          AND ex.original_date = v_occurrence
      ) INTO v_excluded;
      IF NOT v_excluded THEN
        v_reserved := v_reserved + (
          v_batch_count * v_rec.batch_size_kg * 1000 * v_rec.ratio_pct / 100
        )::integer;
      END IF;
    END LOOP;
  END LOOP;
  RETURN v_reserved;
END;
$$;
CREATE OR REPLACE FUNCTION get_bean_effective_stock(
  p_bean_id uuid,
  p_horizon_days integer DEFAULT 28
) RETURNS integer
LANGUAGE sql
STABLE
SECURITY INVOKER
AS $$
  SELECT get_bean_available_stock(p_bean_id) - get_bean_reserved_stock(p_bean_id, p_horizon_days);
$$;
CREATE OR REPLACE FUNCTION get_bean_stock_summary(
  p_bean_id uuid,
  p_horizon_days integer DEFAULT 28
) RETURNS jsonb
LANGUAGE sql
STABLE
SECURITY INVOKER
AS $$
  SELECT jsonb_build_object(
    'current_grams', get_bean_current_stock(p_bean_id),
    'available_grams', get_bean_available_stock(p_bean_id),
    'reserved_grams', get_bean_reserved_stock(p_bean_id, p_horizon_days),
    'effective_grams', get_bean_effective_stock(p_bean_id, p_horizon_days)
  );
$$;
CREATE OR REPLACE FUNCTION get_user_stock_summaries(
  p_user_id uuid,
  p_horizon_days integer DEFAULT 28
) RETURNS jsonb
LANGUAGE sql
STABLE
SECURITY INVOKER
AS $$
  SELECT COALESCE(
    jsonb_object_agg(
      b.id::text,
      get_bean_stock_summary(b.id, p_horizon_days)
    ),
    '{}'::jsonb
  )
  FROM beans b
  WHERE b.user_id = p_user_id;
$$;
GRANT EXECUTE ON FUNCTION get_bean_current_stock(uuid) TO authenticated;
GRANT EXECUTE ON FUNCTION get_bean_available_stock(uuid) TO authenticated;
GRANT EXECUTE ON FUNCTION get_bean_reserved_stock(uuid, integer) TO authenticated;
GRANT EXECUTE ON FUNCTION get_bean_effective_stock(uuid, integer) TO authenticated;
GRANT EXECUTE ON FUNCTION get_bean_stock_summary(uuid, integer) TO authenticated;
GRANT EXECUTE ON FUNCTION get_user_stock_summaries(uuid, integer) TO authenticated;
GRANT EXECUTE ON FUNCTION calc_plan_batch_count(numeric, numeric, numeric, integer) TO authenticated;
GRANT EXECUTE ON FUNCTION expand_rrule_in_range(text, date, date, date, date) TO authenticated;
</file>

<file path="supabase/migrations/20260622000002_inventory_alerts.sql">
CREATE TABLE inventory_alerts (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  user_id uuid NOT NULL REFERENCES auth.users(id) ON DELETE CASCADE,
  bean_id uuid NOT NULL REFERENCES beans(id) ON DELETE CASCADE,
  reason text NOT NULL CHECK (reason IN ('out', 'schedule', 'low')),
  current_grams integer NOT NULL,
  available_grams integer NOT NULL,
  reserved_grams integer NOT NULL,
  effective_grams integer NOT NULL,
  horizon_days integer NOT NULL DEFAULT 28,
  computed_at timestamptz NOT NULL DEFAULT now(),
  dismissed_at timestamptz,
  UNIQUE (user_id, bean_id, reason)
);
ALTER TABLE inventory_alerts ENABLE ROW LEVEL SECURITY;
CREATE POLICY "users manage own inventory_alerts"
  ON inventory_alerts
  FOR ALL
  USING (auth.uid() = user_id);
GRANT SELECT, INSERT, UPDATE, DELETE ON inventory_alerts TO authenticated;
CREATE OR REPLACE FUNCTION compute_inventory_alerts(
  p_user_id uuid,
  p_horizon_days integer DEFAULT 28
) RETURNS void
LANGUAGE plpgsql
SECURITY INVOKER
AS $$
DECLARE
  v_bean record;
  v_current integer;
  v_available integer;
  v_reserved integer;
  v_effective integer;
BEGIN
  FOR v_bean IN
    SELECT id, low_stock_threshold_grams
    FROM beans
    WHERE user_id = p_user_id
  LOOP
    v_current := get_bean_current_stock(v_bean.id);
    v_available := get_bean_available_stock(v_bean.id);
    v_reserved := get_bean_reserved_stock(v_bean.id, p_horizon_days);
    v_effective := v_available - v_reserved;
    IF v_current > 0 AND v_effective >= 0 AND v_current > v_bean.low_stock_threshold_grams THEN
      DELETE FROM inventory_alerts
      WHERE user_id = p_user_id AND bean_id = v_bean.id;
      CONTINUE;
    END IF;
    IF v_current <= 0 THEN
      INSERT INTO inventory_alerts (
        user_id, bean_id, reason,
        current_grams, available_grams, reserved_grams, effective_grams,
        horizon_days, computed_at, dismissed_at
      ) VALUES (
        p_user_id, v_bean.id, 'out',
        v_current, v_available, v_reserved, v_effective,
        p_horizon_days, now(), NULL
      )
      ON CONFLICT (user_id, bean_id, reason) DO UPDATE SET
        current_grams = EXCLUDED.current_grams,
        available_grams = EXCLUDED.available_grams,
        reserved_grams = EXCLUDED.reserved_grams,
        effective_grams = EXCLUDED.effective_grams,
        horizon_days = EXCLUDED.horizon_days,
        computed_at = EXCLUDED.computed_at,
        dismissed_at = NULL;
    END IF;
    IF v_effective < 0 THEN
      INSERT INTO inventory_alerts (
        user_id, bean_id, reason,
        current_grams, available_grams, reserved_grams, effective_grams,
        horizon_days, computed_at, dismissed_at
      ) VALUES (
        p_user_id, v_bean.id, 'schedule',
        v_current, v_available, v_reserved, v_effective,
        p_horizon_days, now(), NULL
      )
      ON CONFLICT (user_id, bean_id, reason) DO UPDATE SET
        current_grams = EXCLUDED.current_grams,
        available_grams = EXCLUDED.available_grams,
        reserved_grams = EXCLUDED.reserved_grams,
        effective_grams = EXCLUDED.effective_grams,
        horizon_days = EXCLUDED.horizon_days,
        computed_at = EXCLUDED.computed_at,
        dismissed_at = NULL;
    ELSE
      DELETE FROM inventory_alerts
      WHERE user_id = p_user_id AND bean_id = v_bean.id AND reason = 'schedule';
    END IF;
    IF v_current > 0 AND v_current <= v_bean.low_stock_threshold_grams THEN
      INSERT INTO inventory_alerts (
        user_id, bean_id, reason,
        current_grams, available_grams, reserved_grams, effective_grams,
        horizon_days, computed_at, dismissed_at
      ) VALUES (
        p_user_id, v_bean.id, 'low',
        v_current, v_available, v_reserved, v_effective,
        p_horizon_days, now(), NULL
      )
      ON CONFLICT (user_id, bean_id, reason) DO UPDATE SET
        current_grams = EXCLUDED.current_grams,
        available_grams = EXCLUDED.available_grams,
        reserved_grams = EXCLUDED.reserved_grams,
        effective_grams = EXCLUDED.effective_grams,
        horizon_days = EXCLUDED.horizon_days,
        computed_at = EXCLUDED.computed_at,
        dismissed_at = NULL;
    ELSE
      DELETE FROM inventory_alerts
      WHERE user_id = p_user_id AND bean_id = v_bean.id AND reason = 'low';
    END IF;
  END LOOP;
END;
$$;
GRANT EXECUTE ON FUNCTION compute_inventory_alerts(uuid, integer) TO authenticated;
</file>

<file path="supabase/migrations/20260622000003_inventory_alert_cron.sql">
CREATE TABLE inventory_alert_runs (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  started_at timestamptz NOT NULL DEFAULT now(),
  finished_at timestamptz,
  status text NOT NULL DEFAULT 'running' CHECK (status IN ('running', 'success', 'error')),
  users_processed integer NOT NULL DEFAULT 0,
  error_message text
);
ALTER TABLE inventory_alert_runs ENABLE ROW LEVEL SECURITY;
CREATE OR REPLACE FUNCTION compute_inventory_alerts_for_all_users(
  p_horizon_days integer DEFAULT 28
) RETURNS uuid
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = public
AS $$
DECLARE
  v_run_id uuid;
  v_user_id uuid;
  v_count integer := 0;
BEGIN
  IF NOT pg_try_advisory_xact_lock(867530901) THEN
    RAISE NOTICE 'inventory alert compute already running';
    RETURN NULL;
  END IF;
  INSERT INTO inventory_alert_runs (status)
  VALUES ('running')
  RETURNING id INTO v_run_id;
  BEGIN
    FOR v_user_id IN
      SELECT DISTINCT user_id FROM beans
    LOOP
      PERFORM compute_inventory_alerts(v_user_id, p_horizon_days);
      v_count := v_count + 1;
    END LOOP;
    UPDATE inventory_alert_runs
    SET status = 'success',
        finished_at = now(),
        users_processed = v_count
    WHERE id = v_run_id;
  EXCEPTION WHEN OTHERS THEN
    UPDATE inventory_alert_runs
    SET status = 'error',
        finished_at = now(),
        users_processed = v_count,
        error_message = SQLERRM
    WHERE id = v_run_id;
    RAISE;
  END;
  RETURN v_run_id;
END;
$$;
CREATE EXTENSION IF NOT EXISTS pg_cron WITH SCHEMA extensions;
DO $cron$
BEGIN
  IF EXISTS (SELECT 1 FROM pg_extension WHERE extname = 'pg_cron') THEN
    PERFORM cron.unschedule(jobid)
    FROM cron.job
    WHERE jobname = 'daily-inventory-alerts';
    PERFORM cron.schedule(
      'daily-inventory-alerts',
      '0 6 * * *',
      'SELECT compute_inventory_alerts_for_all_users(28)'
    );
  END IF;
EXCEPTION
  WHEN OTHERS THEN
    RAISE NOTICE 'pg_cron schedule skipped: %', SQLERRM;
END;
$cron$;
</file>

