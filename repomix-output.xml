<file path="src/views/dashboard/lib/format.ts">
 1: import { i18n } from '@shared/i18n';
 2: 
 3: /** ISO/Date → 'MMM dd' (로케일 인지) */
 4: export const formatDate = (iso: string | Date | null | undefined): string => {
 5:     if (!iso) return '—';
 6:     const d = new Date(iso);
 7:     return d.toLocaleDateString(localeForDate(), { month: 'short', day: 'numeric' });
 8: };
 9: 
10: /** ISO/Date → 'MMM' (로케일 인지, 월만) */
11: export const formatMonth = (iso: string | Date | null | undefined): string => {
12:     if (!iso) return '—';
13:     const d = new Date(iso);
14:     return d.toLocaleDateString(localeForDate(), { month: 'short' });
15: };
16: 
17: /** 그램 → '1.5kg' or '500g' */
18: export const formatWeight = (grams: number): string => {
19:     if (grams >= 1000) {
20:         return `${(grams / 1000).toFixed(1)}kg`;
21:     }
22:     return `${Math.round(grams)}g`;
23: };
24: 
25: /** 시각 기반 인사말 키 */
26: export const getGreeting = (): 'morning' | 'afternoon' | 'evening' => {
27:     const h = new Date().getHours();
28:     if (h < 12) return 'morning';
29:     if (h < 18) return 'afternoon';
30:     return 'evening';
31: };
32: 
33: /** i18n.language → Date 로케일 */
34: export const localeForDate = (): string => {
35:     switch (i18n.language) {
36:         case 'ko':
37:             return 'en-US';
38:         case 'zh-CN':
39:             return 'zh-CN';
40:         case 'ja':
41:             return 'ja-JP';
42:         default:
43:             return 'en-US';
44:     }
45: };
</file>

