622:                 timeStr={timeStr}
623:                 onClose={() => setShowEndRoastModal(false)}
624:                 onConfirm={confirmEndRoast}
625:             />
626:             <RoastSummaryModal
627:                 open={showSummaryModal}
628:                 summaryData={summaryData}
629:                 eventMarkerColor={EVENT_MARKER_COLORS}
630:                 isSaving={isSaving}
631:                 ambientTemp={weatherData?.temperature}
632:                 ambientHumidity={weatherData?.humidity}
633:                 onClose={() => {
634:                     setShowSummaryModal(false);
635:                     setSummaryData(null);
636:                 }}
637:                 onDiscard={() => {
638:                     setShowSummaryModal(false);
639:                     setSummaryData(null);
640:                     resetActiveRoast();
641:                 }}
642:                 onSave={async ({ notes, weightGrams: saveWeight, roastLevel: saveLevel }) => {
643:                     if (!user) return;
644:                     const durationSeconds = elapsed;
645:                     const roastedAt =
646:                         roastStartTimeRef.current > 0 ? new Date(roastStartTimeRef.current).toISOString() : null;
647: 
648:                     try {
649:                         let tsvPath: string | null = null;
650:                         if (sessionId) {
651:                             tsvPath = await uploadRoastProfileTsv(sessionId);
652:                         }
653: 
654:                         const savedSession = await saveRoastSession({
655:                             user_id: user.id,
656:                             weight_grams: saveWeight,
657:                             status: 'completed',
658:                             roasted_at: roastedAt,
659:                             duration_seconds: durationSeconds,
660:                             drop_temp_celsius: rawBT != null ? Math.round(rawBT) : null,
661:                             roast_level: saveLevel,
662:                             scheduled_at: null,
663:                             notes: notes || null,
664:                             ambient_temp_celsius: weatherData?.temperature ?? null,
665:                             ambient_humidity_pct: weatherData?.humidity ?? null,
666:                             bean_id: selectedBeanId,
667:                             profile_id: targetProfileId,
668:                             tsv_path: tsvPath,
669:                             plan_batch_id: planBatchHandoff?.planBatchId ?? null,
670:                         });
671:                         const deductionGrams = planBatchHandoff?.batchSizeKg
672:                             ? Math.round(planBatchHandoff.batchSizeKg * 1000)
673:                             : saveWeight > 0
674:                               ? saveWeight
675:                               : 0;
676: 
677:                         await deductRoastStock({
678:                             deductionGrams,
679:                             singleBeanId: selectedBeanId ?? null,
680:                             blendId: planBatchHandoff?.blendId ?? null,
681:                             referenceId: savedSession.id,
682:                         });
683: 
684:                         const newCompletedCount = (planBatchHandoff?.completedSessions ?? 0) + 1;
685:                         const isNowBatchDone =
686:                             planBatchHandoff != null && newCompletedCount >= planBatchHandoff.batchCount;
687: 
688:                         incrementCompletedSession();
689: 
690:                         if (isNowBatchDone && planBatchHandoff) {
691:                             await updatePlanBatch({ id: planBatchHandoff.planBatchId, status: 'done' });
692:                         }
693:                         setShowSummaryModal(false);
694:                         setSummaryData(null);
695:                         resetActiveRoast();
696:                         if (planBatchHandoff) {
697:                             setShowContinueModal(true);
698:                         }
699:                     } catch (err) {
700:                         console.error('[RoastSummary] 저장 실패:', err);
701:                         await message(`저장에 실패했습니다.\n\n${err instanceof Error ? err.message : String(err)}`, {
702:                             title: '저장 실패',
703:                             kind: 'error',
704:                         });
705:                     }
706:                 }}
707:             />
708: 
709:             <PlanBatchContinueModal
