 6: import { sessionsToCsv } from './lib/csv-export';
 7: 
 8: export const useExportCsv = () => {
 9:     const { t } = useTranslation();
10: 
11:     return useCallback(
12:         async (sessions: RoastSessionWithRelations[]) => {
13:             try {
14:                 if (sessions.length === 0) {
15:                     await message(t('history.exportNoSessions'), { title: t('history.exportTitle'), kind: 'info' });
16:                     return;
17:                 }
18: 
19:                 const today = new Date().toISOString().slice(0, 10);
20:                 const filename = `roast-history-${today}.csv`;
21:                 const dir = await downloadDir();
22:                 const path = `${dir}${filename}`;
23: 
24:                 const confirmed = await confirm(t('history.exportConfirm', { path, count: sessions.length }), {
25:                     title: t('history.exportTitle'),
26:                     kind: 'info',
27:                     okLabel: t('history.exportOkLabel'),
28:                     cancelLabel: t('history.exportCancelLabel'),
29:                 });
30:                 if (!confirmed) return;
31: 
32:                 const csv = sessionsToCsv(sessions);
33:                 const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
34:                 const url = URL.createObjectURL(blob);
35:                 const a = document.createElement('a');
36:                 a.href = url;
37:                 a.download = filename;
38:                 a.style.display = 'none';
39:                 document.body.appendChild(a);
40:                 a.click();
41:                 document.body.removeChild(a);
42:                 URL.revokeObjectURL(url);
43:             } catch (err) {
44:                 console.error('Export CSV failed:', err);
45:             }
46:         },
47:         [t],
48:     );
49: };
