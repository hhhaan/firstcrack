478:         { enabled: showEndRoastModal },
479:         [showEndRoastModal, setShowEndRoastModal],
480:     );
481: 
482:     const handleTargetProfileChange = useCallback((id: string | null) => {
483:         userSelectedTargetRef.current = true;
484:         setTargetProfileId(id);
485:     }, []);
486: 
487:     // ── 렌더 ──────────────────────────────────────────────────────
488:     return (
489:         <div className="px-[32px] py-[24px] flex flex-col gap-4 h-full min-h-0 overflow-hidden">
