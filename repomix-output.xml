120:             environment: Some(std::borrow::Cow::Borrowed("production")),
121:             traces_sample_rate: 0.1,
122:             ..Default::default()
123:         },
124:     ));
125:     sentry::Hub::main().bind_client(Some(std::sync::Arc::new(client.clone())));
126: 
127:     let app = tauri::Builder::default()
128:         .plugin(tauri_plugin_sentry::init(&client))
129:         .plugin(tauri_plugin_single_instance::init(|app, _args, _cwd| {
130:             // 두 번째 실행 시 기존 창을 앞으로 가져옴
131:             if let Some(w) = app.get_webview_window("main") {
132:                 let _ = w.set_focus();
133:             }
134:         }))
135:         .plugin(tauri_plugin_shell::init())
136:         .plugin(tauri_plugin_opener::init())
137:         .plugin(tauri_plugin_process::init())
138:         .plugin(tauri_plugin_dialog::init())
139:         .plugin(tauri_plugin_os::init())
140:         .plugin(tauri_plugin_store::Builder::default().build())
141:         .plugin(tauri_plugin_deep_link::init())
142:         .plugin(tauri_plugin_fs::init())
143:         .plugin(tauri_plugin_notification::init())
144:         .plugin(tauri_plugin_updater::Builder::default().build())
145:         // CommandChild has no Drop impl — storing via manage() keeps it alive for the app lifetime.
146:         .manage(SidecarChild(Mutex::new(None)))
147:         .setup(|app| {
148:             // DEBUG: `tauri dev` 시 beforeDevCommand가 띄운 venv Python 사이드카를
149:             // 존중한다. 포트 9999가 이미 응답하면 스폰을 건너뜀 (X1).
150:             #[cfg(debug_assertions)]
151:             {
152:                 if std::net::TcpStream::connect_timeout(
153:                     &"127.0.0.1:9999".parse().unwrap(),
154:                     std::time::Duration::from_millis(300),
155:                 ).is_ok() {
156:                     eprintln!("[sidecar-guard] debug: 포트 9999 감지 — 외부 dev 사이드카 존중, 스폰 건너뜀");
157:                     return Ok(());
158:                 }
159:             }
160: 
161:             // Single-instance 플러그인이 twin 없음을 보장한 이후이므로,
162:             // 포트를 점유한 프로세스는 이전 크래시의 좀비다.
163:             // healthy 여부와 무관하게 항상 정리 (비응답 좀비도 포트를 점유할 수 있음).
164:             kill_zombie_sidecar();
165:             std::thread::sleep(std::time::Duration::from_millis(200));
166: 
167:             let sidecar_command = app.shell().sidecar("sidecar")?;
168:             let parent_pid = std::process::id().to_string();
169:             let (rx, child) = sidecar_command.env("SIDECAR_PARENT_PID", &parent_pid).spawn()?;
170:             *app.state::<SidecarChild>().0.lock().unwrap() = Some(child);
171: 
172:             // stdout/stderr 드레인 + Terminated 감지 시 백오프 재시작.
173:             // 30초 미만 생존은 "빠른 사망"으로 간주해 attempts 증가 (C2).
174:             let app_handle = app.handle().clone();
175:             tauri::async_runtime::spawn(async move {
176:                 let mut current_rx = rx;
177:                 let mut attempts: usize = 0;
178:                 let mut spawned_at = Instant::now();
179: 
180:                 loop {
181:                     while let Some(event) = current_rx.recv().await {
182:                         match event {
183:                             CommandEvent::Stdout(line) => {
184:                                 print!("[sidecar] {}", String::from_utf8_lossy(&line));
185:                             }
186:                             CommandEvent::Stderr(line) => {
187:                                 eprint!("[sidecar] {}", String::from_utf8_lossy(&line));
188:                             }
189:                             CommandEvent::Terminated(payload) => {
190:                                 eprintln!("[sidecar] terminated: code={:?}", payload.code);
191:                                 break;
192:                             }
193:                             _ => {}
194:                         }
195:                     }
196: 
197:                     // 30초 미만 생존 = 빠른 사망 → 실패로 카운트. 충분히 살았으면 리셋.
198:                     if spawned_at.elapsed() < std::time::Duration::from_secs(30) {
199:                         attempts += 1;
200:                     } else {
201:                         attempts = 0;
202:                     }
203: 
204:                     if attempts >= RESTART_BACKOFFS_SECS.len() {
205:                         eprintln!(
206:                             "[sidecar-restart] {}회 재시작 모두 실패 — 사이드카 복구 포기",
207:                             RESTART_BACKOFFS_SECS.len()
208:                         );
209:                         let _ = app_handle.emit("sidecar-dead", ());
210:                         break;
211:                     }
212: 
213:                     let delay = RESTART_BACKOFFS_SECS[attempts.saturating_sub(1).min(RESTART_BACKOFFS_SECS.len() - 1)];
214:                     eprintln!(
215:                         "[sidecar-restart] {}초 후 재시작 ({}/{})",
216:                         delay,
217:                         attempts,
218:                         RESTART_BACKOFFS_SECS.len()
219:                     );
220:                     tokio::time::sleep(std::time::Duration::from_secs(delay)).await;
221: 
222:                     // 재시작 직전 좀비 가드 — 비응답 좀비도 무조건 정리
223:                     kill_zombie_sidecar();
224:                     tokio::time::sleep(std::time::Duration::from_millis(200)).await;
225: 
226:                     let parent_pid = std::process::id().to_string();
227:                     let respawn = app_handle
228:                         .shell()
229:                         .sidecar("sidecar")
230:                         .and_then(|cmd| cmd.env("SIDECAR_PARENT_PID", &parent_pid).spawn().map_err(Into::into));
231: 
232:                     match respawn {
233:                         Ok((new_rx, new_child)) => {
234:                             *app_handle.state::<SidecarChild>().0.lock().unwrap() = Some(new_child);
235:                             current_rx = new_rx;
236:                             spawned_at = Instant::now();
237:                             eprintln!("[sidecar-restart] 재시작 성공");
238:                         }
239:                         Err(e) => {
240:                             eprintln!("[sidecar-restart] spawn 실패: {e}");
241:                         }
242:                     }
243:                 }
244:             });
245: 
246:             Ok(())
247:         })
248:         .invoke_handler(tauri::generate_handler![save_pdf, print_window])
249:         .build(tauri::generate_context!())
250:         .expect("error while running tauri application");
251: 
252:     app.run(|app, event| {
253:         if let RunEvent::Exit = event {
254:             // 1. graceful shutdown: /shutdown 엔드포인트로 sidecar 자체 종료 유도 (C1)
255:             {
256:                 use std::io::Write;
257:                 use std::time::Duration;
258:                 if let Ok(mut stream) = std::net::TcpStream::connect_timeout(
259:                     &"127.0.0.1:9999".parse().unwrap(),
260:                     Duration::from_millis(200),
261:                 ) {
262:                     let _ = stream.write_all(
263:                         b"POST /shutdown HTTP/1.0\r\nHost: 127.0.0.1\r\nContent-Length: 0\r\nConnection: close\r\n\r\n",
264:                     );
265:                     // sidecar가 /shutdown 후 os._exit(0) — 0.3초면 충분
266:                     std::thread::sleep(Duration::from_millis(300));
267:                 }
268:             }
269:             // 2. fallback: 부트로더 kill (워치독으로 자식은 이미 죽어 있어야 함)
270:             if let Some(child) = app.state::<SidecarChild>().0.lock().unwrap().take() {
271:                 let _ = child.kill();
272:             }
273:         }
274:     });
275: }
