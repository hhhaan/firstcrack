  3: import uPlot from 'uplot';
  4: 
  5: export const COMPARE_COLORS = [
  6:     'var(--color-palette-green)',
  7:     'var(--color-palette-blue)',
  8:     'var(--color-palette-purple)',
  9:     'var(--color-palette-yellow)',
