  1: name: _Publish to R2 (reusable)
  2: 
  3: on:
  4:   workflow_call:
  5:     inputs:
  6:       version:
  7:         description: 'Version string (e.g. 1.0.2)'
  8:         required: true
  9:         type: string
 10:       run_id:
 11:         description: 'Artifact run ID to download from (empty = current run — only safe for workflow_call callers where github.run_id == parent run ID)'
 12:         required: false
 13:         type: string
 14:         default: ''
 15: 
 16: permissions:
 17:   contents: read
 18:   actions: read
