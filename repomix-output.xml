394:                             fontWeight: PHASE_BAR_FONT_WEIGHT,
395:                             fill: PHASE_BAR_NAME_COLOR,
396:                             textVerticalAlign: 'middle',
397:                         },
398:                         silent: true,
399:                     });
400:                     children.push({
401:                         type: 'text',
402:                         style: {
403:                             text: durLabel,
404:                             x: endPx - PHASE_BAR_TEXT_INSET,
405:                             y: y + h / 2,
406:                             fontSize: PHASE_BAR_FONT_SIZE,
407:                             fontFamily: PHASE_BAR_FONT_FAMILY,
408:                             fill: PHASE_BAR_DURATION_COLOR,
409:                             textAlign: 'right',
410:                             textVerticalAlign: 'middle',
411:                         },
412:                         silent: true,
413:                     });
414:                 } else if (width > PHASE_BAR_NARROW_THRESHOLD) {
415:                     children.push({
416:                         type: 'text',
417:                         style: {
418:                             text: durLabel,
419:                             x: (startPx + endPx) / 2,
420:                             y: y + h / 2,
421:                             fontSize: PHASE_BAR_FONT_SIZE_NARROW,
422:                             fontFamily: PHASE_BAR_FONT_FAMILY,
423:                             fill: PHASE_BAR_DURATION_COLOR,
424:                             textAlign: 'center',
425:                             textVerticalAlign: 'middle',
426:                         },
427:                         silent: true,
428:                     });
429:                 }
