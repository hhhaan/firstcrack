<file path="src/entities/blend/api.ts">
 1: import { supabase } from '@shared/lib/supabase';
 2: import type { Database } from '@shared/types/database.types';
 3: 
 4: export type Blend = Database['public']['Tables']['blends']['Row'];
 5: export type BlendComponent = Database['public']['Tables']['blend_components']['Row'];
 6: 
 7: export type BlendWithComponents = Blend & {
 8:     blend_components: (BlendComponent & { beans: { name: string } })[];
 9: };
10: 
11: type BlendInsert = Database['public']['Tables']['blends']['Insert'];
12: type BlendComponentInsert = Database['public']['Tables']['blend_components']['Insert'];
13: 
14: const SELECT_WITH_COMPONENTS = '*, blend_components(*, beans(name))';
15: 
16: export const blendApi = {
17:     list: async (userId: string): Promise<BlendWithComponents[]> => {
18:         const { data, error } = await supabase
19:             .from('blends')
20:             .select(SELECT_WITH_COMPONENTS)
21:             .eq('user_id', userId)
22:             .order('created_at', { ascending: false });
23:         if (error) throw error;
24:         return (data ?? []) as BlendWithComponents[];
25:     },
26: 
27:     get: async (id: string): Promise<BlendWithComponents> => {
28:         const { data, error } = await supabase.from('blends').select(SELECT_WITH_COMPONENTS).eq('id', id).single();
29:         if (error) throw error;
30:         return data as BlendWithComponents;
31:     },
32: 
33:     create: async (
34:         blend: BlendInsert,
35:         components: Omit<BlendComponentInsert, 'blend_id'>[],
36:     ): Promise<BlendWithComponents> => {
37:         const { data: newBlend, error: blendErr } = await supabase.from('blends').insert(blend).select().single();
38:         if (blendErr) throw blendErr;
39: 
40:         const { error: compErr } = await supabase
41:             .from('blend_components')
42:             .insert(components.map((c) => ({ ...c, blend_id: newBlend!.id })));
43:         if (compErr) throw compErr;
44: 
45:         return blendApi.get(newBlend!.id);
46:     },
47: 
48:     update: async (
49:         id: string,
50:         patch: Partial<BlendInsert>,
51:         components: Omit<BlendComponentInsert, 'blend_id'>[],
52:     ): Promise<BlendWithComponents> => {
53:         const { error: blendErr } = await supabase
54:             .from('blends')
55:             .update({ ...patch, updated_at: new Date().toISOString() })
56:             .eq('id', id);
57:         if (blendErr) throw blendErr;
58: 
59:         // replace all components
60:         const { error: delErr } = await supabase.from('blend_components').delete().eq('blend_id', id);
61:         if (delErr) throw delErr;
62: 
63:         const { error: compErr } = await supabase
64:             .from('blend_components')
65:             .insert(components.map((c) => ({ ...c, blend_id: id })));
66:         if (compErr) throw compErr;
67: 
68:         return blendApi.get(id);
69:     },
70: 
71:     delete: async (id: string): Promise<void> => {
72:         const { error } = await supabase.from('blends').delete().eq('id', id);
73:         if (error) throw error;
74:     },
75: };
