369:     // ── 로스트 라이프사이클 핸들러 ────────────────────────────────
370: 
371:     /** Phase 2(preheating) → standby: 사용자가 로스팅 준비 완료를 확인 */
372:     const handleEnterStandby = useCallback(() => {
373:         if (phase !== 'preheating') return;
374:         enterStandby();
