<file path="src/shared/lib/roastWeight.ts">
 1: /** Default shrink factor: output ≈ 82% of green input. */
 2: export const DEFAULT_SHRINK_FACTOR = 0.82;
 3: 
 4: export interface RoastWeights {
 5:     outputKg: number;
 6:     inputKg: number;
 7:     lossRate: number;
 8: }
 9: 
10: export const computeRoastWeights = (weightGrams: number | null | undefined): RoastWeights => {
11:     const outputKg = (weightGrams ?? 0) / 1000;
12:     const inputKg = outputKg / DEFAULT_SHRINK_FACTOR;
13:     const lossRate = inputKg > 0 ? ((inputKg - outputKg) / inputKg) * 100 : 0;
14:     return {
15:         outputKg: Math.round(outputKg * 1000) / 1000,
16:         inputKg: Math.round(inputKg * 1000) / 1000,
17:         lossRate: Math.round(lossRate * 10) / 10,
18:     };
19: };
</file>

