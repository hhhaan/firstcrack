851:     // 옵션 적용 — controlData/phaseBar 유무가 바뀌면 grid/axis 구조가 달라지므로 notMerge로 완전 교체
852:     const prevHasControlData = useRef(!!controlData);
853:     const prevHasPhaseBar = useRef(phaseSegments.length > 0);
854:     useEffect(() => {
855:         const chart = chartInstanceRef.current;
856:         if (!chart) return;
857:         const hasPhaseBar = phaseSegments.length > 0;
858:         const structureChanged =
859:             prevHasControlData.current !== !!controlData || prevHasPhaseBar.current !== hasPhaseBar;
860:         prevHasControlData.current = !!controlData;
861:         prevHasPhaseBar.current = hasPhaseBar;
862:         chart.setOption(option, {
863:             notMerge: structureChanged,
864:             lazyUpdate: !structureChanged,
865:         });
866:         // eslint-disable-next-line react-hooks/exhaustive-deps
867:     }, [option]);
868: 
869:     // 마우스 호버
870:     useEffect(() => {
871:         const chart = chartInstanceRef.current;
872:         if (!chart || !onCursorIdx) return;
873: 
874:         // eslint-disable-next-line @typescript-eslint/no-explicit-any
875:         const handleMouseMove = (e: any) => {
876:             const pixel: [number, number] = [e.offsetX, e.offsetY];
877:             const point = chart.convertFromPixel({ xAxisIndex: 0 }, pixel);
878:             if (point && xs.length) {
879:                 const idx = xs.reduce(
880:                     (prev, curr, i) => (Math.abs(curr - point[0]) < Math.abs(xs[prev] - point[0]) ? i : prev),
881:                     0,
882:                 );
883:                 onCursorIdx(idx);
884:             }
885:         };
886: 
887:         chart.on('mousemove', handleMouseMove);
888:         return () => {
889:             chart.off('mousemove', handleMouseMove);
890:         };
891:     }, [xs, onCursorIdx]);
892: 
893:     // ── 마커 드래그 (chart.getZr()로 마크라인 핸들 감지) ──────────
894:     useEffect(() => {
895:         const chart = chartInstanceRef.current;
896:         if (!chart || !onEventMarkerDrag) return;
897: 
898:         const zr = chart.getZr();
899:         if (!zr) return;
900: 
901:         const handleZrPointerDown = (e: Record<string, unknown>) => {
902:             if (!chart) return;
903:             const evt = e.event as MouseEvent | undefined;
904:             const mx = evt?.offsetX ?? (e.offsetX as number);
905:             if (mx == null) return;
906:             const yMid = (chart.convertToPixel({ yAxisIndex: 0 }, 150) as number) ?? 200;
907:             for (const marker of eventMarkers) {
908:                 const pixel = chart.convertToPixel({ xAxisIndex: 0 }, [marker.timeSec, yMid]);
909:                 if (pixel == null) continue;
910:                 const px = Array.isArray(pixel) ? pixel[0] : pixel;
911:                 const dist = Math.abs(mx - px);
912:                 if (dist <= PIXEL_THRESHOLD) {
913:                     dragStateRef.current = {
914:                         active: true,
915:                         eventName: marker.event,
916:                         startX: mx,
917:                         startTimeSec: marker.timeSec,
918:                     };
919:                     break;
920:                 }
921:             }
922:         };
923: 
924:         const handleZrPointerMove = (e: Record<string, unknown>) => {
925:             const ds = dragStateRef.current;
926:             if (!ds || !ds.active || !chart) return;
927:             const evt = e.event as MouseEvent | undefined;
928:             const mx = evt?.offsetX ?? (e.offsetX as number);
929:             const my = evt?.offsetY ?? (e.offsetY as number);
930:             if (mx == null) return;
931:             const point = chart.convertFromPixel({ xAxisIndex: 0 }, [mx, my]);
932:             if (!point) return;
933:             const xVal = Array.isArray(point) ? point[0] : point;
934:             const clamped = Math.max(0, Math.round(xVal));
935:             if (clamped !== ds.startTimeSec) {
936:                 onEventMarkerDrag(ds.eventName, clamped);
937:                 dragStateRef.current = { ...ds, startTimeSec: clamped };
938:             }
939:         };
940: 
941:         const handleZrPointerUp = () => {
942:             if (dragStateRef.current) {
943:                 dragStateRef.current = null;
944:             }
945:         };
946: 
947:         zr.on('mousedown', handleZrPointerDown);
948:         zr.on('mousemove', handleZrPointerMove);
949:         zr.on('mouseup', handleZrPointerUp);
950: 
951:         return () => {
952:             zr.off('mousedown', handleZrPointerDown);
953:             zr.off('mousemove', handleZrPointerMove);
954:             zr.off('mouseup', handleZrPointerUp);
955:         };
956:     }, [eventMarkers, onEventMarkerDrag]);
957: 
958:     useEffect(() => {
959:         chartInstanceRef.current?.resize({ height });
960:     }, [height]);
961: 
962:     return (
963:         <div style={{ position: 'relative', width: '100%', height: `${height}px`, minHeight: '300px' }}>
964:             <div ref={chartRef} style={{ width: '100%', height: '100%' }} />
965:             {controlData && (
966:                 <div className="absolute flex items-center gap-4" style={{ bottom: -5, left: 25 }}>
967:                     {[
968:                         { color: CONTROL_COLORS.drum, label: 'Drum' },
969:                         { color: CONTROL_COLORS.heat, label: 'Heat' },
970:                         { color: CONTROL_COLORS.fan, label: 'Fan' },
971:                     ].map(({ color, label }) => (
972:                         <div key={label} className="flex items-center gap-1.5">
973:                             <div style={{ width: 16, height: 2, background: color }} />
974:                             <span className="text-[11px] text-muted tracking-[0.14px]">{label}</span>
975:                         </div>
976:                     ))}
977:                 </div>
978:             )}
979:         </div>
980:     );
981: };
