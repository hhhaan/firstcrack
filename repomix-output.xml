<file path="src/views/machines/Machines.tsx">
  1: import type { Machine, SidecarStatus, TemperatureReading } from '@entities/machine';
  2: import { isSameSidecarStatus, useMachines, VIRTUAL_ID } from '@entities/machine';
  3: import * as Sentry from '@sentry/react';
  4: import { sidecar } from '@shared/lib/sidecar';
  5: import type { View } from '@shared/types/view';
  6: import { MasterDetailLayout } from '@shared/ui/MasterDetailLayout';
  7: import { PageHeader } from '@shared/ui/PageHeader';
  8: import { PageLayout } from '@shared/ui/PageLayout';
  9: import { PillButton } from '@shared/ui/PillButton';
 10: import { useMachinesPageState } from '@widgets/add-machine-modal/model/useMachinesPageState';
 11: import { AddMachineModal } from '@widgets/add-machine-modal/ui/AddMachineModal';
 12: import { Activity, AlertCircle, Cpu, Flame, Pencil, Plus, Search, Trash2, Wifi, WifiOff } from 'lucide-react';
 13: import { useEffect, useState } from 'react';
 14: import { useTranslation } from 'react-i18next';
 15: 
 16: const POLL_INTERVAL_MS = 3000;
 17: 
 18: export const Machines = ({
 19:     isActive = false,
 20:     onNavigate,
 21: }: {
 22:     isActive?: boolean;
 23:     onNavigate?: (view: View) => void;
 24: }) => {
 25:     const { t } = useTranslation();
 26:     const { machines, removeMachine } = useMachines();
 27:     const [search, setSearch] = useState('');
 28:     const [selectedId, setSelectedId] = useState<string | null>(null);
 29: 
 30:     const [sidecarStatus, setSidecarStatus] = useState<SidecarStatus | null>(null);
 31:     const [temps, setTemps] = useState<TemperatureReading | null>(null);
 32:     const [connecting, setConnecting] = useState(false);
 33: 
 34:     const {
 35:         modalOpen,
 36:         editingMachine,
 37:         openAddModal,
 38:         openEditModal,
 39:         closeModal,
 40:         handleAdd,
 41:         handleEdit,
 42:         isThisMachineConnected,
 43:     } = useMachinesPageState({ sidecarStatus, setSidecarStatus, setTemps });
 44: 
 45:     // 마운트 시 & 모달 닫힐 때 status fetch — "Add & Connect" 흐름에서 연결 상태 즉시 반영
 46:     useEffect(() => {
 47:         if (!isActive) return;
 48:         if (!modalOpen) {
 49:             sidecar
 50:                 .getStatus()
 51:                 .then(setSidecarStatus)
 52:                 .catch(() => null);
 53:         }
 54:     }, [isActive, modalOpen]);
 55: 
 56:     useEffect(() => {
 57:         if (!isActive || !sidecarStatus?.connected || modalOpen) {
 58:             if (!sidecarStatus?.connected) setTemps(null);
 59:             return;
 60:         }
 61: 
 62:         const poll = async () => {
 63:             const [nextTemps, nextStatus] = await Promise.all([
 64:                 sidecar.getTemperatures().catch(() => null),
 65:                 sidecar.getStatus().catch(() => null),
 66:             ]);
 67:             if (nextTemps) setTemps(nextTemps);
 68:             if (nextStatus) {
 69:                 setSidecarStatus((prev) => (isSameSidecarStatus(prev, nextStatus) ? prev : nextStatus));
 70:             }
 71:         };
 72:         poll();
 73:         const id = setInterval(poll, POLL_INTERVAL_MS);
 74:         return () => clearInterval(id);
 75:     }, [isActive, sidecarStatus?.connected, modalOpen]);
 76: 
 77:     // 연결 상태가 바뀔 때만 자동 select — 사용자가 수동으로 다른 카드를 클릭할 수 있음
 78:     useEffect(() => {
 79:         if (!sidecarStatus?.connected) return;
 80:         const connectedId = machines.find((m) => m.roasterKey === sidecarStatus.roaster)?.id;
 81:         if (connectedId) setSelectedId(connectedId);
 82:         // selectedId 제외: 사용자 클릭 시 effect 재실행 방지
 83:         // eslint-disable-next-line react-hooks/exhaustive-deps
 84:     }, [sidecarStatus?.connected, sidecarStatus?.roaster]);
 85: 
 86:     const filtered = machines.filter(
 87:         (m) =>
 88:             m.name.toLowerCase().includes(search.toLowerCase()) || m.brand.toLowerCase().includes(search.toLowerCase()),
 89:     );
 90: 
 91:     const selected = machines.find((m) => m.id === selectedId) ?? null;
 92: 
 93:     const handleConnect = async (machine: Machine) => {
 94:         setConnecting(true);
 95:         setSidecarStatus((prev) => (prev ? { ...prev, error: null } : prev));
 96:         try {
 97:             const status = await sidecar.connect(
 98:                 machine.roasterKey,
 99:                 machine.connectionParams as Record<string, unknown>,
100:             );
101:             setSidecarStatus(status);
102:             if (status.connected) {
103:                 Sentry.addBreadcrumb({
104:                     category: 'hardware.connection',
105:                     message: `로스터 연결 성공: ${machine.name}`,
106:                     level: 'info',
107:                     data: { roasterKey: machine.roasterKey, protocol: machine.protocol },
108:                 });
109:             } else if (status.error) {
110:                 Sentry.addBreadcrumb({
111:                     category: 'hardware.connection',
112:                     message: `로스터 연결 실패: ${machine.name}`,
113:                     level: 'error',
114:                     data: { roasterKey: machine.roasterKey, protocol: machine.protocol, error: status.error },
115:                 });
116:                 Sentry.captureMessage(`로스터 연결 실패: ${machine.name} — ${status.error}`, 'warning');
117:             }
118:         } catch (e) {
119:             console.error(e);
120:             Sentry.addBreadcrumb({
121:                 category: 'hardware.connection',
122:                 message: `로스터 연결 중 예외: ${machine.name}`,
123:                 level: 'error',
124:                 data: { roasterKey: machine.roasterKey, error: String(e) },
125:             });
126:         } finally {
127:             setConnecting(false);
128:         }
129:     };
130: 
131:     const handleDisconnect = async () => {
132:         const prevStatus = sidecarStatus;
133:         const status = await sidecar.disconnect().catch(() => null);
134:         if (status) setSidecarStatus(status);
135:         setTemps(null);
136:         if (prevStatus?.connected) {
137:             Sentry.addBreadcrumb({
138:                 category: 'hardware.connection',
139:                 message: '로스터 연결 해제',
140:                 level: 'info',
141:                 data: {
142:                     prevRoaster: prevStatus.roaster,
143:                     uptimeSec: prevStatus.uptime,
144:                 },
145:             });
146:         }
147:     };
148: 
149:     const connectedMachine = machines.find(isThisMachineConnected);
150:     const isSelectedConnected = selected ? isThisMachineConnected(selected) : false;
151: 
152:     return (
153:         <PageLayout>
154:             <AddMachineModal
155:                 key={editingMachine?.id ?? 'new'}
156:                 open={modalOpen}
157:                 onClose={closeModal}
158:                 onAdd={handleAdd}
159:                 editing={editingMachine}
160:                 onEdit={handleEdit}
161:             />
162: 
163:             <PageHeader
164:                 title="Machines"
165:                 subtitle={`${t('machines.registered', { count: machines.length })}${
166:                     sidecarStatus?.connected && connectedMachine
167:                         ? ` · ${t('machines.connectedSuffix', { name: connectedMachine.name })}`
168:                         : ` · ${t('machines.noActiveConnection')}`
169:                 }`}
170:                 actions={
171:                     <PillButton onClick={openAddModal}>
172:                         <Plus size={15} strokeWidth={2.5} />
173:                         {t('machines.addMachine')}
174:                     </PillButton>
175:                 }
176:             />
177: 
178:             {machines.length === 0 ? (
179:                 <div className="bg-main-bg rounded-lg py-16 px-8 text-center dark:border dark:border-[#585d61]">
180:                     <Cpu size={32} strokeWidth={1.2} color="var(--color-muted)" className="mb-4 mx-auto" />
181:                     <p className="text-[15px] text-muted mb-5">{t('machines.empty')}</p>
182:                     <button
183:                         onClick={openAddModal}
184:                         className="px-5 py-2.5 rounded-[10px] border-none bg-primary dark:bg-[#171717] text-white text-[13px] font-medium cursor-pointer"
185:                     >
186:                         {t('machines.addFirst')}
187:                     </button>
188:                 </div>
189:             ) : (
190:                 <MasterDetailLayout
191:                     left={
192:                         <div>
193:                             <div className="flex items-center gap-2 bg-main-bg rounded-lg px-3 py-2.25 mb-2.5 dark:border dark:border-[#585d61]">
194:                                 <Search size={14} strokeWidth={2} color="var(--color-muted)" />
