  1: import { LazyStore } from '@tauri-apps/plugin-store';
  2: import { useSyncExternalStore } from 'react';
  3: 
  4: const LEGACY_STORAGE_KEY = 'fc_roast_settings';
  5: const STORE_KEY = 'roast.settings';
  6: const SAVE_DEBOUNCE_MS = 200;
  7: 
  8: export type PollIntervalMs = 500 | 1000;
  9: export type RorSpanSec = 15 | 30 | 60;
 10: export type TemperatureUnit = 'C' | 'F';
 11: 
 12: export type RoastSettings = {
 13:     pollIntervalMs: PollIntervalMs;
 14:     rorSpanSec: RorSpanSec;
 15:     temperatureUnit: TemperatureUnit;
 16:     showET: boolean;
 17:     showTargetCurve: boolean;
 18:     showRoRChart: boolean;
 19:     showRoRET: boolean;
 20:     showControlChart: boolean;
 21:     showPhaseBar: boolean;
 22:     tempMinC: number;
 23:     tempMaxC: number;
 24:     rorYMin: number;
 25:     rorYMax: number;
 26:     yellowTempC: number;
 27:     fcStartTempC: number;
 28:     autoChargeDropC: number;
 29:     preChargeDisplaySec: number;
 30: };
 31: 
 32: const DEFAULT_SETTINGS: RoastSettings = {
 33:     pollIntervalMs: 500,
 34:     rorSpanSec: 30,
 35:     temperatureUnit: 'C',
 36:     showET: true,
 37:     showTargetCurve: true,
 38:     showRoRChart: true,
 39:     showRoRET: false,
 40:     showControlChart: true,
 41:     showPhaseBar: true,
 42:     tempMinC: 130,
 43:     tempMaxC: 240,
 44:     rorYMin: -5,
 45:     rorYMax: 20,
 46:     yellowTempC: 150,
 47:     fcStartTempC: 200,
 48:     autoChargeDropC: 5,
 49:     preChargeDisplaySec: 60,
 50: };
 51: 
 52: const isPollIntervalMs = (value: unknown): value is PollIntervalMs => value === 500 || value === 1000;
 53: 
 54: const migratePollIntervalMs = (ms: unknown): PollIntervalMs => {
 55:     if (ms === 250) return 500;
 56:     return isPollIntervalMs(ms) ? ms : DEFAULT_SETTINGS.pollIntervalMs;
 57: };
 58: 
 59: const normalize = (raw: Partial<RoastSettings> | null | undefined): RoastSettings => {
 60:     const merged = { ...DEFAULT_SETTINGS, ...(raw ?? {}) };
 61:     return {
 62:         ...merged,
 63:         pollIntervalMs: migratePollIntervalMs(merged.pollIntervalMs),
 64:     };
 65: };
 66: 
 67: const store = new LazyStore('settings.json');
 68: 
 69: let _settings: RoastSettings = { ...DEFAULT_SETTINGS };
 70: let _userTouched = false;
 71: let _saveTimer: ReturnType<typeof setTimeout> | null = null;
 72: 
 73: const _listeners = new Set<() => void>();
 74: 
 75: const _subscribe = (listener: () => void) => {
 76:     _listeners.add(listener);
 77:     return () => {
 78:         _listeners.delete(listener);
 79:     };
 80: };
 81: 
 82: const _getSnapshot = () => _settings;
 83: 
 84: const _emit = () => _listeners.forEach((l) => l());
 85: 
 86: const _consumeLegacyLocalStorage = (): Partial<RoastSettings> | null => {
 87:     try {
 88:         const raw = window.localStorage.getItem(LEGACY_STORAGE_KEY);
 89:         if (!raw) return null;
 90:         const parsed = JSON.parse(raw) as Partial<RoastSettings>;
 91:         window.localStorage.removeItem(LEGACY_STORAGE_KEY);
 92:         return parsed;
 93:     } catch {
 94:         return null;
 95:     }
 96: };
 97: 
 98: const _flush = async () => {
 99:     try {
100:         await store.set(STORE_KEY, _settings);
101:         await store.save();
102:     } catch {
103:         // store unavailable — drop write
104:     }
105: };
106: 
107: const _scheduleSave = () => {
108:     if (_saveTimer) clearTimeout(_saveTimer);
109:     _saveTimer = setTimeout(() => {
110:         _saveTimer = null;
111:         void _flush();
112:     }, SAVE_DEBOUNCE_MS);
113: };
114: 
115: const _hydrate = async () => {
116:     try {
117:         const stored = await store.get<Partial<RoastSettings>>(STORE_KEY);
118:         if (_userTouched) return;
119: 
120:         if (stored) {
121:             _settings = normalize(stored);
122:             if ((_settings.pollIntervalMs as number) === 250) {
123:                 _settings = { ..._settings, pollIntervalMs: 500 };
124:                 void _flush();
125:             }
126:             _emit();
127:             return;
128:         }
129: 
130:         const legacy = _consumeLegacyLocalStorage();
131:         if (legacy) {
132:             _settings = normalize(legacy);
133:             _emit();
134:             await _flush();
135:         }
136:     } catch {
137:         // store unavailable (e.g., non-Tauri context) — keep defaults
138:     }
139: };
140: 
141: void _hydrate();
142: 
143: export const updateRoastSettings = (patch: Partial<RoastSettings>) => {
144:     _userTouched = true;
145:     _settings = normalize({ ..._settings, ...patch });
146:     _emit();
147:     _scheduleSave();
148: };
149: 
150: export const useRoastSettings = () => useSyncExternalStore(_subscribe, _getSnapshot);
</file>

