<file path="src-tauri/sidecar/adapters/s7.py">
  1: import asyncio
  2: import time
  3: import logging
  4: from typing import Any
  5: 
  6: import config
  7: from adapters.base import Reading
  8: from protocol_trace import TRACE
  9: 
 10: _log = logging.getLogger(__name__)
 11: 
 12: 
 13: class S7Adapter:
 14:     """
 15:     Siemens S7 PLC 어댑터 (Giesen, Probat S7 모델).
 16:     python-snap7 직접 사용 (extern/s7port.py는 Qt에 깊게 결합돼 있어 사용 불가).
 17: 
 18:     channels: roaster_registry의 "channels" 배열
 19:       [{"role": "BT"|"ET"|"heater"|"fan", "db": N, "offset": N, "area": 6, "type": 0|1, "div": 0|1|2}, ...]
 20:     type: 0=int (2 bytes), 1=float (4 bytes)
 21:     area: 6=DB (DataBlock) — Giesen/Probat 모두 여기
 22:     div:  0=raw, 1=÷10, 2=÷100
 23: 
 24:     snap7은 동기 API → run_in_executor로 이벤트 루프 블로킹 방지.
 25:     read_retries=1, min_request_interval=0.04s (40ms) — artisan s7port.py 기준.
 26:     """
 27: 
 28:     def __init__(
 29:         self,
 30:         host: str = "127.0.0.1",
 31:         port: int = 102,
 32:         rack: int = 0,
 33:         slot: int = 0,
 34:         channels: list[dict[str, Any]] | None = None,
 35:         **_: Any,
 36:     ) -> None:
 37:         self._host = host
 38:         self._port = port
 39:         self._rack = rack
 40:         self._slot = slot
 41:         self._channels = channels or []
 42:         self._plc: Any = None
 43:         self._read_retries: int = 1
 44:         self._min_interval: float = config.S7_MIN_REQUEST_INTERVAL
 45:         self._last_request_ts: float = 0.0
 46:         # 채널 캐시 — connect() 시 한 번만 계산
 47:         self._bt_ch: dict[str, Any] | None = None
 48:         self._et_ch: dict[str, Any] | None = None
 49:         self._hp_ch: dict[str, Any] | None = None
 50:         self._fc_ch: dict[str, Any] | None = None
 51:         self._drum_ch: dict[str, Any] | None = None
 52: 
 53:     async def connect(self) -> None:
 54:         import snap7  # type: ignore[import]
 55: 
 56:         if not self._channels:
 57:             raise ValueError("channels가 비어 있음. roaster_registry 확인 필요.")
 58: 
 59:         def _connect() -> None:
 60:             self._plc = snap7.client.Client()
 61:             self._plc.connect(self._host, self._rack, self._slot, self._port)
 62:             time.sleep(0.2)  # Artisan: wait after connect for slow PLCs
 63: 
 64:         loop = asyncio.get_running_loop()
 65:         await loop.run_in_executor(None, _connect)
 66: 
 67:         if not self.connected:
 68:             raise ConnectionError(
 69:                 f"S7 연결 실패: {self._host}:{self._port} (rack={self._rack}, slot={self._slot})"
 70:             )
 71:         self._bt_ch = next((c for c in self._channels if c.get("role") == "BT"), None)
 72:         self._et_ch = next((c for c in self._channels if c.get("role") == "ET"), None)
 73:         self._hp_ch = next((c for c in self._channels if c.get("role") == "heater"), None)
 74:         self._fc_ch = next((c for c in self._channels if c.get("role") == "fan"), None)
 75:         self._drum_ch = next((c for c in self._channels if c.get("role") == "drum"), None)
 76:         _log.info("S7Adapter connected: %s:%d", self._host, self._port)
 77: 
 78:     async def disconnect(self) -> None:
 79:         def _disconnect() -> None:
 80:             if self._plc is not None:
 81:                 try:
 82:                     self._plc.disconnect()
 83:                     self._plc.destroy()
 84:                 except Exception:
 85:                     pass
 86:                 self._plc = None
 87: 
 88:         loop = asyncio.get_running_loop()
 89:         await loop.run_in_executor(None, _disconnect)
 90:         self._bt_ch = self._et_ch = self._hp_ch = self._fc_ch = self._drum_ch = None
 91: 
 92:     def _throttle(self) -> None:
 93:         """요청 간 최소 간격(40ms) 보장. 스레드에서 호출."""
 94:         elapsed = time.monotonic() - self._last_request_ts
 95:         if elapsed < self._min_interval:
 96:             time.sleep(self._min_interval - elapsed)
 97:         self._last_request_ts = time.monotonic()
 98: 
 99:     def _read_channel_sync(self, ch: dict[str, Any]) -> float:
100:         """스레드에서 실행. snap7 db_read → float 변환. retry 포함."""
101:         from snap7.util.getters import get_real, get_int  # type: ignore[import]
102: 
103:         db: int = ch["db"]
104:         offset: int = ch["offset"]
105:         ch_type: int = ch.get("type", 0)  # 0=int(2B), 1=float(4B)
106:         div: int = ch.get("div", 0)
107:         size = 4 if ch_type == 1 else 2
108: 
109:         last_exc: Exception = RuntimeError("S7 읽기 실패")
110:         for attempt in range(self._read_retries + 1):
111:             self._throttle()
112:             try:
113:                 role = ch.get("role", "?")
114:                 TRACE.record("tx", "s7", f"db_read db={db} offset={offset} size={size} role={role}")
115:                 ba: bytearray = self._plc.db_read(db, offset, size)
116:                 TRACE.record("rx", "s7", f"db_read db={db} offset={offset} role={role}", bytes(ba))
117:                 if len(ba) != size:
118:                     raise IOError(f"db_read 응답 크기 불일치: {len(ba)} != {size}")
119:                 value = float(get_real(ba, 0) if ch_type == 1 else get_int(ba, 0))
120:                 if div == 1:
121:                     value /= 10.0
122:                 elif div == 2:
123:                     value /= 100.0
124:                 value = round(value, 1)
125:                 TRACE.record(
126:                     "info", "s7",
127:                     f"decoded role={role} type={'REAL' if ch_type == 1 else 'INT'} div={div}",
128:                     value,
129:                 )
130:                 return value
131:             except Exception as exc:
132:                 last_exc = exc
133:                 TRACE.record("err", "s7", f"db={db} offset={offset} attempt={attempt + 1}: {exc}")
134:                 _log.warning("S7 읽기 실패 (attempt %d/%d): db=%d offset=%d — %s",
135:                              attempt + 1, self._read_retries + 1, db, offset, exc)
136:         raise last_exc
137: 
138:     async def read(self) -> Reading:
139:         if not self.connected:
140:             raise ConnectionError("S7 PLC가 연결되지 않음")
141: 
142:         def _read_all() -> tuple[float, float, float, float, float]:
143:             bt = self._read_channel_sync(self._bt_ch) if self._bt_ch else -1.0
144:             et = self._read_channel_sync(self._et_ch) if self._et_ch else -1.0
145:             hp = self._read_channel_sync(self._hp_ch) if self._hp_ch else 0.0
146:             fc = self._read_channel_sync(self._fc_ch) if self._fc_ch else 0.0
147:             drum = self._read_channel_sync(self._drum_ch) if self._drum_ch else 0.0
148:             return bt, et, hp, fc, drum
149: 
150:         loop = asyncio.get_running_loop()
151:         bt, et, hp, fc, drum = await loop.run_in_executor(None, _read_all)
152:         return Reading(bt=bt, et=et, heater=hp, fan=fc, drum=drum, timestamp=time.monotonic())
153: 
154:     async def control(self, heater: float | None = None, fan: float | None = None, drum: float | None = None) -> None:
155:         pass  # 제어 기능 미사용 — 제거 예정
156: 
157:     @property
158:     def connected(self) -> bool:
159:         # get_connected() can return True after peer-terminated connections (snap7 bug);
160:         # CPU state check is the reliable signal — from Artisan s7port.py
161:         try:
162:             return (self._plc is not None and
163:                     self._plc.get_connected() and
164:                     str(self._plc.get_cpu_state()) == "S7CpuStatusRun")
165:         except Exception:
166:             return False
</file>

