<file path="src/widgets/date-range-filter/ui/DateRangeFilter.tsx">
  1: import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '@shared/ui/select/Select';
  2: import { ChevronDown, X } from 'lucide-react';
  3: import { type ReactNode, useEffect, useMemo, useRef, useState } from 'react';
  4: import { useTranslation } from 'react-i18next';
  5: 
  6: export type DatePreset = 'all' | 'this-month' | 'last-month' | '3-months' | '6-months' | 'this-year' | 'custom';
  7: 
  8: export const DATE_PRESETS: { value: DatePreset }[] = [
  9:     { value: 'all' },
 10:     { value: 'this-month' },
 11:     { value: 'last-month' },
 12:     { value: '3-months' },
 13:     { value: '6-months' },
 14:     { value: 'this-year' },
 15:     { value: 'custom' },
 16: ];
 17: 
 18: export const getPresetYMRange = (preset: DatePreset): { fromYM: string; toYM: string } | null => {
 19:     const now = new Date();
 20:     const y = now.getFullYear();
 21:     const m = now.getMonth();
 22:     const fmt = (year: number, month: number) => `${year}-${String(month + 1).padStart(2, '0')}`;
 23:     if (preset === 'this-month') return { fromYM: fmt(y, m), toYM: fmt(y, m) };
 24:     if (preset === 'last-month') {
 25:         const d = new Date(y, m - 1, 1);
 26:         return { fromYM: fmt(d.getFullYear(), d.getMonth()), toYM: fmt(d.getFullYear(), d.getMonth()) };
 27:     }
 28:     if (preset === '3-months') {
 29:         const d = new Date(y, m - 2, 1);
 30:         return { fromYM: fmt(d.getFullYear(), d.getMonth()), toYM: fmt(y, m) };
 31:     }
 32:     if (preset === '6-months') {
 33:         const d = new Date(y, m - 5, 1);
 34:         return { fromYM: fmt(d.getFullYear(), d.getMonth()), toYM: fmt(y, m) };
 35:     }
 36:     if (preset === 'this-year') return { fromYM: fmt(y, 0), toYM: fmt(y, m) };
 37:     return null;
 38: };
 39: 
 40: interface DateRangeFilterProps {
 41:     preset: DatePreset;
 42:     fromYM: string;
 43:     toYM: string;
 44:     monthOptions: string[];
 45:     onPresetChange: (p: DatePreset) => void;
 46:     onFromYM: (v: string) => void;
 47:     onToYM: (v: string) => void;
 48: }
 49: 
 50: export const DateRangeFilter = ({
 51:     preset,
 52:     fromYM,
 53:     toYM,
 54:     monthOptions,
 55:     onPresetChange,
 56:     onFromYM,
 57:     onToYM,
 58: }: DateRangeFilterProps): ReactNode => {
 59:     const { t } = useTranslation();
 60:     const months = t('months', { returnObjects: true }) as string[];
 61:     const [open, setOpen] = useState(false);
 62:     const ref = useRef<HTMLDivElement>(null);
 63:     const isActive = preset !== 'all';
 64: 
 65:     const initFrom = fromYM || (monthOptions[0] ?? '');
 66:     const initTo = toYM || (monthOptions[monthOptions.length - 1] ?? '');
 67:     const [draftFrom, setDraftFrom] = useState(initFrom);
 68:     const [draftTo, setDraftTo] = useState(initTo);
 69: 
 70:     useEffect(() => {
 71:         if (!open) return;
 72:         const handler = (e: MouseEvent) => {
 73:             const target = e.target as Element;
 74:             const inPanel = ref.current?.contains(target);
 75:             const inPortal = !!target?.closest('[data-radix-popper-content-wrapper]');
 76:             if (!inPanel && !inPortal) setOpen(false);
 77:         };
 78:         document.addEventListener('mousedown', handler);
 79:         return () => document.removeEventListener('mousedown', handler);
 80:     }, [open]);
 81: 
 82:     const years = useMemo(
 83:         () => [...new Set(monthOptions.map((ym) => ym.split('-')[0]))].sort((a, b) => Number(b) - Number(a)),
 84:         [monthOptions],
 85:     );
 86: 
 87:     const fmtLabel = (ym: string) => {
 88:         if (!ym) return '—';
 89:         const [y, m] = ym.split('-');
 90:         const monthName = months[parseInt(m, 10) - 1] || '';
 91:         return `${monthName} ${y}`;
 92:     };
 93: 
 94:     const triggerLabel = (() => {
 95:         if (preset === 'custom' && (fromYM || toYM)) return `${fmtLabel(fromYM)} – ${fmtLabel(toYM)}`;
 96:         const presetLabel = DATE_PRESETS.find((p) => p.value === preset)?.value ?? '';
 97:         return presetLabel ? t('history.datePresets.' + presetLabel) : t('history.datePresets.period');
 98:     })();
 99: 
100:     const handlePresetClick = (p: DatePreset) => {
101:         if (p === 'custom') {
102:             setDraftFrom(fromYM || initFrom);
103:             setDraftTo(toYM || initTo);
104:         }
105:         onPresetChange(p);
106:         if (p !== 'custom') setOpen(false);
107:     };
108: 
109:     const handleApply = () => {
110:         let f = draftFrom;
111:         let t = draftTo;
112:         if (f && t && f > t) {
113:             [f, t] = [t, f];
114:         }
115:         onFromYM(f);
116:         onToYM(t);
117:         setOpen(false);
118:     };
119: 
120:     return (
121:         <div ref={ref} className="relative">
122:             <button
123:                 onClick={() => setOpen((o) => !o)}
124:                 className={`inline-flex items-center gap-1.5 whitespace-nowrap rounded-lg border-0 px-3 py-2 text-[13px] font-medium tracking-[0.14px] transition ${
125:                     isActive
126:                         ? 'bg-surface-warm-solid text-primary'
127:                         : 'bg-surface dark:bg-surface-elevated text-secondary hover:-translate-y-px hover:text-primary'
128:                 }`}
129:             >
130:                 {triggerLabel}
131:                 {isActive ? (
132:                     <X
133:                         size={11}
134:                         strokeWidth={2.5}
135:                         className="text-muted hover:text-primary"
136:                         onClick={(e) => {
137:                             e.stopPropagation();
138:                             onPresetChange('all');
139:                             setOpen(false);
140:                         }}
141:                     />
142:                 ) : (
143:                     <ChevronDown size={11} strokeWidth={2} className="text-muted" />
144:                 )}
145:             </button>
146: 
147:             {open && (
148:                 <div className="absolute border border-border-subtle dark:border-[#585d61] top-full left-0 z-50 mt-2 flex rounded-lg bg-main-bg overflow-hidden shadow-lg">
149:                     {/* 프리셋 목록 */}
150:                     <div className="flex shrink-0 flex-col gap-0.5 py-2 px-2 w-36">
151:                         {DATE_PRESETS.map((p) => (
152:                             <button
153:                                 key={p.value}
154:                                 onClick={() => handlePresetClick(p.value)}
155:                                 className={`w-full rounded-md px-2.5 py-1.5 text-left text-[13px] tracking-[0.14px] transition hover:bg-surface cursor-pointer border-none bg-transparent ${
156:                                     preset === p.value ? 'font-semibold text-primary' : 'text-secondary'
157:                                 }`}
158:                             >
159:                                 {t('history.datePresets.' + p.value)}
160:                             </button>
161:                         ))}
162:                     </div>
163: 
164:                     {/* 커스텀 범위 — draft 상태로 관리, Apply 버튼으로만 반영 */}
165:                     {preset === 'custom' && (
166:                         <div className="flex flex-col justify-center gap-3 border-l border-border-subtle dark:border-[#585d61] px-5 py-4 self-stretch">
167:                             {(
168:                                 [
169:                                     { label: t('history.customRange.start'), val: draftFrom, set: setDraftFrom },
170:                                     { label: t('history.customRange.end'), val: draftTo, set: setDraftTo },
171:                                 ] as const
172:                             ).map(({ label, val, set }) => {
173:                                 const yr = val ? val.split('-')[0] : '';
174:                                 const mo = val ? val.split('-')[1] : '';
175:                                 return (
176:                                     <div key={label} className="flex items-center gap-2">
177:                                         <span className="w-7 shrink-0 text-[11px] font-medium uppercase tracking-[0.5px] text-muted">
178:                                             {label}
179:                                         </span>
180:                                         <Select value={yr} onValueChange={(v) => set(mo ? `${v}-${mo}` : v)}>
181:                                             <SelectTrigger className="w-24 border border-border-subtle dark:border-[#585d61]">
182:                                                 <SelectValue placeholder={t('history.customRange.year')} />
183:                                             </SelectTrigger>
184:                                             <SelectContent>
185:                                                 {years.map((y) => (
186:                                                     <SelectItem key={y} value={y}>
187:                                                         {y}
188:                                                     </SelectItem>
189:                                                 ))}
190:                                             </SelectContent>
191:                                         </Select>
192:                                         <Select value={mo} onValueChange={(v) => set(yr ? `${yr}-${v}` : v)}>
193:                                             <SelectTrigger className="w-20 border border-border-subtle dark:border-[#585d61]">
194:                                                 <SelectValue placeholder={t('history.customRange.month')} />
195:                                             </SelectTrigger>
196:                                             <SelectContent>
197:                                                 {months.map((name, i) => (
198:                                                     <SelectItem key={i} value={String(i + 1).padStart(2, '0')}>
199:                                                         {name}
200:                                                     </SelectItem>
201:                                                 ))}
202:                                             </SelectContent>
203:                                         </Select>
204:                                     </div>
205:                                 );
206:                             })}
207:                             <div className="flex justify-end">
208:                                 <button
209:                                     onClick={handleApply}
210:                                     disabled={!draftFrom || !draftTo}
211:                                     className="mt-1 ml-auto rounded-lg border border-[#111] dark:border-[#585d61] bg-[#111] px-4 py-1.5 text-[13px] font-medium text-white cursor-pointer hover:opacity-90 transition-opacity disabled:opacity-40 disabled:cursor-not-allowed"
212:                                 >
213:                                     {t('history.customRange.apply')}
214:                                 </button>
215:                             </div>
216:                         </div>
217:                     )}
218:                 </div>
219:             )}
220:         </div>
221:     );
222: };
</file>

