LANGUAGE plpgsql
STABLE
SECURITY INVOKER
AS $$
DECLARE
  v_today date := CURRENT_DATE;
  v_horizon date := CURRENT_DATE + p_horizon_days;
  v_reserved integer := 0;
  v_row record;
  v_rec record;
  v_remaining integer;
