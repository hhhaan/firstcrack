 91: class RoasterManager:
 92:     def __init__(self) -> None:
 93:         self._adapter: Any = None
 94:         self._roaster_key: str = ""
 95:         self._protocol: str = ""
 96:         self._merged_params: dict[str, Any] = {}
 97:         self._connected: bool = False
 98:         self._data_ok: bool = False  # 실제 bt/et 값이 읽힌 적 있어야 connected로 판단
 99:         self._error: str | None = None
100:         self._start_time: float = 0.0
101:         self._ror_window: deque[tuple[float, float]] = deque()
102:         self._et_ror_window: deque[tuple[float, float]] = deque()
103:         self._bt_ema: float | None = None
104:         self._et_ema: float | None = None
105:         self._bt_display_ema: float | None = None
106:         self._et_display_ema: float | None = None
107:         self._lock: asyncio.Lock = asyncio.Lock()
108:         self._reconnect_task: asyncio.Task[None] | None = None
109:         self._reconnect_attempt: int = 0
110:         self._ror_warmup: int = 0
111:         self._consecutive_errors: int = 0
112:         self._last_good: dict[str, Any] | None = None
113: 
114:     async def connect(self, roaster_key: str, params: dict[str, Any]) -> None:
115:         async with self._lock:
116:             if self._adapter is not None:
117:                 await self._disconnect_internal()
118: 
119:             reg = ROASTER_REGISTRY.get(roaster_key)
120:             if reg is None:
121:                 raise ValueError(f"알 수 없는 로스터: {roaster_key}")
122: 
123:             protocol = reg["protocol"]
124:             merged = {**reg["default_params"], **params}
125: 
126:             self._adapter = make_adapter(protocol, merged)
127:             self._roaster_key = roaster_key
128:             self._protocol = protocol
129:             self._merged_params = merged
130:             self._ror_window.clear()
131:             self._et_ror_window.clear()
132:             self._bt_ema = None
133:             self._et_ema = None
134:             self._bt_display_ema = None
135:             self._et_display_ema = None
136:             self._error = None
137:             self._ror_warmup = config.ROR_WARMUP_READS
138: 
139:             try:
140:                 await self._adapter.connect()
141:                 self._connected = True
142:                 self._start_time = time.monotonic()
143:                 # Warmup read: _data_ok를 connect 응답 전에 설정해 프론트엔드가 즉시 connected를 볼 수 있게 함
144:                 try:
145:                     reading = await self._adapter.read()
146:                     if reading.bt > 0:
147:                         self._data_ok = True
148:                 except Exception as exc:
149:                     # 연결은 성공했으나 첫 read 실패 — 폴링에서 재시도되므로 치명적이지 않다.
150:                     # 단, status.connected가 _data_ok=False로 인해 false로 보이므로 단서를 남긴다.
151:                     _log.warning("warmup read 실패 (폴링에서 재시도): %s", exc)
152:             except Exception as exc:
153:                 self._error = _format_connection_error(exc, protocol, merged)
154:                 self._connected = False
155:                 _log.error("연결 실패 [%s]: %s", roaster_key, exc, exc_info=True)
156: 
157:     async def disconnect(self) -> None:
158:         async with self._lock:
159:             await self._disconnect_internal()
160: 
161:     async def _disconnect_internal(self) -> None:
162:         if self._reconnect_task is not None and not self._reconnect_task.done():
163:             self._reconnect_task.cancel()
164:             self._reconnect_task = None
165:         if self._adapter is not None:
166:             try:
167:                 await self._adapter.disconnect()
168:             except Exception:
169:                 pass
170:         self._adapter = None
171:         self._connected = False
172:         self._data_ok = False
173:         self._roaster_key = ""
174:         self._protocol = ""
175:         self._merged_params = {}
176:         self._ror_window.clear()
177:         self._et_ror_window.clear()
178:         self._bt_ema = None
179:         self._et_ema = None
180:         self._bt_display_ema = None
181:         self._et_display_ema = None
182:         self._consecutive_errors = 0
183:         self._last_good = None
184: 
185:     async def _reconnect_loop(self) -> None:
186:         """읽기 실패 후 백그라운드 자동 재연결.
187: 
188:         config.RECONNECT_BACKOFFS를 소진한 뒤에는 마지막 간격으로 무한 재시도.
189:         사용자가 /disconnect 하면 _disconnect_internal()이 이 태스크를 취소한다.
190:         """
191:         attempt = 0
192:         try:
193:             while True:
194:                 delay = config.RECONNECT_BACKOFFS[
195:                     min(attempt, len(config.RECONNECT_BACKOFFS) - 1)
196:                 ]
197:                 attempt += 1
198:                 self._reconnect_attempt = attempt
199:                 await asyncio.sleep(delay)
200:                 if self._connected or self._adapter is None:
201:                     return
202:                 async with self._lock:
203:                     if self._connected or self._adapter is None:
204:                         return
205:                     try:
206:                         _log.info("자동 재연결 시도 (%d): %s", attempt, self._roaster_key)
207:                         try:
208:                             await self._adapter.disconnect()
209:                         except Exception:
210:                             pass
211:                         await self._adapter.connect()
212:                         self._connected = True
213:                         self._consecutive_errors = 0
214:                         self._error = None
215:                         self._ror_window.clear()
216:                         self._et_ror_window.clear()
217:                         self._bt_ema = None
218:                         self._et_ema = None
219:                         self._bt_display_ema = None
220:                         self._et_display_ema = None
221:                         self._ror_warmup = config.ROR_WARMUP_READS
222:                         _log.info("자동 재연결 성공: %s", self._roaster_key)
223:                         return
224:                     except Exception as exc:
225:                         self._error = _format_connection_error(
226:                             exc, self._protocol, self._merged_params
227:                         )
228:                         _log.error("재연결 실패 (%d): %s", attempt, exc)
229:         finally:
230:             self._reconnect_attempt = 0
231: 
232:     async def read_temperatures(self) -> dict[str, Any]:
233:         reconnecting = (
234:             self._reconnect_task is not None and not self._reconnect_task.done()
235:         )
236:         if not self._connected or self._adapter is None:
237:             return {
238:                 "bt": None,
239:                 "et": None,
240:                 "ror": 0.0,
241:                 "ror_et": 0.0,
242:                 "heater": 0,
243:                 "fan": 0,
244:                 "drum": 0,
245:                 "timestamp": time.monotonic(),
246:                 "stale": False,
247:                 "reconnecting": reconnecting,
248:             }
249:         try:
250:             reading = await self._adapter.read()
251:         except Exception as exc:
252:             self._consecutive_errors += 1
253:             if (
254:                 self._consecutive_errors <= config.STALE_TOLERANCE_READS
255:                 and self._last_good is not None
256:             ):
257:                 # fail-open: 일시 오류는 이전 값을 유지해 로스팅을 계속한다 (Artisan 방식)
258:                 _log.warning(
259:                     "읽기 실패 (%d/%d) — 이전 값 유지: %s",
260:                     self._consecutive_errors,
261:                     config.STALE_TOLERANCE_READS,
262:                     exc,
263:                 )
264:                 return {
265:                     **self._last_good,
266:                     "stale": True,
267:                     "reconnecting": reconnecting,
268:                     "timestamp": time.monotonic(),
269:                 }
270:             self._error = _format_connection_error(
271:                 exc, self._protocol, self._merged_params
272:             )
273:             self._connected = False
274:             _log.error("읽기 실패: %s", exc, exc_info=True)
275:             if self._reconnect_task is None or self._reconnect_task.done():
276:                 self._reconnect_task = asyncio.create_task(self._reconnect_loop())
277:             return {
278:                 "bt": None,
279:                 "et": None,
280:                 "ror": 0.0,
281:                 "ror_et": 0.0,
282:                 "heater": 0,
283:                 "fan": 0,
284:                 "drum": 0,
285:                 "timestamp": time.monotonic(),
286:                 "stale": False,
287:                 "reconnecting": True,
288:             }
289: 
290:         self._consecutive_errors = 0
291: 
292:         if reading.bt > 0:
293:             self._data_ok = True
294:             self._add_to_ror_window(reading.timestamp, reading.bt)
295:         if reading.et > 0:
296:             self._add_to_et_ror_window(reading.timestamp, reading.et)
297: 
298:         if self._ror_warmup > 0:
299:             self._ror_warmup -= 1
300:             ror = 0.0
301:             ror_et = 0.0
302:         else:
303:             ror = round(self._compute_ror(), 2)
304:             ror_et = round(self._compute_et_ror(), 2)
305: 
306:         payload = {
307:             "bt": round(self._bt_display_ema if self._bt_display_ema is not None else reading.bt, 1),
308:             "et": round(self._et_display_ema if self._et_display_ema is not None else reading.et, 1),
309:             "ror": ror,
310:             "ror_et": ror_et,
311:             "heater": int(round(reading.heater)),
312:             "fan": int(round(reading.fan)),
313:             "drum": round(reading.drum, 1),
314:             "timestamp": reading.timestamp,
315:             "stale": False,
316:             "reconnecting": reconnecting,
317:         }
318:         self._last_good = payload
319:         return payload
320: 
321:     async def control(self, heater: float | None = None, fan: float | None = None, drum: float | None = None) -> None:
322:         if self._adapter is not None and hasattr(self._adapter, "control"):
323:             await self._adapter.control(heater=heater, fan=fan, drum=drum)
324: 
325:     async def enter_standby(self) -> None:
326:         """UI의 READY 버튼과 연동. 어댑터가 지원하면 standby 진입을 알린다."""
327:         if self._adapter is not None and hasattr(self._adapter, "enter_standby"):
328:             await self._adapter.enter_standby()
329: 
330:     async def start_roast(self) -> None:
331:         """UI의 Charge 버튼과 연동. 어댑터가 지원하면 타이머를 리셋하고, RoR 윈도우를 초기화."""
332:         async with self._lock:
333:             self._ror_window.clear()
334:             self._et_ror_window.clear()
335:             self._bt_ema = None
336:             self._et_ema = None
337:             self._bt_display_ema = None
338:             self._et_display_ema = None
339:             self._ror_warmup = config.ROR_WARMUP_READS
340:             if self._adapter is not None and hasattr(self._adapter, "start_roast"):
341:                 await self._adapter.start_roast()
342: 
343:     async def reset_roast(self) -> None:
344:         """로스트 종료 후 어댑터 상태를 초기화한다 (connect() 재호출). RoR 윈도우도 클리어."""
345:         async with self._lock:
346:             self._ror_window.clear()
347:             self._et_ror_window.clear()
348:             self._bt_ema = None
349:             self._et_ema = None
350:             self._bt_display_ema = None
351:             self._et_display_ema = None
352:             if self._adapter is not None and self._connected:
353:                 # connect()만 재호출하면 어댑터에 따라 기존 소켓/핸들이 누수된다
354:                 try:
355:                     await self._adapter.disconnect()
356:                 except Exception:
357:                     pass
358:                 await self._adapter.connect()
359: 
360:     def status(self) -> dict[str, Any]:
361:         uptime = round(time.monotonic() - self._start_time, 1) if self._connected else 0
362:         reg = ROASTER_REGISTRY.get(self._roaster_key, {})
363:         reconnecting = self._reconnect_task is not None and not self._reconnect_task.done()
364:         return {
365:             "connected": self._connected and self._data_ok,
366:             "reconnecting": reconnecting,
367:             "reconnect_attempt": self._reconnect_attempt,
368:             "roaster": self._roaster_key,
369:             "display_name": reg.get("display_name", ""),
370:             "brand": reg.get("brand", ""),
371:             "capabilities": reg.get("capabilities", []),
372:             "uptime": uptime,
373:             "error": self._error,
374:         }
375: 
376:     async def probe(self) -> dict[str, Any]:
377:         """단발 진단 읽기 — EMA/stale 처리를 우회하고 어댑터 원시 값과 소요 시간을 반환.
378: 
379:         실기기에서 Artisan과 값을 직접 비교(A/B)하기 위한 디버깅 전용 경로.
380:         """
381:         adapter = self._adapter
382:         if adapter is None:
383:             return {"ok": False, "error": "연결된 어댑터 없음"}
384:         t0 = time.monotonic()
385:         try:
386:             r = await adapter.read()
387:             return {
388:                 "ok": True,
389:                 "elapsed_ms": round((time.monotonic() - t0) * 1000, 1),
390:                 "raw": {
391:                     "bt": r.bt,
392:                     "et": r.et,
393:                     "heater": r.heater,
394:                     "fan": r.fan,
395:                     "drum": r.drum,
396:                 },
397:             }
398:         except Exception as exc:
399:             return {
400:                 "ok": False,
401:                 "elapsed_ms": round((time.monotonic() - t0) * 1000, 1),
402:                 "error": str(exc),
403:             }
404: 
405:     def _add_to_ror_window(self, ts: float, bt: float) -> None:
406:         if self._bt_ema is None:
407:             self._bt_ema = bt
408:         else:
409:             self._bt_ema = config.EMA_ALPHA * bt + (1.0 - config.EMA_ALPHA) * self._bt_ema
410:         if self._bt_display_ema is None:
411:             self._bt_display_ema = bt
412:         else:
413:             self._bt_display_ema = config.DISPLAY_ALPHA * bt + (1.0 - config.DISPLAY_ALPHA) * self._bt_display_ema
414:         self._ror_window.append((ts, self._bt_ema))
415:         cutoff = ts - config.ROR_WINDOW_SECS
416:         while self._ror_window and self._ror_window[0][0] < cutoff:
417:             self._ror_window.popleft()
418: 
419:     def _add_to_et_ror_window(self, ts: float, et: float) -> None:
420:         if self._et_ema is None:
421:             self._et_ema = et
422:         else:
423:             self._et_ema = config.EMA_ALPHA * et + (1.0 - config.EMA_ALPHA) * self._et_ema
424:         if self._et_display_ema is None:
425:             self._et_display_ema = et
426:         else:
427:             self._et_display_ema = config.DISPLAY_ALPHA * et + (1.0 - config.DISPLAY_ALPHA) * self._et_display_ema
428:         self._et_ror_window.append((ts, self._et_ema))
429:         cutoff = ts - config.ROR_WINDOW_SECS
430:         while self._et_ror_window and self._et_ror_window[0][0] < cutoff:
431:             self._et_ror_window.popleft()
432: 
433:     def _compute_ror(self) -> float:
434:         """BT의 최근 30초 선형 최소제곱 기울기 (°C/min)."""
435:         return self._least_squares_slope(self._ror_window)
436: 
437:     def _compute_et_ror(self) -> float:
438:         """ET의 최근 30초 선형 최소제곱 기울기 (°C/min)."""
439:         return self._least_squares_slope(self._et_ror_window)
440: 
441:     def _least_squares_slope(self, window: deque[tuple[float, float]]) -> float:
442:         if len(window) < 2:
443:             return 0.0
444:         t0 = window[0][0]
445:         xs = [(t - t0) / 60.0 for t, _ in window]
446:         ys = [v for _, v in window]
447:         n = len(xs)
448:         sx, sy = sum(xs), sum(ys)
449:         sxy = sum(x * y for x, y in zip(xs, ys))
450:         sx2 = sum(x * x for x in xs)
451:         denom = n * sx2 - sx * sx
452:         if abs(denom) < 1e-9:
453:             return 0.0
454:         return (n * sxy - sx * sy) / denom
