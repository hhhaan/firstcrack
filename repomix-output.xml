601:                 machine_id: patch.machine_id ?? null,
602:                 bean_id: patch.bean_id ?? null,
603:                 blend_id: patch.blend_id ?? null,
604:                 roast_profile_id: patch.roast_profile_id ?? null,
605:                 batch_type: patch.batch_type ?? 'Single Origin',
606:                 notes: patch.notes ?? '',
