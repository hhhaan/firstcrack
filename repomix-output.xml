<file path="src-tauri/sidecar/main.py">
  1: """
  2: main.py — First Crack sidecar HTTP server
  3: ==========================================
  4: aiohttp 기반. Tauri 프론트엔드와 HTTP로 통신.
  5: 
  6: 엔드포인트:
  7:   GET  /roasters      → 지원 로스터 목록 + 프로토콜별 폼 필드
  8:   GET  /status        → 현재 연결 상태
  9:   POST /connect       → {"roaster": "easyster", "host": "...", ...}
 10:   POST /disconnect
 11:   GET  /temperatures  → {"bt", "et", "ror", "heater", "fan", "timestamp"}
 12:   POST /start         → Charge 버튼 연동: 가상 머신 타이머 리셋 + RoR 윈도우 초기화
 13: 
 14: 어댑터 추가 방법:
 15:   1. adapters/<protocol>.py 에 XxxAdapter 클래스 작성
 16:   2. adapters/__init__.py 의 _PROTOCOL_ADAPTER에 등록
 17:   3. roaster_registry.py 에 항목 추가
 18: """
 19: 
 20: import logging
 21: import os
 22: import sys
 23: import time
 24: from typing import Any
 25: 
 26: from aiohttp import web
 27: 
 28: from manager import RoasterManager
 29: from protocol_trace import TRACE
 30: from roaster_registry import ROASTER_REGISTRY, PROTOCOL_FORM_FIELDS
 31: 
 32: logging.basicConfig(level=logging.DEBUG, format="%(asctime)s %(levelname)s %(message)s")
 33: _log = logging.getLogger(__name__)
 34: 
 35: 
 36: def _pid_alive(pid: int) -> bool:
 37:     """부모 프로세스 생존 여부 확인 (표준 라이브러리만 사용)."""
 38:     try:
 39:         if sys.platform == "win32":
 40:             import ctypes
 41:             SYNCHRONIZE = 0x00100000
 42:             handle = ctypes.windll.kernel32.OpenProcess(SYNCHRONIZE, False, pid)
 43:             if handle:
 44:                 ctypes.windll.kernel32.CloseHandle(handle)
 45:                 return True
 46:             return False
 47:         else:
 48:             os.kill(pid, 0)
 49:             return True
 50:     except (OSError, ProcessLookupError):
 51:         return False
 52: 
 53: 
 54: async def parent_watchdog(parent_pid: int) -> None:
 55:     """Tauri 부모 프로세스가 죽으면 sidecar도 즉시 종료."""
 56:     import asyncio
 57:     while True:
 58:         await asyncio.sleep(1.0)
 59:         if not _pid_alive(parent_pid):
 60:             _log.info("부모 프로세스(PID %d) 종료 감지 — sidecar 종료", parent_pid)
 61:             os._exit(0)
 62: 
 63: class _SilencePolling(logging.Filter):
 64:     def filter(self, record: logging.LogRecord) -> bool:
 65:         msg = record.getMessage()
 66:         return "/temperatures" not in msg and "/status" not in msg
 67: 
 68: logging.getLogger("aiohttp.access").addFilter(_SilencePolling())
 69: 
 70: 
 71: # ---------------------------------------------------------------------------
 72: # Route handlers
 73: # ---------------------------------------------------------------------------
 74: 
 75: 
 76: async def handle_roasters(request: web.Request) -> web.Response:
 77:     INTERNAL_KEYS = {
 78:         "channels",
 79:         "channel_nodes",
 80:         "pid_db",
 81:         "pid_sv_register",
 82:         "modbus_registers",
 83:     }
 84:     result: dict[str, Any] = {}
 85:     for key, reg in ROASTER_REGISTRY.items():
 86:         protocol = reg["protocol"]
 87:         result[key] = {
 88:             "display_name": reg["display_name"],
 89:             "brand": reg["brand"],
 90:             "models": reg["models"],
 91:             "protocol": protocol,
 92:             "capabilities": reg["capabilities"],
 93:             "pid": reg.get("pid"),
 94:             "form_fields": PROTOCOL_FORM_FIELDS.get(protocol, []),
 95:             "default_params": {
 96:                 k: v for k, v in reg["default_params"].items() if k not in INTERNAL_KEYS
 97:             },
 98:         }
 99:     return web.json_response(result)
100: 
101: 
102: async def handle_status(request: web.Request) -> web.Response:
103:     manager: RoasterManager = request.app["manager"]
104:     return web.json_response(manager.status())
105: 
106: 
107: async def handle_connect(request: web.Request) -> web.Response:
108:     manager: RoasterManager = request.app["manager"]
109:     try:
110:         body: dict[str, Any] = await request.json()
111:     except Exception:
112:         return web.json_response({"error": "invalid JSON"}, status=400)
113:     roaster_key = body.pop("roaster", None)
114:     if not roaster_key:
115:         return web.json_response({"error": "roaster field required"}, status=400)
116:     try:
117:         await manager.connect(roaster_key, body)
118:     except ValueError as exc:
119:         return web.json_response({"error": str(exc)}, status=400)
120:     return web.json_response(manager.status())
121: 
122: 
123: async def handle_disconnect(request: web.Request) -> web.Response:
124:     manager: RoasterManager = request.app["manager"]
125:     await manager.disconnect()
126:     return web.json_response(manager.status())
127: 
128: 
129: async def handle_temperatures(request: web.Request) -> web.Response:
130:     manager: RoasterManager = request.app["manager"]
131:     data = await manager.read_temperatures()
132:     return web.json_response(data)
133: 
134: 
135: async def handle_standby(request: web.Request) -> web.Response:
136:     manager: RoasterManager = request.app["manager"]
137:     await manager.enter_standby()
138:     return web.json_response({"ok": True})
139: 
140: 
141: async def handle_start(request: web.Request) -> web.Response:
142:     manager: RoasterManager = request.app["manager"]
143:     await manager.start_roast()
144:     return web.json_response({"ok": True})
145: 
146: 
147: async def handle_reset(request: web.Request) -> web.Response:
148:     manager: RoasterManager = request.app["manager"]
149:     await manager.reset_roast()
150:     return web.json_response({"ok": True})
151: 
152: 
153: async def handle_shutdown(request: web.Request) -> web.Response:
154:     """Tauri Exit 핸들러에서 호출하는 graceful shutdown 엔드포인트."""
155:     import asyncio
156:     asyncio.get_event_loop().call_later(0.05, os._exit, 0)
157:     return web.Response(text="ok")
158: 
159: 
160: async def handle_control(request: web.Request) -> web.Response:
161:     try:
162:         body = await request.json()
163:     except Exception:
164:         return web.Response(status=400, text="invalid json")
165:     manager: RoasterManager = request.app["manager"]
166:     await manager.control(
167:         heater=body.get("heater"),
168:         fan=body.get("fan"),
169:         drum=body.get("drum"),
170:     )
171:     return web.json_response({"ok": True})
172: 
173: 
174: def _is_na(s: str) -> bool:
175:     return not s or s.lower() == "n/a"
176: 
177: 
178: async def handle_serial_ports(request: web.Request) -> web.Response:
179:     try:
180:         import serial.tools.list_ports  # type: ignore[import]
181: 
182:         ports = []
183:         for p in serial.tools.list_ports.comports():
184:             hwid = (p.hwid or "").strip()
185:             desc = (p.description or "").strip()
186:             if _is_na(hwid) and _is_na(desc):  # Bluetooth 가상 포트 제외
187:                 continue
188:             ports.append(
189:                 {
190:                     "device": p.device,
191:                     "description": desc if not _is_na(desc) else p.device,
192:                 }
193:             )
194:     except ImportError:
195:         ports = []
196:     return web.json_response(ports)
197: 
198: async def handle_debug_trace_get(request: web.Request) -> web.Response:
199:     entries = TRACE.dump()
200:     return web.json_response(
201:         {"enabled": TRACE.enabled, "count": len(entries), "entries": entries}
202:     )
203: 
204: 
205: async def handle_debug_trace_post(request: web.Request) -> web.Response:
206:     try:
207:         body: dict[str, Any] = await request.json()
208:     except Exception:
209:         return web.json_response({"error": "invalid JSON"}, status=400)
210:     if "enabled" in body:
211:         TRACE.enabled = bool(body["enabled"])
212:         _log.info("프로토콜 트레이스 %s", "ON" if TRACE.enabled else "OFF")
213:     if body.get("clear"):
214:         TRACE.clear()
215:     return web.json_response({"enabled": TRACE.enabled})
216: 
217: 
218: async def handle_debug_probe(request: web.Request) -> web.Response:
219:     """단발 원시 읽기 + 그 동안의 트레이스. Artisan A/B 비교용.
220: 
221:     probe 중 트레이스를 일시 활성화한다. probe 완료 후 트레이스 상태는 probe 시점의
222:     활성화 여부로 복원된다 (best-effort — 동시 /debug/trace POST 요청이 있으면 그 값이 우선).
223:     finally 블록을 쓰지 않는 이유: probe 예외를 숨기지 않기 위해 직접 복원한다.
224:     """
225:     manager: RoasterManager = request.app["manager"]
226:     prev_enabled = TRACE.enabled
227:     TRACE.enabled = True
228:     t0 = round(time.monotonic(), 4)
229:     result = await manager.probe()
230:     TRACE.enabled = prev_enabled  # best-effort restore; concurrent /debug/trace POST takes precedence
231:     result["trace"] = [e for e in TRACE.dump() if e["ts"] >= t0]
232:     return web.json_response(result)
233: 
234: 
235: # ---------------------------------------------------------------------------
236: # App factory
237: # ---------------------------------------------------------------------------
238: 
239: 
240: # Tauri 프론트엔드가 사용하는 origin 목록.
241: # macOS 번들: "tauri://localhost", Windows 번들: "http://tauri.localhost",
242: # dev(Vite): "http://localhost:1420"
243: _ALLOWED_ORIGINS = frozenset({
244:     "tauri://localhost",
245:     "http://tauri.localhost",
246:     "http://localhost:1420",
247: })
248: 
249: 
250: @web.middleware
251: async def cors_middleware(request: web.Request, handler: Any) -> web.Response:
252:     if request.method == "OPTIONS":
253:         resp = web.Response()
254:     else:
255:         resp = await handler(request)
256: 
257:     origin = request.headers.get("Origin", "")
258:     if origin in _ALLOWED_ORIGINS:
259:         resp.headers["Access-Control-Allow-Origin"] = origin
260:         # Chromium의 Private Network Access(LNA) 정책 대응 — preflight에서 요구됨
261:         resp.headers["Access-Control-Allow-Private-Network"] = "true"
262:     resp.headers["Access-Control-Allow-Methods"] = "GET, POST, OPTIONS"
263:     resp.headers["Access-Control-Allow-Headers"] = "Content-Type"
264:     return resp
265: 
266: 
267: def create_app() -> web.Application:
268:     app = web.Application(middlewares=[cors_middleware])
269:     app["manager"] = RoasterManager()
270: 
271:     async def _start_watchdog(app: web.Application) -> None:
272:         import asyncio
273:         pid_str = os.environ.get("SIDECAR_PARENT_PID")
274:         if pid_str:
275:             asyncio.create_task(parent_watchdog(int(pid_str)))
276: 
277:     app.on_startup.append(_start_watchdog)
278: 
279:     # 클라이언트는 src/entities/machine/roasterRegistry.ts (정적 복사본)를 사용.
280:     # GET /roasters는 현재 호출되지 않음 — 향후 단일화 시 활성화.
281:     app.router.add_get("/roasters", handle_roasters)
282:     app.router.add_get("/serial-ports", handle_serial_ports)
283:     app.router.add_get("/status", handle_status)
284:     app.router.add_post("/connect", handle_connect)
285:     app.router.add_post("/disconnect", handle_disconnect)
286:     app.router.add_get("/temperatures", handle_temperatures)
287:     app.router.add_post("/standby", handle_standby)
288:     app.router.add_post("/start", handle_start)
289:     app.router.add_post("/reset", handle_reset)
290:     app.router.add_post("/control", handle_control)
291:     app.router.add_get("/debug/trace", handle_debug_trace_get)
292:     app.router.add_post("/debug/trace", handle_debug_trace_post)
293:     app.router.add_get("/debug/probe", handle_debug_probe)
294:     app.router.add_post("/shutdown", handle_shutdown)
295:     app.router.add_route("OPTIONS", "/{path_info:.*}", lambda r: web.Response())
296:     return app
297: 
298: 
299: if __name__ == "__main__":
300:     _log.info("First Crack sidecar 시작 — http://127.0.0.1:9999")
301:     web.run_app(create_app(), host="127.0.0.1", port=9999, print=None)
</file>

<file path="AGENTS.md">
  1: # AGENTS.md
  2: 
  3: ## Project
  4: Roastery management desktop app (like Cropster): roast profile logging, roast history tracking, green bean inventory management.
  5: 
  6: ## External Services
  7: - Supabase: BaaS — auth, DB (roast records, inventory), Edge Functions (R2 presigned URL issuer)
  8: - R2: storage — roast profiles via presigned URL (upload/download issued by Supabase Edge Function; credentials never in client)
  9: - Slack webhook: CI/CD notifications only (build/release success/failure)
 10: 
 11: ## Security — Secrets
 12: - NO `VITE_*` prefix for any credential (access key, secret key, service role key) → bundled into client JS, extractable by anyone
 13: - R2/S3 uploads from frontend: NO direct credentials → presigned URL only, issued by Supabase Edge Function
 14: - presigned URL: short expiry (≤5min), scoped to single key, validate user owns the resource before issuing
 15: - if a `VITE_*` secret is ever found in code: rotate the credential immediately, don't just remove the line
 16: 
 17: # AGENT RULES
 18: - NO chat/greetings/summaries. Output ONLY precise code diffs (modified lines only).
 19: - Keep repomix-output.md updated via npx repomix --compress --remove-comments --remove-empty-lines --silent before/after code changes.- ALWAYS prefix all bash/shell commands with `rtk ` (e.g., `rtk ls`, `rtk git`, `rtk npm`).
 20: - [Exception] Omit `rtk ` prefix ONLY if output compression breaks error debugging.
 21: 
 22: ## Tauri v2
 23: - dev:1420 HMR:1421 | devUrl:localhost:1420 frontendDist:../dist
 24: - perms: src-tauri/capabilities/default.json
 25: - vite: ignore src-tauri/**
 26: 
 27: ## Sidecar
 28: - sidecar/server.py + drivers/ (MQTT,Modbus,Phidget,Roest)
 29: - cfg: sidecar/config/devices/**/*.json
 30: 
 31: ## UI
 32: - views/: History,ActiveRoast | widgets/: modals,sidebar | shared/ui/: primitives
 33: 
 34: 
 35: ## Design
 36: - shadow: multi-layer opacity<0.1, rgba(78,50,23,0.04)
 37: - font: Waldenburg 300 heading / Inter +0.14px body
 38: - NO emoji → Lucide | btn: radius:9999px
 39: - vars: DESIGN.md | tw utility > style prop
 40: 
 41: ## State
 42: server data→ReactQuery | settings→TauriStore(LazyStore) | CRUD lists→Zustand+persist | session→Zustand
 43: 
 44: - Store: single settings.json, key=`domain.field`, singleton LazyStore, high-freq writes debounce 200ms+save(), localStorage fallback
 45: - Zustand persist: key prefix=`fc_`, exclude fields→partialize, rehydrate→merge
 46: - Zustand pure: src/shared/store/*.ts | entities/<slice>/model.ts | NO persist: auth, roast session, sensors
 47: 
 48: ## Fetch
 49: ReactQuery+axios | NO useEffect fetch
 50: 
 51: - api.ts: raw axios | queries.ts: reads | use<X>.ts: writes
 52: - keyFactory: `{all, list(), detail(id)}`
 53: - mutation→invalidateQueries | NO refetch()
 54: - staleTime:Infinity(global) | axios singleton: shared/lib/axios.ts
 55: 
 56: ## FSD
 57: Unidirectional: shared → entities → features → widgets → views → app
 58: 
 59: ### Hook segment naming (per slice)
 60: model:domain logic/state(useAuth) | lib:pure infra util(useDebounce) | api:query/mutation wrap(useRoastQuery) | ui:render-only local state(useModalAnimation)
 61: mismatch→move to correct segment
 62: 
 63: ## SRP — all files (.ts/.tsx/.rs/.py)
 64: check: count reasons-to-change → 1=OK, >1=split
 65: size: >300L = re-check trigger, NOT the rule (50L file can still violate)
 66: 
 67: violations→split:
 68: - fetch+transform+render in 1 fn → 3 fns
 69: - hook w/ 2+ unrelated concerns (session+sensor) → 2 hooks
 70: - file importing 2+ unrelated domains (entities/roast+entities/auth) → split/move to shared
 71: - #[tauri::command] w/ inline multi-step orchestration → extract to domain fn, command=thin wrapper
 72: - component: fetch+form state+render all inline → container/presentational split or extract hook
 73: - views/*/components/* calling useQuery/useMutation/axios directly → move to entities or features
 74: 
 75: split naming: name=reason-to-change, NO utils.ts/helpers.ts
 76: 
 77: ### Layers
 78: | Layer     | Purpose                                              | Key files                              |
 79: |-----------|------------------------------------------------------|----------------------------------------|
 80: | shared/   | Generic utils, UI primitives — zero domain knowledge | lib/, ui/, store/                      |
 81: | entities/ | Domain models & server state                         | api.ts, queries.ts, model.ts, types.ts |
 82: | features/ | Single user action (one feature = one mutation)      | use<Action>.ts, UI                     |
 83: | widgets/  | Composed blocks from multiple features               | modals, sidebar                        |
 84: | views/    | Page-level composition only                          | History.tsx, ActiveRoast.tsx           |
 85: | app/      | Providers, router, global config                     | —                                      |
 86: 
 87: ### Rules
 88: - Upper → lower import: FORBIDDEN
 89: - entities ↔ entities direct import: FORBIDDEN (route through shared)
 90: - features → features direct import: FORBIDDEN (compose in widgets/views)
 91: - One slice = one responsibility; split if it grows
 92: 
 93: 
 94: ## Cross-Platform
 95: - CI: macOS arm64 only | x86_64+Windows: release-time only → don't trust CI for OS bugs
 96: - paths: pathlib.Path (py) / Tauri app.path() (rust) | NO hardcode `/`, `~/Library/...`, string-concat
 97: - env: NO assume HOME exists (unset on Windows) → Path.home() / platform-safe API
 98: - shortcuts: Tauri `mod+` notation only | NO hardcode Cmd+/Ctrl+
 99: - UI: NO custom titlebar/tray/window chrome → native OS UI only
100: - sidecar/native deps: no Windows sidecar binary built yet → serial/socket/driver code NOT Unix-path-assuming
101: 
102: - before tag: PR touched sidecar or path logic → manual full-matrix build first
</file>

<file path=".github/workflows/release.yml">
  1: name: Release
  2: 
  3: on:
  4:   push:
  5:     tags:
  6:       - 'v*'
  7:   workflow_dispatch:
  8:     inputs:
  9:       version:
 10:         description: 'Version to release (e.g. 1.0.2). Required when not triggered by a tag.'
 11:         required: false
 12: 
 13: permissions:
 14:   contents: read
 15:   actions: write
 16:   checks: read
 17: 
 18: jobs:
 19:   setup:
 20:     runs-on: ubuntu-latest
 21:     outputs:
 22:       version: ${{ steps.version.outputs.version }}
 23:     steps:
 24:       - name: Resolve version
 25:         id: version
 26:         run: |
 27:           if [ -n "${{ inputs.version }}" ]; then
 28:             VERSION="${{ inputs.version }}"
 29:           elif [[ "$GITHUB_REF_NAME" =~ ^v[0-9]+\.[0-9]+\.[0-9]+ ]]; then
 30:             VERSION="${GITHUB_REF_NAME#v}"
 31:           else
 32:             echo "::error::Cannot determine version. Push a semver tag (v*) or supply the 'version' input."
 33:             exit 1
 34:           fi
 35:           echo "version=$VERSION" >> $GITHUB_OUTPUT
 36:           echo "Resolved version: $VERSION"
 37: 
 38:   build:
 39:     needs: setup
 40:     runs-on: ${{ matrix.runner }}
 41:     strategy:
 42:       fail-fast: false
 43:       matrix:
 44:         include:
 45:           - runner: macos-latest
 46:             target: aarch64-apple-darwin
 47:           - runner: macos-15-intel
 48:             target: x86_64-apple-darwin
 49:           - runner: windows-latest
 50:             target: x86_64-pc-windows-msvc
 51: 
 52:     defaults:
 53:       run:
 54:         shell: bash
 55: 
 56:     steps:
 57:       - uses: actions/checkout@v4
 58: 
 59:       - name: Check CI status before building
 60:         env:
 61:           GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
 62:         run: |
 63:           echo "Checking CI status for commit ${GITHUB_SHA}..."
 64:           RESPONSE=$(gh api "repos/${{ github.repository }}/commits/${GITHUB_SHA}/check-runs" \
 65:             --jq '[.check_runs[] | select(.name == "typecheck" or .name == "lint" or .name == "sidecar")]')
 66:           TOTAL=$(echo "$RESPONSE" | jq 'length')
 67:           FAILED=$(echo "$RESPONSE" | jq '[.[] | select(.conclusion != "success")] | length')
 68: 
 69:           echo "CI checks found: $TOTAL"
 70:           echo "$RESPONSE" | jq -r '.[] | "  \(.name): \(.conclusion)"'
 71: 
 72:           if [ "$TOTAL" -eq 0 ]; then
 73:             echo "::warning::No CI checks found for this commit. Proceeding anyway."
 74:           elif [ "$FAILED" -gt 0 ]; then
 75:             echo "::error::$FAILED CI check(s) failed. Release aborted to prevent wasted resources."
 76:             exit 1
 77:           else
 78:             echo "✅ All CI checks passed."
 79:           fi
 80: 
 81:       - name: Validate required secrets
 82:         env:
 83:           TAURI_KEY:     ${{ secrets.TAURI_SIGNING_PRIVATE_KEY }}
 84:           TAURI_KEY_PW:  ${{ secrets.TAURI_SIGNING_PRIVATE_KEY_PASSWORD }}
 85:           SUPABASE_URL:  ${{ secrets.VITE_SUPABASE_URL }}
 86:           SUPABASE_ANON: ${{ secrets.VITE_SUPABASE_ANON_KEY }}
 87:           APPLE_CERT:    ${{ secrets.APPLE_CERTIFICATE }}
 88:           APPLE_CERT_PW: ${{ secrets.APPLE_CERTIFICATE_PASSWORD }}
 89:           APPLE_IDENTITY: ${{ secrets.APPLE_SIGNING_IDENTITY }}
 90:           APPLE_ID:      ${{ secrets.APPLE_ID }}
 91:           APPLE_PW:      ${{ secrets.APPLE_PASSWORD }}
 92:           APPLE_TEAM:    ${{ secrets.APPLE_TEAM_ID }}
 93:         run: |
 94:           missing=false
 95:           check() {
 96:             if [ -z "${!1}" ]; then
 97:               echo "  MISSING: $2"
 98:               missing=true
 99:             fi
100:           }
101: 
102:           echo "Checking shared secrets..."
103:           check TAURI_KEY        "TAURI_SIGNING_PRIVATE_KEY"
104:           check TAURI_KEY_PW     "TAURI_SIGNING_PRIVATE_KEY_PASSWORD"
105:           check SUPABASE_URL     "VITE_SUPABASE_URL"
106:           check SUPABASE_ANON    "VITE_SUPABASE_ANON_KEY"
107: 
108:           if [ "$RUNNER_OS" = "macOS" ]; then
109:             echo "Checking macOS signing secrets..."
110:             check APPLE_CERT      "APPLE_CERTIFICATE"
111:             check APPLE_CERT_PW   "APPLE_CERTIFICATE_PASSWORD"
112:             check APPLE_IDENTITY  "APPLE_SIGNING_IDENTITY"
113:             check APPLE_ID        "APPLE_ID"
114:             check APPLE_PW        "APPLE_PASSWORD"
115:             check APPLE_TEAM      "APPLE_TEAM_ID"
116:           fi
117: 
118:           if [ "$missing" = "true" ]; then
119:             echo "::error::One or more required secrets are missing – aborting before build."
120:             exit 1
121:           fi
122:           echo "All required secrets present."
123: 
124:       - uses: pnpm/action-setup@v4
125: 
126:       - uses: actions/setup-node@v4
127:         with:
128:           node-version: 22
129:           cache: pnpm
130: 
131:       - name: Install Rust
132:         uses: dtolnay/rust-toolchain@stable
133:         with:
134:           targets: ${{ matrix.target }}
135: 
136:       - name: Rust cache
137:         uses: swatinem/rust-cache@v2
138:         with:
139:           workspaces: src-tauri
140:           shared-key: rust-${{ matrix.target }}
141:           save-if: ${{ github.ref == 'refs/heads/main' }}
142: 
143:       - name: Install frontend deps
144:         run: pnpm install
145: 
146:       - name: Cache sidecar binary
147:         id: sidecar-cache
148:         uses: actions/cache@v4
149:         with:
150:           path: src-tauri/binaries
151:           key: sidecar-${{ matrix.target }}-${{ hashFiles('src-tauri/sidecar/requirements.txt', 'src-tauri/sidecar/**/*.py', 'src-tauri/sidecar/sidecar.spec') }}
152: 
153:       - name: Set up Python
154:         if: steps.sidecar-cache.outputs.cache-hit != 'true'
155:         uses: actions/setup-python@v5
156:         with:
157:           python-version: '3.13'
158:           cache: pip
159:           cache-dependency-path: src-tauri/sidecar/requirements.txt
160: 
161:       - name: Install sidecar dependencies
162:         if: steps.sidecar-cache.outputs.cache-hit != 'true'
163:         run: pip install pyinstaller -r src-tauri/sidecar/requirements.txt
164: 
165:       - name: Build sidecar binary
166:         if: steps.sidecar-cache.outputs.cache-hit != 'true'
167:         run: npm run build:sidecar
168: 
169:       - name: Build Tauri app
170:         uses: tauri-apps/tauri-action@v0
171:         env:
172:           GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
173:           TAURI_SIGNING_PRIVATE_KEY: ${{ secrets.TAURI_SIGNING_PRIVATE_KEY }}
174:           TAURI_SIGNING_PRIVATE_KEY_PASSWORD: ${{ secrets.TAURI_SIGNING_PRIVATE_KEY_PASSWORD }}
175:           VITE_SUPABASE_URL: ${{ secrets.VITE_SUPABASE_URL }}
176:           VITE_SUPABASE_ANON_KEY: ${{ secrets.VITE_SUPABASE_ANON_KEY }}
177:           PUBLIC_SITE_URL: https://your-domain.com
178:           PUBLIC_TAURI_REDIRECT: firstcrack://auth/callback
179:           CARGO_INCREMENTAL: "0"
180:           RUSTFLAGS: "-C debuginfo=0"
181:           CARGO_NET_RETRY: "3"
182:           CARGO_NET_GIT_FETCH_WITH_CLI: "true"
183:           APPLE_CERTIFICATE: ${{ secrets.APPLE_CERTIFICATE }}
184:           APPLE_CERTIFICATE_PASSWORD: ${{ secrets.APPLE_CERTIFICATE_PASSWORD }}
185:           APPLE_SIGNING_IDENTITY: ${{ secrets.APPLE_SIGNING_IDENTITY }}
186:           APPLE_ID: ${{ secrets.APPLE_ID }}
187:           APPLE_PASSWORD: ${{ secrets.APPLE_PASSWORD }}
188:           APPLE_TEAM_ID: ${{ secrets.APPLE_TEAM_ID }}
189:         with:
190:           args: --target ${{ matrix.target }}
191: 
192:       - name: Upload macOS artifacts
193:         if: runner.os == 'macOS'
194:         uses: actions/upload-artifact@v4
195:         with:
196:           name: macos-${{ matrix.target }}
197:           path: |
198:             src-tauri/target/${{ matrix.target }}/release/bundle/dmg/*.dmg
199:             src-tauri/target/${{ matrix.target }}/release/bundle/macos/*.app.tar.gz
200:             src-tauri/target/${{ matrix.target }}/release/bundle/macos/*.app.tar.gz.sig
201:           retention-days: 1
202: 
203:       - name: Upload Windows artifacts
204:         if: runner.os == 'Windows'
205:         uses: actions/upload-artifact@v4
206:         with:
207:           name: windows-${{ matrix.target }}
208:           path: |
209:             src-tauri/target/${{ matrix.target }}/release/bundle/msi/*.msi
210:             src-tauri/target/${{ matrix.target }}/release/bundle/msi/*.msi.sig
211:           retention-days: 1
212: 
213:       - name: Notify build failure
214:         if: failure()
215:         env:
216:           SLACK_WEBHOOK: ${{ secrets.VITE_SLACK_WEBHOOK_URL }}
217:         run: |
218:           if [ -n "$SLACK_WEBHOOK" ]; then
219:             curl -s -X POST -H 'Content-type: application/json' "$SLACK_WEBHOOK" \
220:               --data "{\"text\":\":x: *Release build FAILED* — \`${GITHUB_REF_NAME}\` | \`${{ matrix.target }}\` | <${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}|View run>\"}"
221:           else
222:             echo "VITE_SLACK_WEBHOOK_URL not set — skipping notification"
223:           fi
224: 
225:   notify-build:
226:     needs: [setup, build]
227:     if: success()
228:     runs-on: ubuntu-latest
229:     steps:
230:       - name: Notify build success
231:         env:
232:           SLACK_WEBHOOK: ${{ secrets.VITE_SLACK_WEBHOOK_URL }}
233:           VERSION: ${{ needs.setup.outputs.version }}
234:         run: |
235:           if [ -n "$SLACK_WEBHOOK" ]; then
236:             curl -s -X POST -H 'Content-type: application/json' "$SLACK_WEBHOOK" \
237:               --data "{\"text\":\":white_check_mark: *Release build succeeded* — v${VERSION} (macOS arm64/x64 + Windows) | <${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}|View run>\"}"
238:           else
239:             echo "VITE_SLACK_WEBHOOK_URL not set — skipping notification"
240:           fi
241: 
242:   publish-r2:
243:     needs: [setup, build]
244:     permissions:
245:       contents: read
246:       actions: read
247:     uses: ./.github/workflows/_publish-r2-reusable.yml
248:     with:
249:       version: ${{ needs.setup.outputs.version }}
250:     secrets: inherit
251: 
252:   cleanup-artifacts:
253:     needs: [publish-r2]
254:     if: success()
255:     runs-on: ubuntu-latest
256:     permissions:
257:       actions: write
258:     steps:
259:       - name: Delete release build artifacts
260:         env:
261:           GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
262:         run: |
263:           for name in \
264:             "macos-aarch64-apple-darwin" \
265:             "macos-x86_64-apple-darwin" \
266:             "windows-x86_64-pc-windows-msvc"
267:           do
268:             id=$(gh api "repos/${{ github.repository }}/actions/runs/${{ github.run_id }}/artifacts" \
269:               --jq ".artifacts[] | select(.name == \"$name\") | .id")
270:             if [ -n "$id" ]; then
271:               gh api -X DELETE "repos/${{ github.repository }}/actions/artifacts/$id"
272:               echo "Deleted artifact: $name (id: $id)"
273:             else
274:               echo "Artifact not found (already expired?): $name"
275:             fi
276:           done
</file>

<file path="src/entities/bean-stock-event/api.ts">
  1: import { expandRRuleInRange, formatDateLocal } from '@shared/lib/rrule';
  2: import { supabase } from '@shared/lib/supabase';
  3: import type { Database } from '@shared/types/database.types';
  4: 
  5: const RESERVATION_HORIZON_DAYS = 28; // 4 weeks — only count batches within this window
  6: 
  7: export type BeanStockEvent = Database['public']['Tables']['bean_stock_events']['Row'];
  8: export type BeanStockEventInsert = Database['public']['Tables']['bean_stock_events']['Insert'];
  9: 
 10: export type StockSummary = {
 11:     currentGrams: number;
 12:     reservedGrams: number;
 13:     effectiveGrams: number;
 14: };
 15: 
 16: export const beanStockEventApi = {
 17:     listByBean: async (beanId: string): Promise<BeanStockEvent[]> => {
 18:         const { data, error } = await supabase
 19:             .from('bean_stock_events')
 20:             .select('*')
 21:             .eq('bean_id', beanId)
 22:             .order('created_at', { ascending: false });
 23:         if (error) throw error;
 24:         return data ?? [];
 25:     },
 26: 
 27:     insert: async (event: BeanStockEventInsert): Promise<BeanStockEvent> => {
 28:         const { data, error } = await supabase.from('bean_stock_events').insert(event).select().single();
 29:         if (error) throw error;
 30:         return data!;
 31:     },
 32: 
 33:     /** Atomic batch insert via RPC — all events in one transaction. Idempotent: duplicate (reference_id, bean_id) pairs are silently skipped. */
 34:     insertMany: async (events: BeanStockEventInsert[]): Promise<void> => {
 35:         if (!events.length) return;
 36:         // eslint-disable-next-line @typescript-eslint/no-explicit-any
 37:         const { error } = await (supabase as any).rpc('insert_stock_events_batch', { p_events: events });
 38:         if (error) throw error;
 39:     },
 40: 
 41:     getCurrentStock: async (beanId: string): Promise<number> => {
 42:         const { data, error } = await supabase.from('bean_stock_events').select('delta_grams').eq('bean_id', beanId);
 43:         if (error) throw error;
 44:         return (data ?? []).reduce((sum, e) => sum + e.delta_grams, 0);
 45:     },
 46: 
 47:     getReservedStock: async (beanId: string): Promise<number> => {
 48:         const today = new Date();
 49:         today.setHours(0, 0, 0, 0);
 50:         const horizon = new Date(today);
 51:         horizon.setDate(horizon.getDate() + RESERVATION_HORIZON_DAYS);
 52:         const todayStr = formatDateLocal(today);
 53:         const horizonStr = formatDateLocal(horizon);
 54: 
 55:         // ── 1. Materialized batches (one-off + exception rows) within horizon ──
 56:         const { data: batches, error: batchErr } = await supabase
 57:             .from('roast_plan_batches')
 58:             .select('id, batch_size_kg, batch_count, recurrence_rule_id, original_date')
 59:             .eq('bean_id', beanId)
 60:             .in('status', ['pending', 'in-progress'])
 61:             .or(`scheduled_date.is.null,scheduled_date.lte.${horizonStr}`);
 62:         if (batchErr) throw batchErr;
 63: 
 64:         const batchIds = (batches ?? []).map((b) => b.id);
 65:         const completedMap = new Map<string, number>();
 66:         if (batchIds.length) {
 67:             const { data: sessions, error: sessErr } = await supabase
 68:                 .from('roast_sessions')
 69:                 .select('plan_batch_id')
 70:                 .in('plan_batch_id', batchIds);
 71:             if (sessErr) throw sessErr;
 72:             for (const s of sessions ?? []) {
 73:                 if (s.plan_batch_id) completedMap.set(s.plan_batch_id, (completedMap.get(s.plan_batch_id) ?? 0) + 1);
 74:             }
 75:         }
 76: 
 77:         const materializedReserved = (batches ?? []).reduce((sum, b) => {
 78:             const remaining = Math.max(0, b.batch_count - (completedMap.get(b.id) ?? 0));
 79:             return sum + remaining * b.batch_size_kg * 1000;
 80:         }, 0);
 81: 
 82:         // ── 2. Virtual recurring instances within horizon ──
 83:         const { data: rules, error: ruleErr } = await supabase
 84:             .from('recurrence_rules')
 85:             .select('id, rrule, dtstart, batch_size_kg, target_roasted_kg, yield_pct')
 86:             .eq('bean_id', beanId)
 87:             .eq('status', 'active');
 88:         if (ruleErr) throw ruleErr;
 89:         if (!rules?.length) return materializedReserved;
 90: 
 91:         // Build excluded original_dates per rule:
 92:         // - modified exceptions (already in materialized total)
 93:         // - cancelled exceptions (must not generate a virtual slot)
 94:         // Keyed by original_date (local string) to match RRULE expansion output.
 95:         const excludedByRule = new Map<string, Set<string>>();
 96:         for (const b of batches ?? []) {
 97:             if (b.recurrence_rule_id && b.original_date) {
 98:                 if (!excludedByRule.has(b.recurrence_rule_id)) excludedByRule.set(b.recurrence_rule_id, new Set());
 99:                 excludedByRule.get(b.recurrence_rule_id)!.add(b.original_date);
100:             }
101:         }
102:         // Fetch cancelled exception rows by original_date range (M-2: use original_date not scheduled_date
103:         // so "moved outside horizon" instances are still excluded from virtual expansion)
104:         const ruleIds = rules.map((r) => r.id);
105:         const { data: cancelledRows } = await supabase
106:             .from('roast_plan_batches')
107:             .select('recurrence_rule_id, original_date')
108:             .in('recurrence_rule_id', ruleIds)
109:             .eq('exception_type', 'cancelled') // M-1: cancelled only
110:             .gte('original_date', todayStr)
111:             .lte('original_date', horizonStr);
112:         for (const b of cancelledRows ?? []) {
113:             if (b.recurrence_rule_id && b.original_date) {
114:                 if (!excludedByRule.has(b.recurrence_rule_id)) excludedByRule.set(b.recurrence_rule_id, new Set());
115:                 excludedByRule.get(b.recurrence_rule_id)!.add(b.original_date);
116:             }
117:         }
118: 
119:         let virtualReserved = 0;
120:         for (const rule of rules) {
121:             let dates: Date[];
122:             try {
123:                 dates = expandRRuleInRange(rule.rrule, new Date(rule.dtstart), today, horizon);
124:             } catch {
125:                 continue; // skip corrupt rrule; don't crash the whole summary
126:             }
127:             const excluded = excludedByRule.get(rule.id) ?? new Set<string>();
128:             // C-1: use formatDateLocal (local tz) not toISOString (UTC) to match DB original_date strings
129:             const virtualDates = dates.filter((d) => !excluded.has(formatDateLocal(d)));
130:             if (!virtualDates.length) continue;
131:             const batchSize = Number(rule.batch_size_kg) || 0;
132:             const targetKg = Number(rule.target_roasted_kg) || 0;
133:             const yieldPct = Number(rule.yield_pct) > 0 ? Number(rule.yield_pct) : 1;
134:             const roastedPerBatch = batchSize * yieldPct;
135:             const batchCount = roastedPerBatch > 0 && targetKg > 0 ? Math.ceil(targetKg / roastedPerBatch) : 1;
136:             virtualReserved += virtualDates.length * batchCount * batchSize * 1000;
137:         }
138: 
139:         return materializedReserved + virtualReserved;
140:     },
141: 
142:     getStockSummary: async (beanId: string): Promise<StockSummary> => {
143:         const [currentGrams, reservedGrams] = await Promise.all([
144:             beanStockEventApi.getCurrentStock(beanId),
145:             beanStockEventApi.getReservedStock(beanId),
146:         ]);
147:         return {
148:             currentGrams,
149:             reservedGrams,
150:             effectiveGrams: currentGrams - reservedGrams,
151:         };
152:     },
153: 
154:     /** 배치: user의 모든 bean에 대한 재고 요약을 beanId→StockSummary 맵으로 반환 */
155:     getStockSummariesByUser: async (userId: string): Promise<Record<string, StockSummary>> => {
156:         const { data: beans } = await supabase.from('beans').select('id').eq('user_id', userId);
157:         if (!beans?.length) return {};
158: 
159:         const beanIds = beans.map((b) => b.id);
160: 
161:         const today = new Date();
162:         today.setHours(0, 0, 0, 0);
163:         const horizon = new Date(today);
164:         horizon.setDate(horizon.getDate() + RESERVATION_HORIZON_DAYS);
165:         const todayStr = formatDateLocal(today);
166:         const horizonStr = formatDateLocal(horizon);
167: 
168:         const [currentRes, reservedRes, rulesRes] = await Promise.all([
169:             supabase.from('bean_stock_events').select('bean_id, delta_grams').in('bean_id', beanIds),
170:             supabase
171:                 .from('roast_plan_batches')
172:                 .select('id, bean_id, batch_size_kg, batch_count, recurrence_rule_id, original_date')
173:                 .in('bean_id', beanIds)
174:                 .in('status', ['pending', 'in-progress'])
175:                 .or(`scheduled_date.is.null,scheduled_date.lte.${horizonStr}`),
176:             supabase
177:                 .from('recurrence_rules')
178:                 .select('id, bean_id, rrule, dtstart, batch_size_kg, target_roasted_kg, yield_pct')
179:                 .eq('user_id', userId)
180:                 .eq('status', 'active')
181:                 .not('bean_id', 'is', null),
182:         ]);
183: 
184:         if (currentRes.error) throw currentRes.error;
185:         if (reservedRes.error) throw reservedRes.error;
186:         if (rulesRes.error) throw rulesRes.error;
187: 
188:         const currentMap: Record<string, number> = {};
189:         for (const e of currentRes.data ?? []) {
190:             currentMap[e.bean_id] = (currentMap[e.bean_id] ?? 0) + e.delta_grams;
191:         }
192: 
193:         // ── Materialized batches ──
194:         const pendingBatchIds = (reservedRes.data ?? []).map((b) => b.id);
195:         const sessionCountMap = new Map<string, number>();
196:         if (pendingBatchIds.length) {
197:             const { data: sessions, error: sessErr } = await supabase
198:                 .from('roast_sessions')
199:                 .select('plan_batch_id')
200:                 .in('plan_batch_id', pendingBatchIds);
201:             if (sessErr) throw sessErr;
202:             for (const s of sessions ?? []) {
203:                 if (s.plan_batch_id)
204:                     sessionCountMap.set(s.plan_batch_id, (sessionCountMap.get(s.plan_batch_id) ?? 0) + 1);
205:             }
206:         }
207: 
208:         const reservedMap: Record<string, number> = {};
209:         for (const b of reservedRes.data ?? []) {
210:             if (!b.bean_id) continue;
211:             const remaining = Math.max(0, b.batch_count - (sessionCountMap.get(b.id) ?? 0));
212:             reservedMap[b.bean_id] = (reservedMap[b.bean_id] ?? 0) + remaining * b.batch_size_kg * 1000;
213:         }
214: 
215:         // ── Virtual recurring instances within horizon ──
216:         if (rulesRes.data?.length) {
217:             // Build excluded original_dates per rule (already covered by materialized rows)
218:             const excludedByRule = new Map<string, Set<string>>();
219:             for (const b of reservedRes.data ?? []) {
220:                 if (b.recurrence_rule_id && b.original_date) {
221:                     if (!excludedByRule.has(b.recurrence_rule_id)) excludedByRule.set(b.recurrence_rule_id, new Set());
222:                     excludedByRule.get(b.recurrence_rule_id)!.add(b.original_date);
223:                 }
224:             }
225:             // Fetch cancelled exception rows by original_date range (M-2: original_date not scheduled_date
226:             // so instances moved outside horizon are still excluded from virtual expansion)
227:             const ruleIds = rulesRes.data.map((r) => r.id);
228:             const { data: cancelledRows } = await supabase
229:                 .from('roast_plan_batches')
230:                 .select('recurrence_rule_id, original_date')
231:                 .in('recurrence_rule_id', ruleIds)
232:                 .eq('exception_type', 'cancelled') // M-1: cancelled only
233:                 .gte('original_date', todayStr)
234:                 .lte('original_date', horizonStr);
235:             for (const b of cancelledRows ?? []) {
236:                 if (b.recurrence_rule_id && b.original_date) {
237:                     if (!excludedByRule.has(b.recurrence_rule_id)) excludedByRule.set(b.recurrence_rule_id, new Set());
238:                     excludedByRule.get(b.recurrence_rule_id)!.add(b.original_date);
239:                 }
240:             }
241: 
242:             for (const rule of rulesRes.data) {
243:                 if (!rule.bean_id) continue;
244:                 let dates: Date[];
245:                 try {
246:                     dates = expandRRuleInRange(rule.rrule, new Date(rule.dtstart), today, horizon);
247:                 } catch {
248:                     continue; // skip corrupt rrule; don't crash the whole summary
249:                 }
250:                 const excluded = excludedByRule.get(rule.id) ?? new Set<string>();
251:                 // C-1: formatDateLocal (local tz) to match DB original_date strings
252:                 const virtualDates = dates.filter((d) => !excluded.has(formatDateLocal(d)));
253:                 if (!virtualDates.length) continue;
254:                 const batchSize = Number(rule.batch_size_kg) || 0;
255:                 const targetKg = Number(rule.target_roasted_kg) || 0;
256:                 const yieldPct = Number(rule.yield_pct) > 0 ? Number(rule.yield_pct) : 1;
257:                 const roastedPerBatch = batchSize * yieldPct;
258:                 const batchCount = roastedPerBatch > 0 && targetKg > 0 ? Math.ceil(targetKg / roastedPerBatch) : 1;
259:                 reservedMap[rule.bean_id] =
260:                     (reservedMap[rule.bean_id] ?? 0) + virtualDates.length * batchCount * batchSize * 1000;
261:             }
262:         }
263: 
264:         const result: Record<string, StockSummary> = {};
265:         for (const id of beanIds) {
266:             const currentGrams = currentMap[id] ?? 0;
267:             const reservedGrams = reservedMap[id] ?? 0;
268:             result[id] = { currentGrams, reservedGrams, effectiveGrams: currentGrams - reservedGrams };
269:         }
270:         return result;
271:     },
272: };
</file>

