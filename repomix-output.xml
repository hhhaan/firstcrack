246:                                     onClick={() => col.sortable && col.key && onSort(col.key as SortKey)}
247:                                     className={`px-3 py-3 text-left text-[11px] font-medium uppercase tracking-[0.5px] text-muted select-none whitespace-nowrap ${responsiveClass} ${col.sortable ? 'cursor-pointer' : 'cursor-default'}`}
248:                                     style={{ width: col.width }}
