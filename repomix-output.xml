392:     }, [charged, rawBT, triggerCharge, setConnected, disableAutoCharge]);
393: 
394:     /** 로스팅을 처음 상태로 되돌린다. 사이드카가 연결되어 있으면 예열 단계로 재진입 */
395:     const resetActiveRoast = () => {
