131:             const orderIndex = batch.order_index ?? previousDayBatches?.length ?? previousPlanBatches?.length ?? 0;
132:             const optimistic: PlanBatchWithProgress = {
133:                 id: `__optimistic__${Date.now()}`,
134:                 plan_id: batch.plan_id,
135:                 bean_name: batch.bean_name,
136:                 bean_id: batch.bean_id ?? null,
137:                 blend_id: batch.blend_id ?? null,
138:                 batch_type: batch.batch_type ?? '',
139:                 batch_size_kg: batch.batch_size_kg,
140:                 target_roasted_kg: batch.target_roasted_kg,
141:                 batch_count: Math.ceil(batch.target_roasted_kg / batch.batch_size_kg),
142:                 yield_pct: batch.yield_pct ?? 1,
143:                 order_index: orderIndex,
144:                 machine_id: batch.machine_id ?? null,
145:                 roast_profile_id: batch.roast_profile_id ?? null,
