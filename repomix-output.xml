<file path="src/shared/lib/rrule.ts">
  1: import { Frequency, RRule } from 'rrule';
  2: 
  3: /**
  4:  * Recurrence interval types mapped to RFC 5545 FREQ values.
  5:  */
  6: export type RecurrenceInterval = 'daily' | 'weekly' | 'biweekly' | 'monthly';
  7: 
  8: /**
  9:  * Map RecurrenceInterval to RRule Frequency.
 10:  */
 11: const intervalToFreq: Record<RecurrenceInterval, Frequency> = {
 12:     daily: Frequency.DAILY,
 13:     weekly: Frequency.WEEKLY,
 14:     biweekly: Frequency.WEEKLY,
 15:     monthly: Frequency.MONTHLY,
 16: };
 17: 
 18: /**
 19:  * Build an RFC 5545 RRULE string from simplified UI parameters.
 20:  *
 21:  * @param interval - The recurrence interval (daily, weekly, biweekly, monthly)
 22:  * @param options - Optional: until date or count limit
 23:  * @returns RFC 5545 RRULE string
 24:  */
 25: export function buildRRule(interval: RecurrenceInterval, options?: { until?: Date; count?: number }): string {
 26:     const rruleOptions: Partial<RRuleOptions> = {
 27:         freq: intervalToFreq[interval],
 28:     };
 29: 
 30:     if (interval === 'biweekly') {
 31:         rruleOptions.interval = 2;
 32:     }
 33: 
 34:     if (options?.count && options.count > 0) {
 35:         rruleOptions.count = options.count;
 36:     } else if (options?.until) {
 37:         // UNTIL in RRULE is exclusive — set to end of day for inclusive behavior
 38:         const until = new Date(options.until);
 39:         until.setHours(23, 59, 59, 999);
 40:         rruleOptions.until = until;
 41:     }
 42: 
 43:     // Convert to RFC 5545 string via RRule helper
 44:     // optionsToString returns "RULE:FREQ=..." — strip the "RULE:" prefix
 45:     return RRule.optionsToString(rruleOptions as RRuleOptions).replace(/^RULE:/, '');
 46: }
 47: 
 48: /**
 49:  * Expand an RFC 5545 RRULE string into an array of Date occurrences.
 50:  *
 51:  * @param rruleStr - RFC 5545 RRULE string (e.g. "FREQ=WEEKLY;INTERVAL=2;COUNT=4")
 52:  * @param dtstart - The start date to anchor the recurrence
 53:  * @returns Array of Date objects in local time, normalized to 00:00:00
 54:  */
 55: export function expandRRule(rruleStr: string, dtstart: Date): Date[] {
 56:     const dtstartLocal = new Date(dtstart);
 57:     dtstartLocal.setHours(0, 0, 0, 0);
 58: 
 59:     const rule = RRule.fromString(rruleStr);
 60:     const allDates = rule
 61:         .between(
 62:             dtstartLocal,
 63:             new Date(dtstartLocal.getTime() + 365 * 24 * 60 * 60 * 1000),
 64:             true, // inclusive
 65:         )
 66:         .map((d) => {
 67:             // Normalize to local midnight
 68:             const local = new Date(d);
 69:             local.setHours(0, 0, 0, 0);
 70:             return local;
 71:         });
 72: 
 73:     // Deduplicate by date string
 74:     const seen = new Set<string>();
 75:     return allDates.filter((d) => {
 76:         const key = `${d.getFullYear()}-${d.getMonth()}-${d.getDate()}`;
 77:         if (seen.has(key)) return false;
 78:         seen.add(key);
 79:         return true;
 80:     });
 81: }
 82: 
 83: /**
 84:  * Expand an RRULE string for dates within a specific range.
 85:  * This is the rendering-time variant — used instead of expanding everything at creation.
 86:  *
 87:  * @param rruleStr - RFC 5545 RRULE string
 88:  * @param dtstart - Recurrence start date
 89:  * @param rangeStart - Range lower bound (inclusive)
 90:  * @param rangeEnd - Range upper bound (inclusive)
 91:  * @returns Array of Date objects within the range
 92:  */
 93: export function expandRRuleInRange(rruleStr: string, dtstart: Date, rangeStart: Date, rangeEnd: Date): Date[] {
 94:     const dtstartLocal = new Date(dtstart);
 95:     dtstartLocal.setHours(0, 0, 0, 0);
 96: 
 97:     // Clamp rangeStart to dtstart (no point expanding before the rule starts)
 98:     const from = dtstartLocal > rangeStart ? dtstartLocal : new Date(rangeStart);
 99:     from.setHours(0, 0, 0, 0);
100: 
101:     const to = new Date(rangeEnd);
102:     to.setHours(23, 59, 59, 999);
103: 
104:     const rule = RRule.fromString(rruleStr);
105:     return rule.between(from, to, true).map((d) => {
106:         const local = new Date(d);
107:         local.setHours(0, 0, 0, 0);
108:         return local;
109:     });
110: }
111: 
112: /**
113:  * Exception row from roast_plan_batches for a recurring rule.
114:  */
115: export interface RecurrenceException {
116:     original_date: string; // The original recurrence date (ISO date string)
117:     scheduled_date: string; // Actual date (may differ from original if moved)
118:     exception_type: 'modified' | 'cancelled';
119:     // Overrides: if 'modified', these fields replace the master's values
120:     batch_size_kg?: number;
121:     target_roasted_kg?: number;
122:     bean_id?: string | null;
123:     bean_name?: string;
124:     machine_id?: string | null;
125:     roast_profile_id?: string | null;
126:     notes?: string;
127:     status?: string;
128:     [key: string]: unknown;
129: }
130: 
131: /**
132:  * Merged recurrence instance — combines master rule data with any exception overrides.
133:  */
134: export interface RecurrenceInstance {
135:     date: string; // ISO date string (yyyy-MM-dd)
136:     originalDate: string; // The original recurrence date
137:     exceptionType: 'normal' | 'modified' | 'cancelled';
138:     exception?: RecurrenceException; // Only present if modified or cancelled
139: }
140: 
141: /**
142:  * Merge expanded recurrence dates with exception rows.
143:  * - cancelled → excluded from result
144:  * - modified → instance data is overridden by the exception row
145:  * - no exception → normal instance
146:  *
147:  * @param expandedDates - Array of Date objects from expandRRule / expandRRuleInRange
148:  * @param exceptions - Array of exception rows from DB
149:  * @returns Merged instances (cancelled ones filtered out)
150:  */
151: export function mergeRecurrenceExceptions(
152:     expandedDates: Date[],
153:     exceptions: RecurrenceException[],
154: ): RecurrenceInstance[] {
155:     // Build exception map keyed by original_date
156:     const exceptionMap = new Map<string, RecurrenceException>();
157:     for (const ex of exceptions) {
158:         exceptionMap.set(ex.original_date, ex);
159:     }
160: 
161:     const result: RecurrenceInstance[] = [];
162: 
163:     for (const date of expandedDates) {
164:         const dateStr = formatDateLocal(date);
165:         const ex = exceptionMap.get(dateStr);
166: 
167:         if (ex?.exception_type === 'cancelled') {
168:             // Skip cancelled instances
169:             continue;
170:         }
171: 
172:         result.push({
173:             date: dateStr,
174:             originalDate: dateStr,
175:             exceptionType: ex?.exception_type === 'modified' ? 'modified' : 'normal',
176:             exception: ex?.exception_type === 'modified' ? ex : undefined,
177:         });
178:     }
179: 
180:     // Also include exceptions whose original_date falls outside the expanded range
181:     // but has a scheduled_date that's been moved to a different date
182:     for (const ex of exceptions) {
183:         if (ex.exception_type === 'modified') {
184:             const matched = result.find((r) => r.originalDate === ex.original_date);
185:             if (!matched) {
186:                 // This is a moved instance — include it with the scheduled_date
187:                 result.push({
188:                     date: ex.scheduled_date,
189:                     originalDate: ex.original_date,
190:                     exceptionType: 'modified',
191:                     exception: ex,
192:                 });
193:             }
194:         }
195:     }
196: 
197:     // Sort by date
198:     result.sort((a, b) => a.date.localeCompare(b.date));
199: 
200:     return result;
201: }
202: 
203: /**
204:  * Format a Date to yyyy-MM-dd in local timezone.
205:  */
206: export function formatDateLocal(d: Date): string {
207:     const y = d.getFullYear();
208:     const m = String(d.getMonth() + 1).padStart(2, '0');
209:     const day = String(d.getDate()).padStart(2, '0');
210:     return `${y}-${m}-${day}`;
211: }
212: 
213: /**
214:  * Preview recurrence: return a human-readable list of dates
215:  * based on the given interval and dtstart.
216:  */
217: export function previewRecurrenceDates(interval: RecurrenceInterval | null, dtstart: Date, limit: number = 5): Date[] {
218:     if (!interval) return [];
219:     const rruleStr = buildRRule(interval, { count: limit });
220:     return expandRRule(rruleStr, dtstart).slice(0, limit);
221: }
222: 
223: // ── Internal types ────────────────────────────────────────────────────────────
224: 
225: interface RRuleOptions {
226:     freq: Frequency;
227:     interval: number;
228:     count: number;
229:     until: Date;
230:     dtstart: Date;
231: }
</file>

