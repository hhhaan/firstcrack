<file path="src-tauri/sidecar/protocol_trace.py">
 1: """
 2: protocol_trace.py — 실기기 디버깅용 프로토콜 트레이스 (인메모리 링버퍼).
 3: 
 4: Artisan의 addserial()(Tx/Rx hex 덤프 로그)에 해당.
 5: 기본 OFF. POST /debug/trace 로 런타임 토글.
 6: 어댑터들은 모듈 싱글턴 TRACE를 import해 record()를 호출한다.
 7: S7처럼 executor 스레드에서 record()가 불려도 deque.append는 GIL 하에서
 8: 원자적이므로 별도 락이 필요 없다.
 9: """
10: import time
11: from collections import deque
12: from typing import Any
13: 
14: import config
15: 
16: 
17: class ProtocolTrace:
18:     def __init__(self, maxlen: int = config.TRACE_BUFFER_SIZE) -> None:
19:         self._buf: deque[dict[str, Any]] = deque(maxlen=maxlen)
20:         self.enabled: bool = False
21: 
22:     def record(self, direction: str, protocol: str, detail: str, data: Any = None) -> None:
23:         """direction: 'tx'|'rx'|'err'|'info'. data가 bytes면 hex 덤프로 변환."""
24:         if not self.enabled:
25:             return
26:         if isinstance(data, (bytes, bytearray)):
27:             data = data.hex(" ")
28:         self._buf.append(
29:             {
30:                 "ts": round(time.monotonic(), 4),
31:                 "dir": direction,
32:                 "protocol": protocol,
33:                 "detail": detail,
34:                 "data": data,
35:             }
36:         )
37: 
38:     def dump(self) -> list[dict[str, Any]]:
39:         return list(self._buf)
40: 
41:     def clear(self) -> None:
42:         self._buf.clear()
43: 
44: 
45: TRACE = ProtocolTrace()
</file>

