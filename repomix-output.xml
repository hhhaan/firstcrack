<file path="src/widgets/blend-list/ui/BlendCompositionBar.tsx">
 1: import type { BlendSegmentSource } from '@entities/blend/lib';
 2: 
 3: export const BLEND_SEGMENT_COLORS = [
 4:     'var(--color-palette-blue)',
 5:     'var(--color-palette-teal)',
 6:     'var(--color-palette-purple)',
 7:     'var(--color-palette-lavender)',
 8:     'var(--color-palette-green)',
 9:     'var(--color-palette-yellow)',
10: ] as const;
11: 
12: export type BlendCompositionSegment = {
13:     ratioPct: number;
14:     color: string;
15:     label?: string;
16:     id?: string;
17: };
18: 
19: export const coloredSegmentsFromSources = (sources: BlendSegmentSource[]): BlendCompositionSegment[] =>
20:     sources.map((source, i) => ({
21:         ...source,
22:         color: BLEND_SEGMENT_COLORS[i % BLEND_SEGMENT_COLORS.length],
23:     }));
24: 
25: const truncateLabel = (label: string, max = 12) => (label.length > max ? `${label.slice(0, max)}…` : label);
26: 
27: export const BlendCompositionBar = ({
28:     segments,
29:     height = 'sm',
30:     showLegend = false,
31: }: {
32:     segments: BlendCompositionSegment[];
33:     height?: 'sm' | 'md';
34:     showLegend?: boolean;
35: }) => {
36:     const total = segments.reduce((sum, s) => sum + s.ratioPct, 0);
37:     const barHeight = height === 'md' ? 'h-1.5' : 'h-1';
38: 
39:     return (
40:         <div>
41:             <div className={`${barHeight} flex rounded-full overflow-hidden bg-surface dark:bg-white/8`}>
42:                 {segments.map((seg) => (
43:                     <div
44:                         key={seg.id ?? `${seg.label}-${seg.ratioPct}`}
45:                         className="h-full transition-all"
46:                         style={{
47:                             width: total > 0 ? `${(seg.ratioPct / total) * 100}%` : '0%',
48:                             backgroundColor: seg.color,
49:                         }}
50:                     />
51:                 ))}
52:             </div>
53:             {showLegend && segments.length > 0 && (
54:                 <p className="text-[11px] text-muted tracking-[0.14px] mt-1.5 truncate">
55:                     {segments.map((seg) => `${truncateLabel(seg.label ?? '')} ${seg.ratioPct}%`).join(' · ')}
56:                 </p>
57:             )}
58:         </div>
59:     );
60: };
