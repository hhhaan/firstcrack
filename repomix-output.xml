814:                     interval: 20,
815:                 },
816:                 ...(hasPhaseBar
817:                     ? [
818:                           {
819:                               gridIndex: 1,
820:                               type: 'value' as const,
821:                               min: 0,
822:                               max: 1,
823:                               show: false,
824:                           },
