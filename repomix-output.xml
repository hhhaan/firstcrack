<file path="supabase/migrations/20260619000000_stock_events_idempotency.sql">
 1: -- Unique partial index: one roast event per (session, bean)
 2: -- Prevents double-deduction on retry without touching purchase events (reference_id IS NULL)
 3: CREATE UNIQUE INDEX bean_stock_events_reference_bean_unique
 4:   ON bean_stock_events(reference_id, bean_id)
 5:   WHERE reference_id IS NOT NULL;
 6: 
 7: -- Add write_off event type
 8: ALTER TABLE bean_stock_events
 9:   DROP CONSTRAINT IF EXISTS bean_stock_events_event_type_check;
10: 
11: ALTER TABLE bean_stock_events
12:   ADD CONSTRAINT bean_stock_events_event_type_check
13:   CHECK (event_type IN ('purchase', 'roast', 'adjustment', 'write_off'));
14: 
15: -- Atomic batch insert for blend deductions
16: -- SECURITY INVOKER: runs as the calling user, RLS is enforced
17: CREATE OR REPLACE FUNCTION insert_stock_events_batch(p_events jsonb)
18: RETURNS void
19: LANGUAGE plpgsql
20: SECURITY INVOKER
21: AS $$
22: BEGIN
23:   INSERT INTO bean_stock_events (user_id, bean_id, delta_grams, event_type, reference_id, note)
24:   SELECT
25:     (e->>'user_id')::uuid,
26:     (e->>'bean_id')::uuid,
27:     (e->>'delta_grams')::integer,
28:     (e->>'event_type')::text,
29:     NULLIF(e->>'reference_id', '')::uuid,
30:     NULLIF(e->>'note', '')
31:   FROM jsonb_array_elements(p_events) AS e
32:   ON CONFLICT (reference_id, bean_id) WHERE reference_id IS NOT NULL DO NOTHING;
33: END;
34: $$;
35: 
36: GRANT EXECUTE ON FUNCTION insert_stock_events_batch(jsonb) TO authenticated;
</file>

<file path="supabase/migrations/20260619000001_drop_legacy_inventory.sql">
1: -- Remove legacy inventory system replaced by bean_stock_events event-sourcing.
2: -- bean_inventory_logs: superseded by bean_stock_events
3: -- beans.stock_grams: superseded by SUM(delta_grams) from bean_stock_events
4: 
5: DROP TABLE IF EXISTS bean_inventory_logs;
6: 
7: ALTER TABLE beans DROP COLUMN IF EXISTS stock_grams;
