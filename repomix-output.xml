<file path="supabase/functions/_shared/r2.ts">
 1: import { GetObjectCommand, PutObjectCommand, S3Client } from 'npm:@aws-sdk/client-s3@3';
 2: import { getSignedUrl } from 'npm:@aws-sdk/s3-request-presigner@3';
 3: 
 4: const PRESIGN_EXPIRY_SEC = 300;
 5: const PROFILE_KEY_RE = /^profiles\/[0-9a-f-]{36}\/[0-9a-f-]{36}\.tsv$/;
 6: 
 7: export const isValidSessionId = (sessionId: string): boolean =>
 8:     /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(sessionId);
 9: 
10: export const profileKeyForUser = (userId: string, sessionId: string): string =>
11:     `profiles/${userId}/${sessionId}.tsv`;
12: 
13: export const isOwnedProfileKey = (key: string, userId: string): boolean =>
14:     PROFILE_KEY_RE.test(key) && key.startsWith(`profiles/${userId}/`);
15: 
16: const getR2Client = (): S3Client => {
17:     const accountId = Deno.env.get('R2_ACCOUNT_ID');
18:     const accessKeyId = Deno.env.get('R2_ACCESS_KEY_ID');
19:     const secretAccessKey = Deno.env.get('R2_SECRET_ACCESS_KEY');
20:     if (!accountId || !accessKeyId || !secretAccessKey) {
21:         throw new Error('R2 credentials are not configured');
22:     }
23:     return new S3Client({
24:         region: 'auto',
25:         endpoint: `https://${accountId}.r2.cloudflarestorage.com`,
26:         credentials: { accessKeyId, secretAccessKey },
27:     });
28: };
29: 
30: const getBucket = (): string => {
31:     const bucket = Deno.env.get('R2_BUCKET_NAME');
32:     if (!bucket) throw new Error('R2_BUCKET_NAME is not configured');
33:     return bucket;
34: };
35: 
36: export const presignUploadUrl = async (userId: string, sessionId: string): Promise<string> => {
37:     const key = profileKeyForUser(userId, sessionId);
38:     return getSignedUrl(
39:         getR2Client(),
40:         new PutObjectCommand({
41:             Bucket: getBucket(),
42:             Key: key,
43:             ContentType: 'text/tab-separated-values',
44:         }),
45:         { expiresIn: PRESIGN_EXPIRY_SEC },
46:     );
47: };
48: 
49: export const presignDownloadUrl = async (userId: string, key: string): Promise<string> => {
50:     if (!isOwnedProfileKey(key, userId)) {
51:         throw new Error('Forbidden');
52:     }
53:     return getSignedUrl(
54:         getR2Client(),
55:         new GetObjectCommand({ Bucket: getBucket(), Key: key }),
56:         { expiresIn: PRESIGN_EXPIRY_SEC },
57:     );
58: };
</file>

<file path="supabase/functions/get-download-url/index.ts">
 1: import { corsHeaders, getAuthenticatedUser, jsonResponse } from '../_shared/auth.ts';
 2: import { presignDownloadUrl } from '../_shared/r2.ts';
 3: 
 4: Deno.serve(async (req) => {
 5:     if (req.method === 'OPTIONS') {
 6:         return new Response('ok', { headers: corsHeaders });
 7:     }
 8: 
 9:     if (req.method !== 'POST') {
10:         return jsonResponse({ error: 'Method not allowed' }, 405);
11:     }
12: 
13:     const user = await getAuthenticatedUser(req);
14:     if (!user) {
15:         return jsonResponse({ error: 'Unauthorized' }, 401);
