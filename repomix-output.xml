<file path="src/entities/bean-stock-event/queries.ts">
 1: import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
 2: import type { BeanStockEventInsert, StockSummary } from './api';
 3: import { beanStockEventApi } from './api';
 4: 
 5: export const stockEventKeys = {
 6:     byBean: (beanId: string) => ['bean-stock-events', beanId] as const,
 7:     summary: (beanId: string) => ['bean-stock-summary', beanId] as const,
 8:     summariesByUser: (userId: string) => ['bean-stock-summaries', userId] as const,
 9: };
10: 
11: export const useBeanStockEvents = (beanId: string) =>
12:     useQuery({
13:         queryKey: stockEventKeys.byBean(beanId),
14:         queryFn: () => beanStockEventApi.listByBean(beanId),
15:         enabled: !!beanId,
16:     });
17: 
18: export const useBeanStockSummary = (beanId: string) =>
19:     useQuery({
20:         queryKey: stockEventKeys.summary(beanId),
21:         queryFn: () => beanStockEventApi.getStockSummary(beanId),
22:         enabled: !!beanId,
23:     });
24: 
25: export const useBeanStockSummaries = (userId: string) =>
26:     useQuery({
27:         queryKey: stockEventKeys.summariesByUser(userId),
28:         queryFn: () => beanStockEventApi.getStockSummariesByUser(userId),
29:         enabled: !!userId,
30:     });
31: 
32: export const useInsertStockEvent = () => {
33:     const qc = useQueryClient();
34:     return useMutation({
35:         mutationFn: beanStockEventApi.insert,
36:         onMutate: async (newEvent: BeanStockEventInsert) => {
37:             const beanId = newEvent.bean_id!;
38:             await qc.cancelQueries({ queryKey: stockEventKeys.summary(beanId) });
39:             await qc.cancelQueries({ queryKey: ['bean-stock-summaries'] });
40: 
41:             const prevSummary = qc.getQueryData<StockSummary>(stockEventKeys.summary(beanId));
42:             const prevSummaries = qc.getQueriesData<Record<string, StockSummary>>({
43:                 queryKey: ['bean-stock-summaries'],
44:             });
45: 
46:             if (prevSummary) {
47:                 const next = prevSummary.currentGrams + newEvent.delta_grams;
48:                 qc.setQueryData<StockSummary>(stockEventKeys.summary(beanId), {
49:                     ...prevSummary,
50:                     currentGrams: next,
51:                     effectiveGrams: next - prevSummary.reservedGrams,
52:                 });
53:             }
54: 
55:             qc.setQueriesData<Record<string, StockSummary>>({ queryKey: ['bean-stock-summaries'] }, (prev) => {
56:                 if (!prev?.[beanId]) return prev;
57:                 const old = prev[beanId];
58:                 const next = old.currentGrams + newEvent.delta_grams;
59:                 return { ...prev, [beanId]: { ...old, currentGrams: next, effectiveGrams: next - old.reservedGrams } };
60:             });
61: 
62:             return { prevSummary, prevSummaries };
63:         },
64:         onError: (_err, newEvent, ctx) => {
65:             const beanId = newEvent.bean_id!;
66:             if (ctx?.prevSummary) qc.setQueryData(stockEventKeys.summary(beanId), ctx.prevSummary);
67:             if (ctx?.prevSummaries) {
68:                 for (const [queryKey, data] of ctx.prevSummaries) qc.setQueryData(queryKey, data);
69:             }
70:         },
71:         onSettled: (_data, _err, newEvent: BeanStockEventInsert) => {
72:             const beanId = newEvent.bean_id!;
73:             qc.invalidateQueries({ queryKey: stockEventKeys.byBean(beanId) });
74:             qc.invalidateQueries({ queryKey: stockEventKeys.summary(beanId) });
75:             qc.invalidateQueries({ queryKey: ['bean-stock-summaries'] });
76:         },
77:     });
78: };
</file>

<file path="src/features/active-roast/model/useDeductRoastStock.ts">
 1: import { beanStockEventApi, stockEventKeys } from '@entities/bean-stock-event';
 2: import { blendApi } from '@entities/blend';
 3: import { useAuthStore } from '@shared/store/auth';
 4: import { useQueryClient } from '@tanstack/react-query';
 5: import { useCallback } from 'react';
 6: import { buildBlendDeductions } from '../lib/buildBlendDeductions';
 7: 
 8: export interface DeductRoastStockParams {
 9:     deductionGrams: number;
10:     singleBeanId: string | null;
11:     blendId: string | null;
12:     /** roast_session.id or plan_batch.id for idempotent stock events */
13:     referenceId: string;
14: }
15: 
16: export const useDeductRoastStock = () => {
17:     const qc = useQueryClient();
18:     const user = useAuthStore((s) => s.user);
19: 
20:     return useCallback(
21:         async ({ deductionGrams, singleBeanId, blendId, referenceId }: DeductRoastStockParams) => {
22:             if (!user || deductionGrams <= 0) return;
23: 
24:             const events: Parameters<typeof beanStockEventApi.insertMany>[0] = [];
25: 
26:             if (singleBeanId && !blendId) {
27:                 events.push({
28:                     user_id: user.id,
29:                     bean_id: singleBeanId,
30:                     delta_grams: -deductionGrams,
31:                     event_type: 'roast',
32:                     reference_id: referenceId,
33:                 });
34:             }
35: 
36:             if (blendId) {
37:                 const blend = await blendApi.get(blendId);
38:                 const deductions = buildBlendDeductions(deductionGrams, blend.blend_components);
39:                 for (const d of deductions) {
40:                     if (d.grams <= 0) continue;
41:                     events.push({
42:                         user_id: user.id,
43:                         bean_id: d.beanId,
44:                         delta_grams: -d.grams,
45:                         event_type: 'roast',
46:                         reference_id: referenceId,
47:                         note: `${blend.name} 블렌드 차감`,
48:                     });
49:                 }
50:             }
51: 
52:             if (!events.length) return;
53: 
54:             await beanStockEventApi.insertMany(events);
55: 
56:             qc.invalidateQueries({ queryKey: ['bean-stock-summaries'] });
57:             for (const e of events) {
58:                 qc.invalidateQueries({ queryKey: stockEventKeys.summary(e.bean_id!) });
59:                 qc.invalidateQueries({ queryKey: stockEventKeys.byBean(e.bean_id!) });
60:             }
61:         },
62:         [user, qc],
63:     );
64: };
</file>

