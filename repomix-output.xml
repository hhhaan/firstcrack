 21: 
 22: export const ProfileCurveChart = ({ series }: ProfileCurveChartProps) => {
 23:     const containerRef = useRef<HTMLDivElement>(null);
 24:     const plotRef = useRef<uPlot | null>(null);
 25: 
 26:     useEffect(() => {
 27:         const el = containerRef.current;
 28:         if (!el || series.length === 0) return;
 29: 
 30:         const cs = getComputedStyle(document.documentElement);
 31:         const colorMuted = cs.getPropertyValue('--color-muted').trim() || '#9ca3af';
 32: 
 33:         const maxT = Math.max(...series.map((s) => s.curve[s.curve.length - 1]?.t ?? 0));
 34:         const xs: number[] = [];
 35:         for (let t = 0; t <= maxT; t += 30) xs.push(t);
 36: 
 37:         const ysArrays = series.map((s) => {
 38:             const map = new Map(s.curve.map((pt) => [pt.t, pt.bt]));
 39:             return xs.map((t) => map.get(t) ?? null);
 40:         });
 41: 
 42:         const isMulti = series.length > 1;
 43:         const resolvedColors = series.map((s) => resolveColor(s.color));
 44: 
 45:         const ttEl = document.createElement('div');
 46:         Object.assign(ttEl.style, {
 47:             position: 'absolute',
 48:             pointerEvents: 'none',
 49:             display: 'none',
 50:             background: cs.getPropertyValue('--color-main-bg').trim() || 'white',
 51:             borderRadius: '10px',
 52:             padding: '10px 14px',
 53:             boxShadow: 'rgba(0,0,0,0.4) 0px 0px 1px, rgba(0,0,0,0.04) 0px 4px 4px',
 54:             fontSize: '12px',
 55:             zIndex: '10',
 56:             whiteSpace: 'nowrap',
 57:         });
 58: 
 59:         const tooltipPlugin: uPlot.Plugin = {
 60:             hooks: {
 61:                 init: [
 62:                     (u) => {
 63:                         u.root.style.position = 'relative';
 64:                         u.root.appendChild(ttEl);
 65:                     },
 66:                 ],
 67:                 setCursor: [
 68:                     (u) => {
 69:                         const { idx, left: cx, top: cy } = u.cursor;
 70:                         if (idx == null || cx == null || cy == null) {
 71:                             ttEl.style.display = 'none';
 72:                             return;
 73:                         }
 74:                         const xSec = (u.data[0] as number[])[idx];
 75:                         const m = Math.floor(xSec / 60);
 76:                         const s = Math.round(xSec % 60);
 77:                         let html = `<div style="font-weight:500;color:${colorMuted};margin-bottom:4px">${m}:${String(s).padStart(2, '0')}</div>`;
 78:                         series.forEach((ser, i) => {
 79:                             const val = (u.data[i + 1] as (number | null)[])[idx];
 80:                             if (val == null) return;
 81:                             html += `<div style="display:flex;align-items:center;gap:6px;${i > 0 ? 'margin-top:3px' : ''}">
 82:                                 <div style="width:8px;height:8px;border-radius:2px;background:${resolvedColors[i]}"></div>
 83:                                 <span style="color:${colorMuted}">${isMulti ? ser.label : 'Bean Temp'}:</span>
 84:                                 <span style="font-weight:600;color:#171717">${val.toFixed(1)}°C</span>
 85:                             </div>`;
 86:                         });
 87:                         const tw = ttEl.offsetWidth || 160;
 88:                         ttEl.innerHTML = html;
 89:                         ttEl.style.display = 'block';
 90:                         ttEl.style.left = `${cx + 12 + tw > u.width ? cx - tw - 12 : cx + 12}px`;
 91:                         ttEl.style.top = `${Math.max(0, cy - 20)}px`;
 92:                     },
 93:                 ],
 94:             },
 95:         };
 96: 
 97:         const opts: uPlot.Options = {
 98:             width: el.offsetWidth,
 99:             height: 160,
100:             padding: [4, 12, 0, 0],
101:             cursor: { focus: { prox: 16 }, drag: { x: false, y: false } },
102:             legend: { show: false },
103:             axes: [
104:                 {
105:                     stroke: colorMuted,
106:                     grid: { stroke: 'rgba(0,0,0,0.05)', width: 1 },
107:                     ticks: { show: false },
108:                     border: { show: false },
109:                     font: '11px monospace',
110:                     size: 24,
111:                     incrs: [30, 60, 120, 180, 300],
112:                     values: (_, vals) => vals.map((v) => `${Math.floor(v / 60)}m`),
113:                 },
114:                 {
115:                     stroke: colorMuted,
116:                     grid: { show: false },
117:                     ticks: { show: false },
118:                     border: { show: false },
119:                     font: '11px monospace',
120:                     size: 32,
121:                     values: (_, vals) => vals.map((v) => `${v}°`),
122:                 },
123:             ],
124:             scales: { x: { time: false }, y: { range: [140, 230] } },
125:             series: [{}, ...resolvedColors.map((c) => ({ stroke: c, width: 2, points: { show: false } }))],
126:             plugins: [tooltipPlugin],
127:         };
128: 
129:         // eslint-disable-next-line @typescript-eslint/no-explicit-any
130:         plotRef.current = new uPlot(opts, [xs, ...ysArrays] as any, el);
131: 
132:         const obs = new ResizeObserver(() => {
133:             if (plotRef.current && el) plotRef.current.setSize({ width: el.offsetWidth, height: 160 });
134:         });
135:         obs.observe(el);
136: 
137:         return () => {
138:             obs.disconnect();
139:             plotRef.current?.destroy();
140:             plotRef.current = null;
141:         };
142:         // eslint-disable-next-line react-hooks/exhaustive-deps
143:     }, []);
144: 
145:     return <div ref={containerRef} className="w-full" />;
146: };
</file>

