 2: import type { RoastSessionWithRelations } from '@shared/types/database.types';
 3: 
 4: export interface MonthlyReportData {
 5:     year: number;
 6:     month: number;
 7:     businessName: string;
 8:     ownerName: string;
 9:     totalRoasts: number;
10:     totalInputKg: number;
11:     totalOutputKg: number;
12:     avgLossRate: number;
13:     sessions: {
14:         date: string;
15:         beanLot: string;
16:         inputKg: number;
17:         outputKg: number;
18:         lossRate: number;
19:         profile: string;
20:         worker: string;
21:     }[];
22: }
23: 
24: export const buildReportData = (
25:     rawSessions: RoastSessionWithRelations[],
26:     profileDisplayName: string | null | undefined,
27:     userEmail: string | null | undefined,
28: ): MonthlyReportData => {
29:     const now = new Date();
30:     const year = now.getFullYear();
31:     const month = now.getMonth() + 1;
32:     const workerName = profileDisplayName || userEmail || '';
33: 
34:     const monthSessions = rawSessions.filter((s) => {
35:         if (!s.roasted_at) return false;
36:         const d = new Date(s.roasted_at);
37:         return d.getFullYear() === year && d.getMonth() + 1 === month;
38:     });
39: 
40:     const sessions = monthSessions.map((s) => {
41:         const { outputKg, inputKg, lossRate } = computeRoastWeights(s.weight_grams);
42:         return {
43:             date: s.roasted_at ? s.roasted_at.slice(0, 10) : '',
44:             beanLot: s.beans?.name ?? '—',
45:             inputKg,
46:             outputKg,
47:             lossRate,
48:             profile: s.roast_profiles?.name ?? '—',
49:             worker: workerName,
50:         };
51:     });
52: 
53:     const totalInputKg = sessions.reduce((sum, s) => sum + s.inputKg, 0);
54:     const totalOutputKg = sessions.reduce((sum, s) => sum + s.outputKg, 0);
55:     const avgLossRate = totalInputKg > 0 ? ((totalInputKg - totalOutputKg) / totalInputKg) * 100 : 0;
56: 
57:     return {
58:         year,
59:         month,
60:         businessName: 'First Crack',
61:         ownerName: 'Admin',
62:         totalRoasts: sessions.length,
63:         totalInputKg: Math.round(totalInputKg * 1000) / 1000,
64:         totalOutputKg: Math.round(totalOutputKg * 1000) / 1000,
65:         avgLossRate: Math.round(avgLossRate * 10) / 10,
66:         sessions,
67:     };
68: };
</file>

