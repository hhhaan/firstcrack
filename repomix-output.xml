 1: import { sidecar } from '@shared/lib/sidecar';
 2: import type { LogEntry } from '@shared/types/roast';
 3: import { useCallback } from 'react';
 4: import { formatTemp } from '../lib/temperature';
 5: import { parseTimeSec } from '../lib/time';
 6: import type { TurningPoint } from '../lib/turningPoints';
 7: import type { TemperatureUnit } from './settings';
 8: import { useRoastingStore } from './status';
 9: 
10: interface UseRoastActionsParams {
11:     unit: TemperatureUnit;
12:     rawBT: number | null;
13:     setLogEntries: React.Dispatch<React.SetStateAction<LogEntry[]>>;
14:     setIsRunning: React.Dispatch<React.SetStateAction<boolean>>;
15:     setShowEndRoastModal: React.Dispatch<React.SetStateAction<boolean>>;
16:     storeStartCharge: () => void;
17:     roastStartTimeRef: React.MutableRefObject<number>;
18: }
19: 
20: interface UseRoastActionsReturn {
21:     triggerCharge: (btAtCharge?: number | null) => void;
22:     handleAutoDrop: () => void;
23:     handleTurningPoint: (tp: TurningPoint) => void;
24: }
25: 
26: export const useRoastActions = ({
27:     unit,
28:     rawBT,
29:     setLogEntries,
30:     setIsRunning,
31:     setShowEndRoastModal,
32:     storeStartCharge,
33:     roastStartTimeRef,
34: }: UseRoastActionsParams): UseRoastActionsReturn => {
35:     const triggerCharge = useCallback(
36:         (btAtCharge?: number | null) => {
37:             sidecar.startRoast().catch(() => {});
38:             roastStartTimeRef.current = Date.now();
39:             storeStartCharge();
40:             setIsRunning(true);
41:             const temp = btAtCharge != null ? formatTemp(btAtCharge, unit) : formatTemp(rawBT, unit);
42:             setLogEntries([{ time: '0:00', event: 'Charge', temp, note: 'Bean drop detected' }]);
43:         },
44:         [unit, rawBT, setLogEntries, setIsRunning, storeStartCharge, roastStartTimeRef],
45:     );
46: 
47:     const handleAutoDrop = useCallback(() => {
48:         setLogEntries((prev) => {
49:             if (prev.some((e) => e.event === 'Drop')) return prev;
50:             const elapsed = useRoastingStore.getState().elapsed;
51:             const min2 = Math.floor(elapsed / 60);
52:             const sec2 = elapsed % 60;
53:             return [
54:                 ...prev,
55:                 {
56:                     time: `${min2}:${String(sec2).padStart(2, '0')}`,
57:                     event: 'Drop',
58:                     temp: formatTemp(rawBT, unit),
59:                     note: 'Bean drop detected',
60:                 },
61:             ];
62:         });
63:         setShowEndRoastModal(true);
64:     }, [rawBT, unit, setLogEntries, setShowEndRoastModal]);
65: 
66:     const handleTurningPoint = useCallback(
67:         (tp: TurningPoint) => {
68:             const timeMin = Math.floor(tp.timeSec / 60);
69:             const tpSec = Math.floor(tp.timeSec % 60);
70:             const tpTimeStr = `${timeMin}:${String(tpSec).padStart(2, '0')}`;
71:             setLogEntries((prev) => {
72:                 if (prev.some((e) => e.event === 'TP')) return prev;
73:                 const newEntry = {
74:                     time: tpTimeStr,
75:                     event: 'TP',
76:                     temp: formatTemp(tp.temp, unit),
77:                     note: 'Turning Point detected',
78:                 };
79:                 return [...prev, newEntry].sort((a, b) => parseTimeSec(a.time) - parseTimeSec(b.time));
80:             });
81:         },
82:         [unit, setLogEntries],
83:     );
84: 
85:     return { triggerCharge, handleAutoDrop, handleTurningPoint };
86: };
</file>

