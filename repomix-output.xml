 34: export const BeanList = ({ beans, isLoading, onSelect, search, onSearchChange, stockSummaries }: BeanListProps) => {
 35:     const searchLower = search.toLowerCase();
 36:     const filtered = beans.filter(
 37:         (b) => b.name.toLowerCase().includes(searchLower) || (b.origin ?? '').toLowerCase().includes(searchLower),
 38:     );
 39: 
 40:     return (
 41:         <div>
 42:             <div className="flex items-center gap-2 bg-main-bg rounded-lg px-3 py-[9px] mb-2.5 border border-border">
 43:                 <Search size={14} strokeWidth={2} className="text-muted shrink-0" />
 44:                 <input
 45:                     value={search}
 46:                     onChange={(e) => onSearchChange(e.target.value)}
 47:                     placeholder="Search beans..."
 48:                     className="border-none bg-transparent outline-none text-[13px] text-primary font-body w-full tracking-[0.14px]"
 49:                 />
 50:             </div>
 51: 
 52:             {isLoading ? (
 53:                 <Skeleton />
 54:             ) : (
 55:                 <div className="flex flex-col gap-2">
 56:                     {filtered.map((bean) => {
 57:                         const summary = stockSummaries[bean.id];
 58:                         const effectiveGrams = summary?.effectiveGrams ?? 0;
 59:                         const status = getStatus(effectiveGrams, bean.low_stock_threshold_grams);
 60:                         const cfg = statusConfig[status];
 61:                         const pct = Math.min(100, (effectiveGrams / bean.capacity_grams) * 100);
 62: 
 63:                         return (
 64:                             <div
 65:                                 key={bean.id}
 66:                                 onClick={() => onSelect(bean.id)}
 67:                                 className="bg-main-bg rounded-lg px-4 py-3.5 cursor-pointer border border-border transition-all duration-150"
 68:                             >
 69:                                 <div className="flex items-start justify-between mb-2">
 70:                                     <div>
 71:                                         <div className="text-[13px] font-medium text-primary tracking-[0.14px] mb-0.5">
 72:                                             {bean.name}
 73:                                         </div>
 74:                                         <div className="text-xs text-muted tracking-[0.14px]">
 75:                                             {bean.origin ?? '—'} · {bean.process ?? '—'}
 76:                                         </div>
 77:                                     </div>
 78:                                     <span
 79:                                         className="text-[11px] font-medium px-[7px] py-0.5 rounded-full shrink-0 ml-2"
 80:                                         style={{ color: cfg.color, background: cfg.bg }}
 81:                                     >
 82:                                         {cfg.label}
 83:                                     </span>
 84:                                 </div>
 85: 
 86:                                 <div className="h-1 bg-surface rounded-full overflow-hidden mb-1">
 87:                                     <div
 88:                                         className="h-full rounded-full"
 89:                                         style={{
 90:                                             width: `${pct}%`,
 91:                                             background:
 92:                                                 status === 'Out'
 93:                                                     ? '#dc2626'
 94:                                                     : status === 'Low'
 95:                                                       ? '#d97706'
 96:                                                       : 'var(--color-primary)',
 97:                                             transition: 'width 0.5s',
 98:                                         }}
 99:                                     />
100:                                 </div>
101:                                 <div className="text-xs text-muted font-mono">
102:                                     {(effectiveGrams / 1000).toFixed(2)}kg / {(bean.capacity_grams / 1000).toFixed(2)}kg
103:                                 </div>
104:                             </div>
105:                         );
106:                     })}
107: 
108:                     {filtered.length === 0 && (
109:                         <div className="px-5 py-10 text-center text-muted text-sm tracking-[0.14px]">
110:                             {beans.length === 0 ? 'No beans yet. Add your first lot!' : 'No results found.'}
111:                         </div>
112:                     )}
113:                 </div>
114:             )}
115:         </div>
116:     );
117: };
</file>

