 1: import { profileKeyForUser, requestUploadUrl } from '@shared/lib/r2';
 2: import { BaseDirectory, readTextFile, remove } from '@tauri-apps/plugin-fs';
 3: 
 4: export const uploadRoastProfile = async (sessionId: string, userId: string): Promise<string | null> => {
 5:     if (!('__TAURI_INTERNALS__' in window)) return null;
 6: 
 7:     let tsvContent: string;
 8:     try {
 9:         tsvContent = await readTextFile(`session_${sessionId}.tsv`, {
10:             baseDir: BaseDirectory.AppLocalData,
11:         });
12:     } catch {
13:         return null;
14:     }
15: 
16:     const uploadUrl = await requestUploadUrl(sessionId);
17:     const res = await fetch(uploadUrl, {
18:         method: 'PUT',
19:         body: tsvContent,
20:         headers: { 'Content-Type': 'text/tab-separated-values' },
21:     });
22:     if (!res.ok) {
23:         const text = await res.text().catch(() => '');
24:         throw new Error(`R2 upload failed (${res.status})${text ? `: ${text}` : ''}`);
25:     }
26: 
27:     const r2Key = profileKeyForUser(userId, sessionId);
28:     remove(`session_${sessionId}.tsv`, { baseDir: BaseDirectory.AppLocalData }).catch(() => {});
29:     return r2Key;
30: };
</file>

