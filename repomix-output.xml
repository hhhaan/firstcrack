<file path="src/widgets/add-machine-modal/model/useMachinesPageState.ts">
 1: import type { Machine, RoasterDef, SidecarStatus, TemperatureReading } from '@entities/machine';
 2: import { useMachines } from '@entities/machine';
 3: import { sidecar } from '@shared/lib/sidecar';
 4: import { type Dispatch, type SetStateAction, useCallback, useState } from 'react';
 5: 
 6: type Args = {
 7:     sidecarStatus: SidecarStatus | null;
 8:     setSidecarStatus: Dispatch<SetStateAction<SidecarStatus | null>>;
 9:     setTemps: Dispatch<SetStateAction<TemperatureReading | null>>;
10: };
11: 
12: export const useMachinesPageState = ({ sidecarStatus, setSidecarStatus, setTemps }: Args) => {
13:     const { addMachine, updateMachine, machines } = useMachines();
14:     const [modalOpen, setModalOpen] = useState(false);
15:     const [editingMachine, setEditingMachine] = useState<Machine | null>(null);
16: 
17:     const isThisMachineConnected = useCallback(
18:         (m: Machine) => Boolean(sidecarStatus?.connected && sidecarStatus.roaster === m.roasterKey),
19:         [sidecarStatus?.connected, sidecarStatus?.roaster],
20:     );
21: 
22:     const handleAdd = useCallback(
23:         (roasterKey: string, def: RoasterDef, params: Record<string, unknown>) => {
24:             addMachine({
25:                 name: def.display_name,
26:                 roasterKey,
27:                 displayName: def.display_name,
28:                 brand: def.brand,
29:                 models: def.models,
30:                 protocol: def.protocol,
31:                 connectionParams: params,
32:                 capabilities: def.capabilities,
33:                 pid: def.pid,
34:             });
35:         },
36:         [addMachine],
37:     );
38: 
39:     const handleEdit = useCallback(
40:         async (id: string, params: Record<string, unknown>, keepConnection = false): Promise<void> => {
41:             const machine = machines.find((m) => m.id === id);
42:             const wasConnected = machine ? isThisMachineConnected(machine) : false;
43:             updateMachine(id, { connectionParams: params });
44:             if (wasConnected && !keepConnection) {
45:                 const status = await sidecar.disconnect().catch(() => null);
46:                 if (status) setSidecarStatus(status);
47:                 setTemps(null);
48:             } else if (keepConnection) {
49:                 const status = await sidecar.getStatus().catch(() => null);
50:                 if (status) setSidecarStatus(status);
51:             }
52:         },
53:         [machines, isThisMachineConnected, updateMachine, setSidecarStatus, setTemps],
54:     );
55: 
56:     const openAddModal = useCallback(() => {
57:         setEditingMachine(null);
58:         setModalOpen(true);
59:     }, []);
60: 
61:     const openEditModal = useCallback((machine: Machine) => {
62:         setEditingMachine(machine);
63:         setModalOpen(true);
64:     }, []);
65: 
66:     const closeModal = useCallback(() => {
67:         setModalOpen(false);
68:         setEditingMachine(null);
69:     }, []);
70: 
71:     return {
72:         modalOpen,
73:         editingMachine,
74:         openAddModal,
75:         openEditModal,
76:         closeModal,
77:         handleAdd,
78:         handleEdit,
79:         isThisMachineConnected,
80:     };
81: };
</file>

