 1: """
 2: config.py — 사이드카 전역 상수.
 3: 실기기 튜닝 시 이 파일만 수정한다. 타이밍 값의 출처는 Artisan 코드베이스
 4: (artisan/src/artisanlib/modbusport.py, s7port.py) 기준.
 5: """
 6: 
 7: # ── RoR / 평활화 ────────────────────────────────────────────────────────
 8: # EMA 계수: 낮을수록 더 부드럽고 lag 증가 (0 < α < 1)
 9: EMA_ALPHA = 0.2            # RoR 계산용
10: DISPLAY_ALPHA = 0.16       # 화면 표시용
11: ROR_WINDOW_SECS = 30.0     # RoR 최소제곱 슬라이딩 윈도우 길이
12: ROR_WARMUP_READS = 3       # 연결/Charge 후 RoR 표시 억제 read 횟수
13: 
14: # ── 장애 허용 ───────────────────────────────────────────────────────────
15: # read 실패 시 이전 값을 유지하는 허용 횟수 (Artisan acceptable_errors=3)
16: STALE_TOLERANCE_READS = 3
17: # 자동 재연결 백오프(초). 소진 후에는 마지막 값 간격으로 무한 재시도.
18: RECONNECT_BACKOFFS = [2.0, 5.0, 10.0]
19: 
20: # ── 프로토콜 타이밍 (Artisan 공식 값) ───────────────────────────────────
21: MODBUS_TCP_TIMEOUT = 0.25       # min(delay/2000, 0.4), delay=500ms 기준
22: MODBUS_RTU_TIMEOUT = 0.3        # 시리얼 응답 지연 여유
23: MODBUS_RTU_CONNECT_DELAY = 0.5  # modbus_serial_connect_delay
24: MODBUS_CLOSE_TIMEOUT = 1.0      # 불량 포트에서 close() 행 방지
25: S7_MIN_REQUEST_INTERVAL = 0.04  # PLC 과부하 방지 40ms
26: 
27: # ── 디버그 트레이스 ─────────────────────────────────────────────────────
28: # 링버퍼 항목 수. 5채널 × 2회/초 폴링(엔트리 3개/read) 기준 약 2~3분 분량.
29: TRACE_BUFFER_SIZE = 5000
