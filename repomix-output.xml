216: export const useCreateRecurringBatches = (userId: string, currentPlanId?: string) => {
217:     const qc = useQueryClient();
218:     return useMutation({
219:         mutationFn: async ({
220:             baseBatch,
221:             interval,
222:             dtstart,
223:         }: {
224:             baseBatch: Omit<PlanBatchInsert, 'plan_id'>;
225:             interval: RecurrenceInterval;
226:             dtstart: Date;
227:         }) => {
228:             const rruleStr = buildRRule(interval);
229:             return planBatchApi.createRecurring(baseBatch, rruleStr, dtstart, userId);
230:         },
231:         onMutate: async ({ baseBatch, interval, dtstart }) => {
232:             const rruleStr = buildRRule(interval);
233:             const dtstartDate = format(dtstart, 'yyyy-MM-dd');
234:             const optimisticId = `__optimistic__${Date.now()}`;
235: 
236:             let previousCurrentPlan: PlanBatchWithProgress[] | undefined;
237: 
238:             if (currentPlanId) {
239:                 await qc.cancelQueries({ queryKey: planKeys.batches(currentPlanId) });
240:                 previousCurrentPlan = qc.getQueryData<PlanBatchWithProgress[]>(planKeys.batches(currentPlanId));
241:             }
242: 
243:             await qc.cancelQueries({ queryKey: planKeys.dayBatches(userId, dtstartDate) });
244:             const previousDayBatches = qc.getQueryData<PlanBatchWithProgress[]>(
245:                 planKeys.dayBatches(userId, dtstartDate),
246:             );
247: 
248:             const batchSize = Number(baseBatch.batch_size_kg) || 0;
249:             const targetKg = Number(baseBatch.target_roasted_kg) || 0;
250:             const batchCount = batchSize > 0 && targetKg > 0 ? Math.ceil(targetKg / batchSize) : 1;
251:             const orderIndex = baseBatch.order_index ?? previousDayBatches?.length ?? previousCurrentPlan?.length ?? 0;
252: 
253:             const optimistic: PlanBatchWithProgress = {
254:                 id: `${optimisticId}:${dtstartDate}`,
255:                 plan_id: currentPlanId ?? '',
256:                 bean_name: baseBatch.bean_name,
257:                 bean_id: baseBatch.bean_id ?? null,
258:                 blend_id: baseBatch.blend_id ?? null,
259:                 batch_type: baseBatch.batch_type ?? '',
260:                 batch_size_kg: baseBatch.batch_size_kg,
261:                 target_roasted_kg: baseBatch.target_roasted_kg,
262:                 batch_count: batchCount,
263:                 yield_pct: baseBatch.yield_pct ?? 1,
264:                 order_index: orderIndex,
265:                 machine_id: baseBatch.machine_id ?? null,
266:                 roast_profile_id: baseBatch.roast_profile_id ?? null,
267:                 rrule: rruleStr,
268:                 recurrence_group_id: null,
269:                 recurrence_rule_id: optimisticId,
270:                 scheduled_date: dtstartDate,
271:                 original_date: dtstartDate,
272:                 exception_type: null,
273:                 notes: baseBatch.notes ?? '',
274:                 green_lot: baseBatch.green_lot ?? '',
275:                 status: 'pending',
276:                 created_at: new Date().toISOString(),
277:                 updated_at: new Date().toISOString(),
278:                 completed_sessions: 0,
279:             };
280: 
281:             if (currentPlanId) {
282:                 patchPlanBatchesCache(qc, currentPlanId, (prev) => [...prev, optimistic]);
283:             }
284:             patchDayBatchesCache(qc, userId, dtstartDate, (prev) => [...prev, optimistic]);
285: 
286:             return { previousCurrentPlan, previousDayBatches, dtstartDate };
287:         },
288:         onError: (_err, _vars, context) => {
289:             if (context?.previousCurrentPlan && currentPlanId) {
290:                 qc.setQueryData(planKeys.batches(currentPlanId), context.previousCurrentPlan);
291:             }
292:             if (context?.previousDayBatches && context.dtstartDate) {
293:                 qc.setQueryData(planKeys.dayBatches(userId, context.dtstartDate), context.previousDayBatches);
294:             }
295:         },
296:         onSettled: () => {
297:             qc.invalidateQueries({ queryKey: ['plan_batches'] });
298:             qc.invalidateQueries({ queryKey: ['day_plan', userId] });
299:             qc.invalidateQueries({ queryKey: ['day_plan_range', userId] });
300:             qc.invalidateQueries({ queryKey: ['recurrence_rules', userId] });
301:             invalidateScheduledBatchQueries(qc);
302:         },
303:     });
304: };
