 14: def _format_connection_error(
 15:     exc: Exception, protocol: str, params: dict[str, Any]
 16: ) -> str:
 17:     """Python 예외를 사용자 친화적인 연결 오류 메시지로 변환."""
 18:     msg = str(exc)
 19:     exc_type = type(exc).__name__
 20: 
 21:     # ── 라이브러리/드라이버 미설치 ──────────────────────────────────────
 22:     if "No module named 'snap7'" in msg:
 23:         return "snap7 라이브러리가 설치되지 않았습니다. 설치 가이드를 확인하세요."
 24:     if "No module named 'pymodbus'" in msg:
 25:         return "pymodbus 라이브러리가 설치되지 않았습니다."
 26:     if "No module named 'Phidget22'" in msg:
 27:         return "Phidget22 SDK가 설치되지 않았습니다. phidgets.com에서 시스템 드라이버를 설치하세요."
 28:     if "No module named 'websockets'" in msg:
 29:         return "websockets 라이브러리가 설치되지 않았습니다."
 30: 
 31:     # ── 시리얼 포트 (MODBUS RTU, Kaleido Serial) ────────────────────────
 32:     if protocol in ("modbus", "kaleido") and params.get("mode", "").lower() in (
 33:         "rtu",
 34:         "serial",
 35:     ):
 36:         comport = params.get("comport", "")
 37:         if "No such file or directory" in msg or "could not open port" in msg:
 38:             return f"시리얼 포트 '{comport}'를 찾을 수 없습니다. 포트 이름과 케이블 연결을 확인하세요."
 39:         if "Device or resource busy" in msg or "Access is denied" in msg:
 40:             return f"시리얼 포트 '{comport}'가 다른 프로그램에서 사용 중입니다. 다른 앱을 종료 후 다시 시도하세요."
 41:         if "Permission denied" in msg:
 42:             return f"시리얼 포트 '{comport}' 접근 권한이 없습니다. (Linux: sudo usermod -aG dialout $USER)"
 43: 
 44:     # ── Phidget 장치 미연결 ──────────────────────────────────────────────
 45:     if "PhidgetException" in exc_type or "EPHIDGET" in msg or "Not Attached" in msg:
 46:         return "Phidget 장치가 감지되지 않습니다. USB 연결과 시스템 드라이버 설치를 확인하세요."
 47:     if "Phidget" in exc_type and ("Timeout" in msg or "timed out" in msg.lower()):
 48:         return "Phidget 장치 응답 없음. USB 케이블과 시스템 드라이버를 확인하세요."
 49: 
 50:     # ── 네트워크 연결 실패 ───────────────────────────────────────────────
 51:     if "Connection refused" in msg:
 52:         host = params.get("host", "")
 53:         port = params.get("port", "")
 54:         if protocol == "s7":
 55:             return f"PLC({host}:{port})가 연결을 거부했습니다. 머신 전원과 S7 통신 설정을 확인하세요."
 56:         if protocol in ("modbus", "probat_ws", "kaleido"):
 57:             return (
 58:                 f"{host}:{port} 연결이 거부됐습니다. 머신 전원과 IP/포트를 확인하세요."
 59:             )
 60:         return f"연결이 거부됐습니다 ({host}:{port}). 머신 전원과 네트워크 설정을 확인하세요."
 61: 
 62:     if "timed out" in msg.lower() or exc_type in (
 63:         "TimeoutError",
 64:         "asyncio.TimeoutError",
 65:     ):
 66:         host = params.get("host", "")
 67:         if protocol == "s7":
 68:             return f"PLC({host}) 응답 없음. 같은 네트워크에 있는지, IP 주소가 맞는지 확인하세요."
 69:         return f"{host} 응답 없음. 머신이 같은 네트워크에 있는지 확인하세요."
 70: 
 71:     if "Network is unreachable" in msg or "No route to host" in msg:
 72:         return f"호스트({params.get('host', '')})에 도달할 수 없습니다. 네트워크 연결을 확인하세요."
 73: 
 74:     # ── S7 PLC 연결 확인 실패 (snap7 connected=False) ───────────────────
 75:     if "S7 연결 실패" in msg or ("S7" in msg and "연결" in msg):
 76:         host = params.get("host", "")
 77:         return f"S7 PLC({host}) 연결 실패. rack/slot 값과 머신 전원을 확인하세요."
 78: 
 79:     # ── MODBUS 연결 확인 실패 ────────────────────────────────────────────
 80:     if "MODBUS 연결 실패" in msg:
 81:         if params.get("mode", "tcp").lower() == "tcp":
 82:             return f"MODBUS TCP 연결 실패 ({params.get('host')}:{params.get('port')}). IP와 포트를 확인하세요."
 83:         return (
 84:             f"MODBUS RTU 연결 실패 ({params.get('comport')}). 시리얼 포트를 확인하세요."
 85:         )
 86: 
 87:     # ── fallback: 원본 메시지 ────────────────────────────────────────────
 88:     return msg
