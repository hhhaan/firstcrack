 23: 
 24:     steps:
 25:       - name: Download artifacts
 26:         uses: actions/download-artifact@v4
 27:         with:
 28:           path: artifacts
 29:           # For workflow_call callers: github.run_id is the parent run — artifacts are found correctly.
 30:           # For direct dispatch: always pass run_id explicitly.
 31:           run-id: ${{ inputs.run_id || github.run_id }}
 32:           github-token: ${{ secrets.GITHUB_TOKEN }}
 33: 
 34:       - name: Validate artifact signatures
 35:         run: |
 36:           set -e
 37:           AARCH64_SIG=$(find artifacts/macos-aarch64-apple-darwin -name "*.app.tar.gz.sig" | head -1)
 38:           X64_SIG=$(find artifacts/macos-x86_64-apple-darwin -name "*.app.tar.gz.sig" | head -1)
 39:           WIN_SIG=$(find artifacts/windows-x86_64-pc-windows-msvc -name "*.msi.sig" | head -1)
 40: 
 41:           verify_sig() {
 42:             local file="$1" label="$2"
 43:             if [ ! -f "$file" ]; then
 44:               echo "::error::$label .sig file not found: $file"
 45:               exit 1
 46:             fi
 47:             if [ ! -s "$file" ]; then
 48:               echo "::error::$label .sig file is empty: $file"
 49:               exit 1
 50:             fi
 51:             echo "  OK: $label ($(wc -c < "$file") bytes)"
 52:           }
 53: 
 54:           verify_sig "$AARCH64_SIG" "macOS aarch64"
 55:           verify_sig "$X64_SIG"     "macOS x86_64"
 56:           verify_sig "$WIN_SIG"     "Windows x86_64"
 57:           echo "All .sig files valid."
 58: 
 59:       - name: Backup current latest.json
 60:         env:
 61:           AWS_ACCESS_KEY_ID: ${{ secrets.R2_PUBLISH_ACCESS_KEY_ID }}
 62:           AWS_SECRET_ACCESS_KEY: ${{ secrets.R2_PUBLISH_SECRET_ACCESS_KEY }}
 63:           R2_ENDPOINT: https://${{ secrets.R2_PUBLISH_ACCOUNT_ID }}.r2.cloudflarestorage.com
 64:           R2_BUCKET: ${{ secrets.R2_PUBLISH_BUCKET_NAME }}
 65:           VERSION: ${{ inputs.version }}
 66:         run: |
 67:           TIMESTAMP=$(date -u +%Y%m%dT%H%M%SZ)
 68:           BACKUP_KEY="releases/latest.json.${VERSION}.${TIMESTAMP}.bak"
 69:           aws s3 cp "s3://${R2_BUCKET}/releases/latest.json" \
 70:             "s3://${R2_BUCKET}/${BACKUP_KEY}" \
 71:             --endpoint-url "$R2_ENDPOINT" --region auto \
 72:             --content-type "application/json" && \
 73:             echo "BACKUP_KEY=${BACKUP_KEY}" >> $GITHUB_ENV || \
 74:             echo "No existing latest.json to backup (first release?)"
 75: 
 76:       - name: Upload binaries & latest.json to R2
 77:         id: upload-r2
 78:         env:
 79:           AWS_ACCESS_KEY_ID: ${{ secrets.R2_PUBLISH_ACCESS_KEY_ID }}
 80:           AWS_SECRET_ACCESS_KEY: ${{ secrets.R2_PUBLISH_SECRET_ACCESS_KEY }}
 81:           R2_ENDPOINT: https://${{ secrets.R2_PUBLISH_ACCOUNT_ID }}.r2.cloudflarestorage.com
 82:           VERSION: ${{ inputs.version }}
 83:           R2_BUCKET: ${{ secrets.R2_PUBLISH_BUCKET_NAME }}
 84:           R2_PUBLIC_URL: https://pub-32f64eaa15504eeba9203bcbbced439d.r2.dev
 85:         run: |
 86:           set -e
 87:           S3="aws s3 cp --endpoint-url $R2_ENDPOINT --region auto"
 88: 
 89:           AARCH64_TAR=$(find artifacts/macos-aarch64-apple-darwin -name "*.app.tar.gz" ! -name "*.sig" | head -1)
 90:           AARCH64_SIG=$(find artifacts/macos-aarch64-apple-darwin -name "*.app.tar.gz.sig" | head -1)
 91:           X64_TAR=$(find artifacts/macos-x86_64-apple-darwin -name "*.app.tar.gz" ! -name "*.sig" | head -1)
 92:           X64_SIG=$(find artifacts/macos-x86_64-apple-darwin -name "*.app.tar.gz.sig" | head -1)
 93:           WIN_MSI=$(find artifacts/windows-x86_64-pc-windows-msvc -name "*.msi" ! -name "*.sig" | head -1)
 94:           WIN_SIG=$(find artifacts/windows-x86_64-pc-windows-msvc -name "*.msi.sig" | head -1)
 95:           AARCH64_DMG=$(find artifacts/macos-aarch64-apple-darwin -name "*.dmg" | head -1)
 96:           X64_DMG=$(find artifacts/macos-x86_64-apple-darwin -name "*.dmg" | head -1)
 97: 
 98:           [ -z "$AARCH64_TAR" ] && echo "ERROR: macOS arm64 .app.tar.gz not found" && exit 1
 99:           [ -z "$X64_TAR" ]     && echo "ERROR: macOS x64 .app.tar.gz not found"   && exit 1
100:           [ -z "$WIN_MSI" ]     && echo "ERROR: Windows MSI not found"              && exit 1
101: 
102:           AARCH64_TAR_R2="First-Crack-${VERSION}-aarch64.app.tar.gz"
103:           X64_TAR_R2="First-Crack-${VERSION}-x86_64.app.tar.gz"
104:           WIN_MSI_R2=$(basename "$WIN_MSI")
105: 
106:           # Phase 1: fire all binary uploads in parallel
107:           pids=""
108:           $S3 "$AARCH64_TAR" "s3://$R2_BUCKET/releases/$VERSION/$AARCH64_TAR_R2" & pids="$pids $!"
109:           [ -n "$AARCH64_SIG" ] && { $S3 "$AARCH64_SIG" "s3://$R2_BUCKET/releases/$VERSION/$AARCH64_TAR_R2.sig" & pids="$pids $!"; }
110:           $S3 "$X64_TAR"     "s3://$R2_BUCKET/releases/$VERSION/$X64_TAR_R2" & pids="$pids $!"
111:           [ -n "$X64_SIG" ]     && { $S3 "$X64_SIG"     "s3://$R2_BUCKET/releases/$VERSION/$X64_TAR_R2.sig" & pids="$pids $!"; }
112:           $S3 "$WIN_MSI"     "s3://$R2_BUCKET/releases/$VERSION/$WIN_MSI_R2" & pids="$pids $!"
113:           [ -n "$WIN_SIG" ]     && { $S3 "$WIN_SIG"     "s3://$R2_BUCKET/releases/$VERSION/$WIN_MSI_R2.sig" & pids="$pids $!"; }
114:           [ -n "$AARCH64_DMG" ] && { $S3 "$AARCH64_DMG" "s3://$R2_BUCKET/releases/$VERSION/$(basename "$AARCH64_DMG")" & pids="$pids $!"; }
115:           [ -n "$X64_DMG" ]     && { $S3 "$X64_DMG"     "s3://$R2_BUCKET/releases/$VERSION/$(basename "$X64_DMG")" & pids="$pids $!"; }
116: 
117:           # Build latest.json while uploads run
118:           jq --null-input \
119:             --arg version   "$VERSION" \
120:             --arg pub_date  "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
121:             --arg aarch64_sig "$([ -n "$AARCH64_SIG" ] && cat "$AARCH64_SIG" || echo "")" \
122:             --arg aarch64_url "$R2_PUBLIC_URL/releases/$VERSION/$AARCH64_TAR_R2" \
123:             --arg x64_sig   "$([ -n "$X64_SIG" ] && cat "$X64_SIG" || echo "")" \
124:             --arg x64_url   "$R2_PUBLIC_URL/releases/$VERSION/$X64_TAR_R2" \
125:             --arg win_sig   "$([ -n "$WIN_SIG" ] && cat "$WIN_SIG" || echo "")" \
126:             --arg win_url   "$R2_PUBLIC_URL/releases/$VERSION/$WIN_MSI_R2" \
127:             '{version:$version,notes:"",pub_date:$pub_date,platforms:{"darwin-aarch64":{signature:$aarch64_sig,url:$aarch64_url},"darwin-x86_64":{signature:$x64_sig,url:$x64_url},"windows-x86_64":{signature:$win_sig,url:$win_url}}}' \
128:             > latest.json
129: 
130:           # Wait for all Phase 1 binary uploads
131:           fail=0
132:           for pid in $pids; do wait $pid || fail=1; done
133:           if [ "$fail" -ne 0 ]; then
134:             echo "ERROR: one or more binary uploads failed"
135:             exit 1
136:           fi
137: 
138:           # Phase 2: latest.json + landing page aliases (parallel)
139:           pids=""
140:           $S3 latest.json "s3://$R2_BUCKET/releases/latest.json" \
141:             --cache-control "no-cache, no-store, must-revalidate" \
142:             --content-type "application/json" & pids="$pids $!"
143:           [ -n "$AARCH64_DMG" ] && { $S3 "$AARCH64_DMG" "s3://$R2_BUCKET/releases/latest/First-Crack-arm64.dmg" & pids="$pids $!"; }
144:           [ -n "$X64_DMG" ]     && { $S3 "$X64_DMG"     "s3://$R2_BUCKET/releases/latest/First-Crack-x64.dmg" & pids="$pids $!"; }
145:           $S3 "$WIN_MSI" "s3://$R2_BUCKET/releases/latest/First-Crack-Windows.msi" & pids="$pids $!"
146: 
147:           fail=0
148:           for pid in $pids; do wait $pid || fail=1; done
149:           if [ "$fail" -ne 0 ]; then
150:             echo "ERROR: one or more latest/landing uploads failed"
151:             exit 1
152:           fi
153: 
154:       - name: Purge Cloudflare cache for latest.json
155:         env:
156:           CF_API_TOKEN: ${{ secrets.CLOUDFLARE_API_TOKEN }}
157:           CF_ZONE_ID: ${{ secrets.CLOUDFLARE_ZONE_ID }}
158:           R2_PUBLIC_URL: https://pub-32f64eaa15504eeba9203bcbbced439d.r2.dev
159:         run: |
160:           if [ -z "$CF_API_TOKEN" ] || [ -z "$CF_ZONE_ID" ]; then
161:             echo "CLOUDFLARE_API_TOKEN or CLOUDFLARE_ZONE_ID not set — skipping (not required for r2.dev direct URL)"
162:             exit 0
163:           fi
164:           RESPONSE=$(curl -s -w "\n%{http_code}" -X POST \
165:             "https://api.cloudflare.com/client/v4/zones/${CF_ZONE_ID}/purge_cache" \
166:             -H "Authorization: Bearer ${CF_API_TOKEN}" \
167:             -H "Content-Type: application/json" \
168:             --data "{\"files\":[\"${R2_PUBLIC_URL}/releases/latest.json\"]}")
169:           HTTP_CODE=$(echo "$RESPONSE" | tail -1)
170:           BODY=$(echo "$RESPONSE" | head -1)
171:           echo "Cloudflare response (HTTP $HTTP_CODE): $BODY"
172:           if [ "$HTTP_CODE" -lt 200 ] || [ "$HTTP_CODE" -ge 300 ]; then
173:             echo "::warning::Cloudflare cache purge failed with HTTP $HTTP_CODE — continuing (r2.dev uses no-cache headers)"
174:             exit 0
175:           fi
176: 
177:       - name: Rollback latest.json on failure
178:         if: failure() && steps.upload-r2.outcome == 'failure' && env.BACKUP_KEY != ''
179:         env:
180:           AWS_ACCESS_KEY_ID: ${{ secrets.R2_PUBLISH_ACCESS_KEY_ID }}
181:           AWS_SECRET_ACCESS_KEY: ${{ secrets.R2_PUBLISH_SECRET_ACCESS_KEY }}
182:           R2_ENDPOINT: https://${{ secrets.R2_PUBLISH_ACCOUNT_ID }}.r2.cloudflarestorage.com
183:           R2_BUCKET: ${{ secrets.R2_PUBLISH_BUCKET_NAME }}
184:           CF_API_TOKEN: ${{ secrets.CLOUDFLARE_API_TOKEN }}
185:           CF_ZONE_ID: ${{ secrets.CLOUDFLARE_ZONE_ID }}
186:           R2_PUBLIC_URL: https://pub-32f64eaa15504eeba9203bcbbced439d.r2.dev
187:         run: |
188:           echo "::warning::Upload failed — rolling back latest.json from ${BACKUP_KEY}"
189:           if aws s3 cp "s3://${R2_BUCKET}/${BACKUP_KEY}" \
190:               "s3://${R2_BUCKET}/releases/latest.json" \
191:               --endpoint-url "$R2_ENDPOINT" --region auto \
192:               --cache-control "no-cache, no-store, must-revalidate" \
193:               --content-type "application/json"; then
194:             echo "Rollback complete."
195:             if [ -n "$CF_API_TOKEN" ] && [ -n "$CF_ZONE_ID" ]; then
196:               RESPONSE=$(curl -s -w "\n%{http_code}" -X POST \
197:                 "https://api.cloudflare.com/client/v4/zones/${CF_ZONE_ID}/purge_cache" \
198:                 -H "Authorization: Bearer ${CF_API_TOKEN}" \
199:                 -H "Content-Type: application/json" \
200:                 --data "{\"files\":[\"${R2_PUBLIC_URL}/releases/latest.json\"]}")
201:               HTTP_CODE=$(echo "$RESPONSE" | tail -1)
202:               echo "CF purge after rollback: HTTP $HTTP_CODE"
203:             fi
204:             echo "ROLLBACK_STATUS=success" >> $GITHUB_ENV
205:           else
206:             echo "::error::Rollback FAILED — latest.json may be in broken state"
207:             echo "ROLLBACK_STATUS=failed" >> $GITHUB_ENV
208:           fi
209: 
210:       - name: Notify publish result
211:         if: always()
212:         env:
213:           SLACK_WEBHOOK: ${{ secrets.VITE_SLACK_WEBHOOK_URL }}
214:           VERSION: ${{ inputs.version }}
215:         run: |
216:           RUN_URL="${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}"
217:           if [ "${{ job.status }}" = "success" ]; then
218:             TEXT=":white_check_mark: *Release published* — v${VERSION} | <${RUN_URL}|View run>"
219:           elif [ "$ROLLBACK_STATUS" = "success" ]; then
220:             TEXT=":x: *Release publish FAILED* — v${VERSION} | :white_check_mark: latest.json rolled back | <${RUN_URL}|View run>"
221:           elif [ "$ROLLBACK_STATUS" = "failed" ]; then
222:             TEXT=":rotating_light: *Release publish FAILED + Rollback FAILED* — v${VERSION} — latest.json 수동 확인 필요 | <${RUN_URL}|View run>"
223:           else
224:             TEXT=":x: *Release publish FAILED* — v${VERSION} | <${RUN_URL}|View run>"
225:           fi
226:           if [ -n "$SLACK_WEBHOOK" ]; then
