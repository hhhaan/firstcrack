493:                 selectedBeanId={selectedBeanId}
494:                 fallbackBeanName={handoffBeanName}
495:                 onTargetProfileChange={handleTargetProfileChange}
496:                 onBeanChange={setSelectedBeanId}
497:                 onOpenRoastSettings={onOpenRoastSettings}
498:             />
499: 
500:             {isFullscreen && (
501:                 <LiveReadings
502:                     rawBT={rawBT}
503:                     rawET={rawET}
504:                     displayRoR={displayRoR}
505:                     unit={unit}
506:                     phase={roastPhaseName}
