 57:         mutationFn: roastProfileApi.delete,
 58:         onSuccess: (_, id) => {
 59:             qc.invalidateQueries({ queryKey: roastProfileKeys.all(userId) });
 60:             qc.removeQueries({ queryKey: roastProfileKeys.detail(id) });
 61:         },
 62:     });
