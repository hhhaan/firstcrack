135: 
136: export const dayPlanRangeApi = {
137:     listSummary: async (userId: string, startDate: string, endDate: string): Promise<DayPlanSummary[]> => {
138:         const batches = await planBatchApi.listForDateRange(userId, startDate, endDate);
139:         const summaryMap = new Map<string, DayPlanSummary>();
140: 
141:         for (const batch of batches) {
142:             const date = batch.scheduled_date;
143:             if (!date) continue;
144: 
145:             if (!summaryMap.has(date)) {
146:                 summaryMap.set(date, {
147:                     date,
148:                     plan_id: batch.plan_id,
149:                     pending: 0,
150:                     in_progress: 0,
151:                     done: 0,
152:                     skipped: 0,
153:                     batches: [],
154:                 });
155:             }
156: 
157:             const summary = summaryMap.get(date)!;
158:             summary.batches.push({
159:                 id: batch.id,
160:                 bean_name: batch.bean_name,
161:                 status: batch.status,
162:                 order_index: batch.order_index,
163:                 batch_count: batch.batch_count,
164:                 target_roasted_kg: batch.target_roasted_kg,
