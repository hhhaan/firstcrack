288:     async def test_reconnect_survives_more_than_three_failures(self, manager, monkeypatch):
289:         """백오프 3회 소진 후에도 포기하지 않고 마지막 간격으로 계속 재시도한다."""
290:         import config
291:         monkeypatch.setattr(config, "RECONNECT_BACKOFFS", [0.01, 0.01, 0.01])
292: 
293:         adapter = FlakyConnectAdapter(fail_times=5)  # 기존 로직이면 3회 후 포기 → 실패
294:         manager._adapter = adapter
295:         manager._connected = False
296:         manager._roaster_key = "test"
297:         manager._protocol = "virtual"
298:         manager._merged_params = {}
299: 
300:         manager._reconnect_task = asyncio.create_task(manager._reconnect_loop())
301:         await asyncio.wait_for(manager._reconnect_task, timeout=2.0)
302: 
303:         assert manager._connected is True
304:         assert adapter.connect_call_count == 6  # 실패 5 + 성공 1
305:         assert manager._error is None
306:         assert manager._reconnect_attempt == 0
307: 
308:     async def test_reconnect_stops_when_adapter_removed(self, manager, monkeypatch):
309:         """disconnect로 어댑터가 제거되면 루프가 종료된다."""
310:         import config
311:         monkeypatch.setattr(config, "RECONNECT_BACKOFFS", [0.01])
312: 
313:         adapter = FlakyConnectAdapter(fail_times=10_000)
314:         manager._adapter = adapter
315:         manager._connected = False
316: 
317:         task = asyncio.create_task(manager._reconnect_loop())
318:         await asyncio.sleep(0.05)
319:         manager._adapter = None  # disconnect 상당
