 1: import type { RoastersResponse, SerialPort, SidecarStatus, TemperatureReading } from '@entities/machine';
 2: import { logger } from './logger';
 3: 
 4: const BASE = 'http://127.0.0.1:9999';
 5: 
 6: async function request<T>(path: string, init?: RequestInit): Promise<T> {
 7:     try {
 8:         const res = await fetch(`${BASE}${path}`, {
 9:             headers: { 'Content-Type': 'application/json' },
10:             ...init,
11:             signal: AbortSignal.timeout(5000),
12:         });
13:         if (!res.ok) {
14:             const body = await res.json().catch(() => ({}));
15:             const msg = (body as { error?: string }).error ?? `HTTP ${res.status}`;
16:             logger.error(`[sidecar] ${init?.method ?? 'GET'} ${path} 실패:`, msg);
17:             throw new Error(msg);
18:         }
19:         return res.json() as Promise<T>;
20:     } catch (err) {
21:         if (!(err instanceof Error && err.message.startsWith('HTTP'))) {
22:             logger.error(`[sidecar] ${path} 네트워크 오류:`, err);
23:         }
24:         throw err;
25:     }
26: }
27: 
28: export const sidecar = {
29:     getRoasters: () => request<RoastersResponse>('/roasters'),
30: 
31:     getStatus: () => request<SidecarStatus>('/status'),
32: 
33:     connect: (roasterKey: string, params: Record<string, unknown>) =>
34:         request<SidecarStatus>('/connect', {
35:             method: 'POST',
36:             body: JSON.stringify({ roaster: roasterKey, ...params }),
37:         }),
38: 
39:     disconnect: () => request<SidecarStatus>('/disconnect', { method: 'POST' }),
40: 
41:     getTemperatures: () => request<TemperatureReading>('/temperatures'),
42: 
43:     // READY 버튼과 연동 — 가상 머신에 standby 진입 알림 (생두 투입 시뮬레이션 시작)
44:     enterStandby: () => request<{ ok: boolean }>('/standby', { method: 'POST' }),
45: 
46:     // Charge 버튼과 연동 — 시뮬레이터 타이머 리셋 + RoR 윈도우 초기화
47:     startRoast: () => request<{ ok: boolean }>('/start', { method: 'POST' }),
48: 
49:     // 로스트 종료/리셋 — 어댑터 상태를 초기화해 다음 로스트를 예열 상태에서 시작
50:     resetRoast: () => request<{ ok: boolean }>('/reset', { method: 'POST' }),
