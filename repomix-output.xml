462:         phase,
463:         onToggleFullscreen: toggleFullscreen,
464:         onExitFullscreen: exitFullscreen,
465:         onEnterStandby: handleEnterStandby,
466:         onManualCharge: handleManualCharge,
467:         onMarkEvent: markEvent,
468:         onMarkDrop: handleMarkDrop,
469:     });
470: 
