829:             dataZoom: [
830:                 {
831:                     type: 'inside',
832:                     xAxisIndex: 0,
833:                     zoomOnMouseWheel: true,
834:                     moveOnMouseMove: false,
835:                     moveOnMouseWheel: true,
836:                 },
837:             ],
838:         };
839:     }, [
840:         xs,
841:         btTarget,
842:         targetXs,
843:         targetBt,
844:         btActual,
845:         etActual,
846:         rorActual,
847:         eventMarkers,
848:         turningPoints,
849:         temperatureUnit,
850:         showET,
851:         showTargetCurve,
852:         showRoR,
853:         showRoRET,
854:         rorEtActual,
855:         controlData,
856:         phaseSegments,
857:         resolvedTheme,
858:     ]);
859: 
860:     // 옵션 적용 — controlData/phaseBar/target 유무가 바뀌면 grid/axis/series 구조가 달라지므로 notMerge로 완전 교체
861:     const prevHasControlData = useRef(!!controlData);
862:     const prevHasPhaseBar = useRef(phaseSegments.length > 0);
863:     const prevHasTargetData = useRef(!!(targetXs?.length && targetBt?.length));
864:     useEffect(() => {
865:         const chart = chartInstanceRef.current;
866:         if (!chart) return;
867:         const hasPhaseBar = phaseSegments.length > 0;
868:         const hasTargetData = !!(targetXs?.length && targetBt?.length);
869:         const structureChanged =
870:             prevHasControlData.current !== !!controlData ||
871:             prevHasPhaseBar.current !== hasPhaseBar ||
872:             prevHasTargetData.current !== hasTargetData;
873:         prevHasControlData.current = !!controlData;
874:         prevHasPhaseBar.current = hasPhaseBar;
875:         prevHasTargetData.current = hasTargetData;
876:         chart.setOption(option, {
877:             notMerge: structureChanged,
878:             lazyUpdate: !structureChanged,
879:         });
880:         // eslint-disable-next-line react-hooks/exhaustive-deps
881:     }, [option]);
882: 
883:     // 마우스 호버
884:     useEffect(() => {
885:         const chart = chartInstanceRef.current;
886:         if (!chart || !onCursorIdx) return;
887: 
888:         // eslint-disable-next-line @typescript-eslint/no-explicit-any
889:         const handleMouseMove = (e: any) => {
890:             const pixel: [number, number] = [e.offsetX, e.offsetY];
891:             const point = chart.convertFromPixel({ xAxisIndex: 0 }, pixel);
892:             if (point && xs.length) {
893:                 const idx = xs.reduce(
894:                     (prev, curr, i) => (Math.abs(curr - point[0]) < Math.abs(xs[prev] - point[0]) ? i : prev),
895:                     0,
896:                 );
897:                 onCursorIdx(idx);
898:             }
899:         };
900: 
901:         chart.on('mousemove', handleMouseMove);
902:         const handleGlobalOut = () => onCursorIdx(null);
903:         chart.on('globalout', handleGlobalOut);
904:         return () => {
905:             chart.off('mousemove', handleMouseMove);
906:             chart.off('globalout', handleGlobalOut);
907:         };
908:     }, [xs, onCursorIdx]);
909: 
910:     // ── 마커 드래그 (chart.getZr()로 마크라인 핸들 감지) ──────────
911:     useEffect(() => {
912:         const chart = chartInstanceRef.current;
913:         if (!chart || !onEventMarkerDrag) return;
914: 
915:         const zr = chart.getZr();
916:         if (!zr) return;
917: 
918:         const handleZrPointerDown = (e: Record<string, unknown>) => {
919:             if (!chart) return;
920:             const evt = e.event as MouseEvent | undefined;
921:             const mx = evt?.offsetX ?? (e.offsetX as number);
922:             if (mx == null) return;
923:             const yMid = (chart.convertToPixel({ yAxisIndex: 0 }, 150) as number) ?? 200;
924:             for (const marker of eventMarkers) {
925:                 const pixel = chart.convertToPixel({ xAxisIndex: 0 }, [marker.timeSec, yMid]);
926:                 if (pixel == null) continue;
927:                 const px = Array.isArray(pixel) ? pixel[0] : pixel;
928:                 const dist = Math.abs(mx - px);
929:                 if (dist <= PIXEL_THRESHOLD) {
930:                     dragStateRef.current = {
931:                         active: true,
932:                         eventName: marker.event,
933:                         startX: mx,
934:                         startTimeSec: marker.timeSec,
935:                     };
936:                     break;
937:                 }
938:             }
939:         };
940: 
941:         const handleZrPointerMove = (e: Record<string, unknown>) => {
942:             const ds = dragStateRef.current;
943:             if (!ds || !ds.active || !chart) return;
944:             const evt = e.event as MouseEvent | undefined;
945:             const mx = evt?.offsetX ?? (e.offsetX as number);
946:             const my = evt?.offsetY ?? (e.offsetY as number);
947:             if (mx == null) return;
948:             const point = chart.convertFromPixel({ xAxisIndex: 0 }, [mx, my]);
949:             if (!point) return;
950:             const xVal = Array.isArray(point) ? point[0] : point;
951:             const clamped = Math.max(0, Math.round(xVal));
952:             if (clamped !== ds.startTimeSec) {
953:                 onEventMarkerDrag(ds.eventName, clamped);
954:                 dragStateRef.current = { ...ds, startTimeSec: clamped };
955:             }
956:         };
957: 
958:         const handleZrPointerUp = () => {
959:             if (dragStateRef.current) {
960:                 dragStateRef.current = null;
961:             }
962:         };
963: 
964:         zr.on('mousedown', handleZrPointerDown);
965:         zr.on('mousemove', handleZrPointerMove);
966:         zr.on('mouseup', handleZrPointerUp);
967: 
968:         return () => {
969:             zr.off('mousedown', handleZrPointerDown);
970:             zr.off('mousemove', handleZrPointerMove);
971:             zr.off('mouseup', handleZrPointerUp);
972:         };
973:     }, [eventMarkers, onEventMarkerDrag]);
974: 
975:     return (
976:         <div style={{ position: 'relative', width: '100%', height: `${height}px`, minHeight: '300px' }}>
977:             <div ref={chartRef} style={{ width: '100%', height: '100%' }} />
978:             {controlData && (
979:                 <div className="absolute flex items-center gap-4" style={{ bottom: -5, left: 25 }}>
980:                     {[
981:                         { color: CONTROL_COLORS.drum, label: 'Drum' },
982:                         { color: CONTROL_COLORS.heat, label: 'Heat' },
983:                         { color: CONTROL_COLORS.fan, label: 'Fan' },
984:                     ].map(({ color, label }) => (
985:                         <div key={label} className="flex items-center gap-1.5">
986:                             <div style={{ width: 16, height: 2, background: color }} />
987:                             <span className="text-[11px] text-muted tracking-[0.14px]">{label}</span>
988:                         </div>
989:                     ))}
990:                 </div>
991:             )}
992:         </div>
993:     );
994: };
</file>

