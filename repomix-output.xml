251:                                         {colLabel(col.key || col.label)}
252:                                         {col.sortable && col.key && (
253:                                             <SortIcon col={col.key as SortKey} sortKey={sortKey} sortAsc={sortAsc} />
254:                                         )}
255:                                     </span>
256:                                 </th>
257:                             );
258:                         })}
259:                     </tr>
260:                 </thead>
261:                 <tbody>
262:                     {sessions.map((session) => {
263:                         const isExpanded = expandedId === session.id;
264:                         return (
265:                             <Fragment key={session.id}>
266:                                 <tr
267:                                     onClick={() => onRowClick(session.id)}
268:                                     className={`cursor-pointer border-b border-border-subtle dark:border-[#585d61] transition ${isExpanded ? 'bg-[rgba(245,245,245,0.5)] dark:bg-[rgba(38,43,48,0.5)]' : 'hover:bg-[rgba(245,242,239,0.45)] dark:hover:bg-[rgba(38,43,48,0.45)]'}`}
269:                                 >
270:                                     {columns.map((col, idx) => {
271:                                         const cellClass =
272:                                             col.key === 'date'
273:                                                 ? 'font-mono text-muted'
274:                                                 : col.key === 'bean'
275:                                                   ? 'font-medium tracking-[0.14px] text-primary'
276:                                                   : 'tracking-[0.14px] text-secondary';
277:                                         const responsiveClass = col.hideOnMd ? 'md:hidden lg:table-cell' : '';
278:                                         const cellTitle = getCellTitle(col, session);
279:                                         return (
280:                                             <td
281:                                                 key={col.key || idx}
282:                                                 title={cellTitle}
283:                                                 className={`overflow-hidden px-3 py-3 text-[13px] whitespace-nowrap ${cellClass} ${responsiveClass}`}
284:                                                 style={{ width: col.width }}
285:                                             >
286:                                                 {col.render(session)}
287:                                             </td>
288:                                         );
289:                                     })}
290:                                 </tr>
291:                                 {isExpanded && <ExpandedRow session={session} />}
292:                             </Fragment>
293:                         );
294:                     })}
295:                 </tbody>
296:             </table>
297: 
298:             <div className="flex flex-col gap-3 border-t border-border-subtle dark:border-[#585d61] px-5 py-3 sm:flex-row sm:items-center sm:justify-between">
299:                 <span className="text-xs tracking-[0.14px] text-muted">
300:                     {filteredTotal === 0
301:                         ? t('history.noSessionsFound')
302:                         : `${t('history.pagination', { start, end, total: filteredTotal })}${filteredTotal < total ? t('history.filteredFrom', { count: total }) : ''}`}
303:                 </span>
304: 
305:                 <div className="flex items-center gap-1">
306:                     <button
307:                         type="button"
308:                         onClick={() => onPageChange(page - 1)}
309:                         disabled={page === 1}
310:                         className="flex h-6 w-6 items-center justify-center rounded text-muted transition hover:bg-surface hover:text-primary disabled:opacity-30 disabled:cursor-not-allowed"
311:                     >
312:                         <ChevronLeft size={13} strokeWidth={2} />
313:                     </button>
314: 
315:                     {Array.from({ length: totalPages }, (_, i) => i + 1)
316:                         .filter((p) => p === 1 || p === totalPages || Math.abs(p - page) <= 1)
317:                         .reduce<(number | '…')[]>((acc, p, i, arr) => {
318:                             if (i > 0 && p - (arr[i - 1] as number) > 1) acc.push('…');
319:                             acc.push(p);
320:                             return acc;
321:                         }, [])
322:                         .map((item, i) =>
323:                             item === '…' ? (
324:                                 <span key={`ellipsis-${i}`} className="px-1 text-xs text-muted">
325:                                     …
326:                                 </span>
327:                             ) : (
328:                                 <button
329:                                     key={item}
330:                                     onClick={() => onPageChange(item as number)}
331:                                     className={`h-6 min-w-6 rounded px-1.5 text-xs font-medium transition ${
332:                                         page === item
333:                                             ? 'bg-surface-warm-solid text-primary'
334:                                             : 'text-muted hover:bg-surface hover:text-secondary'
335:                                     }`}
336:                                 >
337:                                     {item}
338:                                 </button>
339:                             ),
340:                         )}
341: 
342:                     <button
343:                         onClick={() => onPageChange(page + 1)}
344:                         disabled={page === totalPages || totalPages === 0}
345:                         className="flex h-6 w-6 items-center justify-center rounded text-muted transition hover:bg-surface hover:text-primary disabled:opacity-30 disabled:cursor-not-allowed"
346:                     >
347:                         <ChevronRight size={13} strokeWidth={2} />
348:                     </button>
349:                 </div>
350:             </div>
351:         </div>
352:     );
353: };
</file>

