 84: const fmtSec = (v: number) => {
 85:     const sign = v < 0 ? '-' : '';
 86:     const abs = Math.abs(v);
 87:     const m = Math.floor(abs / 60);
 88:     const s = Math.round(abs % 60);
 89:     return `${sign}${m}:${String(s).padStart(2, '0')}`;
 90: };
 91: 
 92: /** Approximate perceived brightness of a hex color (0–255). */
 93: const luminance = (hex: string): number => {
 94:     const c = hex.replace('#', '');
 95:     if (c.length < 6) return 255;
 96:     const r = parseInt(c.substring(0, 2), 16);
 97:     const g = parseInt(c.substring(2, 4), 16);
 98:     const b = parseInt(c.substring(4, 6), 16);
 99:     return (r * 299 + g * 587 + b * 114) / 1000;
100: };
