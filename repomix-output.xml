261: # ---------------------------------------------------------------------------
262: # _reconnect_loop — infinite retry
263: # ---------------------------------------------------------------------------
264: 
265: class FlakyConnectAdapter:
266:     """connect가 fail_times번 실패한 뒤 성공하는 페이크."""
267: 
268:     def __init__(self, fail_times: int):
269:         self._remaining_failures = fail_times
270:         self.connect_call_count = 0
271:         self.connected = False
272: 
273:     async def connect(self) -> None:
274:         self.connect_call_count += 1
275:         if self._remaining_failures > 0:
276:             self._remaining_failures -= 1
277:             raise ConnectionError("simulated failure")
278:         self.connected = True
279: 
280:     async def disconnect(self) -> None:
281:         self.connected = False
282: 
283:     async def read(self):
284:         raise RuntimeError("not used")
285: 
286: 
