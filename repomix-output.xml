100: // 비교 모드용 — paths 순서대로 결과 배열 반환. 각 fallbackKey는 캐시 충돌 방지용.
101: export const useRoastProfileCurves = (paths: (string | null | undefined)[], fallbackKeys: string[] = []) =>
102:     useQueries({
103:         queries: paths.map((p, i) => curveQueryConfig(p, fallbackKeys[i])),
104:     });
105: 
106: export type { RoastProfileWithSource };
107: 
108: // ── Profile Bean History ──────────────────────────────────────────────────────
109: 
110: export type BeanHistoryItem = {
111:     name: string;
112:     count: number;
113:     lastDate: string;
114: };
115: 
116: export const useProfileBeanHistory = (profileId: string) =>
117:     useQuery({
118:         queryKey: ['profile-bean-history', profileId],
119:         queryFn: async (): Promise<BeanHistoryItem[]> => {
120:             const { data, error } = await supabase
121:                 .from('roast_sessions')
122:                 .select('bean_id, roasted_at, beans(name)')
123:                 .eq('profile_id', profileId)
124:                 .not('bean_id', 'is', null)
125:                 .order('roasted_at', { ascending: false });
126:             if (error) throw error;
127: 
128:             const grouped: Record<string, { name: string; count: number; lastDate: string }> = {};
129:             for (const s of data ?? []) {
130:                 if (!s.bean_id) continue;
131:                 if (!grouped[s.bean_id]) {
132:                     grouped[s.bean_id] = {
133:                         name: (s.beans as { name: string } | null)?.name ?? 'Unknown',
134:                         count: 0,
135:                         lastDate: s.roasted_at ?? '',
136:                     };
137:                 }
138:                 grouped[s.bean_id].count++;
139:             }
140:             return Object.values(grouped).sort((a, b) => b.count - a.count);
141:         },
142:         enabled: !!profileId,
143:     });
