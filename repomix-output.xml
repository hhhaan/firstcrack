<file path="src/views/active-roast/lib/display-derivatives.ts">
 1: import { EVENT_MARKER_COLORS, getResolvedEventColor } from '@features/active-roast/lib/chart-config';
 2: import { formatTemp, toDisplayTemp } from '@features/active-roast/lib/temperature';
 3: import { parseTimeSec } from '@features/active-roast/lib/time';
 4: import type { TemperatureUnit } from '@features/active-roast/model/settings';
 5: import type { LogEntry } from '@shared/types/roast';
 6: import type { LiveRoastPoint } from '../model/useSidecarPolling';
 7: import type { RoastEventMarker } from '../ui/RoastTempChart';
 8: 
 9: export interface DevTimeResult {
10:     devTimeStr: string;
11:     dtrPct: number | null;
12: }
13: 
14: /** Development 시간 및 DTR 비율 계산 */
15: export const calcDevTime = (fcStartEntry: LogEntry | undefined, elapsed: number): DevTimeResult => {
16:     if (!fcStartEntry || elapsed === 0) return { devTimeStr: '—', dtrPct: null };
17:     const devSec = elapsed - parseTimeSec(fcStartEntry.time);
18:     if (devSec <= 0) return { devTimeStr: '—', dtrPct: null };
19:     const pct = Math.round((devSec / elapsed) * 100);
20:     return {
21:         devTimeStr: `${Math.floor(devSec / 60)}:${String(devSec % 60).padStart(2, '0')} (${pct}%)`,
22:         dtrPct: pct,
23:     };
24: };
25: 
26: export interface DeltaResult {
27:     deltaBT: string | null;
28:     deltaET: string | null;
29: }
30: 
31: /** ΔBT, ΔET — 30초 전 대비 현재 온도 변화량 (pre-charge 포인트 제외) */
32: export const calcDelta = (livePoints: LiveRoastPoint[], unit: TemperatureUnit): DeltaResult => {
33:     const postChargePoints = livePoints.filter((p) => p.time >= 0);
34:     if (postChargePoints.length < 2) return { deltaBT: null, deltaET: null };
35:     const current = postChargePoints[postChargePoints.length - 1];
36:     const targetTime = current.time - 30;
37:     const past = postChargePoints.reduce((prev, curr) =>
38:         Math.abs(curr.time - targetTime) < Math.abs(prev.time - targetTime) ? curr : prev,
39:     );
40:     if (past === current) return { deltaBT: null, deltaET: null };
41:     const dbt = toDisplayTemp(current.bt, unit) - toDisplayTemp(past.bt, unit);
42:     const det =
43:         current.et != null && past.et != null ? toDisplayTemp(current.et, unit) - toDisplayTemp(past.et, unit) : null;
44:     return {
45:         deltaBT: dbt.toFixed(1),
46:         deltaET: det != null ? det.toFixed(1) : null,
47:     };
48: };
49: 
50: /** 이벤트 로그를 ECharts 마커 배열로 변환 */
51: export const buildEventMarkers = (logEntries: LogEntry[]): RoastEventMarker[] =>
52:     logEntries
53:         .filter((e) => EVENT_MARKER_COLORS[e.event] && e.event !== 'TP' && e.event !== 'Note')
54:         .map((e) => {
55:             const [min, sec] = e.time.split(':').map(Number);
56:             const timeSec = Math.max(0, min * 60 + sec);
57:             return { timeSec, event: e.event, color: getResolvedEventColor(e.event) };
58:         });
59: 
60: export interface RoastLogDisplayEntry extends LogEntry {
61:     current?: boolean;
62: }
63: 
64: /** 로그 표시용 엔트리 배열 (현재 진행 중 표시 + 정렬) */
65: export const buildRoastLogDisplayEntries = (
66:     logEntries: LogEntry[],
67:     roastEnded: boolean,
68:     charged: boolean,
69:     timeStr: string,
70:     rawBT: number | null,
71:     roastPhaseName: string,
72:     unit: TemperatureUnit,
73: ): RoastLogDisplayEntry[] => {
74:     const sorted = [...logEntries].sort((a, b) => parseTimeSec(a.time) - parseTimeSec(b.time));
75:     return [
76:         ...sorted,
77:         ...(!roastEnded && charged
78:             ? [
79:                   {
80:                       time: timeStr,
81:                       event: 'Now',
82:                       temp: formatTemp(rawBT, unit),
83:                       note: `${roastPhaseName} in progress`,
84:                       current: true,
85:                   },
86:               ]
87:             : []),
88:     ];
89: };
</file>

