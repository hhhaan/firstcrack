 80: export const useResolvedProfileCurve = (profile: RoastProfileWithSource | null) => {
 81:     const tsvPath = profile ? resolveTsvPath(profile) : null;
 82:     const { data: real = [], isLoading, isError } = useRoastProfileCurve(tsvPath);
 83:     const synthetic = useMemo(
 84:         () =>
 85:             profile
 86:                 ? generateProfileCurve(profile.drop_temp_celsius ?? 200, profile.duration_sec ?? 720).map((p) => ({
 87:                       t: p.t,
 88:                       bt: p.bt,
 89:                       et: null as number | null,
 90:                       ror: null as number | null,
 91:                   }))
 92:                 : [],
 93:         [profile],
 94:     );
 95:     const points = real.length > 0 ? real : synthetic;
 96:     const source: ProfileCurveSource = real.length > 0 ? 'session' : synthetic.length > 0 ? 'synthetic' : 'none';
 97:     return { points, source, isLoading, isError };
 98: };
