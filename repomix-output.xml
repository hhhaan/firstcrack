 65: // TSV는 세션당 immutable — 한 번 fetch 후 영구 캐시.
 66: const curveQueryConfig = (tsvPath: string | null | undefined, fallbackKey?: string) => ({
 67:     queryKey: tsvPath ? roastProfileKeys.curve(tsvPath) : ['roast_profile_curve', 'none', fallbackKey ?? ''],
 68:     queryFn: async (): Promise<TsvPoint[]> => {
 69:         if (!tsvPath) return [];
 70:         return parseTsv(await fetchTsvFromR2(tsvPath));
 71:     },
 72:     enabled: !!tsvPath,
 73:     staleTime: Infinity,
 74:     gcTime: Infinity,
 75: });
