<file path="supabase/migrations/20260619000002_fix_stock_events_rls.sql">
 1: -- Fix RLS: add bean ownership check to prevent cross-user stock manipulation.
 2: -- The original FOR ALL USING only validates user_id = auth.uid(), allowing a user
 3: -- to insert events for another user's bean by setting bean_id to a foreign bean_id.
 4: 
 5: DROP POLICY IF EXISTS "users see own stock events" ON bean_stock_events;
 6: 
 7: CREATE POLICY "users see own stock events" ON bean_stock_events
 8:     FOR ALL
 9:     USING (auth.uid() = user_id)
10:     WITH CHECK (
11:         auth.uid() = user_id
12:         AND EXISTS (
13:             SELECT 1 FROM beans
14:             WHERE beans.id = bean_stock_events.bean_id
15:               AND beans.user_id = auth.uid()
16:         )
17:     );
</file>

