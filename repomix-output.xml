408:     /**
409:      * List batches for a date range, merging recurrence rules with exception rows.
410:      * This is the rendering-time entry point — computes instances on the fly.
411:      *
412:      * @returns Array of PlanBatch-like objects (includes recurrence metadata)
413:      */
414:     listForDateRange: async (userId: string, startDate: string, endDate: string): Promise<PlanBatchWithProgress[]> => {
415:         // 1. Get active recurrence rules
416:         const rules = await recurrenceRuleApi.listActive(userId);
417: 
418:         // 2. Get one-off batches in the range
419:         const { data: plans, error: plansError } = await supabase
420:             .from('roast_day_plans')
421:             .select('id, date')
422:             .eq('user_id', userId)
423:             .gte('date', startDate)
424:             .lte('date', endDate);
425:         if (plansError) throw plansError;
426: 
427:         const dateToPlanId = new Map((plans ?? []).map((p) => [p.date, p.id]));
428:         const planIds = (plans ?? []).map((p) => p.id);
429: 
430:         // Get sessions for progress
431:         const { data: sessions, error: sessionsError } = await supabase
432:             .from('roast_sessions')
433:             .select('plan_batch_id')
434:             .not('plan_batch_id', 'is', null);
435:         if (sessionsError) throw sessionsError;
436: 
437:         const sessionCountMap = new Map<string, number>();
438:         for (const s of sessions ?? []) {
439:             if (s.plan_batch_id) {
440:                 sessionCountMap.set(s.plan_batch_id, (sessionCountMap.get(s.plan_batch_id) ?? 0) + 1);
441:             }
442:         }
443: 
444:         // 3. Get exception rows for recurrence rules in the date range
445:         const { data: exceptions, error: exceptionsError } = await supabase
446:             .from('roast_plan_batches')
447:             .select('*')
448:             .not('recurrence_rule_id', 'is', null)
449:             .gte('scheduled_date', startDate)
450:             .lte('scheduled_date', endDate);
451:         if (exceptionsError) throw exceptionsError;
452: 
453:         // 4. Get one-off batches (no recurrence_rule_id)
454:         const { data: oneOffBatches, error: oneOffError } = await supabase
455:             .from('roast_plan_batches')
456:             .select('*')
457:             .is('recurrence_rule_id', null)
458:             .in('plan_id', planIds);
459:         if (oneOffError) throw oneOffError;
460: 
461:         // Build result from one-off batches
462:         const result: PlanBatchWithProgress[] = (oneOffBatches ?? []).map((row) => ({
463:             ...row,
464:             completed_sessions: sessionCountMap.get(row.id) ?? 0,
465:         }));
466: 
467:         // 5. For each active recurrence rule, expand and merge with exceptions
468:         const rangeStart = new Date(startDate + 'T00:00:00');
469:         const rangeEnd = new Date(endDate + 'T23:59:59');
470: 
471:         // Dynamic import to avoid circular dependency
472:         const { expandRRuleInRange, mergeRecurrenceExceptions } = await import('@shared/lib/rrule');
473: 
474:         for (const rule of rules) {
475:             if (rule.status !== 'active') continue;
476: 
477:             // Check if rule is within range
478:             const ruleStart = new Date(rule.dtstart + 'T00:00:00');
479:             if (rule.until && new Date(rule.until + 'T23:59:59') < rangeStart) continue;
480: 
481:             // Expand dates in range
482:             const expandedDates = expandRRuleInRange(
483:                 rule.rrule,
484:                 ruleStart,
485:                 rangeStart,
486:                 rule.until ? new Date(rule.until + 'T23:59:59') : rangeEnd,
487:             );
488: 
489:             // Filter exceptions for this rule
490:             const ruleExceptions = (exceptions ?? [])
491:                 .filter((ex) => ex.recurrence_rule_id === rule.id)
492:                 .map((ex) => ({
493:                     original_date: ex.original_date ?? '',
494:                     scheduled_date: ex.scheduled_date ?? '',
495:                     exception_type: ex.exception_type as 'modified' | 'cancelled',
496:                     batch_size_kg: ex.batch_size_kg,
497:                     target_roasted_kg: ex.target_roasted_kg,
498:                     bean_id: ex.bean_id,
499:                     bean_name: ex.bean_name,
500:                     machine_id: ex.machine_id,
501:                     roast_profile_id: ex.roast_profile_id,
502:                     notes: ex.notes,
503:                     status: ex.status,
504:                 }));
505: 
506:             // Merge
507:             const instances = mergeRecurrenceExceptions(expandedDates, ruleExceptions);
508: 
509:             // For each instance, get or create the day plan and produce a batch-like row
510:             for (const instance of instances) {
511:                 if (instance.exceptionType === 'cancelled') continue;
512: 
513:                 if (instance.exceptionType === 'modified' && instance.exception) {
514:                     // Use exception data
515:                     const exBatch = exceptions?.find((e) => e.original_date === instance.originalDate);
516:                     if (exBatch) {
517:                         result.push({
518:                             ...exBatch,
519:                             completed_sessions: sessionCountMap.get(exBatch.id) ?? 0,
520:                         });
521:                     }
522:                 } else if (instance.exceptionType === 'normal') {
523:                     const planId = dateToPlanId.get(instance.date) ?? '';
524: 
525:                     const batchSize = Number(rule.batch_size_kg) || 0;
526:                     const targetKg = Number(rule.target_roasted_kg) || 0;
527:                     const batchCount = batchSize > 0 && targetKg > 0 ? Math.ceil(targetKg / batchSize) : 1;
528: 
529:                     result.push({
530:                         id: `${rule.id}:${instance.originalDate}`,
531:                         plan_id: planId,
532:                         bean_name: rule.bean_name,
533:                         bean_id: rule.bean_id,
534:                         blend_id: rule.blend_id ?? null,
535:                         batch_type: rule.batch_type,
536:                         batch_size_kg: rule.batch_size_kg,
537:                         target_roasted_kg: rule.target_roasted_kg,
538:                         batch_count: batchCount,
539:                         yield_pct: rule.yield_pct,
540:                         order_index: 0,
541:                         machine_id: rule.machine_id,
542:                         roast_profile_id: rule.roast_profile_id,
543:                         rrule: rule.rrule,
544:                         recurrence_group_id: null,
545:                         recurrence_rule_id: rule.id,
546:                         scheduled_date: instance.date,
547:                         original_date: instance.originalDate,
548:                         exception_type: null,
549:                         notes: rule.notes,
550:                         green_lot: rule.green_lot,
551:                         status: 'pending',
552:                         created_at: rule.created_at,
553:                         updated_at: rule.updated_at,
554:                         completed_sessions: 0,
555:                     });
556:                 }
557:             }
558:         }
559: 
560:         return result.sort((a, b) => a.order_index - b.order_index || a.bean_name.localeCompare(b.bean_name));
561:     },
562: 
