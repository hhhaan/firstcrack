<file path="src/features/active-roast/lib/buildBlendDeductions.ts">
 1: import type { BlendComponent } from '@entities/blend';
 2: 
 3: export type BlendDeduction = { beanId: string; grams: number };
 4: 
 5: /**
 6:  * Distributes chargeGrams across blend components by ratio_pct.
 7:  * Last component absorbs rounding remainder so total always equals chargeGrams.
 8:  */
 9: export const buildBlendDeductions = (chargeGrams: number, components: BlendComponent[]): BlendDeduction[] => {
10:     if (!components.length) return [];
11:     let allocated = 0;
12:     return components.map((comp, i) => {
13:         const isLast = i === components.length - 1;
14:         const grams = isLast ? chargeGrams - allocated : Math.round(chargeGrams * (Number(comp.ratio_pct) / 100));
15:         allocated += grams;
16:         return { beanId: comp.bean_id, grams };
17:     });
18: };
</file>

<file path="src/features/active-roast/lib/phases.ts">
 1: import type { LogEntry } from '@shared/types/roast';
 2: import { parseTimeSec } from './time';
 3: 
 4: export interface PhaseSegment {
 5:     name: string;
 6:     startSec: number;
 7:     endSec: number;
 8:     durationSec: number;
 9:     pct: number;
10:     color: string;
11: }
12: 
13: const PHASE_FILL_COLORS: Record<string, string> = {
14:     Drying: 'rgba(234,179,8,0.22)',
15:     Maillard: 'rgba(132,204,22,0.22)',
16:     Development: 'rgba(249,115,22,0.22)',
17: };
18: 
19: /**
20:  * logEntries + elapsed로 현재까지의 위상 구간 배열을 반환한다.
21:  * charged(Charge 이후)가 아니면 빈 배열.
22:  */
23: export const computePhaseSegments = (logEntries: LogEntry[], elapsed: number, charged: boolean): PhaseSegment[] => {
24:     if (!charged || elapsed === 0) return [];
25: 
26:     const get = (event: string) => {
27:         const e = logEntries.find((l) => l.event === event);
28:         return e ? parseTimeSec(e.time) : null;
29:     };
30: 
31:     const yellow = get('Yellow');
32:     const fcStart = get('FC Start');
33:     const dropTime = get('Drop') ?? get('End') ?? elapsed;
34: 
35:     const bounds: { name: string; start: number | null; end: number }[] = [
36:         { name: 'Drying', start: 0, end: yellow ?? fcStart ?? dropTime },
37:         { name: 'Maillard', start: yellow, end: fcStart ?? dropTime },
38:         { name: 'Development', start: fcStart, end: dropTime },
39:     ];
40: 
41:     return bounds
42:         .filter((b): b is { name: string; start: number; end: number } => b.start != null && b.end > b.start)
43:         .map((b) => {
44:             const end = Math.min(b.end, elapsed);
45:             const dur = end - b.start;
46:             return {
47:                 name: b.name,
48:                 startSec: b.start,
49:                 endSec: end,
50:                 durationSec: dur,
51:                 pct: Math.round((dur / elapsed) * 100),
52:                 color: PHASE_FILL_COLORS[b.name],
53:             };
54:         });
55: };
</file>

