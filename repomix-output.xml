 49: export const ActiveRoast = ({
 50:     isActive,
 51:     onOpenRoastSettings,
 52:     onPlanBatchComplete,
 53: }: {
 54:     isActive: boolean;
 55:     onOpenRoastSettings?: () => void;
 56:     onPlanBatchComplete?: () => void;
 57: }) => {
 58:     // ── 설정 ──────────────────────────────────────────────────────
 59:     const roastSettings = useRoastSettings();
 60:     const unit = roastSettings.temperatureUnit;
 61: 
 62:     // ── 스토어 구독 ───────────────────────────────────────────────
 63:     const phase = useRoastingStore((s) => s.phase);
 64:     const elapsed = useRoastingStore((s) => s.elapsed);
 65:     const liveData = useRoastingStore((s) => s.liveData);
 66:     const tick = useRoastingStore((s) => s.tick);
 67:     const enterPreheating = useRoastingStore((s) => s.enterPreheating);
 68:     const enterStandby = useRoastingStore((s) => s.enterStandby);
 69:     const storeStartCharge = useRoastingStore((s) => s.startCharge);
 70:     const storeEndRoast = useRoastingStore((s) => s.endRoast);
 71:     const resetStore = useRoastingStore((s) => s.reset);
 72:     const sessionId = useRoastingStore((s) => s.sessionId);
 73:     const sidecarConnected = useRoastingStore((s) => s.sidecarConnected);
 74:     const machineCapabilities = useRoastingStore((s) => s.machineCapabilities);
 75:     const setConnected = useRoastingStore((s) => s.setConnected);
 76: 
 77:     const charged = phase === 'roasting' || phase === 'ended';
 78:     const chargedRef = useRef(charged);
 79:     // eslint-disable-next-line react-hooks/refs
 80:     chargedRef.current = charged;
 81:     const roastEnded = phase === 'ended';
 82: 
 83:     // ── 유저 + DB 프로파일 ────────────────────────────────────────
 84:     const user = useAuthStore((s) => s.user);
 85:     const { data: dbProfiles = [] } = useRoastProfiles(user?.id ?? '');
 86:     const { data: userProfile } = useProfile(user?.id ?? '');
 87: 
 88:     // ── 배치 핸드오프 ─────────────────────────────────────────────
 89:     const planBatchHandoff = useRoastSessionStore((s) => s.planBatchHandoff);
 90:     const incrementCompletedSession = useRoastSessionStore((s) => s.incrementCompletedSession);
 91:     const sessionsAfter = planBatchHandoff?.completedSessions ?? 0;
 92:     const batchDone = planBatchHandoff ? sessionsAfter >= planBatchHandoff.batchCount : false;
 93: 
 94:     // ── UI 상태 ───────────────────────────────────────────────────
 95:     const [targetProfileId, setTargetProfileId] = useState<string | null>(null);
 96:     const userSelectedTargetRef = useRef(false);
 97:     const [selectedBeanId, setSelectedBeanId] = useState<string | null>(null);
 98:     const [handoffBeanName, setHandoffBeanName] = useState<string | null>(null);
 99:     const [isRunning, setIsRunning] = useState(false);
100:     const isRunningRef = useRef(isRunning);
101:     useEffect(() => {
102:         isRunningRef.current = isRunning;
103:     }, [isRunning]);
104: 
105:     const [isFullscreen, setIsFullscreen] = useState(false);
106:     const [showEndRoastModal, setShowEndRoastModal] = useState(false);
107:     const [showSummaryModal, setShowSummaryModal] = useState(false);
108:     const [summaryData, setSummaryData] = useState<RoastSummaryData | null>(null);
109:     const [noteInput, setNoteInput] = useState('');
110:     const [showContinueModal, setShowContinueModal] = useState(false);
111: 
112:     const toggleFullscreen = useCallback(() => setIsFullscreen((prev) => !prev), []);
113:     const exitFullscreen = useCallback(() => setIsFullscreen(false), []);
114: 
115:     // 로그인 후 DB에서 기본 프로파일 ID를 가져와서 targetProfileId에 세팅.
116:     // charged 상태(로스팅 진행 중)에서는 절대 덮어쓰면 안 됨 → 로스팅 중 쿼리 refetch가 일어나도 선택 유지.
117:     // userProfile이 undefined이면 아직 로딩 중이므로 null로 덮어쓰는 오류 방지.
118:     // chargedRef: deps 배열에 charged 없이 최신 값을 읽어 stale closure 버그 방지.
119:     useEffect(() => {
120:         if (chargedRef.current || userSelectedTargetRef.current) return;
121:         if (userProfile !== undefined) {
122:             // eslint-disable-next-line react-hooks/set-state-in-effect
123:             setTargetProfileId(userProfile?.default_roast_profile_id ?? null);
124:         }
125:         // eslint-disable-next-line react-hooks/exhaustive-deps
126:     }, [userProfile?.default_roast_profile_id]);
127: 
128:     // isActive가 true가 될 때마다 store의 pendingBeanId를 소비
129:     useEffect(() => {
130:         if (!isActive) return;
131:         const { pendingBeanId, setPendingBean } = useRoastingStore.getState();
132:         if (pendingBeanId) {
133:             // eslint-disable-next-line react-hooks/set-state-in-effect
134:             setSelectedBeanId(pendingBeanId);
135:             setPendingBean(null);
136:         }
137:     }, [isActive]);
138: 
139:     // planBatchHandoff가 설정되고 로스트 화면이 활성화될 때 bean/profile 적용
140:     useEffect(() => {
141:         if (!isActive || !planBatchHandoff) return;
142:         // eslint-disable-next-line react-hooks/set-state-in-effect
143:         if (planBatchHandoff.beanId) setSelectedBeanId(planBatchHandoff.beanId);
144:         // eslint-disable-next-line react-hooks/set-state-in-effect
145:         setHandoffBeanName(planBatchHandoff.beanName || null);
146:         if (planBatchHandoff.profileId) {
147:             userSelectedTargetRef.current = true;
148:             setTargetProfileId(planBatchHandoff.profileId);
149:         }
150:     }, [isActive, planBatchHandoff]);
151: 
152:     // ── 공유 ref (여러 훅·핸들러에서 참조) ───────────────────────
153:     /** Charge 순간의 Date.now() (ms). 0이면 로스팅 미시작 */
154:     const roastStartTimeRef = useRef(0);
155:     /** TP 확정 시각 (초). null이면 미확정 → RoR 미표시 */
156:     const tpTimeSecRef = useRef<number | null>(null);
157: 
158:     // ── 사이드카 폴링 및 실시간 데이터 ───────────────────────────
159:     const { livePoints, setLivePoints } = useSidecarPolling({
160:         isActive,
161:         phase,
162:         pollIntervalMs: roastSettings.pollIntervalMs,
163:         enterPreheating,
164:         setConnected,
165:         roastStartTimeRef,
166:         sessionId,
167:         preChargeDisplaySec: roastSettings.preChargeDisplaySec,
168:     });
169: 
170:     // ── 차트 데이터 파이프라인 ────────────────────────────────────
171:     const targetProfile = useMemo(
172:         () => dbProfiles.find((p) => p.id === targetProfileId) ?? null,
173:         [dbProfiles, targetProfileId],
174:     );
175:     const { points: targetCurvePoints, source: targetCurveSource } = useResolvedProfileCurve(targetProfile);
176: 
177:     // charge 후: 실제 버퍼에 쌓인 구간과 설정값 중 짧은 쪽을 사용
178:     // (ready → charge 대기 시간이 설정값보다 짧으면 빈 공간 없이 딱 맞게)
179:     const actualPreSec =
180:         charged && livePoints.length > 0 && livePoints[0].time < 0 ? Math.ceil(Math.abs(livePoints[0].time)) : 0;
181:     const effectivePreChargeDisplaySec = charged ? Math.min(roastSettings.preChargeDisplaySec, actualPreSec) : 0;
182: 
183:     const { chartData, targetSeries } = useChartData({
184:         livePoints,
185:         targetCurvePoints,
186:         preChargeDisplaySec: effectivePreChargeDisplaySec,
187:     });
188:     /** 차트 x축 끝값. 데이터가 없으면 전체 범위로 고정 */
189:     const MAX_TIME = chartData.length > 0 ? chartData[chartData.length - 1].time : CHART_TOTAL_SECS;
190:     const MIN_TIME = -effectivePreChargeDisplaySec;
191:     const chartRightGridPad =
192:         roastSettings.showRoRChart || roastSettings.showControlChart ? CHART_GRID_RIGHT_WITH_ROR : CHART_GRID_RIGHT;
193: 
194:     // ── 차트 줌·패닝·드래그 ──────────────────────────────────────
195:     const {
196:         setZoomRange,
197:         effectiveZoomRange,
198:         hoveredChartIndexRef,
199:         setHoveredChartIndex,
200:         isChartDragging,
201:         mainChartHeight,
202:         chartAreaRef,
203:         handleChartWheel,
204:         handleChartPointerDown,
205:         handleChartPointerMove,
206:         endChartDrag,
207:     } = useChartZoom(MAX_TIME, MIN_TIME, chartRightGridPad);
208: 
209:     // fullscreen 진입 시 외부 줌 리셋 — ECharts 내부 zoom이 독립적으로 동작한다
210:     useEffect(() => {
211:         if (isFullscreen) setZoomRange(null);
212:     }, [isFullscreen, setZoomRange]);
213: 
214:     // ── 차트 가시 영역 데이터 ────────────────────────────────────
215:     const visibleChartData = useMemo(
216:         () =>
217:             effectiveZoomRange
218:                 ? chartData.filter((p) => p.time >= effectiveZoomRange.start && p.time <= effectiveZoomRange.end)
219:                 : chartData,
220:         [chartData, effectiveZoomRange],
221:     );
222: 
223:     const { visibleXs, visibleBtActual, visibleEtActual, visibleRorActual, visibleRorEtActual } = useMemo(
224:         () => extractVisibleSeries(visibleChartData, unit),
225:         [visibleChartData, unit],
226:     );
227: 
228:     const { visibleTargetXs, visibleTargetBt } = useMemo(() => {
229:         const points = effectiveZoomRange
230:             ? targetSeries.filter((p) => p.time >= effectiveZoomRange.start && p.time <= effectiveZoomRange.end)
231:             : targetSeries;
232:         return extractVisibleTarget(points, unit);
233:     }, [targetSeries, effectiveZoomRange, unit]);
234: 
235:     const { visibleControlXs, visibleDrumTemp, visibleHeatPower, visibleFanSpeed } = useMemo(() => {
236:         const points = effectiveZoomRange
237:             ? livePoints.filter((p) => p.time >= effectiveZoomRange.start && p.time <= effectiveZoomRange.end)
238:             : livePoints;
239:         return extractVisibleControl(points);
240:     }, [livePoints, effectiveZoomRange]);
241: 
242:     // ── 차트 키보드 줌·패닝 ──────────────────────────────────────
243:     useChartKeyboard({
244:         isActive,
245:         isFullscreen,
246:         showEndRoastModal,
247:         showSummaryModal,
248:         minTime: MIN_TIME,
249:         maxTime: MAX_TIME,
250:         zoomRange: effectiveZoomRange,
251:         setZoomRange,
252:         visibleChartData,
253:         hoveredChartIndexRef,
254:     });
255: 
256:     const handleChartCursorIdx = useCallback(
257:         (idx: number | null) => {
258:             setHoveredChartIndex(idx);
259:         },
260:         [setHoveredChartIndex],
261:     );
262: 
263:     // 머신 disconnect 시 진행 중인 로스트를 초기화한다.
264:     useEffect(() => {
265:         if (sidecarConnected) return;
266:         if (phase === 'idle' || phase === 'ended') return;
267:         // eslint-disable-next-line react-hooks/immutability
268:         resetActiveRoast();
269:         // eslint-disable-next-line react-hooks/exhaustive-deps
270:     }, [sidecarConnected]);
271: 
272:     // ── 타이머 ────────────────────────────────────────────────────
273:     useEffect(() => {
274:         if (!isRunning) return;
275:         const interval = setInterval(() => tick(), 1000);
276:         return () => clearInterval(interval);
277:     }, [isRunning, tick]);
278: 
279:     // 로스팅 중 창 닫기 시 확인 다이얼로그를 표시한다.
280:     useEffect(() => {
281:         if (!('__TAURI_INTERNALS__' in window)) return;
282:         const win = getCurrentWindow();
283:         let unlisten: (() => void) | undefined;
284:         let active = true;
285:         win.onCloseRequested(async (e) => {
286:             if (!isRunningRef.current) return;
287:             e.preventDefault();
288:             const ok = await ask('로스팅이 진행 중입니다. 정말 종료하시겠습니까?', {
289:                 title: '로스팅 진행 중',
290:                 kind: 'warning',
291:                 okLabel: '종료',
292:                 cancelLabel: '취소',
293:             });
294:             if (ok) {
295:                 unlisten?.();
296:                 win.close();
297:             }
298:         }).then((fn) => {
299:             if (active) {
300:                 unlisten = fn;
301:             } else {
302:                 fn();
303:             }
304:         });
305:         return () => {
306:             active = false;
307:             unlisten?.();
308:         };
309:     }, []);
310: 
311:     // ── 실시간 파생값 ─────────────────────────────────────────────
