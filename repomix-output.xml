 4: }
 5: 
 6: const SMOOTH_WINDOW = 7;
 7: const MIN_VALID_POINTS = 15;
 8: const TP_LOOKBACK_SEC = 30;
 9: 
10: const movingAvg = (data: number[], w: number): number[] => {
11:     const half = Math.floor(w / 2);
12:     return data.map((_, i) => {
13:         let sum = 0,
14:             count = 0;
15:         for (let j = Math.max(0, i - half); j <= Math.min(data.length - 1, i + half); j++) {
16:             sum += data[j];
17:             count++;
18:         }
19:         return count > 0 ? sum / count : 0;
20:     });
21: };
22: 
23: const centralDiff = (xs: number[], ys: number[]): number[] =>
24:     ys.map((_, i) => {
25:         if (i === 0) return (ys[1] - ys[0]) / Math.max(1e-9, xs[1] - xs[0]);
26:         if (i === ys.length - 1) return (ys[i] - ys[i - 1]) / Math.max(1e-9, xs[i] - xs[i - 1]);
27:         return (ys[i + 1] - ys[i - 1]) / Math.max(1e-9, xs[i + 1] - xs[i - 1]);
28:     });
29: 
30: export const detectTurningPoints = (xs: number[], bt: number[]): TurningPoint[] => {
31:     if (xs.length < MIN_VALID_POINTS) return [];
32: 
33:     // Double smooth to suppress noise before differentiating
34:     const smoothed = movingAvg(movingAvg(bt, SMOOTH_WINDOW), SMOOTH_WINDOW);
35:     const d1 = centralDiff(xs, smoothed);
36: 
37:     const points: TurningPoint[] = [];
38: 
39:     for (let i = 2; i < xs.length - 2; i++) {
40:         // TP: 1st derivative neg → pos  (BT local minimum)
41:         if (d1[i - 1] < -0.01 && d1[i + 1] > 0.01) {
42:             // 스무딩 lag 보정: 탐지 시점 직전 LOOKBACK_SEC 구간에서 실제 최솟값 역추적
43:             const lookbackStart = xs[i] - TP_LOOKBACK_SEC;
44:             let minTemp = Infinity;
45:             let minTimeSec = xs[i];
46:             for (let j = i; j >= 0 && xs[j] >= lookbackStart; j--) {
47:                 if (bt[j] < minTemp) {
48:                     minTemp = bt[j];
49:                     minTimeSec = xs[j];
50:                 }
51:             }
52:             points.push({ timeSec: minTimeSec, temp: minTemp });
53:             break; // TP는 로스팅당 한 번만
54:         }
55:     }
56: 
57:     return points;
58: };
</file>

<file path="src/features/active-roast/model/status.ts">
  1: import { create } from 'zustand';
  2: 
  3: export type RoastPhase = 'idle' | 'preheating' | 'standby' | 'roasting' | 'ended';
  4: 
  5: type LiveData = {
  6:     bt: number | null;
  7:     et: number | null;
  8:     ror: number;
  9:     ror_et: number;
 10:     heater: number;
 11:     fan: number;
 12:     drum: number;
 13: };
 14: 
 15: export interface RoastingState {
 16:     phase: RoastPhase;
 17:     elapsed: number;
 18:     sidecarConnected: boolean;
 19:     sidecarError: string | null;
 20:     machineCapabilities: string[];
 21:     liveData: LiveData | null;
 22:     pendingBeanId: string | null;
 23:     sessionId: string | null;
 24:     reconnecting: boolean;
 25: 
 26:     // derived convenience
 27:     isRoasting: boolean;
 28:     charged: boolean;
 29: 
 30:     enterPreheating: (capabilities?: string[]) => void;
 31:     enterStandby: () => void;
 32:     startCharge: () => void;
 33:     endRoast: () => void;
 34:     tick: () => void;
 35:     setConnected: (connected: boolean, capabilities?: string[]) => void;
 36:     setError: (error: string | null) => void;
 37:     setReconnecting: (reconnecting: boolean) => void;
 38:     updateLiveData: (data: LiveData) => void;
 39:     setPendingBean: (beanId: string | null) => void;
 40:     reset: () => void;
 41: }
 42: 
 43: const initialState = {
 44:     phase: 'idle' as RoastPhase,
 45:     elapsed: 0,
 46:     sidecarConnected: false,
 47:     sidecarError: null as string | null,
 48:     machineCapabilities: [] as string[],
 49:     liveData: null as LiveData | null,
 50:     pendingBeanId: null as string | null,
 51:     sessionId: null as string | null,
 52:     reconnecting: false,
 53:     isRoasting: false,
 54:     charged: false,
 55: };
 56: 
 57: export const useRoastingStore = create<RoastingState>((set, get) => ({
 58:     ...initialState,
 59: 
 60:     enterPreheating: (capabilities?: string[]) => {
 61:         set({
 62:             phase: 'preheating',
 63:             sidecarConnected: true,
 64:             ...(capabilities && { machineCapabilities: capabilities }),
 65:         });
 66:     },
 67: 
 68:     enterStandby: () => {
 69:         const { phase } = get();
 70:         if (phase !== 'preheating') return;
 71:         set({ phase: 'standby' });
 72:     },
 73: 
 74:     startCharge: () => {
 75:         set({ phase: 'roasting', charged: true, isRoasting: true, sessionId: crypto.randomUUID() });
 76:     },
 77: 
 78:     endRoast: () => {
 79:         set({ phase: 'ended', isRoasting: false });
 80:     },
 81: 
 82:     tick: () => {
 83:         set((state) => (state.isRoasting ? { elapsed: state.elapsed + 1 } : state));
 84:     },
 85: 
 86:     setConnected: (connected: boolean, capabilities?: string[]) => {
 87:         set({
 88:             sidecarConnected: connected,
 89:             ...(connected && { sidecarError: null }),
 90:             ...(capabilities && { machineCapabilities: capabilities }),
 91:             ...(!connected && { phase: get().phase === 'idle' ? 'idle' : get().phase }),
 92:         });
 93:     },
 94: 
 95:     setError: (error) => set({ sidecarError: error }),
 96: 
 97:     setReconnecting: (reconnecting) => set({ reconnecting }),
 98: 
 99:     setPendingBean: (beanId) => {
100:         set({ pendingBeanId: beanId });
101:     },
102: 
103:     updateLiveData: (data) => {
104:         const current = get().liveData;
105:         if (
106:             current &&
107:             current.bt === data.bt &&
108:             current.et === data.et &&
109:             current.ror === data.ror &&
110:             current.ror_et === data.ror_et &&
111:             current.heater === data.heater &&
112:             current.fan === data.fan &&
113:             current.drum === data.drum
114:         )
115:             return;
116:         set({ liveData: data });
117:     },
118: 
119:     reset: () => {
120:         const { sidecarConnected, machineCapabilities } = get();
121:         set({ ...initialState, sidecarConnected, machineCapabilities });
122:     },
123: }));
</file>

<file path="src/features/active-roast/model/useAutoDetection.ts">
  1: import type { TurningPoint } from '@features/active-roast';
  2: import { detectTurningPoints } from '@features/active-roast';
  3: import { useCallback, useEffect, useMemo, useRef, useState } from 'react';
  4: import { useRoastingStore } from './status';
  5: 
  6: const AUTO_CHARGE_WINDOW = 5;
  7: 
  8: const AUTO_DROP_DROP_C = 8;
  9: const AUTO_DROP_WINDOW = 5;
 10: const AUTO_DROP_MIN_ELAPSED_S = 180;
 11: 
 12: export const useAutoDetection = (
 13:     livePoints: { time: number; bt: number }[],
 14:     onAutoCharge: (bt: number) => void,
 15:     onAutoDrop: () => void,
 16:     onTurningPoint: (tp: TurningPoint) => void,
 17:     autoChargeDropC: number = 5,
 18: ) => {
 19:     const btWindowRef = useRef<number[]>([]);
 20:     const dropWindowRef = useRef<number[]>([]);
 21:     const autoChargedRef = useRef(false);
 22:     const autoDroppedRef = useRef(false);
 23:     const tpFiredRef = useRef(false);
 24: 
 25:     const [confirmedTP, setConfirmedTP] = useState<TurningPoint | null>(null);
 26: 
 27:     const phase = useRoastingStore((s) => s.phase);
 28:     const elapsed = useRoastingStore((s) => s.elapsed);
 29:     const liveData = useRoastingStore((s) => s.liveData);
 30:     const bt = liveData?.bt ?? null;
 31: 
 32:     // Auto Charge
 33:     useEffect(() => {
 34:         if (phase !== 'standby' || bt == null || autoChargedRef.current) return;
 35: 
 36:         btWindowRef.current = [...btWindowRef.current.slice(-(AUTO_CHARGE_WINDOW - 1)), bt];
 37: 
 38:         if (btWindowRef.current.length >= AUTO_CHARGE_WINDOW) {
 39:             const first = btWindowRef.current[0];
 40:             const last = btWindowRef.current[btWindowRef.current.length - 1];
 41:             if (first - last >= autoChargeDropC) {
 42:                 autoChargedRef.current = true;
 43:                 onAutoCharge(bt);
 44:             }
 45:         }
 46:     }, [phase, bt, onAutoCharge]);
 47: 
 48:     // Auto Drop
 49:     useEffect(() => {
 50:         if (phase !== 'roasting' || bt == null || autoDroppedRef.current) return;
 51:         if (elapsed < AUTO_DROP_MIN_ELAPSED_S) return;
 52: 
 53:         dropWindowRef.current = [...dropWindowRef.current.slice(-(AUTO_DROP_WINDOW - 1)), bt];
 54: 
 55:         if (dropWindowRef.current.length >= AUTO_DROP_WINDOW) {
 56:             const first = dropWindowRef.current[0];
 57:             const last = dropWindowRef.current[dropWindowRef.current.length - 1];
 58:             if (first - last >= AUTO_DROP_DROP_C) {
 59:                 autoDroppedRef.current = true;
 60:                 onAutoDrop();
 61:             }
 62:         }
 63:     }, [phase, bt, elapsed, onAutoDrop]);
 64: 
 65:     // Turning Point detection
 66:     const detectedTPs = useMemo(() => {
 67:         if (phase !== 'roasting' || livePoints.length < 15) return [];
 68:         return detectTurningPoints(
 69:             livePoints.map((p) => p.time),
 70:             livePoints.map((p) => p.bt),
 71:         );
 72:     }, [phase, livePoints]);
 73: 
 74:     // Lock in confirmedTP on first detection (no setState in useMemo)
 75:     useEffect(() => {
 76:         if (confirmedTP !== null || detectedTPs.length === 0) return;
 77:         setConfirmedTP(detectedTPs[0]);
 78:     }, [detectedTPs, confirmedTP]);
 79: 
 80:     // Fire callback exactly once
 81:     useEffect(() => {
 82:         if (confirmedTP === null || tpFiredRef.current) return;
 83:         tpFiredRef.current = true;
 84:         onTurningPoint(confirmedTP);
 85:     }, [confirmedTP, onTurningPoint]);
 86: 
 87:     const turningPoints = confirmedTP !== null ? [confirmedTP] : detectedTPs;
 88: 
 89:     // Manual charge를 누를 때 호출해 auto-charge race 방지
 90:     const disableAutoCharge = useCallback(() => {
 91:         autoChargedRef.current = true;
 92:     }, []);
 93: 
 94:     const resetAutoDetection = useCallback(() => {
 95:         btWindowRef.current = [];
 96:         dropWindowRef.current = [];
 97:         autoChargedRef.current = false;
 98:         autoDroppedRef.current = false;
 99:         tpFiredRef.current = false;
100:         setConfirmedTP(null);
101:     }, []);
102: 
103:     return {
104:         resetAutoDetection,
105:         disableAutoCharge,
106:         turningPoints,
107:         confirmedTP,
108:     };
109: };
</file>

