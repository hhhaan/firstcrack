<file path="src/entities/bean/queries.ts">
 1: import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
 2: import type { Bean } from '../../shared/types/database.types';
 3: import { beanApi } from './api';
 4: 
 5: export const beanKeys = {
 6:     all: (userId: string) => ['beans', userId] as const,
 7:     detail: (id: string) => ['beans', 'detail', id] as const,
 8: };
 9: 
10: export const useBeans = (userId: string) =>
11:     useQuery({
12:         queryKey: beanKeys.all(userId),
13:         queryFn: () => beanApi.list(userId),
14:         enabled: !!userId,
15:     });
16: 
17: export const useBean = (id: string) =>
18:     useQuery({
19:         queryKey: beanKeys.detail(id),
20:         queryFn: () => beanApi.get(id),
21:         enabled: !!id,
22:     });
23: 
24: export const useCreateBean = (userId: string) => {
25:     const qc = useQueryClient();
26:     return useMutation({
27:         mutationFn: beanApi.create,
28:         onMutate: async (newBean) => {
29:             await qc.cancelQueries({ queryKey: beanKeys.all(userId) });
30:             const prev = qc.getQueryData<Bean[]>(beanKeys.all(userId));
31:             const tempId = `opt_${crypto.randomUUID()}`;
32:             const optimistic = {
33:                 id: tempId,
34:                 created_at: new Date().toISOString(),
35:                 updated_at: new Date().toISOString(),
36:                 ...newBean,
37:             } as Bean;
38:             qc.setQueryData<Bean[]>(beanKeys.all(userId), (old = []) => [optimistic, ...old]);
39:             return { prev, tempId };
40:         },
41:         onError: (_err, _vars, ctx) => {
42:             if (ctx?.prev) qc.setQueryData(beanKeys.all(userId), ctx.prev);
43:         },
44:         onSuccess: (realBean, _vars, ctx) => {
45:             qc.setQueryData<Bean[]>(beanKeys.all(userId), (old = []) =>
46:                 old.map((b) => (b.id === ctx!.tempId ? realBean : b)),
47:             );
48:         },
49:     });
50: };
51: 
52: export const useUpdateBean = (userId: string) => {
53:     const qc = useQueryClient();
54:     return useMutation({
55:         mutationFn: beanApi.update,
56:         onMutate: async ({ id, ...patch }) => {
57:             await qc.cancelQueries({ queryKey: beanKeys.all(userId) });
58:             await qc.cancelQueries({ queryKey: beanKeys.detail(id) });
59:             const prevList = qc.getQueryData<Bean[]>(beanKeys.all(userId));
60:             const prevDetail = qc.getQueryData<Bean>(beanKeys.detail(id));
61:             qc.setQueryData<Bean[]>(beanKeys.all(userId), (old = []) =>
62:                 old.map((b) => (b.id === id ? { ...b, ...patch } : b)),
63:             );
64:             if (prevDetail) qc.setQueryData<Bean>(beanKeys.detail(id), { ...prevDetail, ...patch });
65:             return { prevList, prevDetail };
66:         },
67:         onError: (_err, { id }, ctx) => {
68:             if (ctx?.prevList) qc.setQueryData(beanKeys.all(userId), ctx.prevList);
69:             if (ctx?.prevDetail) qc.setQueryData(beanKeys.detail(id), ctx.prevDetail);
70:         },
71:         onSuccess: (updated) => {
72:             qc.setQueryData<Bean[]>(beanKeys.all(userId), (old = []) =>
73:                 old.map((b) => (b.id === updated.id ? updated : b)),
74:             );
75:             qc.setQueryData(beanKeys.detail(updated.id), updated);
76:         },
77:     });
78: };
79: 
80: export const useDeleteBean = (userId: string) => {
81:     const qc = useQueryClient();
82:     return useMutation({
83:         mutationFn: beanApi.delete,
84:         onMutate: async (id) => {
85:             await qc.cancelQueries({ queryKey: beanKeys.all(userId) });
86:             const prev = qc.getQueryData<Bean[]>(beanKeys.all(userId));
87:             qc.setQueryData<Bean[]>(beanKeys.all(userId), (old = []) => old.filter((b) => b.id !== id));
88:             return { prev };
89:         },
90:         onError: (_err, _id, ctx) => {
91:             if (ctx?.prev) qc.setQueryData(beanKeys.all(userId), ctx.prev);
92:         },
93:         onSuccess: (_data, id) => {
94:             qc.removeQueries({ queryKey: beanKeys.detail(id) });
95:         },
96:     });
97: };
</file>

