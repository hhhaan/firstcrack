774:                               min: xMin,
775:                               max: xMax,
776:                               axisLabel: { formatter: fmtSec, ...axisLabelStyle },
777:                               axisTick: { show: false },
778:                               axisLine: { show: false },
779:                               splitLine: { show: false },
780:                               interval: 60,
781:                               splitNumber: 15,
782:                           },
