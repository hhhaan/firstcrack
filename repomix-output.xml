 72: const fmtDuration = (sec: number | null): string => {
 73:     if (sec == null) return '—';
 74:     const m = Math.floor(sec / 60);
 75:     const s = sec % 60;
 76:     return `${m}:${String(s).padStart(2, '0')}`;
 77: };
 78: 
 79: const fmtDate = (iso: string | null): string => {
 80:     if (!iso) return '—';
 81:     return iso.slice(0, 10);
 82: };
