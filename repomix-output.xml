711:                 planBatchHandoff={planBatchHandoff}
712:                 batchDone={batchDone}
713:                 sessionsAfter={sessionsAfter}
714:                 onPlanBatchComplete={onPlanBatchComplete}
715:                 onDismiss={() => setShowContinueModal(false)}
716:             />
717:         </div>
718:     );
719: };
