<file path="src/shared/lib/sessionFilter.ts">
 1: import type { RoastSessionWithRelations } from '@shared/types/database.types';
 2: 
 3: export type SessionSortKey = 'date' | 'bean' | 'duration' | 'drop' | 'level' | 'profile' | 'weight';
 4: 
 5: export interface SessionFilterCriteria {
 6:     search: string;
 7:     levelFilter: string;
 8:     fromYM: string;
 9:     toYM: string;
10:     originFilter: string;
11: }
12: 
13: const qMatch = (s: RoastSessionWithRelations, q: string): boolean => {
14:     if (!q) return true;
15:     const needle = q.toLowerCase();
16:     return (
17:         (s.beans?.name ?? '').toLowerCase().includes(needle) ||
18:         (s.roast_profiles?.name ?? '').toLowerCase().includes(needle) ||
19:         (s.beans?.origin ?? '').toLowerCase().includes(needle)
20:     );
21: };
22: 
23: const ymMatch = (iso: string | null, fromYM: string, toYM: string): boolean => {
24:     if (!fromYM && !toYM) return true;
25:     if (!iso) return false;
26:     const d = new Date(iso);
27:     const sessionYM = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
28:     if (fromYM && sessionYM < fromYM) return false;
29:     if (toYM && sessionYM > toYM) return false;
30:     return true;
31: };
32: 
33: /**
34:  * Full filter: search + level + date range + origin — single pass.
35:  * Used by displayTotal and handleExportCsv (both operate on rawSessions).
36:  */
37: export const filterSessions = (
38:     sessions: RoastSessionWithRelations[],
39:     { search, levelFilter, fromYM, toYM, originFilter }: SessionFilterCriteria,
40: ): RoastSessionWithRelations[] => {
41:     const q = search.toLowerCase();
42:     return sessions.filter((s) => {
43:         if (levelFilter !== 'all' && s.roast_level !== levelFilter) return false;
44:         if (!ymMatch(s.roasted_at, fromYM, toYM)) return false;
45:         if (q && !qMatch(s, q)) return false;
46:         if (originFilter !== 'all' && s.beans?.origin !== originFilter) return false;
47:         return true;
48:     });
49: };
50: 
51: const compareNullable = (
52:     a: string | number | null | undefined,
53:     b: string | number | null | undefined,
54:     dir: number,
55: ): number => {
56:     const av = a ?? '';
57:     const bv = b ?? '';
58:     if (typeof av === 'number' && typeof bv === 'number') return dir * (av - bv);
59:     return dir * String(av).localeCompare(String(bv));
60: };
61: 
62: /** Client-side sort for history table columns. */
63: export const sortSessions = (
64:     sessions: RoastSessionWithRelations[],
65:     sortKey: SessionSortKey,
66:     sortAsc: boolean,
67: ): RoastSessionWithRelations[] => {
68:     const dir = sortAsc ? 1 : -1;
69:     return [...sessions].sort((a, b) => {
70:         switch (sortKey) {
71:             case 'date':
72:                 return compareNullable(a.roasted_at, b.roasted_at, dir);
73:             case 'bean':
74:                 return compareNullable(a.beans?.name, b.beans?.name, dir);
75:             case 'profile':
76:                 return compareNullable(a.roast_profiles?.name, b.roast_profiles?.name, dir);
77:             case 'weight':
78:                 return compareNullable(a.weight_grams, b.weight_grams, dir);
79:             case 'drop':
80:                 return compareNullable(a.drop_temp_celsius, b.drop_temp_celsius, dir);
81:             case 'duration':
82:                 return compareNullable(a.duration_seconds, b.duration_seconds, dir);
83:             case 'level':
84:                 return compareNullable(a.roast_level, b.roast_level, dir);
85:             default:
86:                 return 0;
87:         }
88:     });
89: };
90: 
91: export const paginateSessions = <T>(sessions: T[], page: number, pageSize: number): T[] => {
92:     const safePage = Math.max(1, page);
93:     const start = (safePage - 1) * pageSize;
94:     return sessions.slice(start, start + pageSize);
95: };
</file>

