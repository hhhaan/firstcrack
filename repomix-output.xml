346:                 // 시간축(x) 데이터를 픽셀 좌표로 변환
347:                 const startPx = api.coord([api.value(0), 0])[0];
348:                 const endPx = api.coord([api.value(1), 0])[0];
349:                 const width = Math.max(0, endPx - startPx);
350:                 const { y, height: h } = params.coordSys;
351: 
352:                 // 각 단계의 메타데이터
353:                 const durSec = api.value(2) as number;
354:                 const pct = api.value(3) as number;
355:                 const color = api.value(4) as string;
356:                 const name = api.value(5) as string;
357:                 const durMin = Math.floor(durSec / 60);
358:                 const durS = String(durSec % 60).padStart(2, '0');
359:                 const durLabel = `${durMin}:${durS}  ${pct}%`;
360: 
361:                 // 단계별 배경 박스 생성
362:                 // eslint-disable-next-line @typescript-eslint/no-explicit-any
363:                 const children: any[] = [
364:                     {
365:                         type: 'rect',
366:                         shape: { x: startPx, y, width, height: h },
367:                         style: { fill: color, stroke: PHASE_BAR_STROKE, lineWidth: PHASE_BAR_STROKE_WIDTH },
368:                         silent: true,
369:                     },
370:                 ];
371: 
372:                 // 너비에 따라 텍스트 배치 전략 변경
373:                 // - width > WIDE: 단계명 좌측 + 시간 우측 (여유있음)
374:                 // - width > NARROW: 시간을 중앙에 (공간 제한)
375:                 // - width ≤ NARROW: 텍스트 생략 (너무 좁음)
376:                 if (width > PHASE_BAR_WIDE_THRESHOLD) {
377:                     children.push({
378:                         type: 'text',
379:                         style: {
380:                             text: name,
381:                             x: startPx + PHASE_BAR_TEXT_INSET,
382:                             y: y + h / 2,
383:                             fontSize: PHASE_BAR_FONT_SIZE,
384:                             fontFamily: PHASE_BAR_FONT_FAMILY,
385:                             fontWeight: PHASE_BAR_FONT_WEIGHT,
386:                             fill: PHASE_BAR_NAME_COLOR,
387:                             textVerticalAlign: 'middle',
388:                         },
389:                         silent: true,
390:                     });
391:                     children.push({
392:                         type: 'text',
393:                         style: {
394:                             text: durLabel,
395:                             x: endPx - PHASE_BAR_TEXT_INSET,
396:                             y: y + h / 2,
397:                             fontSize: PHASE_BAR_FONT_SIZE,
398:                             fontFamily: PHASE_BAR_FONT_FAMILY,
399:                             fill: PHASE_BAR_DURATION_COLOR,
400:                             textAlign: 'right',
401:                             textVerticalAlign: 'middle',
402:                         },
403:                         silent: true,
404:                     });
405:                 } else if (width > PHASE_BAR_NARROW_THRESHOLD) {
406:                     children.push({
407:                         type: 'text',
408:                         style: {
409:                             text: durLabel,
410:                             x: (startPx + endPx) / 2,
411:                             y: y + h / 2,
412:                             fontSize: PHASE_BAR_FONT_SIZE_NARROW,
413:                             fontFamily: PHASE_BAR_FONT_FAMILY,
414:                             fill: PHASE_BAR_DURATION_COLOR,
415:                             textAlign: 'center',
416:                             textVerticalAlign: 'middle',
417:                         },
418:                         silent: true,
419:                     });
420:                 }
421: 
422:                 return { type: 'group', children };
423:             },
424:             // 각 단계 데이터: [startSec, endSec, durationSec, percentage, color, name]
