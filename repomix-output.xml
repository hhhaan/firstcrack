149: 
150:         const resizeObserver = new ResizeObserver(() => {
151:             const w = container.offsetWidth;
152:             const h = container.offsetHeight;
153:             if (w <= 0 || h <= 0) return;
154:             const last = lastChartSizeRef.current;
155:             if (last.w === w && last.h === h) return;
156:             lastChartSizeRef.current = { w, h };
157:             chart.resize();
158:         });
159:         resizeObserver.observe(container);
160: 
161:         return () => {
162:             resizeObserver.disconnect();
163:             if (chartInstanceRef.current) {
164:                 chartInstanceRef.current.dispose();
165:                 chartInstanceRef.current = null;
