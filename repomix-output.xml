115: pub fn run() {
116:     let client = sentry::Client::from((
117:         "https://a7ad70395dfd0d01e1a94e04fdf4e0e1@o4511400846884864.ingest.us.sentry.io/4511400857042944",
118:         sentry::ClientOptions {
