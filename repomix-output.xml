499:   "roastepoch": 1746784800,
500:   "Eflags": [...],                // 이벤트 플래그
501:   "Etypes": [...],
502:   "Evalues": [...],
503:   "Enames": [...]                  // 이벤트 이름 배열
504: }
505: ```
