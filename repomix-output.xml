148:                 recurrence_rule_id: batch.recurrence_rule_id ?? null,
149:                 scheduled_date: date,
150:                 original_date: null,
151:                 exception_type: null,
152:                 notes: batch.notes ?? '',
153:                 green_lot: batch.green_lot ?? '',
154:                 status: batch.status ?? 'pending',
155:                 created_at: now,
156:                 updated_at: now,
157:                 completed_sessions: 0,
158:             };
159:             patchPlanBatchesCache(qc, planId, (prev) => [...prev, optimistic]);
160:             patchDayBatchesCache(qc, userId, date, (prev) => [...prev, optimistic]);
161:             return { previousPlanBatches, previousDayBatches };
