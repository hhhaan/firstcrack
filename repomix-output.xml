 13:     if (!profile?.source_session) return null;
 14:     const session = profile.source_session as { tsv_path: string | null } | { tsv_path: string | null }[];
 15:     if (Array.isArray(session)) return session[0]?.tsv_path ?? null;
 16:     return session.tsv_path ?? null;
