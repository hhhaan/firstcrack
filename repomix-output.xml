<file path="src/views/dashboard/api/useDashboard.ts">
  1: import { beanStockEventApi } from '@entities/bean-stock-event';
  2: import { planBatchApi } from '@entities/plan';
  3: import { isBatchStockShort, STOCK_RESERVATION_HORIZON_DAYS } from '@shared/lib/batch-stock';
  4: import { supabase } from '@shared/lib/supabase';
  5: import type { Bean, RoastSessionWithRelations } from '@shared/types/database.types';
  6: import { useQuery } from '@tanstack/react-query';
  7: import { addDays, format } from 'date-fns';
  8: 
  9: export interface MonthlyBatch {
 10:     date: Date;
 11:     batches: number;
 12: }
 13: 
 14: export interface UpcomingBatch {
 15:     id: string;
 16:     bean_name: string;
 17:     batch_count: number;
 18:     target_roasted_kg: number;
 19:     status: string;
 20:     date: string;
 21:     isRecurring: boolean;
 22:     stockShort: boolean;
 23: }
 24: 
 25: export interface InventoryAlert {
 26:     id: string;
 27:     name: string;
 28:     effectiveGrams: number;
 29:     capacityGrams: number;
 30:     lowStockThresholdGrams: number;
 31:     reason: 'out' | 'schedule' | 'low';
 32: }
 33: 
 34: export interface DashboardData {
 35:     batchesThisMonth: number;
 36:     batchesLastMonth: number;
 37:     kgRoastedThisMonth: number;
 38:     kgRoastedLastMonth: number;
 39:     avgDurationSeconds: number;
 40:     avgDurationLastMonthSeconds: number;
 41:     recentSessions: RoastSessionWithRelations[];
 42:     upcomingBatches: UpcomingBatch[];
 43:     inventoryAlerts: InventoryAlert[];
 44:     monthlyBatches: MonthlyBatch[];
 45:     loading: boolean;
 46:     error: string | null;
 47: }
 48: 
 49: const fetchDashboard = async (userId: string): Promise<Omit<DashboardData, 'loading' | 'error'>> => {
 50:     const now = new Date();
 51:     const today = now.toISOString().slice(0, 10);
 52:     const thisMonthStart = new Date(now.getFullYear(), now.getMonth(), 1).toISOString();
 53:     const lastMonthStart = new Date(now.getFullYear(), now.getMonth() - 1, 1).toISOString();
 54:     const sixMonthsAgo = new Date(now.getFullYear(), now.getMonth() - 5, 1).toISOString();
 55: 
 56:     const [completedRes, alertsRes, stockSummaries, monthlyRes] = await Promise.all([
 57:         supabase
 58:             .from('roast_sessions')
 59:             .select('*, beans(name, origin), roast_profiles!profile_id(name, target_level)')
 60:             .eq('user_id', userId)
 61:             .eq('status', 'completed')
 62:             .gte('roasted_at', lastMonthStart)
 63:             .order('roasted_at', { ascending: false }),
 64: 
 65:         // 전체 가져와서 클라이언트에서 필터 (PostgREST는 컬럼 간 비교 미지원)
 66:         supabase.from('beans').select('*').eq('user_id', userId),
 67: 
 68:         // 재고 요약 (이벤트 기반)
 69:         beanStockEventApi.getStockSummariesByUser(userId),
 70: 
 71:         supabase
 72:             .from('roast_sessions')
 73:             .select('roasted_at, weight_grams')
 74:             .eq('user_id', userId)
 75:             .eq('status', 'completed')
 76:             .gte('roasted_at', sixMonthsAgo)
 77:             .order('roasted_at', { ascending: true }),
 78:     ]);
 79: 
 80:     if (completedRes.error) throw completedRes.error;
 81:     if (alertsRes.error) throw alertsRes.error;
 82:     if (monthlyRes.error) throw monthlyRes.error;
 83: 
 84:     const horizonEnd14 = format(addDays(now, 14), 'yyyy-MM-dd');
 85:     const horizonEnd28 = format(addDays(now, STOCK_RESERVATION_HORIZON_DAYS), 'yyyy-MM-dd');
 86: 
 87:     const [rangeBatches14, rangeBatches28] = await Promise.all([
 88:         planBatchApi.listForDateRange(userId, today, horizonEnd14),
 89:         planBatchApi.listForDateRange(userId, today, horizonEnd28),
 90:     ]);
 91: 
 92:     const isBatchPending = (b: { status: string; completed_sessions: number; batch_count: number }) =>
 93:         b.status !== 'done' && b.status !== 'skipped' && b.completed_sessions < b.batch_count;
 94: 
 95:     const scheduleShortBeanIds = new Set<string>();
 96:     for (const b of rangeBatches28) {
 97:         if (!b.bean_id || !isBatchPending(b)) continue;
 98:         const effectiveGrams = stockSummaries?.[b.bean_id]?.effectiveGrams ?? 0;
 99:         if (isBatchStockShort(b, effectiveGrams)) {
100:             scheduleShortBeanIds.add(b.bean_id);
101:         }
102:     }
103: 
104:     const upcomingBatches: UpcomingBatch[] = rangeBatches14
105:         .filter((b) => {
106:             if (b.status === 'done' || b.status === 'skipped') return false;
107:             if (b.completed_sessions >= b.batch_count) return false;
108:             return true;
109:         })
110:         .sort(
111:             (a, b) =>
112:                 (a.scheduled_date ?? today).localeCompare(b.scheduled_date ?? today) || a.order_index - b.order_index,
113:         )
114:         .slice(0, 5)
115:         .map((b) => {
116:             const beanId = b.bean_id ?? '';
117:             const effectiveGrams = beanId ? (stockSummaries?.[beanId]?.effectiveGrams ?? 0) : 0;
118:             const recurring = !!b.recurrence_rule_id;
119:             return {
120:                 id: b.id,
121:                 bean_name: b.bean_name,
122:                 batch_count: b.batch_count,
123:                 target_roasted_kg: b.target_roasted_kg,
124:                 status: b.status,
125:                 date: b.scheduled_date ?? today,
126:                 isRecurring: recurring,
127:                 stockShort: recurring && isBatchStockShort(b, effectiveGrams),
128:             };
129:         });
130: 
131:     const completed = completedRes.data as RoastSessionWithRelations[];
132:     const thisMonth = completed.filter((s) => s.roasted_at! >= thisMonthStart);
133:     const lastMonth = completed.filter((s) => s.roasted_at! < thisMonthStart);
134: 
135:     const sumKg = (arr: typeof completed) => arr.reduce((acc, s) => acc + s.weight_grams, 0) / 1000;
136:     const avgDuration = (arr: typeof completed) =>
137:         arr.length > 0 ? arr.reduce((acc, s) => acc + (s.duration_seconds ?? 0), 0) / arr.length : 0;
138: 
139:     const monthlyMap = new Map<string, number>();
140:     for (let i = 5; i >= 0; i--) {
141:         const d = new Date(now.getFullYear(), now.getMonth() - i, 1);
142:         monthlyMap.set(`${d.getFullYear()}-${d.getMonth()}`, 0);
143:     }
144:     for (const s of (monthlyRes.data ?? []) as { roasted_at: string | null }[]) {
145:         const d = new Date(s.roasted_at!);
146:         const key = `${d.getFullYear()}-${d.getMonth()}`;
147:         if (monthlyMap.has(key)) {
148:             monthlyMap.set(key, (monthlyMap.get(key) ?? 0) + 1);
149:         }
150:     }
151:     const monthlyBatches: MonthlyBatch[] = Array.from(monthlyMap, ([key, batches]) => {
152:         const [year, month] = key.split('-').map(Number);
153:         return { date: new Date(year, month, 1), batches };
154:     });
155: 
156:     const allBeans = (alertsRes.data ?? []) as Bean[];
157:     const inventoryAlerts: InventoryAlert[] = allBeans
158:         .map((b) => {
159:             const effectiveGrams = stockSummaries?.[b.id]?.effectiveGrams ?? 0;
160:             let reason: InventoryAlert['reason'] | null = null;
161:             if (effectiveGrams <= 0) {
162:                 reason = 'out';
163:             } else if (scheduleShortBeanIds.has(b.id)) {
164:                 reason = 'schedule';
165:             } else if (effectiveGrams <= b.low_stock_threshold_grams) {
166:                 reason = 'low';
167:             }
168:             if (!reason) return null;
169:             return {
170:                 id: b.id,
171:                 name: b.name,
172:                 effectiveGrams,
173:                 capacityGrams: b.capacity_grams,
174:                 lowStockThresholdGrams: b.low_stock_threshold_grams,
175:                 reason,
176:             };
177:         })
178:         .filter((item): item is InventoryAlert => item !== null)
179:         .sort((a, b) => {
180:             const rank = { out: 0, schedule: 1, low: 2 };
181:             return rank[a.reason] - rank[b.reason] || a.effectiveGrams - b.effectiveGrams;
182:         });
183: 
184:     return {
185:         batchesThisMonth: thisMonth.length,
186:         batchesLastMonth: lastMonth.length,
187:         kgRoastedThisMonth: sumKg(thisMonth),
188:         kgRoastedLastMonth: sumKg(lastMonth),
189:         avgDurationSeconds: avgDuration(thisMonth),
190:         avgDurationLastMonthSeconds: avgDuration(lastMonth),
191:         recentSessions: completed.slice(0, 5),
192:         upcomingBatches,
193:         inventoryAlerts,
194:         monthlyBatches,
195:     };
196: };
197: 
198: const EMPTY: Omit<DashboardData, 'loading' | 'error'> = {
199:     batchesThisMonth: 0,
200:     batchesLastMonth: 0,
201:     kgRoastedThisMonth: 0,
202:     kgRoastedLastMonth: 0,
203:     avgDurationSeconds: 0,
204:     avgDurationLastMonthSeconds: 0,
205:     recentSessions: [],
206:     upcomingBatches: [],
207:     inventoryAlerts: [],
208:     monthlyBatches: [],
209: };
210: 
211: export const useDashboard = (userId: string): DashboardData => {
212:     const { data, isLoading, error } = useQuery({
213:         queryKey: ['dashboard', userId],
214:         queryFn: () => fetchDashboard(userId),
215:         enabled: !!userId,
216:         staleTime: 5 * 60 * 1000,
217:     });
218: 
219:     return {
220:         ...(data ?? EMPTY),
221:         loading: isLoading,
222:         error: error instanceof Error ? error.message : null,
223:     };
224: };
</file>

<file path="src/views/dashboard/api/useWeather.ts">
 1: import { locationStore } from '@shared/lib/locationStore';
 2: import { useQuery } from '@tanstack/react-query';
 3: 
 4: const WEATHER_TTL = 30 * 60 * 1000;
 5: 
 6: export interface WeatherData {
 7:     temperature: number;
 8:     humidity: number;
 9: }
10: 
11: const fetchOpenMeteo = async (lat: number, lng: number): Promise<WeatherData> => {
12:     const res = await fetch(
13:         `https://api.open-meteo.com/v1/forecast` +
14:             `?latitude=${lat}&longitude=${lng}` +
15:             `&current=temperature_2m,relative_humidity_2m`,
16:     );
17:     if (!res.ok) throw new Error('weather fetch failed');
18:     const json = await res.json();
19:     return {
20:         temperature: Math.round(json.current.temperature_2m),
21:         humidity: Math.round(json.current.relative_humidity_2m),
22:     };
23: };
24: 
25: export const useWeather = () => {
26:     const coords = useQuery({
27:         queryKey: ['weather', 'coords'],
28:         queryFn: () => locationStore.get(),
29:         staleTime: Infinity,
30:     });
31: 
32:     const weather = useQuery({
33:         queryKey: ['weather', 'current', coords.data?.lat, coords.data?.lng],
34:         queryFn: () => fetchOpenMeteo(coords.data!.lat, coords.data!.lng),
35:         enabled: !!coords.data,
36:         staleTime: WEATHER_TTL,
37:         retry: 1,
38:     });
39: 
40:     return {
41:         data: weather.data ?? null,
42:         loading: coords.isLoading || weather.isLoading,
43:     };
44: };
</file>

