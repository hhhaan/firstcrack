169: 
170:     const option = useMemo((): EChartsOption => {
171:         const colors = getResolvedChartColors();
172:         const axisLabelStyle = { ...AXIS_LABEL_FONT, color: colors.axisLabel };
173:         const axisNameStyle = { color: colors.axisLabel };
174:         const rightYAxisLabel = { ...axisLabelStyle, margin: 4 };
