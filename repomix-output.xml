<file path="src-tauri/sidecar/adapters/probat_ws.py">
  1: import asyncio
  2: import json
  3: import random
  4: import socket
  5: import time
  6: import logging
  7: from typing import Any
  8: 
  9: from adapters.base import Reading
 10: from protocol_trace import TRACE
 11: 
 12: _log = logging.getLogger(__name__)
 13: 
 14: 
 15: class ProbatWSAdapter:
 16:     """
 17:     Probat WebSocket 어댑터 (G/UG WebSockets, P Series III, Sample Roaster).
 18:     extern/wsport.py는 Qt + ApplicationWindow에 깊게 결합돼 있어 직접 구현.
 19: 
 20:     프로토콜:
 21:       ws://{host}:{port}/WebSocket
 22:       요청: {"command":"getData","id":<random>,"roasterID":0}
 23:       응답: {"id":<same>,"data":{"beanTemp":210.3,"burner":75,...}}
 24: 
 25:     channel_nodes: roaster_registry의 "channel_nodes" 딕셔너리.
 26:       {"BT":"beanTemp","ET":"ambientTemp","heater":"burner","fan":"exhaustFan"}
 27:     """
 28: 
 29:     _WS_PATH = "WebSocket"
 30:     _REQUEST_TIMEOUT = 3.0
 31:     _CONNECT_TIMEOUT = 5.0
 32: 
 33:     def __init__(
 34:         self,
 35:         host: str = "127.0.0.1",
 36:         port: int = 80,
 37:         channel_nodes: dict[str, str] | None = None,
 38:         **_: Any,
 39:     ) -> None:
 40:         self._host = host
 41:         self._port = port
 42:         self._channel_nodes: dict[str, str] = channel_nodes or {}
 43:         self._ws: Any = None
 44:         self._connected: bool = False
 45: 
 46:     def _url(self) -> str:
 47:         if self._port == 80:
 48:             return f"ws://{self._host}/{self._WS_PATH}"
 49:         return f"ws://{self._host}:{self._port}/{self._WS_PATH}"
 50: 
 51:     async def connect(self) -> None:
 52:         import websockets  # type: ignore[import]
 53: 
 54:         if not self._channel_nodes:
 55:             raise ValueError("channel_nodes가 비어 있음. roaster_registry 확인 필요.")
 56: 
 57:         self._ws = await asyncio.wait_for(
 58:             websockets.connect(
 59:                 self._url(),
 60:                 ping_interval=20,
 61:                 ping_timeout=20,
 62:                 open_timeout=self._CONNECT_TIMEOUT,
 63:                 compression="deflate",
 64:                 origin=websockets.Origin(f"http://{socket.gethostname()}"),
 65:                 user_agent_header="FC-Desktop/1.0 websockets",
 66:             ),
 67:             timeout=self._CONNECT_TIMEOUT,
 68:         )
 69:         self._connected = True
 70:         _log.info("ProbatWSAdapter connected: %s", self._url())
 71: 
 72:     async def disconnect(self) -> None:
 73:         if self._ws is not None:
 74:             try:
 75:                 await self._ws.close()
 76:             except Exception:
 77:                 pass
 78:             self._ws = None
 79:         self._connected = False
 80: 
 81:     def _on_ws_error(self, exc: Exception) -> ConnectionError:
 82:         """WS 오류 시 상태를 정리하고 ConnectionError로 변환."""
 83:         self._ws = None
 84:         self._connected = False
 85:         return ConnectionError(f"Probat WS 연결 끊김: {exc}")
 86: 
 87:     async def read(self) -> Reading:
 88:         if self._ws is None:
 89:             raise ConnectionError("WebSocket이 연결되지 않음")
 90: 
 91:         msg_id = random.randint(1, 99999)
 92:         request = json.dumps(
 93:             {"command": "getData", "id": msg_id, "roasterID": 0},
 94:             separators=(",", ":"),
 95:         )
 96:         try:
 97:             TRACE.record("tx", "probat_ws", f"getData id={msg_id}", request)
 98:             await self._ws.send(request)
 99:         except Exception as exc:
100:             raise self._on_ws_error(exc) from exc
101: 
102:         deadline = time.monotonic() + self._REQUEST_TIMEOUT
103:         while time.monotonic() < deadline:
104:             try:
105:                 raw = await asyncio.wait_for(
106:                     self._ws.recv(),
107:                     timeout=max(0.1, deadline - time.monotonic()),
108:                 )
109:             except asyncio.TimeoutError:
110:                 break
111:             except Exception as exc:
112:                 raise self._on_ws_error(exc) from exc
113:             try:
114:                 j = json.loads(raw)
115:             except json.JSONDecodeError:
116:                 continue
117:             if j.get("id") != msg_id:
118:                 TRACE.record(
119:                     "info", "probat_ws",
120:                     f"unmatched id={j.get('id')} (expected {msg_id})", j,
121:                 )
122:                 continue
123: 
124:             TRACE.record("rx", "probat_ws", f"response id={msg_id}", j)
125:             data: dict[str, Any] = j.get("data", {})
126:             nodes = self._channel_nodes
127: 
128:             def _get(role: str, default: float) -> float:
129:                 node = nodes.get(role)
130:                 if node and node in data:
131:                     try:
132:                         return round(float(data[node]), 1)
133:                     except (TypeError, ValueError):
134:                         pass
135:                 return default
136: 
137:             return Reading(
138:                 bt=_get("BT", -1.0),
139:                 et=_get("ET", -1.0),
140:                 heater=_get("heater", 0.0),
141:                 fan=_get("fan", 0.0),
142:                 drum=_get("drum", 0.0),
143:                 timestamp=time.monotonic(),
144:             )
145: 
146:         TRACE.record("err", "probat_ws", f"getData 응답 타임아웃 id={msg_id}")
147:         raise TimeoutError(f"Probat WS getData 응답 타임아웃 (id={msg_id})")
148: 
149:     async def control(self, heater: float | None = None, fan: float | None = None, drum: float | None = None) -> None:
150:         pass  # 제어 기능 미사용 — 제거 예정
151: 
152:     @property
153:     def connected(self) -> bool:
154:         return self._connected
</file>

