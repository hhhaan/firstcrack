<file path="src/views/active-roast/lib/roast-phase.ts">
 1: import { PHASE_COLORS } from '@features/active-roast/lib/colors';
 2: import { parseTimeSec } from '@features/active-roast/lib/time';
 3: import type { LogEntry } from '@shared/types/roast';
 4: 
 5: /**
 6:  * 이벤트 로그 기반으로 현재 로스팅 단계 이름을 결정한다.
 7:  */
 8: export const getRoastPhaseName = (charged: boolean, phase: string, elapsed: number, logEntries: LogEntry[]): string => {
 9:     if (!charged) {
10:         switch (phase) {
11:             case 'standby':
12:                 return 'READY';
13:             case 'preheating':
14:                 return 'PREHEATING';
15:             case 'idle':
16:                 return 'IDLE';
17:             default:
18:                 return phase;
19:         }
20:     }
21:     const fcStartEntry = logEntries.find((e) => e.event === 'FC Start');
22:     const yellowEntry = logEntries.find((e) => e.event === 'Yellow');
23:     if (fcStartEntry && elapsed >= parseTimeSec(fcStartEntry.time)) return 'Development';
24:     if (yellowEntry && elapsed >= parseTimeSec(yellowEntry.time)) return 'Maillard';
25:     return 'Drying';
26: };
27: 
28: export const getRoastPhaseColor = (charged: boolean, phaseName: string): string => {
29:     if (!charged) return PHASE_COLORS.ready;
30:     switch (phaseName) {
31:         case 'Development':
32:             return PHASE_COLORS.development;
33:         case 'Maillard':
34:             return PHASE_COLORS.maillard;
35:         default:
36:             return PHASE_COLORS.drying;
37:     }
38: };
</file>

<file path="src/views/active-roast/lib/useChartData.ts">
 1: import { interpolateProfileBT } from '@shared/data/roast-profiles';
 2: import type { TsvPoint } from '@shared/lib/tsv';
 3: import { useMemo } from 'react';
 4: import type { LiveRoastPoint } from '../model/useSidecarPolling';
 5: 
 6: /** 차트 전체 x축 범위(초). uPlot에 항상 이 길이를 보장한다. */
 7: export const CHART_TOTAL_SECS = 780;
 8: 
 9: export const useChartData = ({
10:     livePoints,
11:     targetCurvePoints,
12:     preChargeDisplaySec,
13: }: {
14:     livePoints: LiveRoastPoint[];
15:     /** 타깃 프로파일의 실제 저장 데이터. 없으면 빈 배열. */
16:     targetCurvePoints: TsvPoint[];
17:     preChargeDisplaySec: number;
18: }) => {
19:     const chartData = useMemo(() => {
20:         const hasTarget = targetCurvePoints.length > 0;
21:         const sentinel = (t: number) => ({
22:             time: t,
23:             btActual: null as number | null,
24:             etActual: null as number | null,
25:             rorActual: null as number | null,
26:             etRorActual: null as number | null,
27:             btTarget: hasTarget ? interpolateProfileBT(targetCurvePoints, t) : null,
28:         });
29: 
30:         const live = livePoints.map((p) => ({
31:             time: p.time,
32:             btActual: p.bt,
33:             etActual: p.et,
34:             rorActual: p.ror,
35:             etRorActual: p.ror_et,
36:             btTarget: hasTarget ? interpolateProfileBT(targetCurvePoints, p.time) : null,
37:         }));
38: 
39:         // 타깃 프로파일 knot(30s 간격)을 btActual:null로 합치면 live 폴링 시각과
40:         // 겹치지 않아 ECharts 선이 30초마다 끊긴다. btTarget은 live 시각에서 보간한다.
41:         const seen = new Set<number>();
42:         const deduped: ReturnType<typeof sentinel>[] = [];
43:         for (const p of live) {
44:             const key = Math.round(p.time * 100);
45:             if (!seen.has(key)) {
46:                 seen.add(key);
47:                 deduped.push(p);
48:             }
49:         }
50:         deduped.sort((a, b) => a.time - b.time);
51: 
52:         const xMin = -preChargeDisplaySec;
53:         const profileDuration = targetCurvePoints.length > 0 ? targetCurvePoints[targetCurvePoints.length - 1].t : 0;
54:         const liveMax = livePoints.length > 0 ? livePoints[livePoints.length - 1].time : 0;
55:         const chartTotalSecs = Math.max(CHART_TOTAL_SECS, profileDuration, liveMax);
56:         const needsStart = deduped.length === 0 || deduped[0].time > xMin + 0.5;
57:         const needsEnd = deduped.length === 0 || deduped[deduped.length - 1].time < chartTotalSecs - 1;
58:         return [...(needsStart ? [sentinel(xMin)] : []), ...deduped, ...(needsEnd ? [sentinel(chartTotalSecs)] : [])];
59:     }, [livePoints, targetCurvePoints, preChargeDisplaySec]);
60: 
61:     /** 타깃 프로파일 전체 곡선 — BT Actual과 분리해 렌더링 (null actual 구멍 방지) */
62:     const targetSeries = useMemo(
63:         () =>
64:             targetCurvePoints.map((p) => ({
65:                 time: p.t,
66:                 bt: p.bt,
67:             })),
68:         [targetCurvePoints],
69:     );
70: 
71:     return { chartData, targetSeries };
72: };
</file>

<file path="src/views/active-roast/model/useChartKeyboard.ts">
  1: import type { RefObject } from 'react';
  2: import { useHotkeys } from 'react-hotkeys-hook';
  3: import { MIN_VISIBLE_SECS } from './useChartZoom';
  4: 
  5: interface UseChartKeyboardParams {
  6:     isActive: boolean;
  7:     isFullscreen: boolean;
  8:     showEndRoastModal: boolean;
  9:     showSummaryModal: boolean;
 10:     minTime: number;
 11:     maxTime: number;
 12:     /** 현재 줌 범위 (null = 전체) */
 13:     zoomRange: { start: number; end: number } | null;
 14:     setZoomRange: (range: { start: number; end: number } | null) => void;
 15:     /** 줌/패닝 중심 계산용 — 현재 가시 영역 데이터 */
 16:     visibleChartData: { time: number }[];
 17:     hoveredChartIndexRef: RefObject<number | null>;
 18: }
 19: 
 20: export const useChartKeyboard = ({
 21:     isActive,
 22:     isFullscreen,
 23:     showEndRoastModal,
 24:     showSummaryModal,
 25:     minTime,
 26:     maxTime,
 27:     zoomRange,
 28:     setZoomRange,
 29:     visibleChartData,
 30:     hoveredChartIndexRef,
 31: }: UseChartKeyboardParams) => {
 32:     const chartKeysEnabled = isActive && !showEndRoastModal && !showSummaryModal && !isFullscreen;
 33: 
 34:     const zoomChart = (zoomFactor: number) => {
 35:         if (maxTime <= 0) return;
 36:         const currentStart = zoomRange?.start ?? minTime;
 37:         const currentEnd = zoomRange?.end ?? maxTime;
 38:         const currentDuration = currentEnd - currentStart;
 39:         const nextDuration = Math.max(MIN_VISIBLE_SECS, Math.min(maxTime - minTime, currentDuration * zoomFactor));
 40:         if (nextDuration >= maxTime - minTime) {
 41:             setZoomRange(null);
 42:             return;
 43:         }
 44:         const hoveredChartIndex = hoveredChartIndexRef.current;
 45:         const focusTime =
 46:             hoveredChartIndex != null
 47:                 ? (visibleChartData[hoveredChartIndex]?.time ?? (currentStart + currentEnd) / 2)
 48:                 : (currentStart + currentEnd) / 2;
 49:         const ratio = currentDuration > 0 ? (focusTime - currentStart) / currentDuration : 0.5;
 50:         let nextStart = focusTime - ratio * nextDuration;
 51:         let nextEnd = nextStart + nextDuration;
 52:         if (nextStart < minTime) {
 53:             nextStart = minTime;
 54:             nextEnd = minTime + nextDuration;
 55:         }
 56:         if (nextEnd > maxTime) {
 57:             nextEnd = maxTime;
 58:             nextStart = maxTime - nextDuration;
 59:         }
 60:         setZoomRange({ start: nextStart, end: nextEnd });
 61:     };
 62: 
 63:     const panChart = (direction: -1 | 1) => {
 64:         if (!zoomRange) return;
 65:         const duration = zoomRange.end - zoomRange.start;
 66:         const step = Math.max(1, duration * 0.2);
 67:         const nextStart = Math.max(minTime, Math.min(maxTime - duration, zoomRange.start + step * direction));
 68:         setZoomRange({ start: nextStart, end: nextStart + duration });
 69:     };
 70: 
 71:     useHotkeys(
 72:         '+, =',
 73:         (e) => {
 74:             e.preventDefault();
 75:             zoomChart(0.8);
 76:         },
 77:         { enabled: chartKeysEnabled },
 78:         [chartKeysEnabled, maxTime, zoomChart],
 79:     );
 80: 
 81:     useHotkeys(
 82:         '-, _',
 83:         (e) => {
 84:             e.preventDefault();
 85:             zoomChart(1.25);
 86:         },
 87:         { enabled: chartKeysEnabled },
 88:         [chartKeysEnabled, maxTime, zoomChart],
 89:     );
 90: 
 91:     useHotkeys(
 92:         '0',
 93:         (e) => {
 94:             e.preventDefault();
 95:             setZoomRange(null);
 96:         },
 97:         { enabled: chartKeysEnabled },
 98:         [chartKeysEnabled, setZoomRange],
 99:     );
100: 
101:     useHotkeys(
102:         'left',
103:         (e) => {
104:             e.preventDefault();
105:             panChart(-1);
106:         },
107:         { enabled: chartKeysEnabled },
108:         [chartKeysEnabled, panChart],
109:     );
110: 
111:     useHotkeys(
112:         'right',
113:         (e) => {
114:             e.preventDefault();
115:             panChart(1);
116:         },
117:         { enabled: chartKeysEnabled },
118:         [chartKeysEnabled, panChart],
119:     );
120: };
</file>

<file path="src/views/active-roast/model/useChartZoom.ts">
  1: import { CHART_GRID_LEFT, CHART_GRID_RIGHT } from '@features/active-roast/lib/chart-config';
  2: import type { RefObject } from 'react';
  3: import { useCallback, useEffect, useMemo, useRef, useState } from 'react';
  4: 
  5: /** 줌 시 보장하는 최소 표시 구간 (초) */
  6: export const MIN_VISIBLE_SECS = 60;
  7: 
  8: const getChartDataWidth = (rect: DOMRect, rightPad: number) => Math.max(1, rect.width - CHART_GRID_LEFT - rightPad);
  9: 
 10: export interface ChartZoom {
 11:     zoomRange: { start: number; end: number } | null;
 12:     setZoomRange: React.Dispatch<React.SetStateAction<{ start: number; end: number } | null>>;
 13:     /** zoomRange를 [0, MAX_TIME] 범위로 클램핑한 값. null이면 전체 범위 표시 */
 14:     effectiveZoomRange: { start: number; end: number } | null;
 15:     /** 키보드 줌 중심 — 호버마다 리렌더하지 않도록 ref로 유지 */
 16:     hoveredChartIndexRef: RefObject<number | null>;
 17:     setHoveredChartIndex: (index: number | null) => void;
 18:     isChartDragging: boolean;
 19:     mainChartHeight: number;
 20:     chartAreaRef: RefObject<HTMLDivElement | null>;
 21:     handleChartWheel: (event: React.WheelEvent<HTMLDivElement>) => void;
 22:     handleChartPointerDown: (event: React.PointerEvent<HTMLDivElement>) => void;
 23:     handleChartPointerMove: (event: React.PointerEvent<HTMLDivElement>) => void;
 24:     endChartDrag: (event: React.PointerEvent<HTMLDivElement>) => void;
 25: }
 26: 
 27: /**
 28:  * 온도 차트의 줌·패닝·드래그 상태와 인터랙션 핸들러를 관리한다.
 29:  *
 30:  * - 휠: 마우스 위치를 기준으로 줌 인/아웃
 31:  * - 드래그: 줌된 상태에서 좌우 패닝
 32:  * - ResizeObserver: chartAreaRef 크기 변화에 따라 mainChartHeight 갱신
 33:  *
 34:  * `zoomChart` / `panChart` / `handleChartKeyDown`은 visibleChartData에 의존해
 35:  * 이 훅에서 분리할 수 없으므로 컴포넌트에 유지한다.
 36:  *
 37:  * @param MAX_TIME 현재 chartData의 마지막 시간(초). 줌 범위 클램핑에 사용.
 38:  * @param minTime x축 최솟값(초). pre-charge 구간이 있을 때 음수. 기본값 0.
 39:  * @param rightGridPad ECharts grid.right(px). 오른쪽 보조 Y축 있을 때 CHART_GRID_RIGHT_WITH_ROR.
 40:  */
 41: export const useChartZoom = (
 42:     MAX_TIME: number,
 43:     minTime: number = 0,
 44:     rightGridPad: number = CHART_GRID_RIGHT,
 45: ): ChartZoom => {
 46:     const [zoomRange, setZoomRange] = useState<{ start: number; end: number } | null>(null);
 47:     const hoveredChartIndexRef = useRef<number | null>(null);
 48:     const setHoveredChartIndex = useCallback((index: number | null) => {
 49:         hoveredChartIndexRef.current = index;
 50:     }, []);
 51:     const [isChartDragging, setIsChartDragging] = useState(false);
 52:     const [mainChartHeight, setMainChartHeight] = useState(350);
 53: 
 54:     const chartAreaRef = useRef<HTMLDivElement>(null);
 55:     const chartDragRef = useRef<{
 56:         pointerId: number;
 57:         startX: number;
 58:         startRange: { start: number; end: number };
 59:     } | null>(null);
 60: 
 61:     const effectiveZoomRange = useMemo(
 62:         () =>
 63:             zoomRange ? { start: Math.max(minTime, zoomRange.start), end: Math.min(MAX_TIME, zoomRange.end) } : null,
 64:         [zoomRange, minTime, MAX_TIME],
 65:     );
 66: 
 67:     // ECharts는 명시적 height(px)가 필요하므로 ResizeObserver로 chartAreaRef 높이를 그대로 반영한다.
 68:     // ChartLegend는 absolute라 플로우 높이에 포함되지 않는다.
 69:     useEffect(() => {
 70:         const el = chartAreaRef.current;
 71:         if (!el) return;
 72:         const updateHeight = () => {
 73:             if (el.offsetHeight <= 0) return;
 74:             const nextHeight = Math.max(180, el.offsetHeight);
 75:             setMainChartHeight((prev) => (prev === nextHeight ? prev : nextHeight));
 76:         };
 77:         updateHeight();
 78:         const obs = new ResizeObserver(updateHeight);
 79:         obs.observe(el);
 80:         return () => obs.disconnect();
 81:     }, []);
 82: 
 83:     const handleChartWheel = (event: React.WheelEvent<HTMLDivElement>) => {
 84:         if (MAX_TIME <= 0) return;
 85:         event.preventDefault();
 86:         const currentStart = effectiveZoomRange?.start ?? 0;
 87:         const currentEnd = effectiveZoomRange?.end ?? MAX_TIME;
 88:         const currentDuration = currentEnd - currentStart;
 89:         if (event.deltaY < 0 && currentDuration <= MIN_VISIBLE_SECS) return;
 90:         if (event.deltaY > 0 && currentStart === minTime && currentEnd === MAX_TIME) return;
 91:         const rect = event.currentTarget.getBoundingClientRect();
 92:         const dataWidth = getChartDataWidth(rect, rightGridPad);
 93:         const mouseX = event.clientX - rect.left - CHART_GRID_LEFT;
 94:         const pointerRatio = dataWidth > 0 ? Math.max(0, Math.min(1, mouseX / dataWidth)) : 0.5;
 95:         const focusTime = currentStart + pointerRatio * currentDuration;
 96:         const zoomFactor = event.deltaY < 0 ? 0.8 : 1.25;
 97:         const nextDuration = Math.max(MIN_VISIBLE_SECS, Math.min(MAX_TIME, currentDuration * zoomFactor));
 98:         if (nextDuration >= MAX_TIME) {
 99:             setZoomRange(null);
100:             return;
101:         }
102:         let nextStart = focusTime - pointerRatio * nextDuration;
103:         let nextEnd = nextStart + nextDuration;
104:         if (nextStart < minTime) {
105:             nextStart = minTime;
106:             nextEnd = minTime + nextDuration;
107:         }
108:         if (nextEnd > MAX_TIME) {
109:             nextEnd = MAX_TIME;
110:             nextStart = MAX_TIME - nextDuration;
111:         }
112:         setZoomRange({ start: nextStart, end: nextEnd });
113:     };
114: 
115:     const handleChartPointerDown = (event: React.PointerEvent<HTMLDivElement>) => {
116:         if (!effectiveZoomRange || event.button !== 0) return;
117:         chartDragRef.current = {
118:             pointerId: event.pointerId,
119:             startX: event.clientX,
120:             startRange: effectiveZoomRange,
121:         };
122:         event.currentTarget.setPointerCapture(event.pointerId);
123:         event.currentTarget.focus();
124:         setIsChartDragging(true);
125:         event.preventDefault();
126:     };
127: 
128:     const handleChartPointerMove = (event: React.PointerEvent<HTMLDivElement>) => {
129:         const drag = chartDragRef.current;
130:         if (!drag || drag.pointerId !== event.pointerId) return;
131:         const duration = drag.startRange.end - drag.startRange.start;
132:         if (duration <= 0) return;
133:         const rect = event.currentTarget.getBoundingClientRect();
134:         const dataWidth = getChartDataWidth(rect, rightGridPad);
135:         const deltaPx = event.clientX - drag.startX;
136:         const deltaTime = -(deltaPx / dataWidth) * duration;
137:         const nextStart = Math.max(minTime, Math.min(MAX_TIME - duration, drag.startRange.start + deltaTime));
138:         setZoomRange({ start: nextStart, end: nextStart + duration });
139:         event.preventDefault();
140:     };
141: 
142:     const endChartDrag = (event: React.PointerEvent<HTMLDivElement>) => {
143:         const drag = chartDragRef.current;
144:         if (!drag || drag.pointerId !== event.pointerId) return;
145:         if (event.currentTarget.hasPointerCapture(event.pointerId))
146:             event.currentTarget.releasePointerCapture(event.pointerId);
147:         chartDragRef.current = null;
148:         setIsChartDragging(false);
149:     };
150: 
151:     return {
152:         zoomRange,
153:         setZoomRange,
154:         effectiveZoomRange,
155:         hoveredChartIndexRef,
156:         setHoveredChartIndex,
157:         isChartDragging,
158:         mainChartHeight,
159:         chartAreaRef,
160:         handleChartWheel,
161:         handleChartPointerDown,
162:         handleChartPointerMove,
163:         endChartDrag,
164:     };
165: };
</file>

<file path="src/views/active-roast/model/useSidecarPolling.ts">
  1: import { useRoastingStore } from '@features/active-roast/model/status';
  2: import { sidecar } from '@shared/lib/sidecar';
  3: import { BaseDirectory, writeTextFile } from '@tauri-apps/plugin-fs';
  4: import type { MutableRefObject } from 'react';
  5: import { useEffect, useRef, useState } from 'react';
  6: 
  7: /** 폴링 중 누적하는 실시간 측정 포인트 */
  8: export interface LiveRoastPoint {
  9:     time: number;
 10:     label: string;
 11:     bt: number;
 12:     et: number | null;
 13:     ror: number | null;
 14:     ror_et: number | null;
 15:     heater: number;
 16:     fan: number;
 17:     drum: number;
 18: }
 19: 
 20: const TAURI = '__TAURI_INTERNALS__' in window;
 21: const TSV_HEADER = 'time\tbt\tet\tror\theater\tfan\tdrum\n';
 22: 
 23: interface Params {
 24:     /** 뷰가 화면에 노출되어 있는지 여부 (CSS hide → show 전환 감지) */
 25:     isActive: boolean;
 26:     /** 현재 로스팅 단계 */
 27:     phase: string;
 28:     /** 온도 폴링 주기 (ms) */
 29:     pollIntervalMs: number;
 30:     enterPreheating: (capabilities?: string[]) => void;
 31:     setConnected: (connected: boolean, capabilities?: string[]) => void;
 32:     /** Charge 시각 (ms). 0이면 로스팅 미시작 */
 33:     roastStartTimeRef: MutableRefObject<number>;
 34:     /** Charge 시 생성된 세션 UUID. null이면 미시작 */
 35:     sessionId: string | null;
 36:     /** Charge 이전 그래프에 표시할 구간 (초) */
 37:     preChargeDisplaySec: number;
 38: }
 39: 
 40: /**
 41:  * 사이드카(파이썬 프로세스)와의 연결 상태를 관리하고,
 42:  * 로스팅 중 온도를 주기적으로 폴링해 livePoints 배열을 누적한다.
 43:  *
 44:  * livePoints는 차트·자동감지 훅에서 공유되므로 이 훅에서 소유한다.
 45:  * resetActiveRoast 등 외부에서 초기화가 필요할 때를 위해 setLivePoints도 반환한다.
 46:  *
 47:  * sessionId가 설정되면 AppLocalData/session_{sessionId}.tsv에 커브 데이터를 기록한다.
 48:  */
 49: export const useSidecarPolling = ({
 50:     isActive,
 51:     phase,
 52:     pollIntervalMs,
 53:     enterPreheating,
 54:     setConnected,
 55:     roastStartTimeRef,
 56:     sessionId,
 57:     preChargeDisplaySec,
 58: }: Params) => {
 59:     const [livePoints, setLivePoints] = useState<LiveRoastPoint[]>([]);
 60:     // TSV 파일 헤더가 작성됐는지 추적 — sessionId가 바뀌면 다시 false로 리셋된다.
 61:     const tsvInitializedRef = useRef(false);
 62:     // pre-charge 버퍼: absTime으로 누적 (charge 시 음수 상대 시간으로 변환에 사용)
 63:     const preChargeBufferRef = useRef<(Omit<LiveRoastPoint, 'time' | 'label'> & { absTime: number })[]>([]);
 64:     // preheating 첫 폴링 시각 — livePoints 실시간 표시용 세션 기준점
 65:     const preChargeStartRef = useRef<number>(0);
 66:     const prevPhaseRef = useRef(phase);
 67: 
 68:     // sessionId가 새로 설정되면 TSV 파일을 헤더로 초기화한다.
 69:     useEffect(() => {
 70:         if (!sessionId || !TAURI) return;
 71:         tsvInitializedRef.current = false;
 72:         writeTextFile(`session_${sessionId}.tsv`, TSV_HEADER, { baseDir: BaseDirectory.AppLocalData })
 73:             .then(() => {
 74:                 tsvInitializedRef.current = true;
 75:             })
 76:             .catch(() => {});
 77:     }, [sessionId]);
 78: 
 79:     // phase → 'roasting' 전환 감지:
 80:     // 버퍼를 음수 상대 시간으로 변환 후 livePoints를 교체한다.
 81:     // (preheating 중 세션 상대 시간으로 쌓인 display 포인트는 버퍼 기반으로 덮어쓴다)
 82:     useEffect(() => {
 83:         if (prevPhaseRef.current !== 'roasting' && phase === 'roasting') {
 84:             const chargeTime = roastStartTimeRef.current;
 85:             let prePoints: LiveRoastPoint[] = [];
 86:             if (chargeTime !== 0 && preChargeBufferRef.current.length > 0) {
 87:                 const cutoff = chargeTime - preChargeDisplaySec * 1000;
 88:                 prePoints = preChargeBufferRef.current
 89:                     .filter((p) => p.absTime >= cutoff)
 90:                     .map((p) => {
 91:                         const relSec = (p.absTime - chargeTime) / 1000; // 음수
 92:                         const absT = Math.abs(relSec);
 93:                         const m = Math.floor(absT / 60);
 94:                         const s = Math.floor(absT % 60);
 95:                         return {
 96:                             ...p,
 97:                             time: relSec,
 98:                             label: `-${m}:${String(s).padStart(2, '0')}`,
 99:                         };
100:                     });
101:             }
102:             // 세션 상대 시간 display 포인트를 버퍼 기반 음수 포인트로 완전 교체
103:             setLivePoints(prePoints);
104:             preChargeBufferRef.current = [];
105:             preChargeStartRef.current = 0;
106:         }
107:         prevPhaseRef.current = phase;
108:     }, [phase, roastStartTimeRef, preChargeDisplaySec]);
109: 
110:     // 뷰가 활성화될 때 연결 상태를 확인하고 idle 상태면 예열 단계로 진입한다.
111:     useEffect(() => {
112:         if (!isActive) return;
113:         sidecar
114:             .getStatus()
115:             .then((s) => {
116:                 if (s.connected) {
117:                     setConnected(true, s.capabilities);
118:                     if (useRoastingStore.getState().phase === 'idle') {
119:                         enterPreheating(s.capabilities);
120:                     }
121:                 } else {
122:                     setConnected(false);
123:                 }
124:             })
125:             .catch(() => setConnected(false));
126:         // eslint-disable-next-line react-hooks/exhaustive-deps
127:     }, [isActive]);
128: 
129:     // 예열·대기·로스팅 단계에서 주기적으로 온도를 폴링한다.
130:     // idle / ended 단계에서는 폴링을 중단해 불필요한 IPC 호출을 막는다.
131:     useEffect(() => {
132:         if (phase === 'idle' || phase === 'ended') return;
133: 
134:         const poll = async () => {
135:             try {
136:                 const data = await sidecar.getTemperatures();
137:                 // bt가 null이면 연결 끊김 가능성 → /status로 이중 확인
138:                 if (data.bt == null) {
139:                     const status = await sidecar.getStatus().catch(() => null);
140:                     if (!status?.connected) {
141:                         useRoastingStore.getState().setError(status?.error ?? null);
142:                         setConnected(false);
143:                         return;
144:                     }
145:                 }
146:                 useRoastingStore.getState().updateLiveData(data);
147:                 useRoastingStore.getState().setReconnecting(data.reconnecting ?? false);
148:                 setConnected(true);
149:                 const bt = data.bt;
150:                 if (bt == null) return;
151: 
152:                 const currentPhase = useRoastingStore.getState().phase;
153: 
154:                 if (currentPhase === 'roasting' && roastStartTimeRef.current !== 0) {
155:                     // post-charge: 기존 livePoints 기록 로직
156:                     const t = (Date.now() - roastStartTimeRef.current) / 1000;
157:                     setLivePoints((prev) => {
158:                         // 폴링 주기보다 짧은 간격은 무시해 중복 포인트를 방지한다.
159:                         if (prev.length > 0 && t - prev[prev.length - 1].time < 0.4) return prev;
160:                         const min = Math.floor(t / 60);
161:                         const sec = Math.floor(t % 60);
162:                         const point: LiveRoastPoint = {
163:                             time: t,
164:                             label: `${min}:${String(sec).padStart(2, '0')}`,
165:                             bt,
166:                             et: data.et ?? null,
167:                             ror: data.ror,
168:                             ror_et: data.ror_et ?? null,
169:                             heater: data.heater ?? 0,
170:                             fan: data.fan ?? 0,
171:                             drum: data.drum ?? 0,
172:                         };
173: 
174:                         // TSV에 데이터 포인트 추가
175:                         const currentSessionId = useRoastingStore.getState().sessionId;
176:                         if (TAURI && tsvInitializedRef.current && currentSessionId) {
177:                             const row = `${t.toFixed(2)}\t${bt}\t${data.et ?? ''}\t${data.ror ?? ''}\t${data.heater ?? 0}\t${data.fan ?? 0}\t${data.drum ?? 0}\n`;
178:                             writeTextFile(`session_${currentSessionId}.tsv`, row, {
179:                                 baseDir: BaseDirectory.AppLocalData,
180:                                 append: true,
181:                             }).catch(() => {});
182:                         }
183: 
184:                         return [...prev, point];
185:                     });
186:                 } else if (currentPhase === 'standby') {
187:                     // pre-charge: 버퍼(absTime)와 livePoints(세션 상대 시간) 동시 기록
188:                     const absTime = Date.now();
189:                     const buf = preChargeBufferRef.current;
190:                     if (buf.length > 0 && absTime - buf[buf.length - 1].absTime < 400) return;
191: 
192:                     // 첫 폴링 시 세션 기준점 설정
193:                     if (preChargeStartRef.current === 0) {
194:                         preChargeStartRef.current = absTime;
195:                     }
196: 
197:                     const pointData = {
198:                         bt,
199:                         et: data.et ?? null,
200:                         ror: data.ror,
201:                         ror_et: data.ror_et ?? null,
202:                         heater: data.heater ?? 0,
203:                         fan: data.fan ?? 0,
204:                         drum: data.drum ?? 0,
205:                     };
206: 
207:                     // 버퍼: charge 시 음수 상대 시간 변환에 사용
208:                     buf.push({ absTime, ...pointData });
209:                     if (buf.length > 1200) buf.splice(0, buf.length - 1200);
210: 
211:                     // livePoints: 세션 상대 시간으로 차트에 실시간 표시
212:                     const sessionTime = (absTime - preChargeStartRef.current) / 1000;
213:                     const m = Math.floor(sessionTime / 60);
214:                     const s = Math.floor(sessionTime % 60);
215:                     setLivePoints((prev) => [
216:                         ...prev,
217:                         {
218:                             time: sessionTime,
219:                             label: `${m}:${String(s).padStart(2, '0')}`,
220:                             ...pointData,
221:                         },
222:                     ]);
223:                 }
224:             } catch (e) {
225:                 console.error('[sidecar] 폴링 오류:', e);
226:                 const status = await sidecar.getStatus().catch(() => null);
227:                 useRoastingStore.getState().setError(status?.error ?? null);
228:                 useRoastingStore.getState().setReconnecting(false);
229:                 setConnected(false);
230:             }
231:         };
232: 
233:         poll();
234:         const id = setInterval(poll, pollIntervalMs);
235:         return () => clearInterval(id);
236:         // eslint-disable-next-line react-hooks/exhaustive-deps
237:     }, [phase, pollIntervalMs]);
238: 
239:     return { livePoints, setLivePoints };
240: };
</file>

