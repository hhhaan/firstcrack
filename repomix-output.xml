 85: /** BT 커브를 30초 간격으로 생성. dropTemp와 총 duration(초)를 기반으로 계산. */
 86: export const generateProfileCurve = (dropTemp: number, duration: number): { t: number; bt: number }[] => {
 87:     const points: { t: number; bt: number }[] = [];
 88:     for (let t = 0; t <= duration; t += 30) {
 89:         let bt: number;
 90:         if (t <= 90) {
 91:             bt = 200 - (48 * t) / 90;
 92:         } else {
 93:             const remaining = duration - 90;
 94:             const rise = dropTemp - 152;
 95:             const elapsed = t - 90;
 96:             bt = 152 + rise * (elapsed / remaining) ** 0.75;
 97:         }
 98:         points.push({ t, bt: Math.round(bt * 10) / 10 });
 99:     }
100:     return points;
101: };
102: 
103: /** 시간(초)에 대한 BT를 선형 보간으로 반환 */
104: export const interpolateProfileBT = (curve: { t: number; bt: number }[], timeSec: number): number | null => {
105:     if (curve.length === 0) return null;
106:     if (timeSec <= curve[0].t) return curve[0].bt;
107:     if (timeSec >= curve[curve.length - 1].t) return curve[curve.length - 1].bt;
108:     for (let i = 0; i < curve.length - 1; i++) {
109:         const lo = curve[i];
110:         const hi = curve[i + 1];
111:         if (lo.t <= timeSec && timeSec <= hi.t) {
112:             const ratio = (timeSec - lo.t) / (hi.t - lo.t);
113:             return lo.bt + ratio * (hi.bt - lo.bt);
114:         }
115:     }
116:     return null;
117: };
</file>

<file path="src/shared/lib/batch-stock.ts">
 1: import { buildRRule, expandRRuleInRange, type RecurrenceInterval } from '@shared/lib/rrule';
 2: import type { PlanBatchWithProgress } from '@shared/types/database.types';
 3: 
 4: /** Matches bean-stock-event reservation horizon (4 weeks). */
 5: export const STOCK_RESERVATION_HORIZON_DAYS = 28;
 6: 
 7: /** Remaining green coffee (g) needed to complete this plan batch. */
 8: export const batchGreenNeededGrams = (batch: PlanBatchWithProgress): number => {
 9:     const remaining = Math.max(0, batch.batch_count - batch.completed_sessions);
10:     return remaining * Number(batch.batch_size_kg) * 1000;
11: };
12: 
13: export const isBatchStockShort = (batch: PlanBatchWithProgress, effectiveGrams: number | undefined): boolean => {
14:     if (!batch.bean_id) return false;
15:     const needed = batchGreenNeededGrams(batch);
16:     if (needed <= 0) return false;
17:     return (effectiveGrams ?? 0) < needed;
18: };
19: 
20: /** Green (g) required for all recurring instances within the reservation horizon. */
21: export const recurringHorizonGreenNeededGrams = (
22:     interval: RecurrenceInterval,
23:     dtstart: Date,
24:     batchSizeKg: number,
25:     batchCount: number,
26: ): number => {
27:     if (batchSizeKg <= 0 || batchCount <= 0) return 0;
28: 
29:     const today = new Date();
30:     today.setHours(0, 0, 0, 0);
31:     const horizon = new Date(today);
32:     horizon.setDate(horizon.getDate() + STOCK_RESERVATION_HORIZON_DAYS);
33:     horizon.setHours(23, 59, 59, 999);
34: 
35:     const rruleStr = buildRRule(interval);
36:     const instances = expandRRuleInRange(rruleStr, dtstart, today, horizon);
37:     return instances.length * batchCount * batchSizeKg * 1000;
38: };
39: 
40: export const isRecurringHorizonStockShort = (
41:     effectiveGrams: number | undefined,
42:     interval: RecurrenceInterval,
43:     dtstart: Date,
44:     batchSizeKg: number,
45:     batchCount: number,
46: ): boolean => {
47:     const needed = recurringHorizonGreenNeededGrams(interval, dtstart, batchSizeKg, batchCount);
48:     if (needed <= 0) return false;
49:     return (effectiveGrams ?? 0) < needed;
50: };
</file>

<file path="src/shared/lib/blend-stock.ts">
 1: export type BlendRoastableInput = {
 2:     beanId: string;
 3:     beanName: string;
 4:     ratioPct: number;
 5:     effectiveGrams: number;
 6: };
 7: 
 8: export type BlendRoastableResult = {
 9:     maxGrams: number;
10:     limitingBeanId: string | null;
11:     limitingBeanName: string | null;
12:     limitingEffectiveGrams: number;
13: };
14: 
15: export const EMPTY_BLEND_ROASTABLE: BlendRoastableResult = {
16:     maxGrams: 0,
17:     limitingBeanId: null,
18:     limitingBeanName: null,
19:     limitingEffectiveGrams: 0,
20: };
21: 
22: type BlendComponentStockSource = {
23:     bean_id: string;
24:     ratio_pct: number;
25:     beans: { name: string };
26: };
27: 
28: type BlendStockSource = {
29:     id: string;
30:     blend_components: BlendComponentStockSource[];
31: };
32: 
33: type StockSummaryLike = { effectiveGrams?: number };
34: 
35: /** Max green charge (g) roastable for a blend given per-component effective stock and ratios. */
36: export const blendMaxRoastableGrams = (components: BlendRoastableInput[]): BlendRoastableResult => {
37:     if (!components.length) {
38:         return EMPTY_BLEND_ROASTABLE;
39:     }
40: 
41:     let maxGrams = Infinity;
42:     let limitingBeanId: string | null = null;
43:     let limitingBeanName: string | null = null;
44:     let limitingEffectiveGrams = 0;
45: 
46:     for (const comp of components) {
47:         if (comp.ratioPct <= 0) {
48:             return EMPTY_BLEND_ROASTABLE;
49:         }
50:         const componentMax = Math.floor((comp.effectiveGrams * 100) / comp.ratioPct);
51:         if (componentMax < maxGrams) {
52:             maxGrams = componentMax;
53:             limitingBeanId = comp.beanId;
54:             limitingBeanName = comp.beanName;
55:             limitingEffectiveGrams = comp.effectiveGrams;
56:         }
57:     }
58: 
59:     if (!Number.isFinite(maxGrams) || maxGrams < 0) {
60:         return EMPTY_BLEND_ROASTABLE;
61:     }
62: 
63:     return { maxGrams, limitingBeanId, limitingBeanName, limitingEffectiveGrams };
64: };
65: 
66: export const blendToRoastableInputs = (
67:     blend: BlendStockSource,
68:     stockSummaries: Record<string, StockSummaryLike>,
69: ): BlendRoastableInput[] =>
70:     blend.blend_components.map((c) => ({
71:         beanId: c.bean_id,
72:         beanName: c.beans.name,
73:         ratioPct: Number(c.ratio_pct),
74:         effectiveGrams: stockSummaries[c.bean_id]?.effectiveGrams ?? 0,
75:     }));
76: 
77: export const blendRoastableByBlends = (
78:     blends: BlendStockSource[],
79:     stockSummaries: Record<string, StockSummaryLike>,
80: ): Record<string, BlendRoastableResult> =>
81:     Object.fromEntries(
82:         blends.map((blend) => [blend.id, blendMaxRoastableGrams(blendToRoastableInputs(blend, stockSummaries))]),
83:     );
</file>

