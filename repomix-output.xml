 61:     const { data: stockSummaries = {} } = useBeanStockSummaries(userId);
 62:     const isLoading = isDayPlanLoading || isBatchesLoading;
 63: 
 64:     const createBatch = useCreatePlanBatch(planId, userId, dateKey);
 65:     const reorderBatches = useReorderPlanBatches({ userId, date: dateKey, planId });
 66:     const createRecurringBatches = useCreateRecurringBatches(userId, planId);
 67:     const deleteSingleBatch = useDeleteSingleBatch({ userId, date: dateKey });
 68:     const deleteFromThis = useDeleteFromThis();
 69:     const deleteAllBatches = useDeleteAllBatches();
 70:     const updateSingleBatch = useUpdateSingleBatch();
 71:     const updateFromThis = useUpdateFromThis();
 72:     const updateAllBatches = useUpdateAllBatches();
 73: 
 74:     const commitStatusTransition = useCallback(
 75:         async (batch: PlanBatchWithProgress, status: 'in-progress' | 'done') => {
 76:             const patch = buildMaterializePatch(batch, status);
 77: 
 78:             if (isVirtualPlanBatch(batch) && batch.recurrence_rule_id && batch.scheduled_date) {
 79:                 const realBatch = await planBatchApi.materialize(
 80:                     userId,
 81:                     batch.recurrence_rule_id,
 82:                     batch.scheduled_date,
 83:                     batch.original_date ?? batch.scheduled_date,
 84:                     patch,
 85:                 );
 86:                 return { targetId: realBatch.id, targetPlanId: realBatch.plan_id };
 87:             }
 88: 
 89:             await updateSingleBatch.mutateAsync({
 90:                 id: batch.id,
 91:                 patch: {
 92:                     id: batch.id,
 93:                     plan_id: batch.plan_id,
 94:                     status,
 95:                     ...(batch.recurrence_rule_id ? buildRecurrencePatch(batch) : {}),
 96:                 },
 97:                 ...buildRecurrenceMeta(batch),
 98:             });
 99: 
100:             return { targetId: batch.id, targetPlanId: batch.plan_id };
101:         },
102:         [updateSingleBatch, userId],
103:     );
104: 
105:     const handleScopeDelete = useCallback(
106:         async (scope: EditScope, batch: PlanBatchWithProgress) => {
107:             if (!batch.recurrence_rule_id) return;
108: 
109:             if (scope === 'single') {
110:                 if (window.confirm(i18n.t('schedule.deleteConfirm.single'))) {
111:                     let targetPlanId = batch.plan_id;
112:                     if (!targetPlanId && batch.recurrence_rule_id && batch.scheduled_date) {
113:                         const plan = await dayPlanApi.getOrCreate(userId, batch.scheduled_date);
114:                         targetPlanId = plan.id;
115:                     }
116:                     deleteSingleBatch.mutate({
117:                         id: batch.id,
118:                         meta: {
119:                             recurrenceRuleId: batch.recurrence_rule_id,
120:                             originalDate: batch.scheduled_date ?? dateKey,
121:                             planId: targetPlanId ?? '',
122:                         },
123:                     });
124:                 }
125:             } else if (scope === 'from_this') {
126:                 if (
127:                     window.confirm(
128:                         i18n.t('schedule.deleteConfirm.fromThis', {
129:                             date: format(selectedDate, 'M월 d일', { locale: getDateFnsLocale() }),
130:                         }),
131:                     )
132:                 ) {
133:                     deleteFromThis.mutate({
134:                         ruleId: batch.recurrence_rule_id,
135:                         fromDate: dateKey,
136:                     });
137:                 }
138:             } else if (scope === 'all') {
139:                 if (window.confirm(i18n.t('schedule.deleteConfirm.all'))) {
140:                     deleteAllBatches.mutate(batch.recurrence_rule_id);
141:                 }
142:             }
143: 
144:             setIsDeleteScopeModalOpen(false);
145:             setScopeBatch(null);
146:         },
147:         [deleteSingleBatch, deleteFromThis, deleteAllBatches, dateKey, selectedDate, userId],
148:     );
149: 
150:     const handleEdit = useCallback((batch: PlanBatchWithProgress) => {
151:         if (batch.recurrence_rule_id) {
152:             setScopeBatch(batch);
153:             setIsEditScopeModalOpen(true);
154:         } else {
155:             setEditingBatch(batch);
156:             setEditScope(null);
157:         }
158:     }, []);
159: 
160:     const handleBatchDelete = useCallback(
161:         (batch: PlanBatchWithProgress) => {
162:             if (batch.recurrence_rule_id) {
163:                 setScopeBatch(batch);
164:                 setIsDeleteScopeModalOpen(true);
165:             } else {
166:                 if (window.confirm(i18n.t('schedule.deleteConfirm.batch', { name: batch.bean_name }))) {
167:                     deleteSingleBatch.mutate({ id: batch.id });
168:                 }
169:             }
170:         },
171:         [deleteSingleBatch],
172:     );
173: 
174:     const handleEditScopeConfirm = useCallback(
175:         (scope: EditScope) => {
176:             if (!scopeBatch) return;
177:             setEditScope(scope);
178:             setEditingBatch(scopeBatch);
179:             setIsEditScopeModalOpen(false);
180:             setScopeBatch(null);
181:         },
182:         [scopeBatch],
183:     );
184: 
185:     const handleDeleteScopeConfirm = useCallback(
186:         (scope: EditScope) => {
187:             if (!scopeBatch) return;
188:             handleScopeDelete(scope, scopeBatch);
189:         },
190:         [scopeBatch, handleScopeDelete],
191:     );
192: 
193:     const handleEditScopeUpdate = useCallback(
194:         async (data: NewBatchData) => {
195:             if (!editScope || !editingBatch?.recurrence_rule_id) return;
196: 
197:             const basePatch = {
198:                 id: editingBatch.id,
199:                 plan_id: '',
200:                 bean_name: data.beanName || editingBatch.bean_name,
201:                 bean_id: data.beanId,
202:                 blend_id: data.blendId ?? null,
203:                 batch_type: data.batchType,
204:                 roast_profile_id: data.profileId,
205:                 machine_id: data.machineId,
206:                 target_roasted_kg: data.targetRoasted,
207:                 batch_size_kg: data.batchSize,
208:                 yield_pct: data.yieldPct / 100,
209:                 notes: data.notes,
210:                 green_lot: data.greenLot,
211:             };
212: 
213:             if (editScope === 'single') {
214:                 let targetPlanId = editingBatch.plan_id;
215:                 if (!targetPlanId && editingBatch.recurrence_rule_id) {
216:                     const scheduleDate = editingBatch.scheduled_date ?? dateKey;
217:                     const plan = await dayPlanApi.getOrCreate(userId, scheduleDate);
218:                     targetPlanId = plan.id;
219:                 }
220:                 updateSingleBatch.mutate({
221:                     id: editingBatch.id,
222:                     patch: { ...basePatch, plan_id: targetPlanId ?? '' },
223:                     meta: {
224:                         recurrenceRuleId: editingBatch.recurrence_rule_id,
225:                         originalDate: editingBatch.scheduled_date ?? dateKey,
226:                     },
227:                 });
228:             } else {
229:                 const instanceDate = editingBatch.scheduled_date ?? dateKey;
230:                 const masterPatch = {
231:                     machine_id: data.machineId || null,
232:                     roast_profile_id: data.profileId,
233:                     bean_id: data.beanId,
234:                     blend_id: data.blendId ?? null,
235:                     bean_name: data.beanName || editingBatch.bean_name,
236:                     green_lot: data.greenLot,
237:                     batch_size_kg: data.batchSize,
238:                     yield_pct: data.yieldPct / 100,
239:                     target_roasted_kg: data.targetRoasted,
240:                     notes: data.notes,
241:                     batch_type: data.batchType,
242:                     ...(data.recurringInterval ? { rrule: buildRRule(data.recurringInterval) } : {}),
243:                 };
244: 
245:                 if (editScope === 'from_this') {
246:                     updateFromThis.mutate({
247:                         ruleId: editingBatch.recurrence_rule_id,
248:                         fromDate: instanceDate,
249:                         patch: { ...masterPatch, dtstart: instanceDate, userId },
250:                     });
251:                 } else if (editScope === 'all') {
252:                     updateAllBatches.mutate({
253:                         ruleId: editingBatch.recurrence_rule_id,
254:                         patch: masterPatch,
255:                     });
256:                 }
257:             }
258:         },
259:         [editScope, editingBatch, updateSingleBatch, updateFromThis, updateAllBatches, dateKey, userId],
260:     );
261: 
262:     const handleNewBatch = useCallback(
263:         async (data: NewBatchData) => {
264:             const baseBatch: Omit<PlanBatchInsert, 'plan_id'> = {
265:                 order_index: batches.length,
266:                 bean_name: data.beanName || data.batchType,
267:                 bean_id: data.beanId,
268:                 blend_id: data.blendId ?? null,
269:                 batch_type: data.batchType,
270:                 roast_profile_id: data.profileId,
271:                 machine_id: data.machineId || null,
272:                 target_roasted_kg: data.targetRoasted,
273:                 batch_size_kg: data.batchSize,
274:                 yield_pct: data.yieldPct / 100,
275:                 notes: data.notes,
276:                 green_lot: data.greenLot,
277:                 status: 'pending',
278:             };
279: 
280:             if (data.recurringInterval) {
281:                 createRecurringBatches.mutate(
282:                     { baseBatch, interval: data.recurringInterval, dtstart: data.date },
283:                     {
284:                         onError: (err) => {
285:                             console.error('[Schedule] createRecurringBatches failed:', err);
286:                             alert(
287:                                 i18n.t('schedule.error.createRecurring') +
288:                                     ` ${err instanceof Error ? err.message : String(err)}`,
289:                             );
290:                         },
291:                     },
292:                 );
293:             } else if (planId) {
294:                 createBatch.mutate({ ...baseBatch, plan_id: planId } as PlanBatchInsert, {
295:                     onError: (err) => {
296:                         console.error('[Schedule] createBatch failed:', err);
297:                         alert(
298:                             i18n.t('schedule.error.createBatch') +
299:                                 ` ${err instanceof Error ? err.message : String(err)}`,
300:                         );
301:                     },
302:                 });
303:             }
304:         },
305:         [planId, batches.length, createBatch, createRecurringBatches],
306:     );
307: 
308:     const handleAddBatch = useCallback(
309:         async (data: NewBatchData) => {
310:             if (editScope && editingBatch?.recurrence_rule_id) {
311:                 await handleEditScopeUpdate(data);
312:                 return;
313:             }
314:             await handleNewBatch(data);
315:         },
316:         [editScope, editingBatch, handleEditScopeUpdate, handleNewBatch],
317:     );
318: 
319:     const handleMove = useCallback(
320:         (index: number, dir: 'up' | 'down') => {
321:             const batch = batches[index];
322:             if (batch?.recurrence_rule_id) return;
323: 
324:             const next = [...batches];
325:             const swapWith = dir === 'up' ? index - 1 : index + 1;
326:             [next[index], next[swapWith]] = [next[swapWith], next[index]];
327:             reorderBatches.mutate(next.map((b) => b.id));
328:         },
329:         [batches, reorderBatches],
330:     );
331: 
332:     const handleStart = useCallback(
333:         async (batch: PlanBatchWithProgress) => {
334:             const handoffBeanId = batch.bean_id;
335:             const handoffBlendId = batch.blend_id ?? null;
336:             const handoffProfileId = batch.roast_profile_id;
337: 
338:             try {
339:                 const result = await commitStatusTransition(batch, 'in-progress');
340:                 const targetId = result.targetId;
341:                 const targetPlanId = result.targetPlanId;
342: 
343:                 onStartBatch({
344:                     planBatchId: targetId,
345:                     planId: targetPlanId,
346:                     beanId: handoffBeanId,
347:                     blendId: handoffBlendId,
348:                     beanName: batch.bean_name,
349:                     batchSizeKg: Number(batch.batch_size_kg),
350:                     profileId: handoffProfileId,
351:                     batchCount: batch.batch_count,
352:                     completedSessions: batch.completed_sessions,
353:                 });
354:             } catch (err) {
355:                 console.error('[Schedule] materialize failed:', err);
356:             }
357:         },
358:         [commitStatusTransition, onStartBatch],
359:     );
360: 
361:     const handleCompleteClick = useCallback((batch: PlanBatchWithProgress) => {
362:         setCompletingBatch(batch);
363:         setIsCompleteModalOpen(true);
364:     }, []);
365: 
366:     const handleCompleteClose = useCallback(() => {
367:         setIsCompleteModalOpen(false);
368:         setCompletingBatch(null);
369:     }, []);
370: 
371:     const handleCompleteConfirm = useCallback(
372:         async (deductStock: boolean) => {
373:             const batch = completingBatch;
374:             if (!batch) return;
375: 
376:             try {
377:                 const { targetId } = await commitStatusTransition(batch, 'done');
378: 
379:                 if (deductStock) {
380:                     const deductionGrams = batchGreenNeededGrams(batch);
381:                     if (deductionGrams > 0 && (batch.bean_id || batch.blend_id)) {
382:                         await deductRoastStock({
383:                             deductionGrams,
384:                             singleBeanId: batch.bean_id ?? null,
385:                             blendId: batch.blend_id ?? null,
386:                             referenceId: targetId,
387:                         });
388:                     }
389:                 }
390:             } catch (err) {
391:                 console.error('[Schedule] complete failed:', err);
392:                 alert(i18n.t('schedule.error.completeBatch') + ` ${err instanceof Error ? err.message : String(err)}`);
393:             } finally {
394:                 handleCompleteClose();
395:             }
396:         },
397:         [completingBatch, commitStatusTransition, deductRoastStock, handleCompleteClose],
398:     );
399: 
400:     const isRecurringStockShort = useCallback(
401:         (batch: PlanBatchWithProgress) => {
402:             if (!batch.recurrence_rule_id || !batch.bean_id) return false;
403:             return isBatchStockShort(batch, stockSummaries[batch.bean_id]?.effectiveGrams);
404:         },
405:         [stockSummaries],
406:     );
407: 
408:     const recurringStockShortDetail = useCallback(
409:         (batch: PlanBatchWithProgress) => {
410:             if (!batch.bean_id) return null;
411:             const neededKg = (batchGreenNeededGrams(batch) / 1000).toFixed(1);
412:             const availableKg = ((stockSummaries[batch.bean_id]?.effectiveGrams ?? 0) / 1000).toFixed(1);
413:             return { neededKg, availableKg };
414:         },
415:         [stockSummaries],
416:     );
417: 
418:     return {
419:         isLoading,
420:         isAddModalOpen,
421:         setIsAddModalOpen,
422:         batches,
423:         editingBatch,
424:         editScope,
425:         scopeBatch,
426:         isEditScopeModalOpen,
427:         setIsEditScopeModalOpen,
428:         isDeleteScopeModalOpen,
429:         setIsDeleteScopeModalOpen,
430:         setEditingBatch,
431:         setEditScope,
432:         setScopeBatch,
433:         handleAddBatch,
434:         handleMove,
435:         handleStart,
436:         handleCompleteClick,
437:         handleCompleteConfirm,
438:         handleCompleteClose,
439:         completingBatch,
440:         isCompleteModalOpen,
441:         handleEdit,
442:         handleBatchDelete,
443:         handleEditScopeConfirm,
444:         handleDeleteScopeConfirm,
445:         isRecurringStockShort,
446:         recurringStockShortDetail,
447:     };
448: };
</file>

