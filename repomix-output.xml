<file path="src/features/active-roast/model/useRoastLog.ts">
 1: import type { LogEntry } from '@shared/types/roast';
 2: import { useCallback, useState } from 'react';
 3: import { TOGGLEABLE_LOG_EVENTS } from '../lib/constants';
 4: import { formatTemp } from '../lib/temperature';
 5: import { parseTimeSec } from '../lib/time';
 6: import type { TemperatureUnit } from './settings';
 7: 
 8: export const useRoastLog = (unit: TemperatureUnit, rawBT: number | null, timeStr: string) => {
 9:     const [logEntries, setLogEntries] = useState<LogEntry[]>([]);
10:     const [pressedButtons, setPressedButtons] = useState<Set<string>>(new Set());
11: 
12:     const flashButton = useCallback((label: string) => {
13:         setPressedButtons((prev) => new Set(prev).add(label));
14:         setTimeout(() => {
15:             setPressedButtons((prev) => {
16:                 const n = new Set(prev);
17:                 n.delete(label);
18:                 return n;
19:             });
20:         }, 600);
21:     }, []);
22: 
23:     const markEvent = useCallback(
24:         (event: string, note: string, buttonLabel?: string) => {
25:             const isRemoval = TOGGLEABLE_LOG_EVENTS.has(event) && logEntries.some((e) => e.event === event);
26: 
27:             setLogEntries((prev) => {
28:                 if (TOGGLEABLE_LOG_EVENTS.has(event) && prev.some((e) => e.event === event)) {
29:                     return prev.filter((e) => e.event !== event);
30:                 }
31: 
32:                 const newEntry: LogEntry = {
33:                     id: crypto.randomUUID(),
34:                     time: timeStr,
35:                     event,
36:                     temp: rawBT !== null ? formatTemp(rawBT, unit) : '',
37:                     note,
38:                 };
39: 
40:                 return [...prev, newEntry].sort((a, b) => parseTimeSec(a.time) - parseTimeSec(b.time));
41:             });
42: 
43:             if (!isRemoval && buttonLabel) {
44:                 flashButton(buttonLabel);
45:             }
46:         },
47:         [logEntries, timeStr, rawBT, unit, flashButton],
48:     );
49: 
50:     const handleDrop = useCallback(() => {
51:         markEvent('Drop', 'Coffee dropped', 'Drop');
52:     }, [markEvent]);
53: 
54:     const removeLogEntry = useCallback((id: string) => {
55:         setLogEntries((prev) => prev.filter((entry) => entry.id !== id));
56:     }, []);
57: 
58:     return {
59:         logEntries,
60:         pressedButtons,
61:         markEvent,
62:         flashButton,
63:         handleDrop,
64:         setLogEntries, // reset할 때 필요
65:         removeLogEntry,
66:     };
67: };
</file>

<file path="src/features/export-csv/lib/csv-export.ts">
 1: import { formatDuration } from '@shared/lib/format';
 2: import { computeRoastWeights } from '@shared/lib/roastWeight';
 3: import type { RoastSessionWithRelations } from '@shared/types/database.types';
 4: 
 5: /** Escape a CSV field — wrap in quotes if it contains comma, quote, or newline. */
 6: const escapeField = (val: string): string => {
 7:     if (val.includes(',') || val.includes('"') || val.includes('\n') || val.includes('\r')) {
 8:         return `"${val.replace(/"/g, '""')}"`;
 9:     }
10:     return val;
11: };
12: 
13: export interface CsvRow {
14:     date: string;
15:     bean: string;
16:     origin: string;
17:     profile: string;
18:     weightGrams: number;
19:     inputKg: number;
20:     outputKg: number;
21:     lossRate: number;
22:     roastLevel: string;
23:     dropTemp: string;
24:     duration: string;
25:     notes: string;
26: }
27: 
28: const HEADERS: (keyof CsvRow)[] = [
29:     'date',
30:     'bean',
31:     'origin',
32:     'profile',
33:     'weightGrams',
34:     'inputKg',
35:     'outputKg',
36:     'lossRate',
37:     'roastLevel',
38:     'dropTemp',
39:     'duration',
40:     'notes',
41: ];
42: 
43: const HEADER_LABELS: Record<keyof CsvRow, string> = {
44:     date: 'Date',
45:     bean: 'Bean',
46:     origin: 'Origin',
47:     profile: 'Profile',
48:     weightGrams: 'Weight (g)',
49:     inputKg: 'Input (kg)',
50:     outputKg: 'Output (kg)',
51:     lossRate: 'Loss Rate (%)',
52:     roastLevel: 'Roast Level',
53:     dropTemp: 'Drop Temp (°C)',
54:     duration: 'Duration',
55:     notes: 'Notes',
56: };
57: 
58: const toCsvRow = (s: RoastSessionWithRelations): CsvRow => {
59:     const { outputKg, inputKg, lossRate } = computeRoastWeights(s.weight_grams);
60: 
61:     return {
62:         date: s.roasted_at ? s.roasted_at.slice(0, 10) : '',
63:         bean: s.beans?.name ?? '',
64:         origin: s.beans?.origin ?? '',
65:         profile: s.roast_profiles?.name ?? '',
66:         weightGrams: s.weight_grams ?? 0,
67:         inputKg,
68:         outputKg,
69:         lossRate,
70:         roastLevel: s.roast_level ?? '',
71:         dropTemp: s.drop_temp_celsius != null ? `${s.drop_temp_celsius}°C` : '',
72:         duration: s.duration_seconds != null ? formatDuration(s.duration_seconds) : '',
73:         notes: s.notes ?? '',
74:     };
75: };
76: 
77: /** Convert an array of RoastSessionWithRelations to a CSV string with BOM. */
78: export const sessionsToCsv = (sessions: RoastSessionWithRelations[]): string => {
79:     const header = HEADERS.map((h) => HEADER_LABELS[h]).join(',') + '\n';
80: 
81:     const rows = sessions
82:         .map((s) => {
83:             const row = toCsvRow(s);
84:             return HEADERS.map((h) => escapeField(String(row[h]))).join(',');
85:         })
86:         .join('\n');
87: 
88:     return `\uFEFF${header}${rows}\n`;
89: };
</file>

