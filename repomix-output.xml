 23: /// 포트 9999를 점유한 프로세스가 우리 사이드카 바이너리인지 확인 후 kill.
 24: /// 정상 twin이 없다고 single-instance 플러그인이 이미 보장한 상태에서만 호출된다.
 25: fn kill_zombie_sidecar() {
 26:     #[cfg(not(target_os = "windows"))]
 27:     {
 28:         // lsof -t: PID만 출력, -i tcp:9999: 해당 포트 리스너/연결만 필터
 29:         let pid_output = std::process::Command::new("sh")
 30:             .args(["-c", "lsof -ti tcp:9999 2>/dev/null"])
 31:             .output();
 32: 
 33:         if let Ok(out) = pid_output {
 34:             let pids = String::from_utf8_lossy(&out.stdout);
 35:             for pid_str in pids.split_whitespace() {
 36:                 // ps -o comm=: 실행 파일 basename만 출력 (경로 없음).
 37:                 // Tauri externalBin 규약상 바이너리는 "sidecar-<target-triple>" 형태이므로
 38:                 // contains("sidecar")가 확실히 매칭된다.
 39:                 let name_check = std::process::Command::new("sh")
 40:                     .args(["-c", &format!("ps -p {pid_str} -o comm= 2>/dev/null")])
 41:                     .output();
 42:                 if let Ok(n) = name_check {
 43:                     let name = String::from_utf8_lossy(&n.stdout).to_lowercase();
 44:                     // release에서는 "sidecar"만 매칭 — 사용자의 무관한 python 서버 오살 방지 (W3)
 45:                     // debug에서는 "python"도 추가해 venv dev 서버 정리 허용
 46:                     let should_kill = name.contains("sidecar")
 47:                         || (cfg!(debug_assertions) && name.contains("python"));
 48:                     if should_kill {
 49:                         let _ = std::process::Command::new("kill")
 50:                             .args(["-9", pid_str])
 51:                             .output();
 52:                         eprintln!("[sidecar-guard] 좀비 사이드카 kill: PID {pid_str}");
 53:                     }
 54:                 }
 55:             }
 56:         }
 57:     }
 58:     #[cfg(target_os = "windows")]
 59:     {
 60:         use std::os::windows::process::CommandExt;
 61: 
 62:         const CREATE_NO_WINDOW: u32 = 0x08000000;
 63: 
 64:         // netstat -ano 출력을 받아 Rust에서 직접 ":9999" 필터링.
 65:         // (콜론이 포트 경계 역할을 함: "127.0.0.1:19999"에서 ':' 다음 문자는 '1'이라 불일치)
 66:         let netstat = std::process::Command::new("netstat")
 67:             .args(["-ano"])
 68:             .creation_flags(CREATE_NO_WINDOW)
 69:             .output();
 70:         if let Ok(out) = netstat {
 71:             let text = String::from_utf8_lossy(&out.stdout);
 72:             let mut seen: std::collections::HashSet<String> = std::collections::HashSet::new();
 73:             for line in text.lines() {
 74:                 // ":9999"를 포함하지 않는 라인은 스킵 (findstr :9999 대체)
 75:                 if !line.contains(":9999") {
 76:                     continue;
 77:                 }
 78:                 // netstat 출력의 마지막 컬럼이 PID
 79:                 let pid = match line.split_whitespace().last() {
 80:                     Some(p) => p.to_string(),
 81:                     None => continue,
 82:                 };
 83:                 // 숫자가 아닌 토큰(헤더 행 등) 제외
 84:                 if pid.is_empty() || !pid.chars().all(|c| c.is_ascii_digit()) {
 85:                     continue;
 86:                 }
 87:                 if !seen.insert(pid.clone()) {
 88:                     continue;
 89:                 }
 90:                 // tasklist: 프로세스 이름 검증 후 우리 사이드카일 때만 kill (직접 호출)
 91:                 let tasklist = std::process::Command::new("tasklist")
 92:                     .args(["/FI", &format!("PID eq {pid}"), "/FO", "CSV", "/NH"])
 93:                     .creation_flags(CREATE_NO_WINDOW)
 94:                     .output();
 95:                 if let Ok(t) = tasklist {
 96:                     let name = String::from_utf8_lossy(&t.stdout).to_lowercase();
 97:                     // /T: 부트로더→자식 전체 트리 킬 (W2). release는 "sidecar"만 (W3).
 98:                     let should_kill = name.contains("sidecar")
 99:                         || (cfg!(debug_assertions) && name.contains("python"));
100:                     if should_kill {
101:                         let _ = std::process::Command::new("taskkill")
102:                             .args(["/F", "/T", "/PID", &pid])
103:                             .creation_flags(CREATE_NO_WINDOW)
104:                             .output();
105:                         eprintln!("[sidecar-guard] Windows 좀비 사이드카 kill: PID {pid}");
106:                     }
107:                 }
108:             }
109:         }
110:     }
111: }
