{
    "output": {
        "filePath": "repomix-output.xml",
        "style": "xml",
        "removeComments": false,
        "showLineNumbers": true
    },
    "include": ["**/*"],
    "ignore": {
        "useGitignore": true,
        "customPatterns": [
            "node_modules/**",
            ".git/**",
            "dist/**",
            "build/**",
            ".next/**",
            "repomix-output.txt",
            "package-lock.json",
            "yarn.lock",
            "pnpm-lock.yaml"
        ]
    }
}
