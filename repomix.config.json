{
    "output": {
        "filePath": "repomix-output.xml",
        "style": "xml",
        "removeComments": true,
        "removeEmptyLines": true,
        "showLineNumbers": true,
        "compress": true
    },
    "include": ["**/*"],
    "ignore": {
        "useGitignore": true,
        "useDefaultPatterns": true,
        "customPatterns": [
            "node_modules/**",
            ".git/**",
            "dist/**",
            "build/**",
            ".next/**",
            "artifacts/**",
            "repomix-output.txt",
            "repomix-output.xml",
            "package-lock.json",
            "yarn.lock",
            "pnpm-lock.yaml",
            ".mcp.json",
            ".codex/**",
            ".cursor/**",
            ".claude/**",
            ".clinerules/**",
            ".reasonix/**",
            ".omo/**",
            ".opencode/**",
            ".commandcode/**",
            ".superpowers/**",
            "memory.jsonl",
            "code_review.txt",
            "specific_file.diff",
            "*.diff",
            "TODOS.md",
            "DESIGN_REF_DATAROBOT.md",
            "react-doctor-report.json",
            "skills-lock.json",
            "src/shared/types/database.types.ts",
            "src-tauri/target/**",
            "src-tauri/binaries/**",
            "src-tauri/sidecar/venv/**",
            "src-tauri/sidecar/.venv/**",
            "src-tauri/sidecar/build/**",
            "src-tauri/sidecar/dist/**",
            "**/__pycache__/**",
            "**/*.{png,jpg,jpeg,gif,webp,ico,icns,woff,woff2,ttf,otf,msi,sig,dmg,zip}"
        ]
    }
}
