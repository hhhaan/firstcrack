{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "First Crack",
    "version": "1.1.12",
    "identifier": "com.han.firstcrack",
    "build": {
        "beforeDevCommand": "pnpm run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "pnpm run build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "First Crack",
                "width": 1260,
                "height": 810,
                "center": true,
                "resizable": true,
                "minWidth": 1260,
                "minHeight": 810,
                "devtools": true
            }
        ],
        "security": {
            "csp": "default-src 'self'; img-src 'self' data: https: blob:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:9999 https://*.supabase.co https://*.r2.cloudflarestorage.com https://pub-32f64eaa15504eeba9203bcbbced439d.r2.dev https://api.open-meteo.com https://*.ingest.us.sentry.io https://*.ingest.sentry.io"
        }
    },
    "plugins": {
        "deep-link": {
            "desktop": {
                "schemes": ["firstcrack"]
            }
        },
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlBODIzMjY0MjMyNzJCQjQKUldTMEt5Y2paREtDbW1WZU1XSWpvYTF3Q0ZVRW9BWGFlZ0ZYWE5IWFc5RG0xWkNid3ZyS1ZPdSsK",
            "endpoints": ["https://pub-32f64eaa15504eeba9203bcbbced439d.r2.dev/releases/latest.json"]
        }
    },
    "bundle": {
        "active": true,
        "targets": ["app", "dmg", "msi"],
        "createUpdaterArtifacts": true,
        "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
        "macOS": {
            "infoPlist": "Info.plist",
            "entitlements": "entitlements.plist"
        },
        "windows": {
            "webviewInstallMode": {
                "type": "embedBootstrapper"
            }
        }
    }
}
