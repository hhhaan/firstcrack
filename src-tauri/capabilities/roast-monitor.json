{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "roast-monitor",
  "description": "Live roast display and requests to the main window; no machine or file access.",
  "platforms": ["linux", "macOS", "windows"],
  "windows": ["roast-monitor"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:event:allow-emit-to",
    "core:window:allow-set-title",
    "store:allow-get",
    "store:allow-load",
    "os:allow-locale"
  ]
}
