{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities",
  "platforms": ["linux", "macOS", "windows"],
  "windows": ["main"],
  "permissions": [
    "core:default",
    "deep-link:default",
    "opener:default",
    "store:default",
    "shell:allow-spawn",
    "shell:allow-kill",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    "dialog:allow-save",
    "fs:allow-applocaldatadir",
    "fs:allow-applocaldatadir-read-recursive",
    "fs:allow-applocaldatadir-write-recursive",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-append-text-file",
    "fs:allow-remove-file"
  ]
}
