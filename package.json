{
    "name": "roastery-agent",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "predev": "lsof -ti:9999 | xargs kill -9 2>/dev/null || true",
        "dev": "concurrently --names \"vite,sidecar\" --prefix-colors \"cyan,yellow\" \"vite\" \"src-tauri/sidecar/.venv/bin/python src-tauri/sidecar/main.py\"",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "tauri": "tauri",
        "types:gen": "supabase gen types typescript --linked 2>/dev/null > src/shared/types/database.types.ts && node scripts/append-db-aliases.mjs",
        "build:sidecar": "bash scripts/build-sidecar.sh",
        "build:debug": "npm run build:sidecar && tauri build --debug && open 'src-tauri/target/debug/bundle/macos/First Crack.app'",
        "lint": "eslint src",
        "lint:fix": "eslint src --fix",
        "check": "biome check src",
        "check:fix": "biome check --write src",
        "format": "biome format src",
        "format:fix": "biome format --write src",
        "scan:secrets": "secretlint \"**/*\"",
        "prepare": "husky",
        "doctor": "react-doctor",
        "doctor:fast": "react-doctor --diff",
        "doctor:fix": "react-doctor --fix",
        "doctor:strict": "react-doctor --fail-on-warnings",
        "doctor:report": "react-doctor --format json > react-doctor-report.json"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1050.0",
        "@radix-ui/react-popover": "^1.1.15",
        "@radix-ui/react-select": "^2.2.6",
        "@sentry/react": "^10.53.1",
        "@supabase/supabase-js": "^2.105.4",
        "@tanstack/react-query": "^5.100.9",
        "@tauri-apps/api": "^2",
        "@tauri-apps/plugin-deep-link": "^2.4.9",
        "@tauri-apps/plugin-dialog": "^2.7.1",
        "@tauri-apps/plugin-fs": "^2.5.1",
        "@tauri-apps/plugin-notification": "^2.3.3",
        "@tauri-apps/plugin-opener": "^2",
        "@tauri-apps/plugin-os": "^2.3.2",
        "@tauri-apps/plugin-process": "^2.3.1",
        "@tauri-apps/plugin-store": "^2.4.3",
        "@tauri-apps/plugin-updater": "^2.10.1",
        "axios": "^1.16.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "date-fns": "^4.1.0",
        "echarts": "^6.0.0",
        "echarts-for-react": "^3.0.6",
        "i18next": "^26.0.10",
        "lucide-react": "^1.8.0",
        "react": "^19.1.0",
        "react-day-picker": "^10.0.1",
        "react-dom": "^19.1.0",
        "react-i18next": "^17.0.7",
        "react-to-print": "^3.3.0",
        "rrule": "^2.8.1",
        "tailwind-merge": "^3.6.0",
        "uplot": "^1.6.32",
        "zustand": "^5.0.13"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.0",
        "@eslint/js": "^10.0.1",
        "@secretlint/secretlint-rule-preset-recommend": "^13.0.2",
        "@tailwindcss/vite": "^4.2.4",
        "@tauri-apps/cli": "^2",
        "@types/react": "^19.1.8",
        "@types/react-dom": "^19.1.6",
        "@vitejs/plugin-react": "^4.6.0",
        "concurrently": "^9.2.1",
        "eslint": "^10.4.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.2",
        "globals": "^17.6.0",
        "husky": "^9.1.7",
        "imagemin-lint-staged": "^0.5.1",
        "lint-staged": "^17.0.5",
        "react-doctor": "^0.2.8",
        "secretlint": "^13.0.2",
        "tailwindcss": "^4.2.4",
        "typescript": "~5.8.3",
        "typescript-eslint": "^8.59.4",
        "vite": "^7.0.4"
    },
    "lint-staged": {
        "src/**/*.{ts,tsx}": "biome format --write --no-errors-on-unmatched",
        "**/*.{js,jsx,mjs,cjs,json,css,md}": "biome format --write --no-errors-on-unmatched",
        "*.{png,jpeg,jpg,gif,svg}": "imagemin-lint-staged",
        "**/*.{ts,tsx,js,jsx,mjs,cjs,json,yml,yaml,toml,md,py,sh,html,css,env,env.*}": "secretlint"
    },
    "packageManager": "pnpm@11.3.0+sha512.2c403d6594527287672b1f7056343a1f7c3634036a67ffabfcc2b3d7595d843768f8787148d1b57cf7956c90606bbd192857c363af19e96d2d0ec9ec5741d215"
}
