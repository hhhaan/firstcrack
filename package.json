{
    "name": "roastery-agent",
    "private": true,
    "version": "1.1.33",
    "type": "module",
    "scripts": {
        "setup": "bash scripts/setup.sh",
        "predev": "bash scripts/ensure-sidecar-venv.sh && (lsof -ti:9999 | xargs kill -9 2>/dev/null || true)",
        "dev": "concurrently --names \"vite,sidecar\" --prefix-colors \"cyan,yellow\" \"vite\" \"src-tauri/sidecar/.venv/bin/python src-tauri/sidecar/main.py\"",
        "build": "vite build",
        "typecheck": "tsgo --noEmit && tsgo --noEmit -p tsconfig.test.json",
        "test": "vitest run",
        "test:e2e": "playwright test --config e2e/playwright.config.ts",
        "test:e2e:ui": "playwright test --config e2e/playwright.config.ts --ui",
        "verify:core": "pnpm check && pnpm check:i18n && pnpm check:registry && pnpm check:plan-caps && pnpm typecheck && pnpm test",
        "verify": "pnpm verify:core && pnpm lint",
        "check:i18n": "node scripts/check-i18n.mjs",
        "check:registry": "node scripts/check-roaster-registry.mjs",
        "check:plan-caps": "node scripts/check-plan-caps.mjs",
        "verify:sidecar": "bash scripts/verify-sidecar.sh",
        "verify:all": "concurrently -g --raw \"pnpm verify:core\" \"pnpm lint\" \"pnpm verify:sidecar\"",
        "preview": "vite preview",
        "tauri": "tauri",
        "types:gen": "supabase gen types typescript --linked 2>/dev/null > src/shared/types/database.types.ts && node scripts/append-db-aliases.mjs",
        "build:sidecar": "bash scripts/build-sidecar.sh",
        "build:debug": "pnpm run build:sidecar && pnpm tauri build --debug && open 'src-tauri/target/debug/bundle/macos/First Crack.app'",
        "lint": "eslint --cache --cache-location node_modules/.cache/eslint src",
        "lint:fix": "eslint src --fix",
        "check": "biome check src scripts",
        "check:fix": "biome check --write src scripts",
        "format": "biome format src scripts",
        "format:fix": "biome format --write src scripts",
        "scan:secrets": "secretlint \"**/*\"",
        "prepare": "husky",
        "doctor": "react-doctor",
        "doctor:fast": "react-doctor --diff",
        "doctor:fix": "react-doctor --fix",
        "doctor:strict": "react-doctor --fail-on-warnings",
        "doctor:report": "react-doctor --format json > react-doctor-report.json",
        "version:bump": "node scripts/version-bump.mjs",
        "release": "node scripts/release.mjs",
        "repomix": "repomix --quiet"
    },
    "dependencies": {
        "@carbon/icons-react": "^11.82.0",
        "@hookform/resolvers": "^5.0.1",
        "@radix-ui/react-popover": "^1.1.15",
        "@radix-ui/react-select": "^2.2.6",
        "@sentry/react": "^10.53.1",
        "@supabase/supabase-js": "^2.105.4",
        "@tanstack/react-query": "^5.100.9",
        "@tauri-apps/api": "^2",
        "@tauri-apps/plugin-deep-link": "^2.4.9",
        "@tauri-apps/plugin-dialog": "^2.7.1",
        "@tauri-apps/plugin-fs": "^2.5.1",
        "@tauri-apps/plugin-notification": "^2.3.3",
        "@tauri-apps/plugin-opener": "^2",
        "@tauri-apps/plugin-os": "^2.3.2",
        "@tauri-apps/plugin-process": "^2.3.1",
        "@tauri-apps/plugin-store": "^2.4.3",
        "@tauri-apps/plugin-updater": "^2.10.1",
        "clsx": "^2.1.1",
        "date-fns": "^4.1.0",
        "echarts": "^6.0.0",
        "i18next": "^26.0.10",
        "lucide-react": "^1.8.0",
        "react": "^19.1.0",
        "react-day-picker": "^10.0.1",
        "react-dom": "^19.1.0",
        "react-hook-form": "^7.55.0",
        "react-hotkeys-hook": "^5.3.2",
        "react-i18next": "^17.0.7",
        "react-number-format": "^5.4.5",
        "rrule": "^2.8.1",
        "tailwind-merge": "^3.6.0",
        "uplot": "^1.6.32",
        "zod": "^3.24.3",
        "zustand": "^5.0.13"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.7",
        "@playwright/test": "1.62.1",
        "@secretlint/secretlint-rule-preset-recommend": "^13.0.4",
        "@sentry/vite-plugin": "^5.4.0",
        "@tailwindcss/vite": "^4.3.3",
        "@tauri-apps/cli": "^2",
        "@types/node": "^26.1.2",
        "@types/react": "^19.1.8",
        "@types/react-dom": "^19.1.6",
        "@typescript/native-preview": "7.0.0-dev.20260707.2",
        "@vitejs/plugin-react": "^4.6.0",
        "concurrently": "^9.2.4",
        "eslint": "^10.8.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.3",
        "globals": "^17.9.0",
        "husky": "^9.1.7",
        "imagemin-lint-staged": "^0.5.1",
        "jsdom": "^29.1.1",
        "lint-staged": "^17.3.0",
        "react-doctor": "^0.9.5",
        "secretlint": "^13.0.4",
        "tailwindcss": "^4.3.3",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.66.0",
        "vite": "^7.3.6",
        "vitest": "^4.1.10"
    },
    "lint-staged": {
        "src/**/*.{ts,tsx}": "biome check --write --no-errors-on-unmatched",
        "**/*.{js,jsx,mjs,cjs,json,css,md}": "biome check --write --no-errors-on-unmatched",
        "*.{png,jpeg,jpg,gif,svg}": "imagemin-lint-staged",
        "**/*.{ts,tsx,js,jsx,mjs,cjs,json,yml,yaml,toml,md,py,sh,html,css,env,env.*}": "secretlint"
    },
    "packageManager": "pnpm@11.3.0+sha512.2c403d6594527287672b1f7056343a1f7c3634036a67ffabfcc2b3d7595d843768f8787148d1b57cf7956c90606bbd192857c363af19e96d2d0ec9ec5741d215"
}
