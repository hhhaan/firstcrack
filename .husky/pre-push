#!/usr/bin/env sh
. "$(dirname "$0")/_/husky.sh"

# Regenerate repomix output for downstream AI tools
repomix --quiet

# Auto-fix import sorting, formatting, and safe lint fixes
npx biome check --write src

npx tsc --noEmit --pretty
npx react-doctor --diff

# Sidecar Python tests
(cd src-tauri/sidecar && .venv/bin/python -m pytest tests/ -q)
