{
    "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
    // husky pre-commit이 `node scripts/...`로 직접 호출한다. husky 플러그인은 known binary만 본다.
    // CI invokes billing types through tsc; the MCP runner invokes its integration fixture through Deno.
    "entry": [
        "scripts/check-version-sync.mjs",
        "supabase/tests/polar-database-types.ts",
        "supabase/tests/mcp-opaque.integration.ts"
    ],
    // Deno resolves the pinned npm: imports; Knip otherwise reports a nonexistent package named "npm".
    "ignoreIssues": { "supabase/tests/mcp-opaque.integration.ts": ["unlisted"] },
    "ignore": [
        // Deno. `deno check`(edge-check)와 vitest가 본다. `npm:` specifier는 knip이 패키지 `npm`으로 오인한다.
        "supabase/functions/**",
        // 로컬 프리뷰. 앱 그래프 밖.
        "output/**",
        // 연결 전 코드. 지우거나 다시 붙이면 이 목록에서 뺀다.
        "src/shared/store/dismissedAlerts.ts",
        "src/widgets/blend-detail/index.ts",
        "src/widgets/blend-list/index.ts",
        // App.tsx에서 첫 실행 테마 선택은 주석으로 꺼 둔 상태.
        "src/widgets/theme-select-modal/**"
    ],
    // types:gen의 supabase CLI. npm 패키지가 아니다.
    "ignoreBinaries": ["supabase"],
    // .secretlintrc.json이 로드한다. knip에 secretlint 플러그인이 없다.
    "ignoreDependencies": ["@secretlint/secretlint-rule-preset-recommend"],
    // 배럴 public API의 unused export는 이번 게이트에 넣지 않는다.
    "exclude": ["exports", "types", "nsExports", "nsTypes", "duplicates", "enumMembers", "namespaceMembers", "cycles"]
}
